+++ b/src/ModelingAlgorithms/TKMesh/BRepMesh/BRepMesh_BucketClass2d.hxx
@@ -0,0 +1,448 @@
+// Copyright (c) 2026 — modification of Open CASCADE Technology 8.0.1 for FreeCAD (defect 012,
+// https://github.com/fozzfut/freecad-kernel-fixes). Distributed under GNU LGPL 2.1 with the Open
+// CASCADE exception, as the rest of OCCT.
+//
+// Point-in-polygon with EXACTLY the answers of CSLib_Class2d::SiDans (OCCT 8.0.1, TKMath,
+// CSLib_Class2d.cxx: init, SiDans, internalSiDans, internalSiDansOuOn, transformToNormalized) -
+// every per-segment predicate uses the same floating-point expressions - but a query visits only
+// the segments/vertices that can change its answer, found through uniform buckets over the
+// normalized polygon:
+//   parity (ray to +x)  : segments whose y-interval contains Py   -> y-buckets of segments
+//   ON test 1 (vertex)  : vertices within the open box of Tolu/Tolv -> y-buckets of vertices
+//   ON test 2 (x-cross) : segments whose x-interval strictly contains Px -> x-buckets of segments
+// CSLib_Class2d scans all N segments for every query; on the owner's ball-screw face (14 149
+// boundary segments) that scan was 35-39 % of the meshing time
+// (C:/dev/cad-perf-research/tessellation).
+//
+// 8.0.1 semantics (resynced 26.09.2026 from CSLib_Class2d.cxx of V8_0_1; the 7.8.1 copy differed):
+//  - ON test 2 skips nearly vertical segments: std::abs(aEdgeDx) > Precision::PConfusion()
+//    (CSLib_Class2d.cxx:305-306);
+//  - the four tolerance-corner checks run only when myTolU > 0.0 || myTolV > 0.0 (7.8.1: any
+//    non-zero tolerance, i.e. also a negative or NaN one);
+//  - the point arrays are NCollection_Array1<double> members sized by Resize(0, N, false), as
+//    8.0.1 init() sizes them, so their allocation and its failure are the stock ones.
+//
+// Why no candidate is ever missed: bucketOf() is monotone non-decreasing in its argument, and every
+// predicate that can fire implies (in exact arithmetic on the stored doubles, since a - b < 0 <=> a
+// < b and rounding is monotone) that the stored coordinate lies between the two query bounds whose
+// buckets are scanned. The extra PConfusion guard of ON test 2 only removes firings, so the x-bucket
+// candidates remain a superset. The order of the visited segments does not matter: parity is a
+// count, ON is "any segment". A polygon with a non-finite coordinate falls back to one bucket (= the
+// full scan of CSLib_Class2d). Small polygons (N < THE_MIN_BUCKETED segments) and every one-bucket
+// case skip the tables and run CSLib's own fused loops (fullSiDansOuOn / fullParity: same
+// expressions, same order), so a face with a short boundary pays no extra cost over CSLib_Class2d.
+// Identity also relies on the floating-point model: OCCT's TKMath (CSLib_Class2d) and TKMesh (this
+// class) must both be compiled with /fp:precise (or the equivalent) and WITHOUT floating-point
+// contraction into FMA (MSVC: no /fp:contract, no /fp:fast; GCC/Clang: -ffp-contract=off),
+// otherwise the same source expression may round differently in the two libraries. Out of memory:
+// the bucket tables are extra memory that stock never asks for: if they cannot be allocated
+// (std::bad_alloc), the class drops them and answers with CSLib's full scan (K = 1) - the same
+// answers, and no new exception type reaches the caller. Test hook (BREPMESH_BUCKETCLASS2D_TESTHOOKS,
+// defined only by classcmp) makes the table allocation fail for real: an impossible request to
+// operator new.
+#ifndef _BRepMesh_BucketClass2d_HeaderFile
+#define _BRepMesh_BucketClass2d_HeaderFile
+
+#include <Standard.hxx>
+#include <Standard_DefineAlloc.hxx>
+#include <gp_Pnt2d.hxx>
+#include <NCollection_Array1.hxx>
+#include <Precision.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <new>
+#include <vector>
+
+class BRepMesh_BucketClass2d
+{
+public:
+  DEFINE_STANDARD_ALLOC
+
+  BRepMesh_BucketClass2d(const NCollection_Array1<gp_Pnt2d>& thePnts,
+                         const double                        theTolU,
+                         const double                        theTolV,
+                         const double                        theUMin,
+                         const double                        theVMin,
+                         const double                        theUMax,
+                         const double                        theVMax)
+      : myUmin(theUMin),
+        myVmin(theVMin),
+        myUmax(theUMax),
+        myVmax(theVMax),
+        myN(0),
+        myTolu(0.),
+        myTolv(0.)
+  {
+    // == CSLib_Class2d::init (8.0.1)
+    if (theUMax <= theUMin || theVMax <= theVMin || thePnts.Length() < 3)
+      return;
+    myN    = thePnts.Length();
+    myTolu = theTolU;
+    myTolv = theTolV;
+    // == myPnts2dX.Resize(0, myPointsCount, false); myPnts2dY.Resize(0, myPointsCount, false);
+    myPntsX.Resize(0, myN, false);
+    myPntsY.Resize(0, myN, false);
+    myX              = &myPntsX.ChangeFirst();
+    myY              = &myPntsY.ChangeFirst();
+    const double du  = theUMax - theUMin;
+    const double dv  = theVMax - theVMin;
+    const int aLower = thePnts.Lower();
+    for (int i = 0; i < myN; ++i)
+    {
+      const gp_Pnt2d& aP = thePnts(i + aLower);
+      myX[i]             = transform2d(aP.X(), theUMin, du);
+      myY[i]             = transform2d(aP.Y(), theVMin, dv);
+    }
+    myX[myN] = myX[0];
+    myY[myN] = myY[0];
+    constexpr double THE_MIN_RANGE = 1e-10;
+    if (du > THE_MIN_RANGE)
+      myTolu /= du;
+    if (dv > THE_MIN_RANGE)
+      myTolv /= dv;
+    build();
+  }
+
+  //! Number of buckets per axis (1 = CSLib's full scan, no tables). For tests.
+  int NbBuckets() const { return myK; }
+
+#ifdef BREPMESH_BUCKETCLASS2D_TESTHOOKS
+  //! Test only: make the next constructions fail to allocate the tables.
+  static bool& TestFailTables()
+  {
+    static bool aFlag = false;
+    return aFlag;
+  }
+
+  //! Test only: number of constructions that lost their tables to std::bad_alloc.
+  static long long& TestTableFallbacks()
+  {
+    static long long aCount = 0;
+    return aCount;
+  }
+#endif
+
+  // myX/myY point into myPntsX/myPntsY: no copies
+  BRepMesh_BucketClass2d(const BRepMesh_BucketClass2d&)            = delete;
+  BRepMesh_BucketClass2d& operator=(const BRepMesh_BucketClass2d&) = delete;
+
+  //! Same contract as CSLib_Class2d::SiDans: 1 inside, 0 on/uncertain, -1 outside.
+  int SiDans(const gp_Pnt2d& theP) const
+  {
+    if (myN == 0)
+      return 0;
+    double       x     = theP.X();
+    double       y     = theP.Y();
+    const double aTolu = myTolu * (myUmax - myUmin);
+    const double aTolv = myTolv * (myVmax - myVmin);
+    // myN != 0 implies myUmax > myUmin and myVmax > myVmin (init), as in 8.0.1
+    if (x < (myUmin - aTolu) || x > (myUmax + aTolu) || y < (myVmin - aTolv)
+        || y > (myVmax + aTolv))
+      return -1;
+    x             = transform2d(x, myUmin, myUmax - myUmin);
+    y             = transform2d(y, myVmin, myVmax - myVmin);
+    const int res = siDansOuOn(x, y);
+    if (res == -1)
+      return 0;
+    if (myTolu > 0.0 || myTolv > 0.0)
+    {
+      if (res != parity(x - myTolu, y - myTolv) || res != parity(x + myTolu, y - myTolv)
+          || res != parity(x - myTolu, y + myTolv) || res != parity(x + myTolu, y + myTolv))
+        return 0;
+    }
+    return res ? 1 : -1;
+  }
+
+private:
+  //! == transformToNormalized in CSLib_Class2d.cxx (8.0.1)
+  static double transform2d(const double u, const double umin, const double d)
+  {
+    constexpr double THE_MIN_RANGE = 1e-10;
+    if (d > THE_MIN_RANGE)
+    {
+      return (u - umin) / d;
+    }
+    return u;
+  }
+
+  //! Monotone non-decreasing in v; the bound check precedes the cast, so a huge or infinite f never
+  //! reaches the (undefined) double -> int conversion.
+  static int bucketOf(const double v, const double lo, const double inv, const int theK)
+  {
+    const double f = (v - lo) * inv;
+    if (!(f >= 0.))
+      return 0; // also NaN
+    if (f >= (double)theK)
+      return theK - 1;
+    return (int)f; // 0 <= f < theK: the conversion is defined
+  }
+
+  int bucketOf(const double v, const double lo, const double inv) const
+  {
+    return bucketOf(v, lo, inv, myK);
+  }
+
+  void build()
+  {
+    double xhi = -1e300, yhi = -1e300;
+    myXlo = myYlo = 1e300;
+    bool isFinite = true;
+    for (int i = 0; i <= myN; ++i)
+    {
+      if (!std::isfinite(myX[i]) || !std::isfinite(myY[i]))
+        isFinite = false;
+      myXlo = std::min(myXlo, myX[i]);
+      xhi   = std::max(xhi, myX[i]);
+      myYlo = std::min(myYlo, myY[i]);
+      yhi   = std::max(yhi, myY[i]);
+    }
+    myK = (isFinite && myN >= THE_MIN_BUCKETED) ? std::max(1, std::min(1 << 16, myN / 4)) : 1;
+    // Memory guard: a polygon whose segments each span many buckets (a zigzag across the whole
+    // face) would store O(N * K) entries; halve K until the tables hold at most 32 entries per
+    // segment. Answers do not depend on K.
+    const long long aLimit = 32LL * myN + 4096;
+    for (;;)
+    {
+      myXinv = (xhi > myXlo) ? myK / (xhi - myXlo) : 0.;
+      myYinv = (yhi > myYlo) ? myK / (yhi - myYlo) : 0.;
+      if (myK == 1)
+        break;
+      long long aTotal = 0;
+      for (int i = 0; i < myN && aTotal <= aLimit; ++i)
+      {
+        aTotal += bucketOf(std::max(myY[i], myY[i + 1]), myYlo, myYinv)
+                  - bucketOf(std::min(myY[i], myY[i + 1]), myYlo, myYinv)
+                  + bucketOf(std::max(myX[i], myX[i + 1]), myXlo, myXinv)
+                  - bucketOf(std::min(myX[i], myX[i + 1]), myXlo, myXinv) + 3;
+      }
+      if (aTotal <= aLimit)
+        break;
+      myK /= 2;
+    }
+    if (myK == 1)
+      return; // fullSiDansOuOn / fullParity need no tables
+    try
+    {
+#ifdef BREPMESH_BUCKETCLASS2D_TESTHOOKS
+      if (TestFailTables())
+        mySy.reserve(std::size_t(1)
+                     << 60); // operator new cannot serve 4 EiB: a real std::bad_alloc
+#endif
+      buildTables();
+    }
+    catch (const std::bad_alloc&)
+    {
+      // the tables only speed the queries up; CSLib's full scan (K = 1) gives the same answers
+      // without them
+      std::vector<int>().swap(myOy);
+      std::vector<int>().swap(myOx);
+      std::vector<int>().swap(myOv);
+      std::vector<int>().swap(mySy);
+      std::vector<int>().swap(mySx);
+      std::vector<int>().swap(mySv);
+      myK = 1;
+#ifdef BREPMESH_BUCKETCLASS2D_TESTHOOKS
+      ++TestTableFallbacks();
+#endif
+    }
+  }
+
+  void buildTables()
+  {
+    std::vector<int> cy(myK + 1, 0), cx(myK + 1, 0), cv(myK + 1, 0);
+    for (int pass = 0; pass < 2; ++pass)
+    {
+      if (pass == 1)
+      {
+        for (int k = 0; k < myK; ++k)
+        {
+          cy[k + 1] += cy[k];
+          cx[k + 1] += cx[k];
+          cv[k + 1] += cv[k];
+        }
+        myOy = cy;
+        myOx = cx;
+        myOv = cv;
+        mySy.resize(cy[myK]);
+        mySx.resize(cx[myK]);
+        mySv.resize(cv[myK]);
+      }
+      for (int i = 0; i < myN; ++i)
+      {
+        const int ya = bucketOf(std::min(myY[i], myY[i + 1]), myYlo, myYinv);
+        const int yb = bucketOf(std::max(myY[i], myY[i + 1]), myYlo, myYinv);
+        const int xa = bucketOf(std::min(myX[i], myX[i + 1]), myXlo, myXinv);
+        const int xb = bucketOf(std::max(myX[i], myX[i + 1]), myXlo, myXinv);
+        const int kv = bucketOf(myY[i + 1], myYlo, myYinv); // vertex ip1 = i + 1
+        for (int k = ya; k <= yb; ++k)
+        {
+          if (pass == 0)
+            ++cy[k + 1];
+          else
+            mySy[cy[k]++] = i;
+        }
+        for (int k = xa; k <= xb; ++k)
+        {
+          if (pass == 0)
+            ++cx[k + 1];
+          else
+            mySx[cx[k]++] = i;
+        }
+        if (pass == 0)
+          ++cv[kv + 1];
+        else
+          mySv[cv[kv]++] = i + 1;
+      }
+    }
+  }
+
+  //! One crossing of the ray from (Px, Py) to +x by the segment with end offsets (aPrevDx, aPrevDy)
+  //! and (aCurrDx, aCurrDy) whose y signs differ: == the crossing test of internalSiDans (8.0.1).
+  static bool crosses(const double aPrevDx,
+                      const double aPrevDy,
+                      const double aCurrDx,
+                      const double aCurrDy)
+  {
+    if (aPrevDx > 0.0 && aCurrDx > 0.0)
+      return true;
+    if (aPrevDx > 0.0 || aCurrDx > 0.0)
+    {
+      const double aXIntersect = aPrevDx - aPrevDy * (aCurrDx - aPrevDx) / (aCurrDy - aPrevDy);
+      return aXIntersect > 0.0;
+    }
+    return false;
+  }
+
+  //! == CSLib_Class2d::internalSiDans restricted to the segments that can cross the ray
+  int parity(const double Px, const double Py) const
+  {
+    if (myK == 1)
+      return fullParity(Px, Py);
+    const int k   = bucketOf(Py, myYlo, myYinv);
+    int       nbc = 0;
+    for (int j = myOy[k]; j < myOy[k + 1]; ++j)
+    {
+      const int    i       = mySy[j];
+      const double aPrevDx = myX[i] - Px;
+      const double aPrevDy = myY[i] - Py;
+      const double aCurrDx = myX[i + 1] - Px;
+      const double aCurrDy = myY[i + 1] - Py;
+      if ((aCurrDy < 0.0) != (aPrevDy < 0.0) && crosses(aPrevDx, aPrevDy, aCurrDx, aCurrDy))
+        ++nbc;
+    }
+    return nbc & 1;
+  }
+
+  //! == ON test 2 of CSLib_Class2d::internalSiDansOuOn for the segment ending at vertex ip1
+  bool onEdge(const int ip1, const double Px, const double Py) const
+  {
+    const double aCurrDx = myX[ip1] - Px;
+    const double aEdgeDx = myX[ip1] - myX[ip1 - 1];
+    if ((myX[ip1 - 1] - Px) * aCurrDx < 0.0 && std::abs(aEdgeDx) > Precision::PConfusion())
+    {
+      const double aInterpY = myY[ip1] - (myY[ip1] - myY[ip1 - 1]) / aEdgeDx * aCurrDx;
+      const double aDeltaY  = aInterpY - Py;
+      if (aDeltaY >= -myTolv && aDeltaY <= myTolv)
+        return true;
+    }
+    return false;
+  }
+
+  //! == ON test 1 of CSLib_Class2d::internalSiDansOuOn at vertex v
+  bool onVertex(const int v, const double Px, const double Py) const
+  {
+    const double aCurrDx = myX[v] - Px;
+    const double aCurrDy = myY[v] - Py;
+    return aCurrDx < myTolu && aCurrDx > -myTolu && aCurrDy < myTolv && aCurrDy > -myTolv;
+  }
+
+  //! == CSLib_Class2d::internalSiDansOuOn: -1 if ON (either test, any segment), else the parity
+  int siDansOuOn(const double Px, const double Py) const
+  {
+    if (myK == 1)
+      return fullSiDansOuOn(Px, Py);
+    {
+      const int a = bucketOf(Py - myTolv, myYlo, myYinv), b = bucketOf(Py + myTolv, myYlo, myYinv);
+      for (int k = a; k <= b; ++k)
+        for (int j = myOv[k]; j < myOv[k + 1]; ++j)
+          if (onVertex(mySv[j], Px, Py))
+            return -1;
+    }
+    {
+      const int k = bucketOf(Px, myXlo, myXinv);
+      for (int j = myOx[k]; j < myOx[k + 1]; ++j)
+        if (onEdge(mySx[j] + 1, Px, Py))
+          return -1;
+    }
+    return parity(Px, Py);
+  }
+
+  //! == CSLib_Class2d::internalSiDans, the same loop (all segments, one pass)
+  int fullParity(const double Px, const double Py) const
+  {
+    int    nbc              = 0;
+    double aPrevDx          = myX[0] - Px;
+    double aPrevDy          = myY[0] - Py;
+    bool   aPrevYIsNegative = (aPrevDy < 0.0);
+    for (int aNextIdx = 1; aNextIdx <= myN; ++aNextIdx)
+    {
+      const double aCurrDx          = myX[aNextIdx] - Px;
+      const double aCurrDy          = myY[aNextIdx] - Py;
+      const bool   aCurrYIsNegative = (aCurrDy < 0.0);
+      if (aCurrYIsNegative != aPrevYIsNegative)
+      {
+        if (crosses(aPrevDx, aPrevDy, aCurrDx, aCurrDy))
+          ++nbc;
+        aPrevYIsNegative = aCurrYIsNegative;
+      }
+      aPrevDx = aCurrDx;
+      aPrevDy = aCurrDy;
+    }
+    return nbc & 1;
+  }
+
+  //! == CSLib_Class2d::internalSiDansOuOn, the same loop (vertex test, edge test, parity in one
+  //! pass)
+  int fullSiDansOuOn(const double Px, const double Py) const
+  {
+    int    nbc              = 0;
+    double aPrevDx          = myX[0] - Px;
+    double aPrevDy          = myY[0] - Py;
+    bool   aPrevYIsNegative = (aPrevDy < 0.0);
+    for (int aNextIdx = 1; aNextIdx <= myN; ++aNextIdx)
+    {
+      if (onVertex(aNextIdx, Px, Py) || onEdge(aNextIdx, Px, Py))
+        return -1;
+      const double aCurrDx          = myX[aNextIdx] - Px;
+      const double aCurrDy          = myY[aNextIdx] - Py;
+      const bool   aCurrYIsNegative = (aCurrDy < 0.0);
+      if (aCurrYIsNegative != aPrevYIsNegative)
+      {
+        if (crosses(aPrevDx, aPrevDy, aCurrDx, aCurrDy))
+          ++nbc;
+        aPrevYIsNegative = aCurrYIsNegative;
+      }
+      aPrevDx = aCurrDx;
+      aPrevDy = aCurrDy;
+    }
+    return nbc & 1;
+  }
+
+  //! Below this many boundary segments the tables cost more than the scan they save.
+  static constexpr int THE_MIN_BUCKETED = 64;
+
+  double                     myUmin, myVmin, myUmax, myVmax;
+  int                        myN;
+  double                     myTolu, myTolv;
+  NCollection_Array1<double> myPntsX; // sized as CSLib_Class2d::init sizes myPnts2dX
+  NCollection_Array1<double> myPntsY;
+  double*                    myX   = nullptr; // &myPntsX.First(), indices 0..N
+  double*                    myY   = nullptr;
+  int                        myK   = 1;
+  double                     myXlo = 0., myYlo = 0., myXinv = 0., myYinv = 0.;
+  std::vector<int>           myOy, myOx, myOv, mySy, mySx, mySv;
+};
+
+#endif
diff --git a/src/ModelingAlgorithms/TKMesh/BRepMesh/BRepMesh_CircleTool.cxx b/src/ModelingAlgorithms/TKMesh/BRepMesh/BRepMesh_CircleTool.cxx
index a4e8abb3..bd5e456e 100644
--- a/src/ModelingAlgorithms/TKMesh/BRepMesh/BRepMesh_CircleTool.cxx
+++ b/src/ModelingAlgorithms/TKMesh/BRepMesh/BRepMesh_CircleTool.cxx
@@ -21,6 +21,498 @@
 #include <BRepMesh_Circle.hxx>
 #include <BRepMesh_CircleInspector.hxx>
 
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <functional>
+#include <memory>
+#include <new>
+#include <vector>
+
+// defect 012: fast selection of the circles shot by a node on faces with many triangles.
+//
+// Why: BRepMesh_Delaun sizes the circle grid once, from the boundary nodes (5 x 5 cells on a long
+// face), so every Select walks the circles of a whole cell - thousands on a face with 10^5..10^6
+// triangles.
+//
+// What stays the same: Select returns exactly what the stock grid returns, in the same order.
+//  - The stock grid (myCellFilter) registers circle i in every cell of the range of its box clamped
+//  to the face
+//    box; a cell's list is newest first (NCollection_CellFilter::add prepends), and Inspect appends
+//    the circles that pass BRepMesh_CircleInspector's test in list order. Circle indices are
+//    triangle indices; triangles get fresh growing indices
+//    (BRepMesh_DataStructureOfDelaun::AddElement), so "newest first" is "descending index" - this
+//    is checked on the stock lists before the fast mode starts, and every later bind must bring an
+//    index the tool has never seen, otherwise the fast mode ends on the spot.
+//  - So the stock result for a point P = the live circles registered in the stock cell of P that
+//  pass the
+//    test, in descending index order. The fast mode keeps every live circle in a finer grid
+//    (FastGrid), in every cell that its disk, grown by a margin far above the test's tolerance and
+//    rounding, reaches (a superset: every circle that can pass the test at P is in the cell of P);
+//    a circle too large for the finest level goes to a coarser one (4 x 4 times coarser each), the
+//    few largest to a list read on every Select. For P, the fast Select keeps a circle only if the
+//    stock cell of P lies in the circle's stock range (the same expressions as the stock grid),
+//    sorts by descending index and runs the stock test (BRepMesh_CircleInspector::Inspect) in that
+//    order. For a point beyond the face box in x the candidates are the disks that reach beyond it
+//    on that side (kept in two lists).
+//  - Circles bound while the fast mode is on go to the finer grid only; when it ends they are added
+//  to the
+//    stock grid in ascending index order, which gives the stock lists (minus dead entries, which
+//    the stock Inspect would purge anyway and which never pass the test).
+// The finer grid is owned by one call of BRepMesh_Delaun::createTrianglesOnNewVertices (see
+// fastSelectUpdate / fastSelectEnd) and reached through a thread_local pointer keyed by the tool's
+// address: no data member is added to any class, the structure is freed when that call returns
+// (also on an exception). Whether and when the fast mode starts (THE_FAST_* below) changes only the
+// speed, never the result.
+namespace
+{
+//! The fast mode starts only for a pass that still inserts at least this many nodes per stock cell.
+const double THE_FAST_MIN_NODES_PER_CELL = 8.;
+//! Passes that end with fewer triangles keep the stock path.
+const int THE_FAST_MIN_TRIANGLES = 16384;
+//! A circle whose range covers more fine cells than this is kept in a list checked on every Select.
+const int THE_FAST_MAX_CELLS_PER_CIRCLE = 16;
+//! Upper bound of the fine grid's cell count.
+const int THE_FAST_MAX_CELLS = 1 << 22;
+//! The grid is rebuilt when its node array holds more than this many nodes per triangle.
+const double THE_FAST_MAX_NODES_PER_TRIANGLE = 16.;
+//! Number of grid levels at most (each 4 x 4 times coarser than the previous one).
+const int THE_FAST_NB_LEVELS = 8;
+
+//! Read access to the stock cell filter (members are protected in NCollection_CellFilter).
+struct CircleCellFilterAccess : public IMeshData::CircleCellFilter
+{
+  static const NCollection_Array1<double>& CellSize(const IMeshData::CircleCellFilter& theFilter)
+  {
+    return theFilter.*(&CircleCellFilterAccess::myCellSize);
+  }
+
+  //! Calls theFunc (cellX, cellY, isFirstOfCell, index) for every entry of every cell, in list
+  //! order. theFunc returns 0 to keep the entry, 1 to purge it (unlinked as
+  //! NCollection_CellFilter::inspect does on CellFilter_Purge), -1 to stop. Returns false if
+  //! stopped.
+  template <class Func>
+  static bool ForEachEntry(IMeshData::CircleCellFilter& theFilter, Func theFunc)
+  {
+    CellMap& aCells = theFilter.*(&CircleCellFilterAccess::myCells);
+    for (CellMap::Iterator aCellIt(aCells); aCellIt.More(); aCellIt.Next())
+    {
+      Cell& aCell = (Cell&)aCellIt.Key();
+      if (aCell.index.Size() != 2)
+      {
+        return false;
+      }
+      bool      isFirst = true;
+      ListNode* aPrev   = NULL;
+      for (ListNode* aNode = aCell.Objects; aNode != NULL;)
+      {
+        ListNode* aNext    = aNode->Next;
+        const int anAction = theFunc(aCell.index[0], aCell.index[1], isFirst, aNode->Object);
+        isFirst            = false;
+        if (anAction < 0)
+        {
+          return false;
+        }
+        if (anAction == 1)
+        {
+          aNode->Object.~Target();
+          (aPrev ? aPrev->Next : aCell.Objects) = aNext;
+        }
+        else
+        {
+          aPrev = aNode;
+        }
+        aNode = aNext;
+      }
+    }
+    return true;
+  }
+};
+
+//! Cell index of the stock grid: the expression of NCollection_CellFilter::Cell.
+inline int stockCell(const double theCoord, const double theSize)
+{
+  double aVal = (double)(theCoord / theSize);
+  return int((aVal > INT_MAX - 1)   ? fmod(aVal, (double)INT_MAX)
+             : (aVal < INT_MIN + 1) ? fmod(aVal, (double)INT_MIN)
+                                    : aVal);
+}
+
+//! Stock clamped box of a circle: the expressions of BRepMesh_CircleTool::bind.
+inline void stockBox(const gp_XY& theLoc,
+                     const double theRadius,
+                     const gp_XY& theFaceMin,
+                     const gp_XY& theFaceMax,
+                     gp_XY&       theMin,
+                     gp_XY&       theMax)
+{
+  double aMaxX = std::min(theLoc.X() + theRadius, theFaceMax.X());
+  double aMinX = std::max(theLoc.X() - theRadius, theFaceMin.X());
+  double aMaxY = std::min(theLoc.Y() + theRadius, theFaceMax.Y());
+  double aMinY = std::max(theLoc.Y() - theRadius, theFaceMin.Y());
+  theMin.SetCoord(aMinX, aMinY);
+  theMax.SetCoord(aMaxX, aMaxY);
+}
+
+//! Cell index of the fine grid; monotone in theV (NaN goes to 0).
+inline int fineCell(const double theV, const double theV0, const double theInv, const int theN)
+{
+  const double aF = std::floor((theV - theV0) * theInv);
+  if (!(aF >= 0.))
+  {
+    return 0;
+  }
+  if (aF >= (double)theN)
+  {
+    return theN - 1;
+  }
+  return (int)aF;
+}
+
+//! A superset of BRepMesh_CircleInspector::Inspect's test (which the tool builds with tol =
+//! PConfusion): the same expression against a bound 10^6 x tol^2 plus 1e-12 r^2, far above any
+//! rounding difference.
+inline bool mayShoot(const BRepMesh_Circle& theCircle, const gp_XY& thePoint)
+{
+  static const double THE_SQ_TOL_BOUND = 1.e6 * Precision::PConfusion() * Precision::PConfusion();
+  const double        aRadius          = theCircle.Radius();
+  const double        aDX              = thePoint.X() - theCircle.Location().X();
+  const double        aDY              = thePoint.Y() - theCircle.Location().Y();
+  return !((aDX * aDX + aDY * aDY) - (aRadius * aRadius)
+           > THE_SQ_TOL_BOUND + 1.e-12 * (aRadius * aRadius));
+}
+
+struct FastNode
+{
+  int Circle;
+  int Next;
+};
+
+//! One level of the fine grid: NX x NY cells over the face box, each a list of nodes.
+struct FastLevel
+{
+  double           X0, Y0, InvX, InvY;
+  int              NX, NY;
+  std::vector<int> Heads; //!< first node of each cell, -1 = empty
+
+  FastLevel()
+      : X0(0.),
+        Y0(0.),
+        InvX(0.),
+        InvY(0.),
+        NX(1),
+        NY(1)
+  {
+  }
+
+  int& Head(const gp_XY& thePoint)
+  {
+    const int aX = fineCell(thePoint.X(), X0, InvX, NX);
+    const int aY = fineCell(thePoint.Y(), Y0, InvY, NY);
+    return Heads[(size_t)aY * (size_t)NX + (size_t)aX];
+  }
+};
+
+//! The fast-mode state of one BRepMesh_CircleTool during one createTrianglesOnNewVertices call.
+//! Level 0 has about one cell per two triangles; each next level is 4 x 4 times coarser. A circle
+//! lives on the finest level where it covers at most THE_FAST_MAX_CELLS_PER_CIRCLE cells, else in
+//! Big.
+struct FastGrid
+{
+  const BRepMesh_CircleTool* Owner;
+  double                     SX, SY; //!< stock cell sizes
+  gp_XY                      FaceMin, FaceMax;
+  FastLevel                  Levels[THE_FAST_NB_LEVELS];
+  int                        NbLevels;
+  std::vector<FastNode>      Nodes;
+  int                        FreeNode;
+  std::vector<int>           Big;          //!< circles covering many cells on every level
+  std::vector<int>           OutLo, OutHi; //!< circles whose grown disk reaches beyond the x range
+  std::vector<int>           Bound;        //!< circles bound while the fast mode is on, ascending
+  std::vector<int>           Candidates;   //!< scratch of Select
+  double                     DomainSlack;  //!< x range of the grid: face box +- DomainSlack
+
+  FastGrid()
+      : Owner(NULL),
+        SX(0.),
+        SY(0.),
+        NbLevels(1),
+        FreeNode(-1),
+        DomainSlack(0.)
+  {
+  }
+
+  //! True if thePoint.X() lies in the x range the grid covers (false for NaN).
+  bool InDomain(const gp_XY& thePoint) const
+  {
+    return thePoint.X() >= FaceMin.X() - DomainSlack && thePoint.X() <= FaceMax.X() + DomainSlack;
+  }
+
+  double NbCells0() const { return (double)Levels[0].NX * (double)Levels[0].NY; }
+
+  //! Sizes the grid for about theTarget cells on level 0 over the face box.
+  void Layout(const double theTarget)
+  {
+    const double aW  = FaceMax.X() - FaceMin.X();
+    const double aH  = FaceMax.Y() - FaceMin.Y();
+    const bool   isW = (aW > 0. && aW < RealLast());
+    const bool   isH = (aH > 0. && aH < RealLast());
+    double       aNX = 1., aNY = 1.;
+    if (isW && isH)
+    {
+      aNX = Ceiling(Sqrt(theTarget * (aW / aH)));
+      aNX = Max(1., Min(aNX, (double)THE_FAST_MAX_CELLS));
+      aNY = Ceiling(theTarget / aNX);
+      aNY = Max(1., Min(aNY, (double)THE_FAST_MAX_CELLS / aNX));
+      aNY = Max(1., Floor(aNY));
+    }
+    else if (isW)
+    {
+      aNX = Max(1., Min(Ceiling(theTarget), (double)THE_FAST_MAX_CELLS));
+    }
+    else if (isH)
+    {
+      aNY = Max(1., Min(Ceiling(theTarget), (double)THE_FAST_MAX_CELLS));
+    }
+    DomainSlack = 1.e-10 * (Abs(FaceMin.X()) + Abs(FaceMax.X())) + 1.e-300;
+    int aCurNX = (int)aNX, aCurNY = (int)aNY;
+    NbLevels = 0;
+    for (;;)
+    {
+      FastLevel& aLevel = Levels[NbLevels++];
+      aLevel.NX         = aCurNX;
+      aLevel.NY         = aCurNY;
+      aLevel.X0         = FaceMin.X();
+      aLevel.Y0         = FaceMin.Y();
+      aLevel.InvX       = isW ? aCurNX / aW : 0.;
+      aLevel.InvY       = isH ? aCurNY / aH : 0.;
+      aLevel.Heads.assign((size_t)aCurNX * (size_t)aCurNY, -1);
+      if ((aCurNX == 1 && aCurNY == 1) || NbLevels == THE_FAST_NB_LEVELS)
+      {
+        break;
+      }
+      aCurNX = (aCurNX + 3) / 4;
+      aCurNY = (aCurNY + 3) / 4;
+    }
+    Nodes.clear();
+    FreeNode = -1;
+    Big.clear();
+    OutLo.clear();
+    OutHi.clear();
+  }
+
+  //! Puts the circle at the head of a cell list.
+  void Link(int& theHead, const int theIndex)
+  {
+    int aNode = FreeNode;
+    if (aNode >= 0)
+    {
+      FreeNode = Nodes[aNode].Next;
+    }
+    else
+    {
+      aNode = (int)Nodes.size();
+      Nodes.push_back(FastNode());
+    }
+    Nodes[aNode].Circle = theIndex;
+    Nodes[aNode].Next   = theHead;
+    theHead             = aNode;
+  }
+
+  //! Counts (thePass == 0, stops above THE_FAST_MAX_CELLS_PER_CIRCLE) or fills (thePass == 1) the
+  //! cells of theLevel that a point passing the stock test for the circle can lie in. Returns the
+  //! count, or -1 when the circle must go to Big (NaN).
+  long long Cover(FastLevel&   theLevel,
+                  const int    thePass,
+                  const int    theIndex,
+                  const gp_XY& theLoc,
+                  const double theRadius)
+  {
+    // BRepMesh_CircleInspector::Inspect accepts |P - loc|^2 - r^2 <= tol^2 (tol = PConfusion), i.e.
+    // |P - loc| <= r + tol + a few ulps of r. The reach adds a margin of 100 x tol plus 1e-12
+    // relative.
+    const double aMargin = 1.e-7 + 1.e-12 * (Abs(theLoc.X()) + Abs(theLoc.Y()) + Abs(theRadius));
+    const double aReach  = theRadius + aMargin;
+    if (!(aReach >= 0.))
+    {
+      return -1;
+    }
+    const int aX0 = fineCell(theLoc.X() - aReach, theLevel.X0, theLevel.InvX, theLevel.NX);
+    const int aX1 = fineCell(theLoc.X() + aReach, theLevel.X0, theLevel.InvX, theLevel.NX);
+
+    // Per column of cells, only the rows the disk (grown by the margin) reaches inside that column:
+    // for a huge circle whose centre lies far outside the face (triangles of the sweep front joined
+    // to the super-triangle vertices) this is a short chord instead of the whole face. The x range
+    // of a column is widened by DomainSlack (far above the rounding of fineCell); the border
+    // columns end at the face box plus DomainSlack - Select takes points beyond that through the
+    // full list (selectOutside).
+    const double aSlack  = DomainSlack + 1.e-10 * Abs(theLoc.X());
+    const double aReach2 = aReach * aReach;
+    long long    aSpan   = 0;
+    for (int aX = aX0; aX <= aX1; ++aX)
+    {
+      const double aLo = (aX == 0 || !(theLevel.InvX > 0.))
+                           ? FaceMin.X() - DomainSlack
+                           : theLevel.X0 + aX / theLevel.InvX - aSlack;
+      const double aHi = (aX == theLevel.NX - 1 || !(theLevel.InvX > 0.))
+                           ? FaceMax.X() + DomainSlack
+                           : theLevel.X0 + (aX + 1) / theLevel.InvX + aSlack;
+      double       aDX = 0.;
+      if (theLoc.X() < aLo)
+      {
+        aDX = aLo - theLoc.X();
+      }
+      else if (theLoc.X() > aHi)
+      {
+        aDX = theLoc.X() - aHi;
+      }
+      aDX = Max(0., aDX * (1. - 1.e-10) - aSlack);
+      // h^2 = reach^2 - dx^2 rounds with an absolute error of a few ulps of reach^2 + dx^2 (large
+      // next to h^2 near the tangent column): the slack of 1e-12 of that sum keeps h^2 an upper
+      // bound
+      const double aDX2 = aDX * aDX;
+      const double aH2  = (aReach2 - aDX2) + 1.e-12 * (aReach2 + aDX2);
+      if (!(aH2 >= 0.))
+      {
+        if (aH2 < 0.)
+        {
+          continue; // the disk does not reach this column
+        }
+        return -1; // NaN
+      }
+      const double aH  = Sqrt(aH2) * (1. + 1.e-10) + aMargin;
+      const int    aY0 = fineCell(theLoc.Y() - aH, theLevel.Y0, theLevel.InvY, theLevel.NY);
+      const int    aY1 = fineCell(theLoc.Y() + aH, theLevel.Y0, theLevel.InvY, theLevel.NY);
+      aSpan += (long long)(aY1 - aY0 + 1);
+      if (thePass == 0)
+      {
+        if (aSpan > THE_FAST_MAX_CELLS_PER_CIRCLE)
+        {
+          return aSpan;
+        }
+        continue;
+      }
+      for (int aY = aY0; aY <= aY1; ++aY)
+      {
+        Link(theLevel.Heads[(size_t)aY * (size_t)theLevel.NX + (size_t)aX], theIndex);
+      }
+    }
+    return aSpan;
+  }
+
+  //! Registers a live circle on the finest level where it covers few cells, or in Big.
+  void Register(const int theIndex, const gp_XY& theLoc, const double theRadius)
+  {
+    // a point beyond the x range of the grid can only lie in these disks (Select, !InDomain)
+    {
+      const double aReach =
+        theRadius + 1.e-7 + 1.e-12 * (Abs(theLoc.X()) + Abs(theLoc.Y()) + Abs(theRadius));
+      if (!(theLoc.X() - aReach >= FaceMin.X() - DomainSlack))
+      {
+        OutLo.push_back(theIndex);
+      }
+      if (!(theLoc.X() + aReach <= FaceMax.X() + DomainSlack))
+      {
+        OutHi.push_back(theIndex);
+      }
+    }
+    // most circles are small: the cells of the box of the grown disk on level 0 (a superset of the
+    // cells Cover finds) when there are few of them
+    {
+      FastLevel&   aLevel = Levels[0];
+      const double aReach =
+        theRadius + 1.e-7 + 1.e-12 * (Abs(theLoc.X()) + Abs(theLoc.Y()) + Abs(theRadius));
+      if (aReach >= 0.)
+      {
+        const int aX0 = fineCell(theLoc.X() - aReach, aLevel.X0, aLevel.InvX, aLevel.NX);
+        const int aX1 = fineCell(theLoc.X() + aReach, aLevel.X0, aLevel.InvX, aLevel.NX);
+        const int aY0 = fineCell(theLoc.Y() - aReach, aLevel.Y0, aLevel.InvY, aLevel.NY);
+        const int aY1 = fineCell(theLoc.Y() + aReach, aLevel.Y0, aLevel.InvY, aLevel.NY);
+        if ((long long)(aX1 - aX0 + 1) * (long long)(aY1 - aY0 + 1)
+            <= THE_FAST_MAX_CELLS_PER_CIRCLE)
+        {
+          for (int aY = aY0; aY <= aY1; ++aY)
+          {
+            for (int aX = aX0; aX <= aX1; ++aX)
+            {
+              Link(aLevel.Heads[(size_t)aY * (size_t)aLevel.NX + (size_t)aX], theIndex);
+            }
+          }
+          return;
+        }
+      }
+    }
+    for (int aLevel = 0; aLevel < NbLevels; ++aLevel)
+    {
+      const long long aSpan = Cover(Levels[aLevel], 0, theIndex, theLoc, theRadius);
+      if (aSpan < 0)
+      {
+        break;
+      }
+      if (aSpan <= THE_FAST_MAX_CELLS_PER_CIRCLE)
+      {
+        Cover(Levels[aLevel], 1, theIndex, theLoc, theRadius);
+        return;
+      }
+    }
+    Big.push_back(theIndex);
+  }
+
+  //! True if the stock grid holds the circle in the stock cell (theSX, theSY).
+  bool InStockCell(const BRepMesh_Circle& theCircle, const int theSX, const int theSY) const
+  {
+    gp_XY aMin, aMax;
+    stockBox(theCircle.Location(), theCircle.Radius(), FaceMin, FaceMax, aMin, aMax);
+    return stockCell(aMin.X(), SX) <= theSX && theSX <= stockCell(aMax.X(), SX)
+           && stockCell(aMin.Y(), SY) <= theSY && theSY <= stockCell(aMax.Y(), SY);
+  }
+
+  //! Collects the live circles of the grid (each once), ascending.
+  void LiveCircles(const IMeshData::VectorOfCircle& theCircles, std::vector<int>& theOut) const
+  {
+    // every node is in a cell list or in the free list; a node is freed only when its circle is
+    // dead, so a plain pass over the node array, Big, OutLo and OutHi, followed by the liveness
+    // test, gives the registered live circles
+    std::vector<char> aSeen((size_t)Max(theCircles.Length(), 0), 0);
+    for (size_t aNode = 0; aNode < Nodes.size(); ++aNode)
+    {
+      aSeen[(size_t)Nodes[aNode].Circle] = 1;
+    }
+    for (size_t i = 0; i < Big.size(); ++i)
+    {
+      aSeen[(size_t)Big[i]] = 1;
+    }
+    // a circle whose disk lies wholly beyond the x range of the grid is linked in no cell, only in
+    // OutLo or OutHi (review t4 #1)
+    for (size_t i = 0; i < OutLo.size(); ++i)
+    {
+      aSeen[(size_t)OutLo[i]] = 1;
+    }
+    for (size_t i = 0; i < OutHi.size(); ++i)
+    {
+      aSeen[(size_t)OutHi[i]] = 1;
+    }
+    theOut.clear();
+    for (size_t anIdx = 0; anIdx < aSeen.size(); ++anIdx)
+    {
+      if (aSeen[anIdx] && !(theCircles.Value((int)anIdx).Radius() < 0.))
+      {
+        theOut.push_back((int)anIdx);
+      }
+    }
+  }
+};
+
+thread_local FastGrid* THE_FAST_GRID = NULL;
+
