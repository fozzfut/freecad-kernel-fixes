+//! Defect 012, Task 4b. perform(i) queries, for every segment s of wire i and every wire j >= i,
+//! the segment tree of wire j: S*W/2 tree queries on a face with S segments and W wires (18.4 % of
+//! the holes1024 top face after Task 4 of plan B). Select() first calls Reject(root box R_j) =
+//! s.IsOut(R_j) and returns 0 without any Accept() when it is true (NCollection_UBTree.hxx:267-268,
+//! 416). The boxes of the segments of wire i lie inside R_i - the union of the same boxes (built
+//! from the same two points, Enlarge(Confusion), the same Gap; Bnd_Box2d::Add keeps the max Gap) -
+//! and for finite boxes without open sides IsOut() (Bnd_Box2d.cxx:331-346) only gets truer when its
+//! own box shrinks: Xmin - Gap and Xmax + Gap move inwards, and the rounding of - and + is
+//! monotone. So R_i.IsOut(R_j) proves that every Select() of the pair (i, j) returns 0 at the root:
+//! the pair adds nothing to the maps, in any order, and is skipped. The candidates j come from one
+//! more UBTree over the root boxes: a node box contains the boxes below it, so a node rejected by
+//! R_i.IsOut() only holds wires j with R_i.IsOut(R_j) (the same monotonicity, on the second box),
+//! and a leaf is reached only when no node above it is rejected. Candidates are therefore exactly
+//! the wires j >= i with !R_i.IsOut(R_j). They are returned ascending - the order of perform()'s
+//! loop - so the queries and the insertions into the maps are the loop's own. Not filtered: a wire
+//! with a non-finite segment coordinate (NaN makes the comparisons false, the lemma does not hold)
+//! queries every wire j >= i and is queried by every wire - as before. A wire without segments has
+//! an empty tree (Select() returns 0, UBTree.hxx:268) and, as wire i, nothing to query. A face with
+//! at most 3 wires (almost every face) builds no tree: every wire j >= i is a candidate - the stock
+//! loop. Out of memory (review of Task 4b, M1; the rule of Task 5, finding 3): the wire tree, the
+//! flags and the candidate lists are extra memory that stock never asks for. If one of them cannot
+//! be allocated (std::bad_alloc from std::vector, Standard_OutOfMemory from Standard::Allocate), it
+//! is dropped and that wire - or, for the tree, every wire of the face - runs the stock loop over
+//! every wire j >= i, which needs no list: the same queries, maps and statuses as stock, and no new
+//! exception type reaches BRepMesh_ModelHealer::process. What the loop itself allocates (the maps)
+//! fails as in stock: Standard_OutOfMemory, which ModelHealer::process catches, marking that face
+//! alone IMeshData_Failure. The wire tree and its filler use the common allocator
+//! (Standard::Allocate throws Standard_OutOfMemory) instead of an NCollection_IncAllocator, whose
+//! new block (Standard::AllocateOptimal, a plain malloc here) is used unchecked. Test hooks
+//! (verification build only, FC4B_OOM) make these allocations fail for real: an impossible request
+//! to operator new or to Standard::Allocate.
+class WireCandidates
+{
+public:
+  WireCandidates(const BRepMesh_FaceChecker::ArrayOfSegments&   theWiresSegments,
+                 const BRepMesh_FaceChecker::ArrayOfBndBoxTree& theWiresBndBoxTree)
+      : myNbWires(theWiresBndBoxTree.Length())
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+        ,
+        myFallbacks(0),
+        myOomWild(false),
+        myOomTree(false),
+        myOomList(false)
+#endif
+  {
+    if (myNbWires <= 3)
+    {
+      return; // no tree: Get() gives every wire j >= i (the stock loop)
+    }
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+    // test hooks (verification build only): FC4B_OOM holds any of "wild", "tree", "list" - the
+    // allocation of the flags, of the wire tree, of every candidate list fails for real
+    if (const char* anOom = std::getenv("FC4B_OOM"))
+    {
+      myOomWild = std::strstr(anOom, "wild") != NULL;
+      myOomTree = std::strstr(anOom, "tree") != NULL;
+      myOomList = std::strstr(anOom, "list") != NULL;
+    }
+#endif
+    try
+    {
+      build(theWiresSegments, theWiresBndBoxTree);
+    }
+    catch (const std::bad_alloc&) // OOM-FALLBACK
+    {
+      dropTree();
+    }
+    catch (const Standard_OutOfMemory&) // OOM-FALLBACK
+    {
+      dropTree();
+    }
+  }
+
+  //! The wires j >= theWireIndex that perform(theWireIndex) must query. Returns true with them in
+  //! theWires, ascending; false when every wire j >= theWireIndex is to be queried - the stock
+  //! loop, theWires left empty.
+  bool Get(const int                              theWireIndex,
+           const Handle(IMeshData::BndBox2dTree)& theTree,
+           std::vector<int>&                      theWires) const
+  {
+    theWires.clear();
+    if (theTree->IsEmpty())
+    {
+      return true; // no segment to query with
+    }
+    if (myTree.IsNull() || myIsWild[(size_t)theWireIndex])
+    {
+      return false; // as before: every wire
+    }
+    try
+    {
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+      if (myOomList)
+      {
+        theWires.reserve(std::size_t(1)
+                         << 60); // operator new cannot serve 4 EiB: a real std::bad_alloc
+      }
+#endif
+      WireBoxSelector aSelector(theTree->Root().Bnd(), theWireIndex, theWires);
+      myTree->Select(aSelector);
+      for (size_t k = 0; k < myWild.size(); ++k)
+      {
+        if (myWild[k] >= theWireIndex)
+        {
+          theWires.push_back(myWild[k]); // wild wires are queried by everyone
+        }
+      }
+    }
+    catch (const std::bad_alloc&) // OOM-FALLBACK
+    {
+      // the list only saves queries whose answer is 0; the stock loop gives the same maps without
+      // it
+      std::vector<int>().swap(theWires);
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+      ++myFallbacks;
+#endif
+      return false;
+    }
+    std::sort(theWires.begin(), theWires.end());
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+    // negative control (verification build only): FC4B_BREAK=drop removes the last candidate of a
+    // list with more than one entry, FC4B_BREAK=swap reverses the list; Step 5a checks that the
+    // comparison below catches both
+    if (const char* aBreak = std::getenv("FC4B_BREAK"))
+    {
+      if (std::strcmp(aBreak, "drop") == 0 && theWires.size() > 1)
+        theWires.pop_back();
+      if (std::strcmp(aBreak, "swap") == 0)
+        std::reverse(theWires.begin(), theWires.end());
+    }
+#endif
+    return true;
+  }
+
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+  //! Verification build only: allocations that failed and fell back to the stock loop (the tree: 1,
+  //! per list: 1).
+  int Fallbacks() const { return myFallbacks; }
+#endif
+
+private:
+  WireCandidates(const WireCandidates&);
+  WireCandidates& operator=(const WireCandidates&);
+
+  void build(const BRepMesh_FaceChecker::ArrayOfSegments&   theWiresSegments,
+             const BRepMesh_FaceChecker::ArrayOfBndBoxTree& theWiresBndBoxTree)
+  {
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+    if (myOomWild)
+    {
+      myIsWild.reserve(std::size_t(1)
+                       << 60); // operator new cannot serve 1 EiB: a real std::bad_alloc
+    }
+#endif
+    myIsWild.assign((size_t)myNbWires, 0);
+    const occ::handle<NCollection_BaseAllocator>& anAlloc =
+      NCollection_BaseAllocator::CommonBaseAllocator();
+    Handle(IMeshData::BndBox2dTree) aTree = new IMeshData::BndBox2dTree(anAlloc);
+    IMeshData::BndBox2dTreeFiller   aFiller(*aTree, anAlloc);
+    try
+    {
+      for (int aWireIt = 0; aWireIt < myNbWires; ++aWireIt)
+      {
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+        if (myOomTree && aWireIt == myNbWires / 2)
+        {
+          Standard::Allocate(std::size_t(1)
+                             << 62); // the OCCT allocator's own failure: Standard_OutOfMemory
+        }
+#endif
+        const Handle(IMeshData::BndBox2dTree)& aWireTree = theWiresBndBoxTree.Value(aWireIt);
+        if (aWireTree->IsEmpty())
+        {
+          continue;
+        }
+        if (!isFinite(*theWiresSegments.Value(aWireIt)))
+        {
+          myIsWild[(size_t)aWireIt] = 1;
+          myWild.push_back(aWireIt);
+          continue;
+        }
+        aFiller.Add(aWireIt, aWireTree->Root().Bnd());
+      }
+      aFiller.Fill();
+    }
+    catch (...)
+    {
+      aFiller
+        .Reset(); // else its destructor would Fill() - allocate again - while the exception unwinds
+      throw;
+    }
+    myTree = aTree;
+  }
+
+  //! Out of memory while building: no tree, no flags - Get() gives every wire j >= i (the stock
+  //! loop).
+  void dropTree()
+  {
+    myTree.Nullify();
+    std::vector<char>().swap(myIsWild);
+    std::vector<int>().swap(myWild);
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+    ++myFallbacks;
+#endif
+  }
+
+  static bool isFinite(const BRepMesh_FaceChecker::Segments& theSegments)
+  {
+    for (int k = 0; k < theSegments.Size(); ++k)
+    {
+      const BRepMesh_FaceChecker::Segment& aSeg = theSegments.Value(k);
+      if (!std::isfinite(aSeg.Point1->X()) || !std::isfinite(aSeg.Point1->Y())
+          || !std::isfinite(aSeg.Point2->X()) || !std::isfinite(aSeg.Point2->Y()))
+      {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  int                             myNbWires;
+  std::vector<char>               myIsWild;
+  std::vector<int>                myWild;
+  Handle(IMeshData::BndBox2dTree) myTree;
+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+  mutable std::atomic<int> myFallbacks;
+  bool                     myOomWild;
+  bool                     myOomTree;
+  bool                     myOomList;
+#endif
+};
