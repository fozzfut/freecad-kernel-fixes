+#ifdef BREPMESH_FACECHECKER_VERIFY_4B
+//! Verification build only: the same keys in the same iteration order (the order of insertion
+//! decides it).
+static bool sameMap(const Handle(IMeshData::MapOfIEdgePtr)& theA,
+                    const Handle(IMeshData::MapOfIEdgePtr)& theB)
+{
+  if (theA.IsNull() || theB.IsNull())
+  {
+    return theA.IsNull() == theB.IsNull();
+  }
+  if (theA->Extent() != theB->Extent())
+  {
+    return false;
+  }
+  IMeshData::MapOfIEdgePtr::Iterator anItA(*theA), anItB(*theB);
+  for (; anItA.More() && anItB.More(); anItA.Next(), anItB.Next())
+  {
+    if (anItA.Key() != anItB.Key())
+    {
+      return false;
+    }
+  }
+  return !anItA.More() && !anItB.More();
+}
+#endif
