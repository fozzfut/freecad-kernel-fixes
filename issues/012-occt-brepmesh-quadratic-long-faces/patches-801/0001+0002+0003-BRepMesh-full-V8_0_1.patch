+//! Defect 012, Task 4b: collects the wires whose root box is not IsOut() of a given box.
+class WireBoxSelector : public IMeshData::BndBox2dTree::Selector
+{
+public:
+  WireBoxSelector(const Bnd_Box2d& theBox, const int theFirst, std::vector<int>& theOut)
+      : myBox(theBox),
+        myFirst(theFirst),
+        myOut(theOut)
+  {
+  }
