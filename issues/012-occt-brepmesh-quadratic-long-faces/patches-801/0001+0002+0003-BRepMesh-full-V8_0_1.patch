+    const Handle(IMeshData::BndBox2dTree)&        aBndBoxTree2 = theWiresBndBoxTree.Value(aWireIt);
+    const Handle(BRepMesh_FaceChecker::Segments)& aSegments2   = theWiresSegments.Value(aWireIt);
