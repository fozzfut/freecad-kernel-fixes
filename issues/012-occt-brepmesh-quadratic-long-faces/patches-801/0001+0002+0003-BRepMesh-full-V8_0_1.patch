+  const IMeshData::IFaceHandle&                  myDFace;
+  const BRepMesh_FaceChecker::ArrayOfSegments&   myWiresSegments;
+  const BRepMesh_FaceChecker::ArrayOfBndBoxTree& myWiresBndBoxTree;
