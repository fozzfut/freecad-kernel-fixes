+//=======================================================================
+// function : fastSelect
+// purpose  : defect 012
+//=======================================================================
+IMeshData::ListOfInteger& BRepMesh_CircleTool::fastSelect(const gp_XY& thePoint)
+{
+  // the circles the stock cell of thePoint holds, found through the cells of thePoint in the finer
+  // grid (dead circles leave the lists here, as CellFilter_Purge does in the stock lists), in
+  // descending index order = the stock list order, then the stock test. mayShoot only skips circles
+  // the stock test rejects.
+  FastGrid*                        aFast    = fastGridOf(this);
+  const IMeshData::VectorOfCircle& aCircles = mySelector.Circles();
+  const int                        aSX      = stockCell(thePoint.X(), aFast->SX);
+  const int                        aSY      = stockCell(thePoint.Y(), aFast->SY);
+  std::vector<int>&                aCand    = aFast->Candidates;
+  aCand.clear();
+
+  if (!aFast->InDomain(thePoint))
+  {
+    // a point beyond the x range of the grid: the candidates are the disks that reach beyond it on
+    // that side; a NaN x passes no test (the stock result is empty)
+    if (thePoint.X() < aFast->FaceMin.X() - aFast->DomainSlack
+        || thePoint.X() > aFast->FaceMax.X() + aFast->DomainSlack)
+    {
+      std::vector<int>& anOut =
+        thePoint.X() < aFast->FaceMin.X() - aFast->DomainSlack ? aFast->OutLo : aFast->OutHi;
+      size_t aKeepOut = 0;
+      for (size_t i = 0; i < anOut.size(); ++i)
+      {
+        const int              anIdx   = anOut[i];
+        const BRepMesh_Circle& aCircle = aCircles.Value(anIdx);
+        if (aCircle.Radius() < 0.)
+        {
+          continue;
+        }
+        anOut[aKeepOut++] = anIdx;
+        if (mayShoot(aCircle, thePoint) && aFast->InStockCell(aCircle, aSX, aSY))
+        {
+          aCand.push_back(anIdx);
+        }
+      }
+      anOut.resize(aKeepOut);
+      std::sort(aCand.begin(), aCand.end(), std::greater<int>());
+      for (size_t i = 0; i < aCand.size(); ++i)
+      {
+        mySelector.Inspect(aCand[i]);
+      }
+    }
+    return mySelector.GetShotCircles();
+  }
+  for (int aLevel = 0; aLevel < aFast->NbLevels; ++aLevel)
+  {
+    int* aLink = &aFast->Levels[aLevel].Head(thePoint);
+    while (*aLink >= 0)
+    {
+      const int              aNodeIdx = *aLink;
+      FastNode&              aNode    = aFast->Nodes[aNodeIdx];
+      const BRepMesh_Circle& aCircle  = aCircles.Value(aNode.Circle);
+      if (aCircle.Radius() < 0.)
+      {
+        *aLink          = aNode.Next;
+        aNode.Next      = aFast->FreeNode;
+        aFast->FreeNode = aNodeIdx;
+        continue;
+      }
+      if (mayShoot(aCircle, thePoint) && aFast->InStockCell(aCircle, aSX, aSY))
+      {
+        aCand.push_back(aNode.Circle);
+      }
+      aLink = &aNode.Next;
+    }
+  }
+
+  std::vector<int>& aBig  = aFast->Big;
+  size_t            aKeep = 0;
+  for (size_t i = 0; i < aBig.size(); ++i)
+  {
+    const int              anIdx   = aBig[i];
+    const BRepMesh_Circle& aCircle = aCircles.Value(anIdx);
+    if (aCircle.Radius() < 0.)
+    {
+      continue;
+    }
+    aBig[aKeep++] = anIdx;
+    if (mayShoot(aCircle, thePoint) && aFast->InStockCell(aCircle, aSX, aSY))
+    {
+      aCand.push_back(anIdx);
+    }
+  }
+  aBig.resize(aKeep);
+
+  std::sort(aCand.begin(), aCand.end(), std::greater<int>());
+  for (size_t i = 0; i < aCand.size(); ++i)
+  {
+    mySelector.Inspect(aCand[i]);
+  }
   return mySelector.GetShotCircles();
 }
 
+//=======================================================================
+// function : fastSelectUpdate
+// purpose  : defect 012
+//=======================================================================
+bool BRepMesh_CircleTool::fastSelectUpdate(const int theNbTriangles, const int theNbToInsert)
+{
+  if (FastGrid* aFast = fastGridOf(this))
+  {
+    // Rebuild the grid (i) larger when it holds more than 4 triangles per cell, (ii) at the same
+    // size when the node array is mostly garbage: a node is freed only when a Select meets its dead
+    // circle, and the cells the insertion front has left behind are seldom visited again.
+    const double aNbCells = aFast->NbCells0();
+    const bool   toGrow =
+      (double)theNbTriangles > 4. * aNbCells && aNbCells < (double)THE_FAST_MAX_CELLS;
+    const bool toClean =
+      (double)aFast->Nodes.size() > THE_FAST_MAX_NODES_PER_TRIANGLE
+                                      * Max((double)theNbTriangles, (double)THE_FAST_MIN_TRIANGLES);
+    if (toGrow || toClean)
+    {
+      try
+      {
+        std::vector<int> aLive;
+        aFast->LiveCircles(mySelector.Circles(), aLive);
+        aFast->Layout(toGrow ? theNbTriangles / 2. : aNbCells);
+        const IMeshData::VectorOfCircle& aCircles = mySelector.Circles();
+        for (size_t i = 0; i < aLive.size(); ++i)
+        {
+          const BRepMesh_Circle& aCircle = aCircles.Value(aLive[i]);
+          aFast->Register(aLive[i], aCircle.Location(), aCircle.Radius());
+        }
+      }
+      catch (const std::bad_alloc&)
+      {
+        fastSelectEnd(); // Bound is intact: the stock lists are completed
+        return false;
+      }
+    }
+    return true;
+  }
+
+  try
+  {
+    return fastSelectStart(theNbTriangles, theNbToInsert);
+  }
+  catch (const std::bad_alloc&)
+  {
+    return false; // nothing installed; the stock lists lost only dead entries
+  }
+}
+
+//=======================================================================
+// function : fastSelectStart
+// purpose  : defect 012
+//=======================================================================
+bool BRepMesh_CircleTool::fastSelectStart(const int theNbTriangles, const int theNbToInsert)
+{
+  if (THE_FAST_GRID != NULL) // another tool of this thread is in the fast mode
+  {
+    return false;
+  }
+  const NCollection_Array1<double>& aCellSize = CircleCellFilterAccess::CellSize(myCellFilter);
+  if (aCellSize.Size() != 2)
+  {
+    return false;
+  }
+  const double aSX = aCellSize(aCellSize.Lower());
+  const double aSY = aCellSize(aCellSize.Lower() + 1);
+  if (!(aSX > 0.) || !(aSY > 0.))
+  {
+    return false;
+  }
+
+  // Worth it? The pass ends with about theNbTriangles + 2 theNbToInsert triangles. The stock grid
+  // has aStockCells cells over the face box; a stock Select walks about triangles / aStockCells
+  // circles, and starting costs about one pass over the triangles: start for a face that ends with
+  // many triangles per stock cell and a pass that still inserts several nodes per stock cell.
+  const double anExpected = (double)theNbTriangles + 2. * (double)theNbToInsert;
+  const double aStockCells =
+    ((double)stockCell(myFaceMax.X(), aSX) - (double)stockCell(myFaceMin.X(), aSX) + 1.)
+    * ((double)stockCell(myFaceMax.Y(), aSY) - (double)stockCell(myFaceMin.Y(), aSY) + 1.);
+  if (anExpected < (double)THE_FAST_MIN_TRIANGLES || !(aStockCells >= 1.)
+      || anExpected <= 4. * aStockCells
+      || (double)theNbToInsert < THE_FAST_MIN_NODES_PER_CELL * aStockCells)
+  {
+    return false;
+  }
+
+  std::unique_ptr<FastGrid> aFast(new FastGrid());
+  aFast->Owner   = this;
+  aFast->SX      = aSX;
+  aFast->SY      = aSY;
+  aFast->FaceMin = myFaceMin;
+  aFast->FaceMax = myFaceMax;
+
+  // Read the stock lists: every live entry must be where the stock expressions put it, each cell's
+  // live entries must be in strictly descending index order, and each live circle must sit in
+  // exactly as many cells as its stock range has. Otherwise the stock path stays.
+  const IMeshData::VectorOfCircle& aCircles   = mySelector.Circles();
+  const int                        aNbCircles = aCircles.Length();
+  std::vector<int>                 aCount((size_t)Max(aNbCircles, 0), 0);
+  int                              aPrev        = INT_MAX;
+  const FastGrid&                  aGrid        = *aFast;
+  const bool                       isConsistent = CircleCellFilterAccess::ForEachEntry(
+    myCellFilter,
+    [&](const int theCellX, const int theCellY, const bool isFirst, const int theIndex) -> int {
+      if (isFirst)
+      {
+        aPrev = INT_MAX;
+      }
+      if (theIndex < 0 || theIndex >= aNbCircles)
+      {
+        return -1;
+      }
+      const BRepMesh_Circle& aCircle = aCircles.Value(theIndex);
+      if (aCircle.Radius() < 0.)
+      {
+        // dead: never passes the test, and a BRepMesh_Delaun never binds its index again (fresh
+        // triangle indices; InitCirclesTool resets the filter first) - purged as the stock Inspect
+        // would purge it
+        return 1;
+      }
+      if (theIndex >= aPrev || !aGrid.InStockCell(aCircle, theCellX, theCellY))
+      {
+        return -1;
+      }
+      aPrev = theIndex;
+      ++aCount[(size_t)theIndex];
+      return 0;
+    });
+  if (!isConsistent)
+  {
+    return false;
+  }
+
+  for (int anIdx = 0; anIdx < aNbCircles; ++anIdx)
+  {
+    if (aCount[(size_t)anIdx] == 0)
+    {
+      continue;
+    }
+    const BRepMesh_Circle& aCircle = aCircles.Value(anIdx);
+    gp_XY                  aMin, aMax;
+    stockBox(aCircle.Location(), aCircle.Radius(), myFaceMin, myFaceMax, aMin, aMax);
+    const long long aNbX =
+      (long long)stockCell(aMax.X(), aFast->SX) - stockCell(aMin.X(), aFast->SX) + 1;
+    const long long aNbY =
+      (long long)stockCell(aMax.Y(), aFast->SY) - stockCell(aMin.Y(), aFast->SY) + 1;
+    if (aNbX <= 0 || aNbY <= 0 || aNbX * aNbY != (long long)aCount[(size_t)anIdx])
+    {
+      return false;
+    }
+  }
+
+  aFast->Layout(Max((double)theNbTriangles, (double)THE_FAST_MIN_TRIANGLES) / 2.);
+  for (int anIdx = 0; anIdx < aNbCircles; ++anIdx)
+  {
+    if (aCount[(size_t)anIdx] != 0)
+    {
+      const BRepMesh_Circle& aCircle = aCircles.Value(anIdx);
+      aFast->Register(anIdx, aCircle.Location(), aCircle.Radius());
+    }
+  }
+  THE_FAST_GRID = aFast.release();
+  return true;
+}
+
+//=======================================================================
+// function : fastSelectEnd
+// purpose  : defect 012
+//=======================================================================
+void BRepMesh_CircleTool::fastSelectEnd()
+{
+  FastGrid* aGrid = fastGridOf(this);
+  if (aGrid == NULL)
+  {
+    return;
+  }
+  THE_FAST_GRID = NULL;
+  std::unique_ptr<FastGrid> aFast(aGrid);
+
+  // The circles bound meanwhile are newer than every circle of the cell filter: added in ascending
+  // order, each cell's list is again newest first, as if Bind had added them one by one.
+  const IMeshData::VectorOfCircle& aCircles = mySelector.Circles();
+  for (size_t i = 0; i < aFast->Bound.size(); ++i)
+  {
+    const int              anIdx   = aFast->Bound[i];
+    const BRepMesh_Circle& aCircle = aCircles.Value(anIdx);
+    if (aCircle.Radius() < 0.)
+    {
+      continue;
+    }
+    gp_XY aMin, aMax;
+    stockBox(aCircle.Location(), aCircle.Radius(), aFast->FaceMin, aFast->FaceMax, aMin, aMax);
+    myCellFilter.Add(anIdx, aMin, aMax);
+  }
+}
