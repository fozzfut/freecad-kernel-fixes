+//! @brief Dense surrogate-key index used in place of a hash map (perf/801-bgraph T3).
+//!
+//! Keys are (kind, number) pairs whose numbers are allocated densely per kind: UID counters
+//! (monotonic per kind) or node indexes. Each kind keeps a column of slots addressed by
+//! (number - base) plus an occupancy flag, so a lookup is two array reads instead of a hash
+//! probe and a slot costs sizeof(Value) + 1 byte instead of a hash-map slot at load <= 13/16.
+//! Keys that do not fit a column (unknown kind, or a number far outside the dense window of its
+//! column) go to a small fallback hash map, so the index answers exactly like the hash map it
+//! replaces for every key: Bind overwrites, UnBind removes, Seek finds.
+//! Iteration order is column order (kind, number), then the fallback map.
+template <typename TheKey, typename TheValue, int TheNbKinds, typename TheKeyTraits>
+class BRepGraphInc_DenseIndex
+{
+public:
+  explicit BRepGraphInc_DenseIndex(const size_t = 0) {}
+
+  //! Bind key to value; returns true if the key was newly added (as NCollection_FlatDataMap).
+  bool Bind(const TheKey& theKey, const TheValue& theValue)
+  {
+    int      aKind   = 0;
+    uint32_t aNumber = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber) && ensureSlot(aKind, aNumber))
+    {
+      Column&      aCol  = myColumns[aKind];
+      const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+      if (!myFallback.IsEmpty() && myFallback.UnBind(theKey))
+      {
+        // the key moved into the dense window: it was bound, keep "existing key updated"
+        aCol.Values.ChangeValue(aSlot) = theValue;
+        if (aCol.Bound.Value(aSlot) == 0)
+        {
+          aCol.Bound.ChangeValue(aSlot) = 1;
+          ++aCol.NbBound;
+        }
+        return false;
+      }
+      aCol.Values.ChangeValue(aSlot) = theValue;
+      if (aCol.Bound.Value(aSlot) != 0)
+      {
+        return false;
+      }
+      aCol.Bound.ChangeValue(aSlot) = 1;
+      ++aCol.NbBound;
+      return true;
+    }
+    return myFallback.Bind(theKey, theValue);
+  }
+
+  //! Remove key; returns true if it was bound.
+  bool UnBind(const TheKey& theKey)
+  {
+    bool     isRemoved = false;
+    int      aKind     = 0;
+    uint32_t aNumber   = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber))
+    {
+      Column& aCol = myColumns[aKind];
+      if (aNumber >= aCol.Base && static_cast<size_t>(aNumber - aCol.Base) < aCol.Bound.Size())
+      {
+        const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          aCol.Bound.ChangeValue(aSlot)  = 0;
+          aCol.Values.ChangeValue(aSlot) = TheValue();
+          --aCol.NbBound;
+          isRemoved = true;
+        }
+      }
+    }
+    if (!myFallback.IsEmpty() && myFallback.UnBind(theKey))
+    {
+      isRemoved = true;
+    }
+    return isRemoved;
+  }
+
+  const TheValue* Seek(const TheKey& theKey) const
+  {
+    int      aKind   = 0;
+    uint32_t aNumber = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber))
