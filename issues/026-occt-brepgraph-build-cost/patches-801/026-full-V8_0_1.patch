+#ifdef BRepGraph_ALIAS_VERIFY
+  NCollection_FlatDataMap<TopoDS_Shape, BRepGraph_NodeId, TopTools_ShapeMapHasher> anExpected(1);
+  theGraph.myData->myIncStorage.ForEachShapeBinding(
+    [&](const TopoDS_Shape& aShape, const BRepGraph_NodeId aNodeId) {
+      anExpected.Bind(aShape, aNodeId);
+    });
+  stockAliasWalkOnCopy(theGraph,
+                       anExpected,
+                       theSourceShape,
+                       thePopulatedShape,
+                       theSourceShape.Location(),
