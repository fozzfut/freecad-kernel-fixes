+#ifdef BRepGraphInc_DENSEINDEX_MUTANT
+      ++aNumber; // negative control: off-by-one column address
+#endif
+      const Column& aCol = myColumns[aKind];
+      if (aNumber >= aCol.Base && static_cast<size_t>(aNumber - aCol.Base) < aCol.Bound.Size())
+      {
+        const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          return &aCol.Values.Value(aSlot);
+        }
+      }
+    }
+    return myFallback.IsEmpty() ? nullptr : myFallback.Seek(theKey);
+  }
+
+  TheValue* ChangeSeek(const TheKey& theKey)
+  {
+    return const_cast<TheValue*>(static_cast<const BRepGraphInc_DenseIndex&>(*this).Seek(theKey));
+  }
+
+  bool IsBound(const TheKey& theKey) const { return Seek(theKey) != nullptr; }
+
+  void Clear(const bool = false)
+  {
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
