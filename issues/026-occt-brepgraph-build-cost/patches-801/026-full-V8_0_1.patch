+                                                               theSourceShape,
+                                                               thePopulatedShape,
+                                                               theSourceShape.Location(),
+                                                               thePopulatedShape.Location());
+  (void)isDedupToEnd;
+#ifdef BRepGraph_ALIAS_VERIFY
+  size_t aNbActual = 0;
+  bool   isSame    = true;
+  theGraph.myData->myIncStorage.ForEachShapeBinding(
+    [&](const TopoDS_Shape& aShape, const BRepGraph_NodeId aNodeId) {
+      ++aNbActual;
+      const BRepGraph_NodeId* anExp = anExpected.Seek(aShape);
+      isSame = isSame && anExp != nullptr && *anExp == aNodeId;
+    });
+  isSame = isSame && aNbActual == anExpected.Size();
+  if (!isSame)
+  {
+    std::fprintf(stderr,
+                 "BGP-T2-VERIFY-MISMATCH bindings expected=%u actual=%u\n",
+                 static_cast<unsigned>(anExpected.Size()),
+                 static_cast<unsigned>(aNbActual));
+    std::fflush(stderr);
+    std::abort();
+  }
+  std::fprintf(stderr,
+               "BGP-T2-VERIFY ok bindings=%u dedup_to_end=%d\n",
+               static_cast<unsigned>(aNbActual),
+               isDedupToEnd ? 1 : 0);
+#endif
 }
 
