+//=================================================================================================
+// perf/801-bgraph T2: deduplicated alias binding.
+//
+// The stock walk (bindSourceShapeAliasesRecursive) visits every USE of every sub-shape: a vertex
+// once per edge use, an edge once per face, and so on. Each visit is fully determined by the tuple
+// (source TShape, source own location, accumulated source location, populated TShape, definition
+// location): the lookup key, the written keys and values, and the children visited next.
+//
+// This walk runs in the stock order and performs the same lookups and writes, but skips a visit
+// whose tuple was already visited, together with its subtree. A skipped repeat would redo the
+// lookups and writes of its first visit; it is a no-op as long as every key still holds the value
+// written then and every lookup would still return what it returned then. Both can only break when
+// the map changes under a key in a way other than the first write of a new key:
+//   - a write re-binds an existing key to ANOTHER node (BindingChange::Changed), or
+//   - a write inserts a key that an earlier lookup missed.
+// On the first such event the walk stops skipping and continues as the stock walk (it visits every
+// use from then on). Up to that point every skipped repeat was a no-op, so the map state equals
+// the stock state at the same point of the stock order; after it, the walk IS the stock walk.
+// New keys are inserted in the same order as in the stock walk, so even the slot layout of the
+// flat map is the same.
+//=================================================================================================
+
+namespace
+{
+struct AliasVisitKey
+{
+  const TopoDS_TShape* SourceTShape    = nullptr;
+  const TopoDS_TShape* PopulatedTShape = nullptr;
+  TopLoc_Location      SourceOwnLocation;
+  TopLoc_Location      SourceLocation;
+  TopLoc_Location      DefinitionLocation;
+};
+
+struct AliasVisitKeyHasher
+{
+  size_t operator()(const AliasVisitKey& theKey) const noexcept
+  {
+    // equal keys have equal hashes; the definition location follows from the others in the
+    // common case, so it is compared but not hashed
+    size_t aHash = std::hash<const void*>()(theKey.SourceTShape);
+    aHash ^= theKey.SourceLocation.HashCode() + 0x9e3779b97f4a7c15ULL + (aHash << 6) + (aHash >> 2);
+    return aHash;
+  }
+
+  bool operator()(const AliasVisitKey& theKey1, const AliasVisitKey& theKey2) const noexcept
+  {
+    return theKey1.SourceTShape == theKey2.SourceTShape
+           && theKey1.PopulatedTShape == theKey2.PopulatedTShape
+           && theKey1.SourceOwnLocation.IsEqual(theKey2.SourceOwnLocation)
+           && theKey1.SourceLocation.IsEqual(theKey2.SourceLocation)
+           && theKey1.DefinitionLocation.IsEqual(theKey2.DefinitionLocation);
+  }
+};
+
+class AliasWalker
+{
+public:
+  AliasWalker(BRepGraph& theGraph, BRepGraphInc_Storage& theStorage)
+      : myGraph(theGraph),
+        myStorage(theStorage),
+        myVisited(256)
+  {
+  }
+
+  bool IsDeduplicating() const { return myIsDedup; }
+
+  // Mirrors bindSourceShapeAlias + bindSourceShapeAliasesRecursive.
+  void Visit(const TopoDS_Shape&    theSourceShape,
+             const TopoDS_Shape&    thePopulatedShape,
+             const TopLoc_Location& theSourceLocation,
+             const TopLoc_Location& theDefinitionLocation)
+  {
+    if (myIsDedup)
+    {
+      AliasVisitKey aKey;
+      aKey.SourceTShape       = theSourceShape.TShape().get();
+      aKey.PopulatedTShape    = thePopulatedShape.TShape().get();
+      aKey.SourceOwnLocation  = theSourceShape.Location();
+      aKey.SourceLocation     = theSourceLocation;
+      aKey.DefinitionLocation = theDefinitionLocation;
+      if (!myVisited.Add(std::move(aKey)))
+      {
+        return; // repeated tuple: its lookups and writes are no-ops (see above)
+      }
+    }
+
+    if (!theSourceShape.IsNull() && !thePopulatedShape.IsNull())
+    {
+      TopoDS_Shape aLookup = thePopulatedShape;
+      aLookup.Location(theDefinitionLocation);
+      const BRepGraph_NodeId aNodeId = myGraph.Shapes().FindNode(aLookup);
+      if (!aNodeId.IsValid())
+      {
+        if (myIsDedup)
+        {
+          myMissedLookups.Add(aLookup);
+        }
+      }
+      else
+      {
+        write(theSourceShape, aNodeId);
+        if (!theSourceShape.Location().IsEqual(theSourceLocation))
+        {
+          TopoDS_Shape aSourceAlias = theSourceShape;
+          aSourceAlias.Location(theSourceLocation);
+          write(aSourceAlias, aNodeId);
+        }
+      }
+    }
+
+    const bool      isCompoundParent = thePopulatedShape.ShapeType() == TopAbs_COMPOUND;
+    TopoDS_Iterator aSourceIt(theSourceShape, false, false);
+    TopoDS_Iterator aPopulatedIt(thePopulatedShape, false, false);
+    for (; aSourceIt.More() && aPopulatedIt.More(); aSourceIt.Next(), aPopulatedIt.Next())
+    {
+      const TopoDS_Shape& aSourceChild    = aSourceIt.Value();
+      const TopoDS_Shape& aPopulatedChild = aPopulatedIt.Value();
+      if (aSourceChild.IsNull() || aPopulatedChild.IsNull())
+      {
+        continue;
+      }
+
+      const TopLoc_Location aChildSourceLocation = theSourceLocation * aSourceChild.Location();
+      if (isCompoundParent)
+      {
+        const TopoDS_Shape aChildDefinition = shapeWithoutOwnLocation(aPopulatedChild);
+        Visit(aSourceChild, aChildDefinition, aChildSourceLocation, TopLoc_Location());
+      }
+      else
+      {
+        Visit(aSourceChild,
+              aPopulatedChild,
+              aChildSourceLocation,
+              theDefinitionLocation * aPopulatedChild.Location());
+      }
+    }
+  }
+
+private:
+  void write(const TopoDS_Shape& theKey, const BRepGraph_NodeId theNodeId)
+  {
+#ifdef BRepGraph_ALIAS_MUTANT
+    // negative control: the third new binding is lost
+    if (myIsDedup && ++myMutantCount == 3 && !myStorage.HasShapeBinding(theKey))
+    {
+      return;
+    }
+#endif
+    const BRepGraphInc_Storage::BindingChange aChange =
+      myStorage.SetDefinitionShapeBindingTracked(theKey, theNodeId);
+    if (!myIsDedup || aChange == BRepGraphInc_Storage::BindingChange::Same)
+    {
+      return;
+    }
+    if (aChange == BRepGraphInc_Storage::BindingChange::Changed
+        || (!myMissedLookups.IsEmpty() && myMissedLookups.Contains(theKey)))
+    {
+      myIsDedup = false; // from here on: the stock walk, every use visited
+    }
+  }
+
+  BRepGraph&                                               myGraph;
+  BRepGraphInc_Storage&                                    myStorage;
+  NCollection_FlatMap<AliasVisitKey, AliasVisitKeyHasher> myVisited;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>   myMissedLookups;
+  bool                                                     myIsDedup = true;
+#ifdef BRepGraph_ALIAS_MUTANT
+  int myMutantCount = 0;
+#endif
+};
+} // namespace
+
+//! Returns false when the walk had to fall back to the stock order (for the verify build).
+static bool bindSourceShapeAliasesDeduplicated(BRepGraph&             theGraph,
+                                               BRepGraphInc_Storage&  theStorage,
+                                               const TopoDS_Shape&    theSourceShape,
+                                               const TopoDS_Shape&    thePopulatedShape,
+                                               const TopLoc_Location& theSourceLocation,
+                                               const TopLoc_Location& theDefinitionLocation)
+{
+  AliasWalker aWalker(theGraph, theStorage);
+  aWalker.Visit(theSourceShape, thePopulatedShape, theSourceLocation, theDefinitionLocation);
+  return aWalker.IsDeduplicating();
+}
+
+#ifdef BRepGraph_ALIAS_VERIFY
+//! Verify build: the stock walk replayed on a copy of the bindings taken before the walk.
+static void stockAliasWalkOnCopy(
+  BRepGraph&                                                                         theGraph,
+  NCollection_FlatDataMap<TopoDS_Shape, BRepGraph_NodeId, TopTools_ShapeMapHasher>& theMap,
+  const TopoDS_Shape&                                                                theSourceShape,
+  const TopoDS_Shape&    thePopulatedShape,
+  const TopLoc_Location& theSourceLocation,
+  const TopLoc_Location& theDefinitionLocation)
+{
+  if (!theSourceShape.IsNull() && !thePopulatedShape.IsNull())
+  {
+    TopoDS_Shape aLookup = thePopulatedShape;
+    aLookup.Location(theDefinitionLocation);
+    BRepGraph_NodeId        aNodeId;
+    const BRepGraph_NodeId* aBound = theMap.Seek(aLookup);
+    if (aBound != nullptr && aBound->IsValid() && !theGraph.Topo().Gen().IsRemoved(*aBound)
+        && theGraph.Topo().Gen().TopoEntity(*aBound) != nullptr)
+    {
+      aNodeId = *aBound;
+    }
+    if (aNodeId.IsValid())
+    {
+      theMap.Bind(theSourceShape, aNodeId);
+      if (!theSourceShape.Location().IsEqual(theSourceLocation))
+      {
+        TopoDS_Shape aSourceAlias = theSourceShape;
+        aSourceAlias.Location(theSourceLocation);
+        theMap.Bind(aSourceAlias, aNodeId);
+      }
+    }
+  }
+  const bool      isCompoundParent = thePopulatedShape.ShapeType() == TopAbs_COMPOUND;
+  TopoDS_Iterator aSourceIt(theSourceShape, false, false);
+  TopoDS_Iterator aPopulatedIt(thePopulatedShape, false, false);
+  for (; aSourceIt.More() && aPopulatedIt.More(); aSourceIt.Next(), aPopulatedIt.Next())
+  {
+    const TopoDS_Shape& aSourceChild    = aSourceIt.Value();
+    const TopoDS_Shape& aPopulatedChild = aPopulatedIt.Value();
+    if (aSourceChild.IsNull() || aPopulatedChild.IsNull())
+    {
+      continue;
+    }
+    const TopLoc_Location aChildSourceLocation = theSourceLocation * aSourceChild.Location();
+    if (isCompoundParent)
+    {
+      stockAliasWalkOnCopy(theGraph,
+                           theMap,
+                           aSourceChild,
+                           shapeWithoutOwnLocation(aPopulatedChild),
+                           aChildSourceLocation,
+                           TopLoc_Location());
+    }
+    else
+    {
+      stockAliasWalkOnCopy(theGraph,
+                           theMap,
+                           aSourceChild,
+                           aPopulatedChild,
+                           aChildSourceLocation,
+                           theDefinitionLocation * aPopulatedChild.Location());
+    }
+  }
+}
+#endif
+
 void BRepGraph::ShapesView::bindSourceShapeAliases(BRepGraph&          theGraph,
                                                    const TopoDS_Shape& theSourceShape,
                                                    const TopoDS_Shape& thePopulatedShape)
