+  //! Kept for interface compatibility with the hash map; columns grow on demand.
+  void Reserve(const size_t) {}
+
+  size_t Size() const
+  {
+    size_t aSize = myFallback.Size();
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
+    {
+      aSize += myColumns[aKind].NbBound;
+    }
+    return aSize;
+  }
+
+  //! Visit all bindings: columns in (kind, number) order, then the fallback map.
+  template <typename FuncT>
+  void ForEach(FuncT&& theFunc) const
+  {
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
+    {
+      const Column& aCol = myColumns[aKind];
+      for (size_t aSlot = 0; aSlot < aCol.Bound.Size(); ++aSlot)
+      {
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          theFunc(TheKeyTraits::Make(aKind, aCol.Base + static_cast<uint32_t>(aSlot)),
+                  aCol.Values.Value(aSlot));
+        }
+      }
+    }
+    for (typename NCollection_FlatDataMap<TheKey, TheValue>::Iterator anIt(myFallback); anIt.More();
+         anIt.Next())
+    {
+      theFunc(anIt.Key(), anIt.Value());
+    }
+  }
+
+private:
+  struct Column
+  {
+    uint32_t                          Base    = 0;
+    size_t                            NbBound = 0;
+    NCollection_LinearVector<TheValue> Values;
+    NCollection_LinearVector<uint8_t>  Bound;
+  };
+
+  //! Makes (theKind, theNumber) addressable in its column; false = use the fallback map.
+  bool ensureSlot(const int theKind, const uint32_t theNumber)
+  {
+    Column& aCol = myColumns[theKind];
+    if (aCol.Bound.IsEmpty())
+    {
+      aCol.Base = theNumber;
+      aCol.Values.Append(TheValue());
+      aCol.Bound.Append(0);
+      return true;
+    }
+    // Window limit: keeps a pathological sparse key set from allocating a huge column.
+    const size_t aLimit = 2 * (aCol.NbBound + 1) + 4096;
+    if (theNumber >= aCol.Base)
+    {
+      const size_t aSlot = static_cast<size_t>(theNumber - aCol.Base);
+      if (aSlot < aCol.Bound.Size())
+      {
+        return true;
+      }
+      if (aSlot + 1 > aLimit + aCol.Bound.Size())
+      {
+        return false;
+      }
+      if (aSlot + 1 > aCol.Values.Capacity())
+      {
+        const size_t aNewCap = std::max(aSlot + 1, 2 * aCol.Values.Capacity());
+        aCol.Values.Reserve(aNewCap);
+        aCol.Bound.Reserve(aNewCap);
+      }
+      while (aCol.Bound.Size() <= aSlot)
+      {
+        aCol.Values.Append(TheValue());
+        aCol.Bound.Append(0);
+      }
+      return true;
+    }
+    // below the base: shift the column up
+    const size_t aShift = static_cast<size_t>(aCol.Base - theNumber);
+    if (aShift > aLimit)
+    {
+      return false;
+    }
+    NCollection_LinearVector<TheValue> aValues(aCol.Values.Size() + aShift);
+    NCollection_LinearVector<uint8_t>  aBound(aCol.Values.Size() + aShift);
+    for (size_t anIdx = 0; anIdx < aShift; ++anIdx)
+    {
+      aValues.Append(TheValue());
+      aBound.Append(0);
+    }
+    for (size_t anIdx = 0; anIdx < aCol.Values.Size(); ++anIdx)
+    {
+      aValues.Append(aCol.Values.Value(anIdx));
+      aBound.Append(aCol.Bound.Value(anIdx));
+    }
+    aCol.Values = std::move(aValues);
+    aCol.Bound  = std::move(aBound);
+    aCol.Base   = theNumber;
+    return true;
+  }
+
+  Column                                   myColumns[TheNbKinds];
+  NCollection_FlatDataMap<TheKey, TheValue> myFallback;
+};
