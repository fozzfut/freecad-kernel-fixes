+#include <algorithm>
 #include <atomic>
 #include <shared_mutex>
 #include <utility>
 
+//! @brief Dense surrogate-key index used in place of a hash map (perf/801-bgraph T3).
+//!
+//! Keys are (kind, number) pairs whose numbers are allocated densely per kind: UID counters
+//! (monotonic per kind) or node indexes. Each kind keeps a column of slots addressed by
+//! (number - base) plus an occupancy flag, so a lookup is two array reads instead of a hash
+//! probe and a slot costs sizeof(Value) + 1 byte instead of a hash-map slot at load <= 13/16.
+//! Keys that do not fit a column (unknown kind, or a number far outside the dense window of its
+//! column) go to a small fallback hash map, so the index answers exactly like the hash map it
+//! replaces for every key: Bind overwrites, UnBind removes, Seek finds.
+//! Iteration order is column order (kind, number), then the fallback map.
+template <typename TheKey, typename TheValue, int TheNbKinds, typename TheKeyTraits>
+class BRepGraphInc_DenseIndex
+{
+public:
+  explicit BRepGraphInc_DenseIndex(const size_t = 0) {}
+
+  //! Bind key to value; returns true if the key was newly added (as NCollection_FlatDataMap).
+  bool Bind(const TheKey& theKey, const TheValue& theValue)
+  {
+    int      aKind   = 0;
+    uint32_t aNumber = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber) && ensureSlot(aKind, aNumber))
+    {
+      Column&      aCol  = myColumns[aKind];
+      const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+      if (!myFallback.IsEmpty() && myFallback.UnBind(theKey))
+      {
+        // the key moved into the dense window: it was bound, keep "existing key updated"
+        aCol.Values.ChangeValue(aSlot) = theValue;
+        if (aCol.Bound.Value(aSlot) == 0)
+        {
+          aCol.Bound.ChangeValue(aSlot) = 1;
+          ++aCol.NbBound;
+        }
+        return false;
+      }
+      aCol.Values.ChangeValue(aSlot) = theValue;
+      if (aCol.Bound.Value(aSlot) != 0)
+      {
+        return false;
+      }
+      aCol.Bound.ChangeValue(aSlot) = 1;
+      ++aCol.NbBound;
+      return true;
+    }
+    return myFallback.Bind(theKey, theValue);
+  }
+
+  //! Remove key; returns true if it was bound.
+  bool UnBind(const TheKey& theKey)
+  {
+    bool     isRemoved = false;
+    int      aKind     = 0;
+    uint32_t aNumber   = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber))
+    {
+      Column& aCol = myColumns[aKind];
+      if (aNumber >= aCol.Base && static_cast<size_t>(aNumber - aCol.Base) < aCol.Bound.Size())
+      {
+        const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          aCol.Bound.ChangeValue(aSlot)  = 0;
+          aCol.Values.ChangeValue(aSlot) = TheValue();
+          --aCol.NbBound;
+          isRemoved = true;
+        }
+      }
+    }
+    if (!myFallback.IsEmpty() && myFallback.UnBind(theKey))
+    {
+      isRemoved = true;
+    }
+    return isRemoved;
+  }
+
+  const TheValue* Seek(const TheKey& theKey) const
+  {
+    int      aKind   = 0;
+    uint32_t aNumber = 0;
+    if (TheKeyTraits::Split(theKey, aKind, aNumber))
+    {
+#ifdef BRepGraphInc_DENSEINDEX_MUTANT
+      ++aNumber; // negative control: off-by-one column address
+#endif
+      const Column& aCol = myColumns[aKind];
+      if (aNumber >= aCol.Base && static_cast<size_t>(aNumber - aCol.Base) < aCol.Bound.Size())
+      {
+        const size_t aSlot = static_cast<size_t>(aNumber - aCol.Base);
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          return &aCol.Values.Value(aSlot);
+        }
+      }
+    }
+    return myFallback.IsEmpty() ? nullptr : myFallback.Seek(theKey);
+  }
+
+  TheValue* ChangeSeek(const TheKey& theKey)
+  {
+    return const_cast<TheValue*>(static_cast<const BRepGraphInc_DenseIndex&>(*this).Seek(theKey));
+  }
+
+  bool IsBound(const TheKey& theKey) const { return Seek(theKey) != nullptr; }
+
+  void Clear(const bool = false)
+  {
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
+    {
+      myColumns[aKind] = Column();
+    }
+    myFallback.Clear();
+  }
+
+  //! Kept for interface compatibility with the hash map; columns grow on demand.
+  void Reserve(const size_t) {}
+
+  size_t Size() const
+  {
+    size_t aSize = myFallback.Size();
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
+    {
+      aSize += myColumns[aKind].NbBound;
+    }
+    return aSize;
+  }
+
+  //! Visit all bindings: columns in (kind, number) order, then the fallback map.
+  template <typename FuncT>
+  void ForEach(FuncT&& theFunc) const
+  {
+    for (int aKind = 0; aKind < TheNbKinds; ++aKind)
+    {
+      const Column& aCol = myColumns[aKind];
+      for (size_t aSlot = 0; aSlot < aCol.Bound.Size(); ++aSlot)
+      {
+        if (aCol.Bound.Value(aSlot) != 0)
+        {
+          theFunc(TheKeyTraits::Make(aKind, aCol.Base + static_cast<uint32_t>(aSlot)),
+                  aCol.Values.Value(aSlot));
+        }
+      }
+    }
+    for (typename NCollection_FlatDataMap<TheKey, TheValue>::Iterator anIt(myFallback); anIt.More();
+         anIt.Next())
+    {
+      theFunc(anIt.Key(), anIt.Value());
+    }
+  }
+
+private:
+  struct Column
+  {
+    uint32_t                          Base    = 0;
+    size_t                            NbBound = 0;
+    NCollection_LinearVector<TheValue> Values;
+    NCollection_LinearVector<uint8_t>  Bound;
+  };
+
+  //! Makes (theKind, theNumber) addressable in its column; false = use the fallback map.
+  bool ensureSlot(const int theKind, const uint32_t theNumber)
+  {
+    Column& aCol = myColumns[theKind];
+    if (aCol.Bound.IsEmpty())
+    {
+      aCol.Base = theNumber;
+      aCol.Values.Append(TheValue());
+      aCol.Bound.Append(0);
+      return true;
+    }
+    // Window limit: keeps a pathological sparse key set from allocating a huge column.
+    const size_t aLimit = 2 * (aCol.NbBound + 1) + 4096;
+    if (theNumber >= aCol.Base)
+    {
+      const size_t aSlot = static_cast<size_t>(theNumber - aCol.Base);
+      if (aSlot < aCol.Bound.Size())
+      {
+        return true;
+      }
+      if (aSlot + 1 > aLimit + aCol.Bound.Size())
+      {
+        return false;
+      }
+      if (aSlot + 1 > aCol.Values.Capacity())
+      {
+        const size_t aNewCap = std::max(aSlot + 1, 2 * aCol.Values.Capacity());
+        aCol.Values.Reserve(aNewCap);
+        aCol.Bound.Reserve(aNewCap);
+      }
+      while (aCol.Bound.Size() <= aSlot)
+      {
+        aCol.Values.Append(TheValue());
+        aCol.Bound.Append(0);
+      }
+      return true;
+    }
+    // below the base: shift the column up
+    const size_t aShift = static_cast<size_t>(aCol.Base - theNumber);
+    if (aShift > aLimit)
+    {
+      return false;
+    }
+    NCollection_LinearVector<TheValue> aValues(aCol.Values.Size() + aShift);
+    NCollection_LinearVector<uint8_t>  aBound(aCol.Values.Size() + aShift);
+    for (size_t anIdx = 0; anIdx < aShift; ++anIdx)
+    {
+      aValues.Append(TheValue());
+      aBound.Append(0);
+    }
+    for (size_t anIdx = 0; anIdx < aCol.Values.Size(); ++anIdx)
+    {
+      aValues.Append(aCol.Values.Value(anIdx));
+      aBound.Append(aCol.Bound.Value(anIdx));
+    }
+    aCol.Values = std::move(aValues);
+    aCol.Bound  = std::move(aBound);
+    aCol.Base   = theNumber;
+    return true;
+  }
+
+  Column                                   myColumns[TheNbKinds];
+  NCollection_FlatDataMap<TheKey, TheValue> myFallback;
+};
+
+//! Key traits of BRepGraphInc_DenseIndex for node UIDs (kind, counter).
+struct BRepGraphInc_NodeUIDKeyTraits
+{
+  static bool Split(const BRepGraph_UID& theKey, int& theKind, uint32_t& theNumber)
+  {
+    theKind   = static_cast<int>(theKey.Kind);
+    theNumber = theKey.Counter;
+    return theKind >= 0 && theKind < 12;
+  }
+
+  static BRepGraph_UID Make(const int theKind, const uint32_t theNumber)
+  {
+    return BRepGraph_UID(static_cast<BRepGraph_NodeId::Kind>(theKind), theNumber);
+  }
+};
+
+//! Key traits of BRepGraphInc_DenseIndex for reference UIDs (kind, counter).
+struct BRepGraphInc_RefUIDKeyTraits
+{
+  static bool Split(const BRepGraph_RefUID& theKey, int& theKind, uint32_t& theNumber)
+  {
+    theKind   = static_cast<int>(theKey.Kind);
+    theNumber = theKey.Counter;
+    return theKind >= 0 && theKind < 7;
+  }
+
+  static BRepGraph_RefUID Make(const int theKind, const uint32_t theNumber)
+  {
+    return BRepGraph_RefUID(static_cast<BRepGraph_RefId::Kind>(theKind), theNumber);
+  }
+};
+
+//! Key traits of BRepGraphInc_DenseIndex for node ids (kind, index).
+struct BRepGraphInc_NodeIdKeyTraits
+{
+  static bool Split(const BRepGraph_NodeId& theKey, int& theKind, uint32_t& theNumber)
+  {
+    theKind   = static_cast<int>(theKey.NodeKind);
+    theNumber = theKey.Index;
+    return theKind >= 0 && theKind < 12;
+  }
+
+  static BRepGraph_NodeId Make(const int theKind, const uint32_t theNumber)
+  {
+    return BRepGraph_NodeId(static_cast<BRepGraph_NodeId::Kind>(theKind), theNumber);
+  }
+};
+
