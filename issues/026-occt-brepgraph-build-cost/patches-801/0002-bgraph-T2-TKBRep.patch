+BRepGraphInc_Storage::BindingChange BRepGraphInc_Storage::SetDefinitionShapeBindingTracked(
+  const TopoDS_Shape&    theShape,
+  const BRepGraph_NodeId theNodeId)
+{
+  std::unique_lock<std::shared_mutex> aLock(myShapeBindingsMutex);
+  if (auto* aBound = myShapeToNodeId.ChangeSeek(theShape))
+  {
+    if (*aBound == theNodeId)
+    {
+      return BindingChange::Same;
+    }
+    *aBound = theNodeId;
+    return BindingChange::Changed;
+  }
+  myShapeToNodeId.Bind(theShape, theNodeId);
+  return BindingChange::Inserted;
+}
+
+//=================================================================================================
+
 bool BRepGraphInc_Storage::RemoveDefinitionShapeBinding(const TopoDS_Shape&    theShape,
                                                         const BRepGraph_NodeId theExpectedNodeId)
 {
diff --git a/src/ModelingData/TKBRep/BRepGraphInc/BRepGraphInc_Storage.hxx b/src/ModelingData/TKBRep/BRepGraphInc/BRepGraphInc_Storage.hxx
