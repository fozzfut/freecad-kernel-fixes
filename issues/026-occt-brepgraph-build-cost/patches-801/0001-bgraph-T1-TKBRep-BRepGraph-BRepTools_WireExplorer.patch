+//! Scratch buffers of chainWireOrder, reused per thread (P2 may run in parallel).
+struct ChainWireScratch
+{
+  std::vector<TopoDS_Shape> Vertices;
+  std::vector<uint32_t>     EdgeStartingAt;
+  std::vector<uint32_t>     StartVertex;
+  std::vector<uint32_t>     EndVertex;
+  std::vector<uint32_t>     ParityPos;
+  std::vector<uint32_t>     ParityKeys;
+  std::vector<char>         ParityForward;
