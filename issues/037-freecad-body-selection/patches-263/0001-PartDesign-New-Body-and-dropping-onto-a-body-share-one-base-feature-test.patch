@@ -122,4 +122,14 @@ std::vector<App::DocumentObject*> collectMovableDependencies(
 /// Relink sketches and datums to target body's origin
 void relinkToOrigin(App::DocumentObject* feature, PartDesign::Body* body);
 
+/**
+ * Returns true if the object can become the BaseFeature of a body: it owns Part geometry (a
+ * Part::Feature, or a GeoFeature whose geometry property is a Part shape), directly or as the final
+ * target of a link, a link array or a chain of them. Objects without Part geometry of their own
+ * (spreadsheets, variable sets, meshes, points, App::Part and group containers, link groups, origin
+ * and App datum elements, links to any of them) are not base feature candidates. Whether the shape
+ * is empty is not checked here.
+ */
+bool canBeBaseFeature(const App::DocumentObject* object);
+
 }  // namespace PartDesignGui
