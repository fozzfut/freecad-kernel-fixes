 src/Mod/PartDesign/Gui/ViewProviderBody.cpp |  4 ++-
 4 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/src/Mod/PartDesign/Gui/CommandBody.cpp b/src/Mod/PartDesign/Gui/CommandBody.cpp
index 2d2a48d..f200669 100644
--- a/src/Mod/PartDesign/Gui/CommandBody.cpp
+++ b/src/Mod/PartDesign/Gui/CommandBody.cpp
@@ -23,6 +23,8 @@
  ***************************************************************************/
 
 
+#include <algorithm>
+
 #include <QApplication>
 #include <QInputDialog>
 #include <QMessageBox>
@@ -123,6 +125,17 @@ void CmdPartDesignBody::activated(int iMsg)
     std::vector<App::DocumentObject*> features = getSelection().getObjectsOfType(
         App::DocumentObject::getClassTypeId()
     );
+    // Only objects that can be a base feature count (canBeBaseFeature(), shared with dropping onto a
+    // body); the rest of the selection (spreadsheets, variable sets, containers, origin elements,
+    // ...) is left out silently, as while only Part::Feature objects were looked at.
+    features.erase(
+        std::remove_if(
+            features.begin(),
+            features.end(),
+            [](const App::DocumentObject* obj) { return !PartDesignGui::canBeBaseFeature(obj); }
+        ),
+        features.end()
+    );
     App::DocumentObject* baseFeature = nullptr;
     bool addtogroup = false;
 
diff --git a/src/Mod/PartDesign/Gui/Utils.cpp b/src/Mod/PartDesign/Gui/Utils.cpp
index 34a4401..7a22cc4 100644
--- a/src/Mod/PartDesign/Gui/Utils.cpp
+++ b/src/Mod/PartDesign/Gui/Utils.cpp
@@ -23,11 +23,15 @@
  ***************************************************************************/
 
 
+#include <algorithm>
+
 #include <QMessageBox>
 #include <gp_Pln.hxx>
 #include <Precision.hxx>
 
 
+#include <App/GeoFeature.h>
+#include <App/Link.h>
 #include <App/Origin.h>
 #include <App/Datums.h>
 #include <App/Part.h>
@@ -35,6 +39,7 @@
 #include <Gui/CommandT.h>
 #include <Gui/MainWindow.h>
 #include <Gui/MDIView.h>
+#include <Mod/Part/App/PropertyTopoShape.h>
 #include <Mod/PartDesign/App/Body.h>
 #include <Mod/PartDesign/App/Feature.h>
 #include <Mod/PartDesign/App/FeatureSketchBased.h>
@@ -540,6 +545,36 @@ void relinkToBody(PartDesign::Feature* feature)
     }
 }
 
+bool canBeBaseFeature(const App::DocumentObject* object)
+{
+    auto ownsPartShape = [](const App::DocumentObject* obj) {
+        return obj->isDerivedFrom<Part::Feature>()
+            || freecad_cast<const Part::PropertyPartShape*>(
+                App::GeoFeature::getPropertyOfGeometry(obj)
+            );
+    };
+    // Follow links to the object that holds the geometry. DocumentObject::getLinkedObject() stops
+    // at a link array (LinkBaseExtension::extensionGetLinkedObject() returns the array itself while
+    // ElementCount > 0), so a link step goes through LinkBaseExtension::getTrueLinkedObject(), which
+    // also resolves the array to its target. A link group has no target and ends the walk.
+    std::vector<const App::DocumentObject*> visited;
+    while (object && std::ranges::find(visited, object) == visited.end()) {
+        if (ownsPartShape(object)) {
+            return true;
+        }
+        visited.push_back(object);
+        const App::DocumentObject* next = nullptr;
+        if (auto* link = object->getExtensionByType<App::LinkBaseExtension>(true)) {
+            next = link->getTrueLinkedObject(true);
+        }
+        else {
+            next = object->getLinkedObject(true);
+        }
+        object = next;
+    }
+    return false;
+}
