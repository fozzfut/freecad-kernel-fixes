+//=======================================================================
+// defect 020 (row 8 of the audit) on OCCT 8.0.1. FixFaceOrientation calls GetShells until a call
+// builds no shell; each stock call (#584) builds the face / edge maps and the connected groups of
+// ALL remaining faces, turns the largest group into shells and puts the other groups back into
+// Lface - on a shell of many separate bodies that is O(faces) per body, quadratic in all
+// (512 boxes in one shell: 2.4-2.9 s on the weekly). ShellGroupsState keeps the stock Lface between
+// the calls of one FixFaceOrientation as
+//   Front                 the faces the last call left: its leftovers, then the faces of one-face
+//                         shells it took apart (they lead the stock Lface),
+//   Groups not processed  the other connected groups, in the order of the stock group list.
+// A call groups only the Front (its groups cannot touch the others: each of those was a whole
+// connected group of an earlier Lface), and takes the first group of the stock list: the largest,
+// and among equal sizes the first in Lface - the stock list is a stable sort by size of the groups
+// in the order of their first face in Lface, i.e. of [groups of the Front, then the groups kept, in
+// the previous list order]. Key: size (descending), call that found it (descending), place in that
+// call's list. The only other thing a stock call does to a group it does not process is to rebuild
+// its face order: the connected-group search (a depth-first search from its first face, over edge
+// -> faces arrays filled in Lface order) runs on it again, and the result depends on the group's
+// own order only. So a group records the call of its order, and when it is needed that search is
+// repeated once per call it missed - on its own faces, with integer ids; the order sequence of a
+// group is deterministic, so once an order repeats the rest is read from the cycle. The group
+// taken is turned into shells by the stock code (buildShellsOfGroup) on the same sequence.
+// Allocation failure while preparing a call (std::bad_alloc, Standard_OutOfMemory): the stock Lface
+// is rebuilt from this state and the stock GetShells does that call and all later ones.
+//=======================================================================
+namespace
+{
+//! One connected group of faces of the stock Lface, not processed yet.
+struct ShellFaceGroup
+{
+  std::vector<TopoDS_Shape> Faces; //!< its faces (the Lface objects) in the order of call Stamp
+  int                       Stamp = 0;
+  int                       Call  = 0; //!< the call that found the group
+  int                       Rank  = 0; //!< its place in that call's group list
+};
+
+//! The stock Lface between the GetShells calls of one FixFaceOrientation (see above).
+struct ShellGroupsState
+{
+  NCollection_Sequence<TopoDS_Shape> Front;
+  std::vector<ShellFaceGroup>        Groups;
+  std::vector<int>                   Heap; //!< ids of the groups not processed (heap by key)
+  int                                CallNo       = 0;
+  int                                NbGroupFaces = 0;
+  bool                               Stock        = false;
+
+  int NbFaces() const { return Front.Length() + NbGroupFaces; }
+};
+
+//! True when group a comes before group b in the stock group list.
+static bool groupBefore(const ShellFaceGroup& a, const ShellFaceGroup& b)
+{
+  const size_t aSize = a.Faces.size(), bSize = b.Faces.size();
+  if (aSize != bSize)
+    return aSize > bSize;
+  if (a.Call != b.Call)
+    return a.Call > b.Call;
+  return a.Rank < b.Rank;
+}
+
+struct GroupHeapLess
+{
+  const std::vector<ShellFaceGroup>* myGroups;
+
+  bool operator()(const int a, const int b) const
+  {
+    return groupBefore((*myGroups)[b], (*myGroups)[a]);
+  }
+};
+
+//! One stock connected-group search on a group whose faces are in the order theIn (local face
+//! ids): edge -> faces arrays filled in that order (a face once per edge: it is appended only by
+//! itself, so the stock scan for it finds it last), then a depth-first search with a stack from
+//! theIn[0], neighbours in the edge order of the face (TopExp_Explorer, with repeats) and the face
+//! order of each edge array (GetConnectedFaceGroups).
+static void groupSearchOnce(const std::vector<std::vector<int>>& theFaceEdges,
+                            std::vector<std::vector<int>>&       theEdgeFaces,
+                            const std::vector<int>&              theIn,
+                            std::vector<char>&                   theVisited,
+                            std::vector<int>&                    theStack,
+                            std::vector<int>&                    theOut)
+{
+  for (std::vector<int>& anArr : theEdgeFaces)
+    anArr.clear();
+  for (const int aF : theIn)
+  {
+    for (const int anE : theFaceEdges[aF])
+    {
+      std::vector<int>& anArr = theEdgeFaces[anE];
+      if (anArr.empty() || anArr.back() != aF)
+        anArr.push_back(aF);
+    }
+  }
+  theVisited.assign(theIn.size(), 0);
+  theStack.clear();
+  theOut.clear();
+  theStack.push_back(theIn[0]);
+  theVisited[theIn[0]] = 1;
+  while (!theStack.empty())
+  {
+    const int aCur = theStack.back();
+    theStack.pop_back();
+    theOut.push_back(aCur);
+    for (const int anE : theFaceEdges[aCur])
+    {
+      for (const int aNb : theEdgeFaces[anE])
+      {
+        if (!theVisited[aNb])
+        {
+          theVisited[aNb] = 1;
+          theStack.push_back(aNb);
+        }
+      }
+    }
+  }
+}
+
+static uint64_t orderHash(const std::vector<int>& theOrder)
+{
+  uint64_t aH = 1469598103934665603ULL;
+  for (const int a : theOrder)
+    aH = (aH ^ static_cast<uint64_t>(static_cast<unsigned int>(a))) * 1099511628211ULL;
+  return aH;
+}
+
+//! Brings the face order of the group to what the stock Lface holds after call theCall: one
+//! connected-group search per call since Stamp. Changes the group only on success.
+static void materializeGroup(ShellFaceGroup& theGroup, const int theCall)
+{
+  const int aPending = theCall - theGroup.Stamp;
+  const int aNb      = static_cast<int>(theGroup.Faces.size());
+  if (aPending <= 0 || aNb <= 2) // an order of one or two faces is its own search result
+  {
+    theGroup.Stamp = std::max(theGroup.Stamp, theCall);
+    return;
+  }
+  NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher> anEdgeIds;
+  std::vector<std::vector<int>>                                   aFaceEdges(aNb);
+  for (int i = 0; i < aNb; ++i)
+  {
+    for (TopExp_Explorer anExp(theGroup.Faces[i], TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const int anId = anEdgeIds.Extent();
+      aFaceEdges[i].push_back(anEdgeIds.TryBound(anExp.Current(), anId));
+    }
+  }
+  std::vector<std::vector<int>> anEdgeFaces(anEdgeIds.Extent());
+  std::vector<char>             aVisited;
+  std::vector<int>              aStack, aCur(aNb), aNext;
+  for (int i = 0; i < aNb; ++i)
+    aCur[i] = i;
+  constexpr int                 THE_MAX_HISTORY = 16;
+  std::vector<std::vector<int>> aHistory(1, aCur);
+  std::vector<uint64_t>         aHashes(1, orderHash(aCur));
+  for (int aStep = 1; aStep <= aPending; ++aStep)
+  {
+    groupSearchOnce(aFaceEdges, anEdgeFaces, aCur, aVisited, aStack, aNext);
+    aCur.swap(aNext);
+    if (aStep >= THE_MAX_HISTORY)
+      continue; // no more history: plain repetition, as the stock calls do
+    const uint64_t aHash = orderHash(aCur);
+    int            aSeen = -1;
+    for (int t = 0; t < static_cast<int>(aHistory.size()) && aSeen < 0; ++t)
+    {
+      if (aHashes[t] == aHash && aHistory[t] == aCur)
+        aSeen = t;
+    }
+    if (aSeen >= 0)
+    {
+      // order(aStep) == order(aSeen): from aSeen on the orders repeat with this period
+      const int aPeriod = aStep - aSeen;
+      aCur              = aHistory[aSeen + (aPending - aSeen) % aPeriod];
+      break;
+    }
+    aHistory.push_back(aCur);
+    aHashes.push_back(aHash);
+  }
+  std::vector<TopoDS_Shape> aFaces(aNb);
+  for (int i = 0; i < aNb; ++i)
+    aFaces[i] = theGroup.Faces[aCur[i]];
+  theGroup.Faces.swap(aFaces);
+  theGroup.Stamp = theCall;
+}
+
+//! The stock Lface of this state after call theCall (the Front, then the groups in list order).
+static void materializeLface(ShellGroupsState&                   theState,
+                             const int                           theCall,
+                             NCollection_Sequence<TopoDS_Shape>& theLfaces)
+{
+  std::vector<int> anOrder(theState.Heap);
+  std::sort(anOrder.begin(), anOrder.end(), [&theState](const int a, const int b) {
+    return groupBefore(theState.Groups[a], theState.Groups[b]);
+  });
+  NCollection_Sequence<TopoDS_Shape> aLfaces(theState.Front);
+  for (const int anId : anOrder)
+  {
+    ShellFaceGroup& aGroup = theState.Groups[anId];
+    materializeGroup(aGroup, theCall);
+    for (const TopoDS_Shape& aFace : aGroup.Faces)
+      aLfaces.Append(aFace);
+  }
+  theLfaces = std::move(aLfaces);
+}
+
+//! One GetShells call of FixFaceOrientation on the state (the same result as the stock GetShells
+//! on the stock Lface); after an allocation failure, and from then on, the stock GetShells on
+//! theLfaces.
+static bool GetShellsOfGroups(
+  ShellGroupsState&                                                         theState,
+  NCollection_Sequence<TopoDS_Shape>&                                       theLfaces,
+  const NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>&             theMapMultiConnectEdges,
+  NCollection_Sequence<TopoDS_Shape>&                                       theSeqShells,
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& theMapFaceShells,
+  NCollection_Sequence<TopoDS_Shape>&                                       theErrFaces)
+{
+  if (!theState.Stock)
+  {
+    const int                          aCall = theState.CallNo + 1;
+    std::vector<ShellFaceGroup>        aNew;
+    FaceEdgesMap                       aFrontEdges;
+    size_t                             aNumberOfEdges = 0;
+    int                                aTaken         = -1; // id of an old group, or -1: aNew[0]
+    NCollection_Sequence<TopoDS_Shape> aProcessingFaces;
+    FaceEdgesMap                       aTakenEdges;
+    bool                               aPrepared = false;
+    try
+    {
+      // groups of the Front, in the stock list order (they lead the stock Lface)
+      if (theState.Front.Length())
+      {
+        EdgeFacesMap aEdgeFaces;
+        aNumberOfEdges = buildFaceEdgeMaps(theState.Front, aFrontEdges, aEdgeFaces);
+        NCollection_List<NCollection_Sequence<TopoDS_Shape>> aList =
+          GetConnectedFaceGroups(aFrontEdges, aEdgeFaces);
+        aNew.reserve(static_cast<size_t>(aList.Size()));
+        int aRank = 0;
+        for (NCollection_List<NCollection_Sequence<TopoDS_Shape>>::Iterator anIt(aList);
+             anIt.More();
+             anIt.Next())
+        {
+          ShellFaceGroup aGroup;
+          aGroup.Faces.reserve(static_cast<size_t>(anIt.Value().Length()));
+          for (NCollection_Sequence<TopoDS_Shape>::Iterator aFIt(anIt.Value()); aFIt.More();
+               aFIt.Next())
+            aGroup.Faces.push_back(aFIt.Value());
+          aGroup.Stamp = aCall;
+          aGroup.Call  = aCall;
+          aGroup.Rank  = aRank++;
+          aNew.push_back(std::move(aGroup));
+        }
+      }
+      if (aNew.empty() && theState.Heap.empty())
+      {
+        return false; // no faces (the stock: empty Lface)
+      }
+      theState.Groups.reserve(theState.Groups.size() + aNew.size());
+      theState.Heap.reserve(theState.Heap.size() + aNew.size());
+      // the first group of the stock list
+      if (aNew.empty()
+          || (!theState.Heap.empty()
