+//=======================================================================
+// defect 020: pairs of wires for FixIntersectingWires found by a sweep of the wire boxes instead of
+// all pairs. OCCT 8.0.1 Bnd_Box2d::IsOut (Bnd_Box2d.cxx:456-479) of two boxes without flags (not
+// void, no open side) tests Xmin - Other.Xmax > Gap + Other.Gap (and the three other sides) on the
+// stored values; it is symmetric, and apart from rounding it is "the Get() ranges are apart in x or
+// in y". The sweep takes the Get() ranges widened by 1e-9 of their magnitude and the gap - far more
+// than the rounding of either form - so a pair the stock test does not reject always intersects in
+// both x and y and is found; the stock test is still applied to every candidate pair. Boxes of
+// other kinds (void, open, not finite) and boxes recomputed after a pair was fixed are tested with
+// every wire, as before.
+//=======================================================================
+namespace
+{
+//! Widened Get() ranges (xmin, ymin, xmax, ymax) of a box for the sweep; false for a box the sweep
+//! does not take.
+static bool sweepRange(const Bnd_Box2d& theBox, double theR[4])
+{
+  if (theBox.IsVoid() || theBox.IsOpenXmin() || theBox.IsOpenXmax() || theBox.IsOpenYmin()
+      || theBox.IsOpenYmax())
+    return false;
+  theBox.Get(theR[0], theR[1], theR[2], theR[3]);
+  const double aGap = theBox.GetGap();
+  const double aMag =
+    std::abs(theR[0]) + std::abs(theR[1]) + std::abs(theR[2]) + std::abs(theR[3]) + 4.0 * std::abs(aGap);
+  if (!std::isfinite(aMag) || !(theR[0] <= theR[2] && theR[1] <= theR[3])) // not finite, NaN
+    return false;
+  const double aWiden = 1.0e-9 * aMag + std::numeric_limits<double>::min();
+  theR[0] -= aWiden;
+  theR[1] -= aWiden;
+  theR[2] += aWiden;
+  theR[3] += aWiden;
+  return true;
+}
+
+//! theSwept[n] = 1 for the boxes the sweep takes; theCand[n1] = sorted n2 > n1 whose ranges
+//! intersect those of n1.
+static void sweepWireBoxes(const NCollection_Sequence<Bnd_Box2d>& theBoxes,
+                           std::vector<char>&                     theSwept,
+                           std::vector<std::vector<int>>&         theCand)
+{
+  const int                          aNb = theBoxes.Length();
+  std::vector<std::array<double, 4>> aR(aNb + 1);
+  std::vector<int>                   anOrder;
+  int                                n = 1;
+  for (NCollection_Sequence<Bnd_Box2d>::Iterator anIt(theBoxes); anIt.More(); anIt.Next(), n++)
+  {
+    if (sweepRange(anIt.Value(), aR[n].data()))
+    {
+      theSwept[n] = 1;
+      anOrder.push_back(n);
+    }
+  }
+  std::sort(anOrder.begin(), anOrder.end(), [&aR](const int a, const int b) {
+    return aR[a][0] < aR[b][0] || (aR[a][0] == aR[b][0] && a < b);
+  });
+  std::vector<int> anActive;
+  for (const int aCur : anOrder)
+  {
+    std::size_t aKeep = 0;
+    for (std::size_t k = 0; k < anActive.size(); k++)
+    {
+      const int a = anActive[k];
+      if (aR[a][2] < aR[aCur][0])
+        continue; // ends before aCur starts: before every later box too
+      anActive[aKeep++] = a;
+      if (!(aR[a][3] < aR[aCur][1] || aR[a][1] > aR[aCur][3]))
+        theCand[(std::min)(a, aCur)].push_back((std::max)(a, aCur));
+    }
+    anActive.resize(aKeep);
+    anActive.push_back(aCur);
+  }
+  for (std::vector<int>& aList : theCand)
+    std::sort(aList.begin(), aList.end());
+}
+
+//! The second wires n2 > n1 the stock loop has to test, in increasing order: all of them when the
+//! box of n1 is not swept (or was recomputed), else the swept candidates of n1 and every not swept
+//! wire above n1.
+static void secondWires(const int               n1,
+                        const int               theNb,
+                        const bool              theSwept1,
+                        const std::vector<int>& theCand1,
+                        const std::vector<int>& theNotSwept,
+                        std::vector<int>&       theOut)
+{
+  theOut.clear();
+  if (!theSwept1)
+  {
+    for (int n2 = n1 + 1; n2 <= theNb; n2++)
+      theOut.push_back(n2);
+    return;
+  }
+  const std::vector<int>::const_iterator anUp =
+    std::upper_bound(theNotSwept.begin(), theNotSwept.end(), n1);
+  std::merge(theCand1.begin(), theCand1.end(), anUp, theNotSwept.end(), std::back_inserter(theOut));
+  theOut.erase(std::unique(theOut.begin(), theOut.end()), theOut.end());
+}
+
+//! The box of wire n was recomputed: from now on the wire is tested with every other wire.
+static void unsweepWire(const int n, std::vector<char>& theSwept, std::vector<int>& theNotSwept)
+{
+  if (!theSwept[n])
+    return;
+  theSwept[n] = 0;
+  theNotSwept.insert(std::upper_bound(theNotSwept.begin(), theNotSwept.end(), n), n);
+}
+} // namespace
+
