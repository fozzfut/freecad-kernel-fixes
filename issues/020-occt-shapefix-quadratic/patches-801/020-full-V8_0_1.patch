+// defect 020 (row 8 of the audit) on OCCT 8.0.1. FixFaceOrientation calls GetShells until a call
+// builds no shell; each stock call (#584) builds the face / edge maps and the connected groups of
+// ALL remaining faces, turns the largest group into shells and puts the other groups back into
+// Lface - on a shell of many separate bodies that is O(faces) per body, quadratic in all
+// (512 boxes in one shell: 2.4-2.9 s on the weekly). ShellGroupsState keeps the stock Lface between
+// the calls of one FixFaceOrientation as
+//   Front                 the faces the last call left: its leftovers, then the faces of one-face
+//                         shells it took apart (they lead the stock Lface),
+//   Groups not processed  the other connected groups, in the order of the stock group list.
+// A call groups only the Front (its groups cannot touch the others: each of those was a whole
+// connected group of an earlier Lface), and takes the first group of the stock list: the largest,
+// and among equal sizes the first in Lface - the stock list is a stable sort by size of the groups
+// in the order of their first face in Lface, i.e. of [groups of the Front, then the groups kept, in
+// the previous list order]. Key: size (descending), call that found it (descending), place in that
+// call's list. The only other thing a stock call does to a group it does not process is to rebuild
+// its face order: the connected-group search (a depth-first search from its first face, over edge
+// -> faces arrays filled in Lface order) runs on it again, and the result depends on the group's
+// own order only. So a group records the call of its order, and when it is needed that search is
+// repeated once per call it missed - on its own faces, with integer ids; the order sequence of a
+// group is deterministic, so once an order repeats the rest is read from the cycle. The group
+// taken is turned into shells by the stock code (buildShellsOfGroup) on the same sequence.
+// Allocation failure while preparing a call (std::bad_alloc, Standard_OutOfMemory): the stock Lface
+// is rebuilt from this state and the stock GetShells does that call and all later ones.
+//=======================================================================
+namespace
+{
+//! One connected group of faces of the stock Lface, not processed yet.
+struct ShellFaceGroup
+{
+  std::vector<TopoDS_Shape> Faces; //!< its faces (the Lface objects) in the order of call Stamp
+  int                       Stamp = 0;
+  int                       Call  = 0; //!< the call that found the group
+  int                       Rank  = 0; //!< its place in that call's group list
+};
+
+//! The stock Lface between the GetShells calls of one FixFaceOrientation (see above).
+struct ShellGroupsState
+{
+  NCollection_Sequence<TopoDS_Shape> Front;
+  std::vector<ShellFaceGroup>        Groups;
+  std::vector<int>                   Heap; //!< ids of the groups not processed (heap by key)
+  int                                CallNo       = 0;
+  int                                NbGroupFaces = 0;
+  bool                               Stock        = false;
+
+  int NbFaces() const { return Front.Length() + NbGroupFaces; }
+};
+
+//! True when group a comes before group b in the stock group list.
+static bool groupBefore(const ShellFaceGroup& a, const ShellFaceGroup& b)
+{
+  const size_t aSize = a.Faces.size(), bSize = b.Faces.size();
+  if (aSize != bSize)
+    return aSize > bSize;
+  if (a.Call != b.Call)
+    return a.Call > b.Call;
+  return a.Rank < b.Rank;
+}
+
+struct GroupHeapLess
+{
+  const std::vector<ShellFaceGroup>* myGroups;
+
+  bool operator()(const int a, const int b) const
+  {
+    return groupBefore((*myGroups)[b], (*myGroups)[a]);
+  }
+};
