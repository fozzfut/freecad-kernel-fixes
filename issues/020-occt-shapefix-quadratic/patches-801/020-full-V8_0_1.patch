+//! The stock Lface of this state after call theCall (the Front, then the groups in list order).
+static void materializeLface(ShellGroupsState&                   theState,
+                             const int                           theCall,
+                             NCollection_Sequence<TopoDS_Shape>& theLfaces)
+{
+  std::vector<int> anOrder(theState.Heap);
+  std::sort(anOrder.begin(), anOrder.end(), [&theState](const int a, const int b) {
+    return groupBefore(theState.Groups[a], theState.Groups[b]);
+  });
+  NCollection_Sequence<TopoDS_Shape> aLfaces(theState.Front);
+  for (const int anId : anOrder)
+  {
+    ShellFaceGroup& aGroup = theState.Groups[anId];
+    materializeGroup(aGroup, theCall);
+    for (const TopoDS_Shape& aFace : aGroup.Faces)
+      aLfaces.Append(aFace);
+  }
+  theLfaces = std::move(aLfaces);
+}
