     : myumin(0.0),
       myusup(0.0),
@@ -674,56 +737,80 @@ void Extrema_GenExtPS::BuildGrid(const gp_Pnt& thePoint)
     // Assume UEdge(i, j) = { Point(i, j); Point(i + 1, j    ) }
