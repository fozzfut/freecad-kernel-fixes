     //
-    // 027: every edge is computed independently of the others (from its two nodes and the
-    // point), so the loop order does not change any value. On B-spline and Bezier surfaces the
-    // points inside edges are evaluated through the adaptor's span cache, which holds one
-    // (U span, V span) pair: the stock U-major order evaluates the inside edges of one U row
-    // across all V spans and rebuilds the cache on almost every evaluation (a long face: one
-    // rebuild per evaluation, 25-40 % of a section). Walking the grid V-major keeps consecutive
-    // evaluations in the same V span. A cache holds the one span whose parameter interval
-    // contains the point (BSplCLib_CacheParams::IsCacheValid, consistent with LocateParameter),
-    // so the evaluated values do not depend on which evaluation came before.
-    const auto aComputeEdges = [&](const int NoU, const int NoV) {
-      const Extrema_POnSurfParams& aParam0 = myPoints.Value(NoU, NoV);
-
-      if (NoU < myusample)
+    // 027: on B-spline and Bezier surfaces the points inside edges are evaluated through the
+    // adaptor's span cache, which holds one (U span, V span) pair. The stock loop evaluates the
+    // inside edges of one U row across all V spans, so on a long face the cache is rebuilt for
+    // almost every evaluation (25-40 % of a section of the ball screw). Here the grid is walked in
+    // the stock order but the surface evaluations are deferred and done afterwards sorted by
+    // (V column, U row): consecutive evaluations stay in one V span. Every edge value depends only
+    // on its two nodes and the point (computeEdgeDeferred027 is ComputeEdgeParameters without the
+    // evaluation), and a span cache is valid only for parameters inside its span, so no value
+    // changes; the verify build compares every edge with ComputeEdgeParameters bit for bit.
+    const bool isDeferred =
+      myS->GetType() == GeomAbs_BSplineSurface || myS->GetType() == GeomAbs_BezierSurface;
+    if (isDeferred)
+    {
+      // key = (NoV * (myusample + 1) + NoU) * 2 + (0 for a U edge, 1 for a V edge)
+      NCollection_Vector<long long> aDeferred(1024);
+      const long long               aRow = (long long)myusample + 1;
+      for (int NoU = 1; NoU <= myusample; NoU++)
       {
-        // Compute parameters to UEdge.
-        const Extrema_POnSurfParams& aParam1 = myPoints.Value(NoU + 1, NoV);
-        const Extrema_POnSurfParams& anEdgeParam =
-          ComputeEdgeParameters(true, aParam0, aParam1, thePoint, aDiffTol);
-
-        myUEdgePntParams.SetValue(NoU, NoV, anEdgeParam);
-      }
+        for (int NoV = 1; NoV <= myvsample; NoV++)
+        {
+          const Extrema_POnSurfParams& aParam0 = myPoints.Value(NoU, NoV);
 
-      if (NoV < myvsample)
-      {
-        // Compute parameters to VEdge.
-        const Extrema_POnSurfParams& aParam1 = myPoints.Value(NoU, NoV + 1);
-        const Extrema_POnSurfParams& anEdgeParam =
-          ComputeEdgeParameters(false, aParam0, aParam1, thePoint, aDiffTol);
+          if (NoU < myusample
+              && computeEdgeDeferred027(true,
+                                        aParam0,
+                                        myPoints.Value(NoU + 1, NoV),
+                                        thePoint,
+                                        aDiffTol,
+                                        myUEdgePntParams.ChangeValue(NoU, NoV)))
+          {
+            aDeferred.Append((NoV * aRow + NoU) * 2);
+          }
 
-        myVEdgePntParams.SetValue(NoU, NoV, anEdgeParam);
+          if (NoV < myvsample
+              && computeEdgeDeferred027(false,
+                                        aParam0,
+                                        myPoints.Value(NoU, NoV + 1),
+                                        thePoint,
+                                        aDiffTol,
+                                        myVEdgePntParams.ChangeValue(NoU, NoV)))
+          {
+            aDeferred.Append((NoV * aRow + NoU) * 2 + 1);
+          }
+        }
       }
-    };
-    const bool isVMajor =
-      myS->GetType() == GeomAbs_BSplineSurface || myS->GetType() == GeomAbs_BezierSurface;
-    if (isVMajor)
-    {
+      if (!aDeferred.IsEmpty())
+      {
+        NCollection_Array1<long long> aKeys(0, aDeferred.Length() - 1);
+        for (int k = 0; k < aDeferred.Length(); ++k)
+        {
+          aKeys.SetValue(k, aDeferred.Value(k));
+        }
+        std::sort(&aKeys.ChangeFirst(), &aKeys.ChangeFirst() + aKeys.Length());
 #ifdef EXTREMA_027_MUTANT
-      const int aLastV = myvsample - 1; // negative control: the last V column keeps stale edges
+        const int aNbEval = aKeys.Length() - 1; // negative control: the last point stays unevaluated
 #else
-      const int aLastV = myvsample;
+        const int aNbEval = aKeys.Length();
 #endif
-      for (int NoV = 1; NoV <= aLastV; NoV++)
-      {
-        for (int NoU = 1; NoU <= myusample; NoU++)
+        for (int k = 0; k < aNbEval; ++k)
         {
-          aComputeEdges(NoU, NoV);
+          const long long        aKey  = aKeys.Value(k);
+          const bool             isV   = (aKey & 1) != 0;
+          const int              NoU   = int((aKey >> 1) % aRow);
+          const int              NoV   = int((aKey >> 1) / aRow);
+          Extrema_POnSurfParams& anEdge = isV ? myVEdgePntParams.ChangeValue(NoU, NoV)
+                                              : myUEdgePntParams.ChangeValue(NoU, NoV);
+          double                 aUPar, aVPar;
+          anEdge.Parameter(aUPar, aVPar);
+          anEdge.SetParameters(aUPar, aVPar, myS->Value(aUPar, aVPar));
+          anEdge.SetSqrDistance(thePoint.SquareDistance(anEdge.Value()));
         }
       }
 #ifdef EXTREMA_027_VERIFY
-      // recompute every edge in the stock U-major order and compare bit for bit
+      // recompute every edge with the stock ComputeEdgeParameters and compare bit for bit
       for (int NoU = 1; NoU <= myusample; NoU++)
       {
         for (int NoV = 1; NoV <= myvsample; NoV++)
@@ -751,7 +838,27 @@ void Extrema_GenExtPS::BuildGrid(const gp_Pnt& thePoint)
       {
         for (int NoV = 1; NoV <= myvsample; NoV++)
         {
-          aComputeEdges(NoU, NoV);
+          const Extrema_POnSurfParams& aParam0 = myPoints.Value(NoU, NoV);
+
+          if (NoU < myusample)
+          {
+            // Compute parameters to UEdge.
+            const Extrema_POnSurfParams& aParam1 = myPoints.Value(NoU + 1, NoV);
+            const Extrema_POnSurfParams& anEdgeParam =
+              ComputeEdgeParameters(true, aParam0, aParam1, thePoint, aDiffTol);
+
+            myUEdgePntParams.SetValue(NoU, NoV, anEdgeParam);
+          }
+
+          if (NoV < myvsample)
+          {
+            // Compute parameters to VEdge.
+            const Extrema_POnSurfParams& aParam1 = myPoints.Value(NoU, NoV + 1);
+            const Extrema_POnSurfParams& anEdgeParam =
+              ComputeEdgeParameters(false, aParam0, aParam1, thePoint, aDiffTol);
+
+            myVEdgePntParams.SetValue(NoU, NoV, anEdgeParam);
+          }
         }
       }
     }
