+//=================================================================================================
+// 027: parallel curve-to-face deviation for the curves without p-curves (section without
+// approximation).
+//
+// ComputeTolReached3d() measures, for each section curve without a p-curve, its largest distance
+// from each face (FindMaxDistance: 11 golden-section searches, about 250 point projections per
+// curve). On a B-spline face every projection runs Extrema_GenExtPS over the whole face grid, so for
+// a long face crossed by many section curves this step costs O(curves x face size) and is the
+// largest part of the section (ball screw thread faces: 50-90 % of the section time). The curves
+// are independent: each task runs the same FindMaxDistance with its own GeomAPI_ProjectPointOnSurf,
+// initialised exactly as IntTools_Context::ProjPS() initialises the shared one (surface from
+// BRep_Tool::Surface, UV bounds from the context, the context tolerance, MIN flag, gradient
+// algorithm). A projection result depends only on the surface, the bounds, the tolerance and the
+// point: the GenExtPS grid is built identically in every projector and all per-query arrays are
+// rewritten on each Perform. The values therefore equal the sequential ones; the verify build
+// (INTTOOLS_027_VERIFY) compares every value with the stock sequential call bit for bit. The values
+// are applied in the stock order; a task that failed (exception, memory) is recomputed there by the
+// stock call, which raises the same exception as stock.
+namespace
+{
+struct MaxDistTask027
+{
+  int                     Curve = 0;
+  int                     Side  = 0;
+  occ::handle<Geom_Curve> C3D;
+  double                  First  = 0.;
+  double                  Last   = 0.;
+  double                  Dist   = 0.;
+  bool                    IsDone = false;
+};
+
+//! Rough size of the Extrema_GenExtPS grid arrays of one projector on theS.
+static double gridBytes027(const occ::handle<Geom_Surface>& theS)
+{
+  double aNbU = 44., aNbV = 44.;
+  if (!theS.IsNull() && theS->DynamicType() == STANDARD_TYPE(Geom_BSplineSurface))
+  {
+    const Geom_BSplineSurface* aBS = static_cast<const Geom_BSplineSurface*>(theS.get());
+    aNbU = std::max(aNbU, 2. + double(aBS->UDegree()) * aBS->NbUKnots());
+    aNbV = std::max(aNbV, 2. + double(aBS->VDegree()) * aBS->NbVKnots());
+  }
+  return aNbU * aNbV * 4. * sizeof(Extrema_POnSurfParams);
+}
+
+static void computeMaxDistancesInParallel027(const NCollection_Sequence<IntTools_Curve>& theCurves,
+                                             const TopoDS_Face&                          theFace1,
+                                             const TopoDS_Face&                          theFace2,
+                                             const occ::handle<IntTools_Context>&        theContext,
+                                             NCollection_Vector<MaxDistTask027>&         theTasks);
+} // namespace
+
+#ifdef INTTOOLS_027_VERIFY
+  #include <atomic>
+  #include <cstdio>
+  #include <cstdlib>
+  #include <cstring>
+
+namespace
+{
+struct Verify027FFCounters
+{
+  std::atomic<long long> Compared{0}, Parallel{0};
+
+  ~Verify027FFCounters()
+  {
+    std::fprintf(stderr,
+                 "027-VERIFY FindMaxDistance compared=%lld parallel-runs=%lld mismatch=0\n",
+                 (long long)Compared,
+                 (long long)Parallel);
+  }
+};
+
+static Verify027FFCounters THE_027_FF_COUNTERS;
+
+static void verify027(const double theNew, const double theStock, const int theI, const int theJ)
+{
+  ++THE_027_FF_COUNTERS.Compared;
+  if (std::memcmp(&theNew, &theStock, sizeof(double)) != 0)
+  {
+    std::fprintf(stderr,
+                 "027-VERIFY-MISMATCH FindMaxDistance curve=%d side=%d new=%.17g stock=%.17g\n",
+                 theI,
+                 theJ,
+                 theNew,
+                 theStock);
+    std::abort();
+  }
+}
+} // namespace
+#endif
