+//! 027: Extrema_GenExtPS::ComputeEdgeParameters() without the surface evaluation.
+//! Writes into theOut exactly what the stock function returns, except that for a point inside the
+//! edge the 3D point and the square distance are left to the caller (they need S(u, v)).
+//! Returns true in that case. The arithmetic is the stock one, expression by expression.
+static bool computeEdgeDeferred027(const bool                   IsUEdge,
+                                   const Extrema_POnSurfParams& theParam0,
+                                   const Extrema_POnSurfParams& theParam1,
+                                   const gp_Pnt&                thePoint,
+                                   const double                 theDiffTol,
+                                   Extrema_POnSurfParams&       theOut)
+{
+  const double aSqrDist01 = theParam0.Value().SquareDistance(theParam1.Value());
+
+  if (aSqrDist01 <= theDiffTol)
+  {
+    // The points are confused. Get the first point and change its type.
+    theOut = theParam0;
+    return false;
+  }
+  const double aDiffDist = std::abs(theParam0.GetSqrDistance() - theParam1.GetSqrDistance());
+
+  if (aDiffDist >= aSqrDist01 - theDiffTol)
+  {
+    // The shortest distance is one of the nodes.
+    theOut = theParam0.GetSqrDistance() > theParam1.GetSqrDistance() ? theParam1 : theParam0;
+    return false;
+  }
+  // The shortest distance is inside the edge.
+  gp_XYZ aPoP(thePoint.XYZ().Subtracted(theParam0.Value().XYZ()));
+  gp_XYZ aPoP1(theParam1.Value().XYZ().Subtracted(theParam0.Value().XYZ()));
+  double aRatio = aPoP.Dot(aPoP1) / aSqrDist01;
+  double aU[2];
+  double aV[2];
+
+  theParam0.Parameter(aU[0], aV[0]);
+  theParam1.Parameter(aU[1], aV[1]);
+
+  double aUPar = aU[0];
+  double aVPar = aV[0];
+
+  if (IsUEdge)
+  {
+    aUPar += aRatio * (aU[1] - aU[0]);
+  }
+  else
+  {
+    aVPar += aRatio * (aV[1] - aV[0]);
+  }
+
+  int anIndices[2];
+  theParam0.GetIndices(anIndices[0], anIndices[1]);
+  theOut.SetParameters(aUPar, aVPar, gp_Pnt(0., 0., 0.));
+  theOut.SetElementType(IsUEdge ? Extrema_UIsoEdge : Extrema_VIsoEdge);
+  theOut.SetIndices(anIndices[0], anIndices[1]);
+  return true;
+}
