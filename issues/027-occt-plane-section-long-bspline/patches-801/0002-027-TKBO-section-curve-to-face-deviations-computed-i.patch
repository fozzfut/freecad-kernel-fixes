+//=================================================================================================
+// 027: parallel curve-to-face deviation for the curves without p-curves (section without
+// approximation).
+//
+// ComputeTolReached3d() measures, for each section curve without a p-curve, its largest distance
+// from each face (FindMaxDistance: 11 golden-section searches, about 250 point projections per
+// curve). On a B-spline face every projection runs Extrema_GenExtPS over the whole face grid, so for
+// a long face crossed by many section curves this step costs O(curves x face size) and is the
+// largest part of the section (ball screw thread faces: 50-90 % of the section time). The curves
+// are independent: each task runs the same FindMaxDistance with its own GeomAPI_ProjectPointOnSurf,
+// initialised exactly as IntTools_Context::ProjPS() initialises the shared one (surface from
+// BRep_Tool::Surface, UV bounds from the context, the context tolerance, MIN flag, gradient
+// algorithm). A projection result depends only on the surface, the bounds, the tolerance and the
+// point: the GenExtPS grid is built identically in every projector and all per-query arrays are
+// rewritten on each Perform. The values therefore equal the sequential ones; the verify build
+// (INTTOOLS_027_VERIFY) compares every value with the stock sequential call bit for bit. The values
+// are applied in the stock order; a task that failed (exception, memory) is recomputed there by the
+// stock call, which raises the same exception as stock.
+namespace
+{
+struct MaxDistTask027
+{
+  int                     Curve = 0;
+  int                     Side  = 0;
+  occ::handle<Geom_Curve> C3D;
+  double                  First  = 0.;
+  double                  Last   = 0.;
+  double                  Dist   = 0.;
+  bool                    IsDone = false;
+};
+
+//! Rough size of the Extrema_GenExtPS grid arrays of one projector on theS.
+static double gridBytes027(const occ::handle<Geom_Surface>& theS)
+{
+  double aNbU = 44., aNbV = 44.;
+  if (!theS.IsNull() && theS->DynamicType() == STANDARD_TYPE(Geom_BSplineSurface))
+  {
+    const Geom_BSplineSurface* aBS = static_cast<const Geom_BSplineSurface*>(theS.get());
+    aNbU = std::max(aNbU, 2. + double(aBS->UDegree()) * aBS->NbUKnots());
+    aNbV = std::max(aNbV, 2. + double(aBS->VDegree()) * aBS->NbVKnots());
+  }
+  return aNbU * aNbV * 4. * sizeof(Extrema_POnSurfParams);
+}
+
+static void computeMaxDistancesInParallel027(const NCollection_Sequence<IntTools_Curve>& theCurves,
+                                             const TopoDS_Face&                          theFace1,
+                                             const TopoDS_Face&                          theFace2,
+                                             const occ::handle<IntTools_Context>&        theContext,
+                                             NCollection_Vector<MaxDistTask027>&         theTasks);
+} // namespace
+
+#ifdef INTTOOLS_027_VERIFY
+  #include <atomic>
+  #include <cstdio>
+  #include <cstdlib>
+  #include <cstring>
+
+namespace
+{
+struct Verify027FFCounters
+{
+  std::atomic<long long> Compared{0}, Parallel{0};
+
+  ~Verify027FFCounters()
+  {
+    std::fprintf(stderr,
+                 "027-VERIFY FindMaxDistance compared=%lld parallel-runs=%lld mismatch=0\n",
+                 (long long)Compared,
+                 (long long)Parallel);
+  }
+};
+
+static Verify027FFCounters THE_027_FF_COUNTERS;
+
+static void verify027(const double theNew, const double theStock, const int theI, const int theJ)
+{
+  ++THE_027_FF_COUNTERS.Compared;
+  if (std::memcmp(&theNew, &theStock, sizeof(double)) != 0)
+  {
+    std::fprintf(stderr,
+                 "027-VERIFY-MISMATCH FindMaxDistance curve=%d side=%d new=%.17g stock=%.17g\n",
+                 theI,
+                 theJ,
+                 theNew,
+                 theStock);
+    std::abort();
+  }
+}
+} // namespace
+#endif
+
+namespace
+{
+static void computeMaxDistancesInParallel027(const NCollection_Sequence<IntTools_Curve>& theCurves,
+                                             const TopoDS_Face&                          theFace1,
+                                             const TopoDS_Face&                          theFace2,
+                                             const occ::handle<IntTools_Context>&        theContext,
+                                             NCollection_Vector<MaxDistTask027>&         theTasks)
+{
+  // Only faces whose point projection runs the grid search (Extrema_GenExtPS) are worth the
+  // threads; on analytic and swept surfaces Extrema_ExtPS projects in closed form and the stock
+  // sequential loop is kept.
+  bool isGridSurface[2] = {false, false};
+  for (int j = 0; j < 2; ++j)
+  {
+    const occ::handle<Geom_Surface> aS = BRep_Tool::Surface(!j ? theFace1 : theFace2);
+    if (aS.IsNull())
+    {
+      continue;
+    }
+    switch (GeomAdaptor_Surface(aS).GetType())
+    {
+      case GeomAbs_Plane:
+      case GeomAbs_Cylinder:
+      case GeomAbs_Cone:
+      case GeomAbs_Sphere:
+      case GeomAbs_Torus:
+      case GeomAbs_SurfaceOfExtrusion:
+      case GeomAbs_SurfaceOfRevolution:
+        break;
+      default:
+        isGridSurface[j] = true;
+    }
+  }
+  if (!isGridSurface[0] && !isGridSurface[1])
+  {
+    return;
+  }
+  const int aNbLin = theCurves.Length();
+  for (int i = 1; i <= aNbLin; ++i)
+  {
+    const IntTools_Curve&          aIC  = theCurves(i);
+    const occ::handle<Geom_Curve>& aC3D = aIC.Curve();
+    if (aC3D.IsNull())
+    {
+      continue;
+    }
+    for (int j = 0; j < 2; ++j)
+    {
+      if (isGridSurface[j] && (!j ? aIC.FirstCurve2d() : aIC.SecondCurve2d()).IsNull())
+      {
+        MaxDistTask027 aTask;
+        aTask.Curve = i;
+        aTask.Side  = j;
+        aTask.C3D   = aC3D;
+        aTask.First = aC3D->FirstParameter();
+        aTask.Last  = aC3D->LastParameter();
+        theTasks.Append(aTask);
+      }
+    }
+  }
+  if (theTasks.Length() < 2)
+  {
+    theTasks.Clear();
+    return;
+  }
+  // inputs of the projectors, prepared as IntTools_Context::ProjPS() prepares them
+  occ::handle<Geom_Surface> aSurf[2];
+  double                    aBounds[2][4] = {{0., 0., 0., 0.}, {0., 0., 0., 0.}};
+  bool                      isUsed[2]     = {false, false};
+  for (int t = 0; t < theTasks.Length(); ++t)
+  {
+    isUsed[theTasks.Value(t).Side] = true;
+  }
+  double aGridBytes = 0.;
+  for (int j = 0; j < 2; ++j)
+  {
+    if (!isUsed[j])
+    {
+      continue;
+    }
+    const TopoDS_Face& aF = !j ? theFace1 : theFace2;
+    theContext->ProjPS(aF); // the context caches the same projectors as on the stock path
+    theContext->UVBounds(aF, aBounds[j][0], aBounds[j][1], aBounds[j][2], aBounds[j][3]);
+    aSurf[j] = BRep_Tool::Surface(aF);
+    aGridBytes += gridBytes027(aSurf[j]);
+  }
+  const double aTol = theContext->POnSProjectionTolerance();
+  // workers: at most one per logical processor and per task, their grids within about 128 MB
+  int aNbWorkers =
+    std::min(theTasks.Length(), std::max(1, OSD_Parallel::NbLogicalProcessors()));
+  aNbWorkers = std::max(1, std::min(aNbWorkers, int(128.e6 / std::max(aGridBytes, 1.))));
+  if (aNbWorkers < 2)
+  {
+    theTasks.Clear();
+    return;
+  }
+#ifdef INTTOOLS_027_VERIFY
+  ++THE_027_FF_COUNTERS.Parallel;
+#endif
+  auto aWorker = [&](const int theWorker) {
+    std::unique_ptr<GeomAPI_ProjectPointOnSurf> aProj[2];
+    for (int t = theWorker; t < theTasks.Length(); t += aNbWorkers)
+    {
+      MaxDistTask027& aTask = theTasks.ChangeValue(t);
+      try
+      {
+        const int j = aTask.Side;
+        if (!aProj[j])
+        {
+          aProj[j] = std::make_unique<GeomAPI_ProjectPointOnSurf>();
+          aProj[j]->Init(aSurf[j], aBounds[j][0], aBounds[j][1], aBounds[j][2], aBounds[j][3], aTol);
+          aProj[j]->SetExtremaFlag(Extrema_ExtFlag_MIN);
+        }
+#ifdef INTTOOLS_027_MUTANT_B
+        // negative control: the parallel value is scaled by the factor INTTOOLS_027_MUTANT_B
+        aTask.Dist =
+          FindMaxDistance(aTask.C3D, aTask.First, aTask.Last, *aProj[j]) * INTTOOLS_027_MUTANT_B;
+#else
+        aTask.Dist = FindMaxDistance(aTask.C3D, aTask.First, aTask.Last, *aProj[j]);
+#endif
+        aTask.IsDone = true;
+      }
+      catch (...)
+      {
+        aTask.IsDone = false; // recomputed on the stock path
+      }
+    }
+  };
+  OSD_Parallel::For(0, aNbWorkers, aWorker, false);
+}
+} // namespace
+
