+                       GeomAPI_ProjectPointOnSurf&    aProjPS)
 {
   int    aNbS;
   double aT1, aT2, aDt, aD, aDMax, anEps;
@@ -2910,8 +3183,7 @@ double FindMaxDistance(const occ::handle<Geom_Curve>&       theCurve,
