     IntTools_Curve&                aIC  = mySeqOfCurve(i);
@@ -668,8 +911,27 @@ void IntTools_FaceFace::ComputeTolReached3d(const bool theToRunParallel)
       else
       {
         // Look for the maximal deviation between 3D curve and surface
-        const TopoDS_Face& aF = !j ? myFace1 : myFace2;
-        double             aD = FindMaxDistance(aC3D, aFirst, aLast, aF, myContext);
+        const TopoDS_Face& aF      = !j ? myFace1 : myFace2;
+        const bool         hasTask = aTaskIt < aTasks.Length() && aTasks.Value(aTaskIt).Curve == i
+                             && aTasks.Value(aTaskIt).Side == j;
+        double aD = 0.;
+        if (hasTask && aTasks.Value(aTaskIt).IsDone)
+        {
+          aD = aTasks.Value(aTaskIt).Dist; // the value of the stock call below, computed beforehand
+#ifdef INTTOOLS_027_VERIFY
+          verify027(aD, FindMaxDistance(aC3D, aFirst, aLast, aF, myContext), i, j);
+#endif
+        }
+        else
+        {
+          // stock path; it also recomputes a task that failed in the parallel phase, so that
+          // its exception, if any, is raised here in the stock order
+          aD = FindMaxDistance(aC3D, aFirst, aLast, aF, myContext);
+        }
+        if (hasTask)
+        {
+          ++aTaskIt;
+        }
         if (aD > aTolC)
         {
           aTolC = aD;
@@ -2901,6 +3163,17 @@ double FindMaxDistance(const occ::handle<Geom_Curve>&       theCurve,
                        const double                         theLast,
                        const TopoDS_Face&                   theFace,
                        const occ::handle<IntTools_Context>& theContext)
+{
+  GeomAPI_ProjectPointOnSurf& aProjPS = theContext->ProjPS(theFace);
+  return FindMaxDistance(theCurve, theFirst, theLast, aProjPS);
+}
