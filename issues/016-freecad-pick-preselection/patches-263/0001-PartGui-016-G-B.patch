+void SoBrepEdgeSet::rayPick(SoRayPickAction* action)
+{
+    // Ray pick of a big edge set: SoShape::rayPick (pick style, object-space ray, bounding box
+    // cache test) followed by only the line segments the pick cone can reach, generated exactly as
+    // Coin's SoIndexedLineSet::generatePrimitives (line-strip branch) would generate them: same
+    // vertex data, details and ascending order, see SoBrepPickAccel.h. Everything else, and every
+    // case the fast path cannot reproduce, is Coin's own SoShape::rayPick.
+    SoState* state = action->getState();
+    const auto style = SoPickStyleElement::get(state);
+    if (!PickAccel::enabled() || this->coordIndex.getNum() < PickAccel::MinSegments
+        || this->vertexProperty.getValue() || this->getNodeType() == SoNode::VRML1
+        || (style != SoPickStyleElement::SHAPE && style != SoPickStyleElement::SHAPE_ON_TOP
+            && style != SoPickStyleElement::SHAPE_FRONTFACES)
+        || !PickAccel::isGuiThread()) {
+        inherited::rayPick(action);
+        return;
+    }
+    // bindings as SoIndexedLineSet::findMaterialBinding / findNormalBinding (Coin)
+    enum
+    {
+        OVERALL = 0,
+        PER_SEGMENT,
+        PER_SEGMENT_INDEXED,
+        PER_LINE,
+        PER_LINE_INDEXED,
+        PER_VERTEX,
+        PER_VERTEX_INDEXED,
+        UNKNOWN
+    };
+    static_assert(
+        int(SoNormalBindingElement::OVERALL) == int(SoMaterialBindingElement::OVERALL)
+            && int(SoNormalBindingElement::PER_PART) == int(SoMaterialBindingElement::PER_PART)
+            && int(SoNormalBindingElement::PER_PART_INDEXED) == int(SoMaterialBindingElement::PER_PART_INDEXED)
+            && int(SoNormalBindingElement::PER_FACE) == int(SoMaterialBindingElement::PER_FACE)
+            && int(SoNormalBindingElement::PER_FACE_INDEXED) == int(SoMaterialBindingElement::PER_FACE_INDEXED)
+            && int(SoNormalBindingElement::PER_VERTEX) == int(SoMaterialBindingElement::PER_VERTEX)
+            && int(SoNormalBindingElement::PER_VERTEX_INDEXED)
+                == int(SoMaterialBindingElement::PER_VERTEX_INDEXED),
+        "binding values"
+    );
+    auto mapBinding = [](int b) -> int {
+        switch (b) {
+            case SoMaterialBindingElement::OVERALL:
+                return OVERALL;
+            case SoMaterialBindingElement::PER_VERTEX:
+                return PER_VERTEX;
+            case SoMaterialBindingElement::PER_VERTEX_INDEXED:
+                return PER_VERTEX_INDEXED;
+            case SoMaterialBindingElement::PER_PART:
+                return PER_SEGMENT;
+            case SoMaterialBindingElement::PER_PART_INDEXED:
+                return PER_SEGMENT_INDEXED;
+            case SoMaterialBindingElement::PER_FACE:
+                return PER_LINE;
+            case SoMaterialBindingElement::PER_FACE_INDEXED:
+                return PER_LINE_INDEXED;
+            default:
+                return UNKNOWN;
+        }
+    };
+    int mbind = mapBinding(SoMaterialBindingElement::get(state));
+    int nbind = mapBinding(SoNormalBindingElement::get(state));
+    // per-segment bindings use Coin's LINES branch: not reproduced here
+    if (mbind == UNKNOWN || nbind == UNKNOWN || mbind == PER_SEGMENT || mbind == PER_SEGMENT_INDEXED
+        || nbind == PER_SEGMENT || nbind == PER_SEGMENT_INDEXED || !PickAccel::noTextures(state)) {
+        ++PickAccel::stats().edgePicksStock;
+        inherited::rayPick(action);
+        return;
+    }
+
+    // SoShape::rayPick: shouldRayPick() is TRUE for the SHAPE styles checked above
+    this->computeObjectSpaceRay(action);
+    const SoBoundingBoxCache* bboxcache = this->getBoundingBoxCache();
+    if (bboxcache && bboxcache->isValid(state)) {
+        const SbBox3f& box = bboxcache->getProjectedBox();
+        if (box.isEmpty() || !action->intersect(box, TRUE)) {
+            return;  // Coin skips generatePrimitives
+        }
+    }
+
+    static std::vector<uint32_t> candidates;  // GUI thread only
+    const PickAccel::Entry* entry = nullptr;
+    if (!PickAccel::edgeCandidates(this, &this->coordIndex, action, state, candidates, entry)) {
+        inherited::rayPick(action);  // the same object-space ray and box test, then Coin's loop
+        return;
+    }
+
+    const SoCoordinateElement* coords;
+    const SbVec3f* normals;
+    const int32_t* cindices;
+    int numindices;
+    const int32_t* normindices;
+    const int32_t* texindices;
+    const int32_t* matindices;
+    SbBool normalCacheUsed;
+    this->getVertexData(
+        state,
+        coords,
+        normals,
+        cindices,
+        normindices,
+        texindices,
+        matindices,
+        numindices,
+        TRUE,
+        normalCacheUsed
+    );
+    if (!normals) {
+        nbind = OVERALL;
+    }
+    if (mbind == PER_VERTEX_INDEXED && !matindices) {
+        matindices = cindices;
+    }
+    if (nbind == PER_VERTEX_INDEXED && !normindices) {
+        normindices = cindices;
+    }
+    if (mbind == PER_VERTEX || mbind == PER_LINE) {
+        matindices = nullptr;
+    }
+    if (nbind == PER_VERTEX || nbind == PER_LINE) {
+        normindices = nullptr;
+    }
+    if (nbind == OVERALL) {
+        normindices = nullptr;
+    }
+    if (mbind == OVERALL) {
+        matindices = nullptr;
+    }
+
+    SoPrimitiveVertex vertex;
+    SoPointDetail pointDetail;
+    SoLineDetail lineDetail;
+    vertex.setDetail(&pointDetail);
+    SbVec3f dummynormal(0.0f, 0.0f, 1.0f);
+    const SbVec3f* initialnormal = normals ? normals : &dummynormal;
+    if (nbind == OVERALL) {
+        vertex.setNormal(*initialnormal);
+    }
+
+    // Vertex k of polyline p, as Coin's line-strip loop sets it. The first vertex of a polyline
+    // takes matindices[moff] / matnr (and the normal likewise); later vertices advance per vertex
+    // only for PER_VERTEX(_INDEXED), otherwise they keep the first vertex's values.
+    auto setVertex = [&](uint32_t p, uint32_t k, SoPointDetail& pointDetail) {
+        const uint32_t start = entry->lineStart[p];
+        const int32_t i = cindices[start + k];
+        const bool perVertexM = mbind >= PER_VERTEX;
+        const uint32_t km = perVertexM ? k : 0;
+        if (matindices) {
+            const uint32_t off = (mbind == PER_VERTEX_INDEXED ? start : p) + km;
+            pointDetail.setMaterialIndex(matindices[off]);
+            vertex.setMaterialIndex(matindices[off]);
+        }
+        else if (mbind != OVERALL) {
+            const int32_t m = static_cast<int32_t>((mbind == PER_VERTEX ? entry->lineVertBefore[p] : p) + km);
+            pointDetail.setMaterialIndex(m);
+            vertex.setMaterialIndex(m);
+        }
+        const bool perVertexN = nbind >= PER_VERTEX;
+        const uint32_t kn = perVertexN ? k : 0;
+        const SbVec3f* currnormal = initialnormal;
+        if (normindices) {
+            const uint32_t off = (nbind == PER_VERTEX_INDEXED ? start : p) + kn;
+            pointDetail.setNormalIndex(normindices[off]);
+            currnormal = &normals[normindices[off]];
+        }
+        else if (nbind != OVERALL) {
+            const int32_t n = static_cast<int32_t>((nbind == PER_VERTEX ? entry->lineVertBefore[p] : p) + kn);
+            pointDetail.setNormalIndex(n);
+            currnormal = &normals[n];
+        }
+        vertex.setNormal(*currnormal);
+        pointDetail.setCoordinateIndex(i);
+        vertex.setPoint(coords->get3(i));
+    };
+
+    // Coin's line-strip primitive data keeps the point detail of the strip's FIRST vertex as
+    // point 0 of every segment's SoLineDetail (soshape_primdata::copyVertex copies point details
+    // only for face details), while the vertex data (point, normal, material) is the segment's
+    // own start vertex. The restarted strip below feeds that combination.
+    SoPointDetail firstDetail;
+    for (const uint32_t s : candidates) {
+        const uint32_t p = entry->segLine[s];
+        const uint32_t j = entry->segPos[s] - entry->lineStart[p];
+        this->beginShape(action, LINE_STRIP, &lineDetail);
+        setVertex(p, 0, firstDetail);
+        setVertex(p, j, pointDetail);
+        vertex.setDetail(&firstDetail);
+        this->shapeVertex(&vertex);
+        vertex.setDetail(&pointDetail);
+        setVertex(p, j + 1, pointDetail);
+        lineDetail.setLineIndex(static_cast<int>(p));
+        lineDetail.setPartIndex(static_cast<int>(entry->lineSegBefore[p] + j));
+        this->shapeVertex(&vertex);
+        this->endShape();
+    }
+}
+
 SoDetail* SoBrepEdgeSet::createLineSegmentDetail(
     SoRayPickAction* action,
     const SoPrimitiveVertex* v1,
