@@ -785,6 +789,171 @@ void SoBrepFaceSet::GLRenderBelowPath(SoGLRenderAction* action)
 
 void SoBrepFaceSet::generatePrimitives(SoAction* action)
 {
+    // Ray pick of a big face set: generate only the triangles the pick line can reach, exactly as
+    // Coin's SoIndexedFaceSet::generatePrimitives would generate them (same vertex data, details
+    // and ascending order), see SoBrepPickAccel.h. Everything else is Coin's own loop.
+    if (PickAccel::enabled() && action->isOfType(SoRayPickAction::getClassTypeId())
+        && this->coordIndex.getNum() >= 4 * PickAccel::MinTriangles
+        && !this->vertexProperty.getValue() && this->getNodeType() != SoNode::VRML1) {
+        SoState* state = action->getState();
+        // bindings as SoIndexedFaceSet::findMaterialBinding / findNormalBinding (Coin)
+        enum
+        {
+            OVERALL,
+            PER_FACE,
+            PER_FACE_INDEXED,
+            PER_VERTEX,
+            PER_VERTEX_INDEXED,
+            UNKNOWN
+        };
+        // SoNormalBindingElement uses the same values as SoMaterialBindingElement
+        static_assert(
+            int(SoNormalBindingElement::OVERALL) == int(SoMaterialBindingElement::OVERALL)
+            && int(SoNormalBindingElement::PER_PART) == int(SoMaterialBindingElement::PER_PART)
+            && int(SoNormalBindingElement::PER_PART_INDEXED) == int(SoMaterialBindingElement::PER_PART_INDEXED)
+            && int(SoNormalBindingElement::PER_FACE) == int(SoMaterialBindingElement::PER_FACE)
+            && int(SoNormalBindingElement::PER_FACE_INDEXED) == int(SoMaterialBindingElement::PER_FACE_INDEXED)
+            && int(SoNormalBindingElement::PER_VERTEX) == int(SoMaterialBindingElement::PER_VERTEX)
+            && int(SoNormalBindingElement::PER_VERTEX_INDEXED)
+                == int(SoMaterialBindingElement::PER_VERTEX_INDEXED),
+            "binding values"
+        );
+        auto mapBinding = [](int b) -> int {
+            switch (b) {
+                case SoMaterialBindingElement::OVERALL:
+                    return OVERALL;
+                case SoMaterialBindingElement::PER_VERTEX:
+                    return PER_VERTEX;
+                case SoMaterialBindingElement::PER_VERTEX_INDEXED:
+                    return PER_VERTEX_INDEXED;
+                case SoMaterialBindingElement::PER_PART:
+                case SoMaterialBindingElement::PER_FACE:
+                    return PER_FACE;
+                case SoMaterialBindingElement::PER_PART_INDEXED:
+                case SoMaterialBindingElement::PER_FACE_INDEXED:
+                    return PER_FACE_INDEXED;
+                default:
+                    return UNKNOWN;
+            }
+        };
+        int mbind = mapBinding(SoMaterialBindingElement::get(state));
+        int nbind = mapBinding(SoNormalBindingElement::get(state));
+        static std::vector<uint32_t> candidates;  // GUI thread only (faceCandidates checks)
+        if (mbind != UNKNOWN && nbind != UNKNOWN && PickAccel::noTextures(state)
+            && PickAccel::faceCandidates(
+                this,
+                &this->coordIndex,
+                static_cast<SoRayPickAction*>(action),
+                state,
+                candidates
+            )) {
+            const SoCoordinateElement* coords;
+            const SbVec3f* normals;
+            const int32_t* cindices;
+            int numindices;
+            const int32_t* nindices;
+            const int32_t* tindices;
+            const int32_t* mindices;
+            SbBool normalCacheUsed;
+            this->getVertexData(
+                state,
+                coords,
+                normals,
+                cindices,
+                nindices,
+                tindices,
+                mindices,
+                numindices,
+                TRUE,
+                normalCacheUsed
+            );
+            if (normalCacheUsed && nbind == PER_VERTEX) {
+                nbind = PER_VERTEX_INDEXED;
+            }
+            else if (normalCacheUsed && nbind == PER_FACE_INDEXED) {
+                nbind = PER_FACE;
+            }
+            if (nbind == PER_VERTEX_INDEXED && !nindices) {
+                nindices = cindices;
+            }
+            if (mbind == PER_VERTEX_INDEXED && !mindices) {
+                mindices = cindices;
+            }
+
+            SoPrimitiveVertex vertex;
+            SoPointDetail pointDetail;
+            SoFaceDetail faceDetail;
+            vertex.setDetail(&pointDetail);
+            SbVec3f dummynormal(0, 0, 1);
+            const SbVec3f* currnormal = normals ? normals : &dummynormal;
+            vertex.setNormal(*currnormal);
+
+            // State of Coin's loop at triangle t (pure triangles, 4 indices each): material and
+            // normal counters 3t+k (PER_VERTEX) or t (PER_FACE), index pointers 4t+k
+            // (PER_VERTEX_INDEXED) or t (PER_FACE_INDEXED), face and part index t. OVERALL never
+            // sets them (defaults stay).
+            this->beginShape(action, TRIANGLES, &faceDetail);
+            for (const uint32_t t : candidates) {
+                const size_t base = 4 * static_cast<size_t>(t);
+                faceDetail.setFaceIndex(static_cast<int>(t));
+                faceDetail.setPartIndex(static_cast<int>(t));
+                for (int k = 0; k < 3; ++k) {
+                    const int32_t idx = cindices[base + k];
+                    int32_t m = 0;
+                    switch (mbind) {
+                        case PER_VERTEX:
+                            m = static_cast<int32_t>(3 * t + k);
+                            break;
+                        case PER_FACE:
+                            m = static_cast<int32_t>(t);
+                            break;
+                        case PER_VERTEX_INDEXED:
+                            m = mindices[base + k];
+                            break;
+                        case PER_FACE_INDEXED:
+                            m = mindices[t];
+                            break;
+                        default:
+                            break;
+                    }
+                    if (mbind != OVERALL) {
+                        pointDetail.setMaterialIndex(m);
+                        vertex.setMaterialIndex(m);
+                    }
+                    int32_t n = 0;
+                    switch (nbind) {
+                        case PER_VERTEX:
+                            n = static_cast<int32_t>(3 * t + k);
+                            break;
+                        case PER_FACE:
+                            n = static_cast<int32_t>(t);
+                            break;
+                        case PER_VERTEX_INDEXED:
+                            n = nindices[base + k];
+                            break;
+                        case PER_FACE_INDEXED:
+                            n = nindices[t];
+                            break;
+                        default:
+                            break;
+                    }
+                    if (nbind != OVERALL) {
+                        pointDetail.setNormalIndex(n);
+                        currnormal = &normals[n];
+                        vertex.setNormal(*currnormal);
+                    }
+                    pointDetail.setCoordinateIndex(idx);
+                    vertex.setPoint(coords->get3(idx));
+                    this->shapeVertex(&vertex);
+                }
+            }
+            this->endShape();
+            if (normalCacheUsed) {
+                this->readUnlockNormalCache();
+            }
+            return;
+        }
+    }
     inherited::generatePrimitives(action);
 }
 
