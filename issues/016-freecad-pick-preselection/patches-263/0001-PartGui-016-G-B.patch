+#pragma once
+
+// Ray-pick acceleration for SoBrepFaceSet / SoBrepEdgeSet (defect 016, plan G task B).
+//
+// Coin picks an indexed face/line set by generating EVERY primitive and testing each against the
+// pick ray. The accelerated path generates only the primitives whose bounding boxes the ray can
+// reach, through the same Coin calls (beginShape/shapeVertex/endShape) with the same per-vertex
+// data and in the same (ascending) order as Coin's own SoIndexedFaceSet / SoIndexedLineSet
+// generatePrimitives. A primitive that is skipped cannot produce an intersection:
+//  - triangles: Coin intersects the central ray line only (SoRayPickAction::intersect(v0,v1,v2)),
+//    so a triangle whose box (padded for float rounding) misses the line cannot be hit;
+//  - segments: Coin tests the pick cone, so segment boxes are expanded by an upper bound of the
+//    cone radius (world radius over the node's depth range, mapped to object space).
+// Triangles/segments with a non-finite coordinate are always generated (Coin's tests on NaN
+// data are not predictable from a box). Anything the path cannot reproduce exactly (textures,
+// vertexProperty, non-triangle faces, per-segment line bindings, non-affine matrices, other
+// threads, ...) goes through the stock Coin code.
+//
+// State lives in side tables keyed by node (no change of the exported class layouts).
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <Inventor/SbBasic.h>
+#include <Inventor/SbLinear.h>
+
+class SoNode;
+class SoState;
+class SoRayPickAction;
+class SoMFInt32;
+class SoFieldSensor;
+class SoCoordinateElement;
+
+namespace PartGui
+{
+namespace PickAccel
+{
+
+// ---- switches and counters ------------------------------------------------------------------
+
+struct Stats
+{
+    std::atomic<unsigned long long> facePicksFast {0};    // face set picks done by the fast path
+    std::atomic<unsigned long long> facePicksStock {0};   // big face set picks left to Coin
+    std::atomic<unsigned long long> edgePicksFast {0};
+    std::atomic<unsigned long long> edgePicksStock {0};
+    std::atomic<unsigned long long> trianglesGenerated {0};  // triangles sent to Coin by the fast path
+    std::atomic<unsigned long long> segmentsGenerated {0};
+    std::atomic<unsigned long long> builds {0};
+    std::atomic<unsigned long long> buildMicroseconds {0};
+    std::atomic<unsigned long long> unsupported {0};  // layouts/bindings the fast path refused
+};
+
+Stats& stats();
+bool& enabledFlag();
+inline bool enabled()
+{
+    return enabledFlag();
+}
+
+// Below these sizes Coin's own loop is cheap enough.
+constexpr int MinTriangles = 256;
+constexpr int MinSegments = 256;
+
+bool isGuiThread();
+
+// ---- object-space pick line -----------------------------------------------------------------
+
+struct Line
+{
+    double o[3];
+    double d[3];
+    double scale;  // max |o| component, for the rounding pad
+};
+
+// Reads action->getLine() (object space, set by computeObjectSpaceRay). False if not usable.
+bool objectLine(SoRayPickAction* action, Line& line);
+
+// ---- BVH over primitive boxes -----------------------------------------------------------------
+
+struct Node
+{
+    float mn[3];
+    float mx[3];
+    uint32_t a;  // internal: index of the left child (right = a + 1); leaf: first slot in order
+    uint32_t n;  // 0 for internal nodes, primitive count for leaves
+};
+
+class BVH
+{
+public:
+    // boxes: 6 floats per primitive (min xyz, max xyz), finite. ids: the primitives to index.
+    void build(const std::vector<float>& boxes, std::vector<uint32_t>&& ids);
+    bool empty() const
+    {
+        return nodes.empty();
+    }
+    // Calls leaf(id) for every indexed primitive in a leaf whose box, expanded by pad, the line
+    // crosses.
+    template<class F>
+    void query(const Line& l, double pad, F&& leaf) const;
+    const Node& root() const
+    {
+        return nodes.front();
+    }
+    void clear()
+    {
+        nodes.clear();
+        nodes.shrink_to_fit();
+        order.clear();
+        order.shrink_to_fit();
+    }
+
+private:
+    std::vector<Node> nodes;
+    std::vector<uint32_t> order;
+};
+
+// Slab test of the infinite line against [mn - pad, mx + pad].
+inline bool lineHitsBox(const Line& l, const double mn[3], const double mx[3], double pad)
+{
+    double t0 = -1e300;
+    double t1 = 1e300;
+    for (int k = 0; k < 3; ++k) {
+        const double lo = mn[k] - pad;
+        const double hi = mx[k] + pad;
+        if (l.d[k] == 0.0) {
+            if (l.o[k] < lo || l.o[k] > hi) {
+                return false;
+            }
+            continue;
+        }
+        const double inv = 1.0 / l.d[k];
+        double a = (lo - l.o[k]) * inv;
+        double b = (hi - l.o[k]) * inv;
+        if (a > b) {
+            std::swap(a, b);
+        }
+        if (a > t0) {
+            t0 = a;
+        }
+        if (b < t1) {
+            t1 = b;
+        }
+        if (t0 > t1) {
+            return false;
+        }
+    }
+    return true;
+}
+
+template<class F>
+void BVH::query(const Line& l, double pad, F&& leaf) const
+{
+    if (nodes.empty()) {
+        return;
+    }
+    uint32_t stack[128];
+    int sp = 0;
+    stack[sp++] = 0;
+    while (sp > 0) {
+        const Node& nd = nodes[stack[--sp]];
+        const double mn[3] = {nd.mn[0], nd.mn[1], nd.mn[2]};
+        const double mx[3] = {nd.mx[0], nd.mx[1], nd.mx[2]};
+        if (!lineHitsBox(l, mn, mx, pad)) {
+            continue;
+        }
+        if (nd.n) {
+            for (uint32_t i = 0; i < nd.n; ++i) {
+                leaf(order[nd.a + i]);
+            }
+            continue;
+        }
+        // depth is bounded by the median split (<= 34 levels for 2^32 primitives)
+        stack[sp++] = nd.a + 1;
+        stack[sp++] = nd.a;
+    }
+}
+
+// ---- per-node cache ---------------------------------------------------------------------------
+
+struct Key
+{
+    SbUniqueId coordsId {0};
+    const void* coordsPtr {nullptr};
+    int numCoords {-1};
+    const int32_t* indexPtr {nullptr};
+    int numIndex {-1};
+    bool operator==(const Key& o) const
+    {
+        return coordsId == o.coordsId && coordsPtr == o.coordsPtr && numCoords == o.numCoords
+            && indexPtr == o.indexPtr && numIndex == o.numIndex;
+    }
+};
+
+struct Entry
+{
+    ~Entry();
+    Key key;
+    std::atomic<bool> dirty {false};  // set by the coordIndex field sensor
+    int seen {0};                     // picks with this key before the index is built
+    bool built {false};
+    bool failed {false};              // layout not supported / build failed, for this key
+    BVH bvh;
+    std::vector<uint32_t> always;  // primitives with a non-finite coordinate
+    // edge sets: segment s starts at coordIndex position segPos[s] and belongs to polyline segLine[s]
+    std::vector<uint32_t> segPos;
+    std::vector<uint32_t> segLine;
+    // polylines: first coordIndex position, vertices before, segments before
+    std::vector<uint32_t> lineStart;
+    std::vector<uint32_t> lineVertBefore;
+    std::vector<uint32_t> lineSegBefore;
+    double rootMn[3] {0, 0, 0};
+    double rootMx[3] {0, 0, 0};
+    SoFieldSensor* sensor {nullptr};
+    void reset(const Key& k);
+};
+
+// Entry of a node; created (with a sensor on 'index') on first use. Only on the GUI thread.
+Entry* entryFor(const SoNode* node, SoMFInt32* index);
+// Called from the node destructors.
+void forget(const SoNode* node);
+
+// Key of the current coordinates + index field; false if the coordinates are not plain 3D.
+bool makeKey(SoState* state, const SoMFInt32& index, Key& key, const SbVec3f*& coords);
+
+// Faces: checks the pure-triangle layout "a b c <0" of 'index', builds the BVH (lazily, on the
+// second pick with the same key) and returns the ascending list of candidate triangles.
+// False = use the stock Coin path.
+bool faceCandidates(
+    const SoNode* node,
+    SoMFInt32* index,
+    SoRayPickAction* action,
+    SoState* state,
+    std::vector<uint32_t>& out
+);
+
+// Edges: polylines "a b [c ...] <0" (each with >= 2 vertices; a trailing single index is ignored
+// as Coin does). Out: ascending candidate segment ids; seg/line tables are in the entry.
+bool edgeCandidates(
+    const SoNode* node,
+    SoMFInt32* index,
+    SoRayPickAction* action,
+    SoState* state,
+    std::vector<uint32_t>& out,
+    const Entry*& entry
+);
+
+// True if no texture unit is enabled (SoTextureCoordinateBundle would not need coordinates).
+bool noTextures(SoState* state);
+
+}  // namespace PickAccel
+}  // namespace PartGui
