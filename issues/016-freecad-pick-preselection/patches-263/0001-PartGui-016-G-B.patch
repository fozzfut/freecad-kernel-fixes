+{
+constexpr uint32_t LeafSize = 8;
+
+std::mutex& tableMutex()
+{
+    static std::mutex m;
+    return m;
+}
+
+std::unordered_map<const SoNode*, std::unique_ptr<Entry>>& table()
+{
+    static std::unordered_map<const SoNode*, std::unique_ptr<Entry>> t;
+    return t;
+}
+
+void sensorCB(void* data, SoSensor* /*sensor*/)
+{
+    static_cast<Entry*>(data)->dirty = true;
+}
+
+inline bool finite3(const SbVec3f& p)
+{
+    return std::isfinite(p[0]) && std::isfinite(p[1]) && std::isfinite(p[2]);
+}
+
+inline void addBox(std::vector<float>& boxes, size_t id, const SbVec3f* pts[], int n)
+{
+    float* b = &boxes[6 * id];
+    for (int k = 0; k < 3; ++k) {
+        float lo = (*pts[0])[k];
+        float hi = lo;
+        for (int i = 1; i < n; ++i) {
+            lo = std::min(lo, (*pts[i])[k]);
+            hi = std::max(hi, (*pts[i])[k]);
+        }
+        b[k] = lo;
+        b[3 + k] = hi;
+    }
+}
+
+double rootScale(const Entry& e)
+{
+    double s = 0.0;
+    for (int k = 0; k < 3; ++k) {
+        s = std::max({s, std::fabs(e.rootMn[k]), std::fabs(e.rootMx[k])});
+    }
+    return s;
+}
+
+void setRoot(Entry& e)
+{
+    if (e.bvh.empty()) {
+        return;
+    }
+    const Node& r = e.bvh.root();
+    for (int k = 0; k < 3; ++k) {
+        e.rootMn[k] = r.mn[k];
+        e.rootMx[k] = r.mx[k];
+    }
+}
+
+// Pad for float rounding: Coin tests with the double object-space line, we with its float copy
+// (relative error ~1e-7 of the coordinates involved); 1e-5 keeps a margin of two decades.
+inline double roundingPad(const Line& l, const Entry& e, double extra)
+{
+    return 1e-5 * (l.scale + rootScale(e) + extra) + 1e-30;
+}
+
+bool buildFaces(Entry& e, const int32_t* ci, int ni, const SbVec3f* coords, int numCoords)
+{
+    const int nt = (ni + 1) / 4;  // Coin reads 3 indices + a terminator per triangle
+    std::vector<float> boxes(static_cast<size_t>(nt) * 6);
+    std::vector<uint32_t> ids;
+    ids.reserve(nt);
+    for (int t = 0; t < nt; ++t) {
+        const int32_t* v = ci + 4 * static_cast<size_t>(t);
+        for (int k = 0; k < 3; ++k) {
+            if (v[k] < 0 || v[k] >= numCoords) {
+                return false;
+            }
+        }
+        if (4 * t + 3 < ni && v[3] >= 0) {
+            return false;  // quad or polygon: Coin's other modes
+        }
+        const SbVec3f* pts[3] = {&coords[v[0]], &coords[v[1]], &coords[v[2]]};
+        if (!finite3(*pts[0]) || !finite3(*pts[1]) || !finite3(*pts[2])) {
+            e.always.push_back(static_cast<uint32_t>(t));
+            continue;
+        }
+        addBox(boxes, t, pts, 3);
+        ids.push_back(static_cast<uint32_t>(t));
+    }
+    e.bvh.build(boxes, std::move(ids));
+    setRoot(e);
+    return true;
+}
+
+bool buildEdges(Entry& e, const int32_t* ci, int ni, const SbVec3f* coords, int numCoords)
+{
+    // the same walk as SoIndexedLineSet::generatePrimitives (line-strip branch)
+    int pos = 0;
+    uint32_t line = 0;
+    uint32_t vbefore = 0;
+    uint32_t sbefore = 0;
+    while (pos + 1 < ni) {
+        if (ci[pos] < 0 || ci[pos + 1] < 0) {
+            return false;  // polyline with < 2 vertices: not reproduced
+        }
+        const int start = pos;
+        pos += 2;
+        while (pos < ni && ci[pos] >= 0) {
+            ++pos;
+        }
+        const int nv = pos - start;
+        if (pos < ni) {
+            ++pos;  // terminator
+        }
+        for (int k = start; k < start + nv; ++k) {
+            if (ci[k] >= numCoords) {
+                return false;
+            }
+        }
+        e.lineStart.push_back(static_cast<uint32_t>(start));
+        e.lineVertBefore.push_back(vbefore);
+        e.lineSegBefore.push_back(sbefore);
+        for (int j = 0; j + 1 < nv; ++j) {
+            e.segPos.push_back(static_cast<uint32_t>(start + j));
+            e.segLine.push_back(line);
+        }
+        vbefore += static_cast<uint32_t>(nv);
+        sbefore += static_cast<uint32_t>(nv - 1);
+        ++line;
+    }
+    const size_t ns = e.segPos.size();
+    std::vector<float> boxes(ns * 6);
+    std::vector<uint32_t> ids;
+    ids.reserve(ns);
+    for (size_t s = 0; s < ns; ++s) {
+        const SbVec3f* pts[2] = {&coords[ci[e.segPos[s]]], &coords[ci[e.segPos[s] + 1]]};
+        if (!finite3(*pts[0]) || !finite3(*pts[1])) {
+            e.always.push_back(static_cast<uint32_t>(s));
+            continue;
+        }
+        addBox(boxes, s, pts, 2);
+        ids.push_back(static_cast<uint32_t>(s));
+    }
+    e.bvh.build(boxes, std::move(ids));
+    setRoot(e);
+    return true;
+}
+
+// Upper bound of Coin's pick-cone radius (SoRayPickAction::computeWorldSpaceRay, intersect(v0,v1)
+// and intersect(point)) at any ray point within that radius of the node's box, in object space.
+bool coneRadiusObjectSpace(SoRayPickAction* action, SoState* state, const Entry& e, double& ros)
+{
+    const SbViewVolume& vv = SoViewVolumeElement::get(state);
+    const SbViewportRegion& vp = SoViewportRegionElement::get(state);
+    const SbVec2s size = vp.getViewportSizePixels();
+    const double w = vv.getWidth();
+    const double h = vv.getHeight();
+    const double depth = vv.getDepth();
+    const double nearDist = vv.getNearDist();
+    const double rpx = action->getRadius();
+    if (size[0] <= 0 || size[1] <= 0 || !(w > 0.0) || !(h > 0.0) || !(depth > 0.0)
+        || !std::isfinite(w) || !std::isfinite(h) || !std::isfinite(depth)
+        || !std::isfinite(nearDist) || !std::isfinite(rpx) || rpx < 0.0) {
+        return false;
+    }
+    const double rs = h / double(size[1]) * rpx;
+    double delta = 0.0;
+    if (vv.getProjectionType() == SbViewVolume::PERSPECTIVE) {
+        SbVec3d dir(0.0, double(float(h) * 0.5f), nearDist);
+        if (dir.normalize() == 0.0 || dir[2] == 0.0) {
+            return false;
+        }
+        const SbVec3d upperfar = dir * (nearDist + depth) / dir[2];
+        const double farsize = (double(upperfar[1]) * 2.0 / double(size[1])) * rpx;
+        delta = (farsize - rs) / depth;
+    }
+    const double ad = std::fabs(delta);
+    if (!std::isfinite(ad) || ad >= 0.5) {
+        return false;
+    }
+    const double rsRay = std::min(w, h) * FLT_EPSILON;  // radius of a ray set with setRay()
+
+    const SbMatrix& m = SoModelMatrixElement::get(state);
+    if (m[0][3] != 0.0f || m[1][3] != 0.0f || m[2][3] != 0.0f || m[3][3] != 1.0f) {
+        return false;
+    }
+    for (int i = 0; i < 4; ++i) {
+        for (int j = 0; j < 4; ++j) {
+            if (!std::isfinite(m[i][j])) {
+                return false;
+            }
+        }
+    }
+    const SbVec3f pp = vv.getProjectionPoint();
+    SbVec3f pd = vv.getProjectionDirection();
+    double dl = std::sqrt(double(pd[0]) * pd[0] + double(pd[1]) * pd[1] + double(pd[2]) * pd[2]);
+    if (!(dl > 0.0) || !std::isfinite(dl)) {
+        return false;
+    }
+    double rpabs = 0.0;
+    for (int c = 0; c < 8; ++c) {
+        const double p[3] = {c & 1 ? e.rootMx[0] : e.rootMn[0],
+                             c & 2 ? e.rootMx[1] : e.rootMn[1],
+                             c & 4 ? e.rootMx[2] : e.rootMn[2]};
+        double rp = -nearDist;
+        for (int j = 0; j < 3; ++j) {
+            const double wj = p[0] * m[0][j] + p[1] * m[1][j] + p[2] * m[2][j] + m[3][j];
+            rp += (wj - pp[j]) * (pd[j] / dl);
+        }
+        rpabs = std::max(rpabs, std::fabs(rp));
+    }
+    double rw = (std::max(rs, rsRay) + ad * rpabs) / (1.0 - ad);
+    rw = rw * 1.5 + FLT_EPSILON * std::max(w, h);
+
+    // |v_object| <= |v_world| * ||L^-1||_F, L = linear part of the model matrix (row vectors)
+    const double a = m[0][0], b = m[0][1], c = m[0][2];
+    const double d = m[1][0], f = m[1][1], g = m[1][2];
+    const double k = m[2][0], l = m[2][1], n = m[2][2];
+    const double det = a * (f * n - g * l) - b * (d * n - g * k) + c * (d * l - f * k);
+    if (!std::isfinite(det) || std::fabs(det) < 1e-300) {
+        return false;
+    }
+    const double cof[9] = {f * n - g * l, c * l - b * n, b * g - c * f,
+                           g * k - d * n, a * n - c * k, c * d - a * g,
+                           d * l - f * k, b * k - a * l, a * f - b * d};
+    double fro = 0.0;
+    for (double v : cof) {
+        fro += v * v;
+    }
+    fro = std::sqrt(fro) / std::fabs(det);
+    ros = rw * fro;
+    return std::isfinite(ros);
+}
+
+// Common part of faceCandidates/edgeCandidates: entry, key, lazy build.
+template<class Build>
+Entry* prepare(const SoNode* node, SoMFInt32* index, SoState* state, const SbVec3f*& coords,
+               Build&& build)
+{
+    Key key;
+    if (!makeKey(state, *index, key, coords)) {
+        return nullptr;
+    }
+    Entry* e = entryFor(node, index);
+    if (e->dirty || !(e->key == key)) {
+        e->reset(key);
+    }
+    if (e->failed) {
+        return nullptr;
+    }
+    if (!e->built) {
+        if (++e->seen < 2) {
+            return nullptr;  // build on the second pick of the same geometry
+        }
+        const auto t0 = std::chrono::steady_clock::now();
+        bool ok = false;
+        try {
+            ok = build(*e, key.indexPtr, key.numIndex, coords, key.numCoords);
+        }
+        catch (const std::bad_alloc&) {
+            ok = false;
+        }
+        if (!ok) {
+            const Key k = e->key;
+            e->reset(k);
+            e->failed = true;
+            ++stats().unsupported;
+            return nullptr;
+        }
+        e->built = true;
+        ++stats().builds;
+        stats().buildMicroseconds += static_cast<unsigned long long>(
+            std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - t0
+            )
+                .count()
+        );
+    }
+    return e;
+}
+
+}  // namespace
+
+Stats& stats()
+{
+    static Stats s;
+    return s;
+}
+
+bool& enabledFlag()
+{
+    static bool on = true;
+    return on;
+}
+
+bool isGuiThread()
+{
+    const QCoreApplication* app = QCoreApplication::instance();
+    return app && QThread::currentThread() == app->thread();
+}
+
+bool objectLine(SoRayPickAction* action, Line& line)
+{
+    const SbLine& l = action->getLine();
+    const SbVec3f& p = l.getPosition();
+    const SbVec3f& d = l.getDirection();
+    if (!finite3(p) || !finite3(d)) {
+        return false;
+    }
+    double len = 0.0;
+    line.scale = 0.0;
+    for (int k = 0; k < 3; ++k) {
+        line.o[k] = p[k];
+        line.d[k] = d[k];
+        len += line.d[k] * line.d[k];
+        line.scale = std::max(line.scale, std::fabs(line.o[k]));
+    }
+    return len > 0.99 && len < 1.01;
+}
+
+void BVH::build(const std::vector<float>& boxes, std::vector<uint32_t>&& ids)
+{
+    nodes.clear();
+    order = std::move(ids);
+    const uint32_t n = static_cast<uint32_t>(order.size());
+    if (n == 0) {
+        return;
+    }
+    nodes.reserve(2 * (n / LeafSize) + 2);
+    struct Task
+    {
+        uint32_t node, b, e;
+    };
+    std::vector<Task> todo;
+    todo.push_back({0, 0, n});
+    nodes.emplace_back();
+    while (!todo.empty()) {
+        const Task t = todo.back();
+        todo.pop_back();
+        float mn[3] = {FLT_MAX, FLT_MAX, FLT_MAX};
+        float mx[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+        float cmn[3] = {FLT_MAX, FLT_MAX, FLT_MAX};
+        float cmx[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+        for (uint32_t i = t.b; i < t.e; ++i) {
+            const float* bx = &boxes[6 * static_cast<size_t>(order[i])];
+            for (int k = 0; k < 3; ++k) {
+                mn[k] = std::min(mn[k], bx[k]);
+                mx[k] = std::max(mx[k], bx[3 + k]);
+                const float c = bx[k] + bx[3 + k];
+                cmn[k] = std::min(cmn[k], c);
+                cmx[k] = std::max(cmx[k], c);
+            }
+        }
+        for (int k = 0; k < 3; ++k) {
+            nodes[t.node].mn[k] = mn[k];
+            nodes[t.node].mx[k] = mx[k];
+        }
+        int axis = 0;
+        for (int k = 1; k < 3; ++k) {
+            if (cmx[k] - cmn[k] > cmx[axis] - cmn[axis]) {
+                axis = k;
+            }
+        }
+        if (t.e - t.b <= LeafSize || !(cmx[axis] - cmn[axis] > 0.0f)) {
+            nodes[t.node].a = t.b;
+            nodes[t.node].n = t.e - t.b;
+            continue;
+        }
+        const uint32_t mid = t.b + (t.e - t.b) / 2;
+        std::nth_element(
+            order.begin() + t.b,
+            order.begin() + mid,
+            order.begin() + t.e,
+            [&boxes, axis](uint32_t x, uint32_t y) {
+                return boxes[6 * static_cast<size_t>(x) + axis] + boxes[6 * static_cast<size_t>(x) + 3 + axis]
+                    < boxes[6 * static_cast<size_t>(y) + axis] + boxes[6 * static_cast<size_t>(y) + 3 + axis];
+            }
+        );
+        const uint32_t left = static_cast<uint32_t>(nodes.size());
+        nodes.emplace_back();
+        nodes.emplace_back();
+        nodes[t.node].a = left;
+        nodes[t.node].n = 0;
+        todo.push_back({left + 1, mid, t.e});
+        todo.push_back({left, t.b, mid});
+    }
+}
+
+Entry::~Entry()
+{
+    delete sensor;  // detaches from the field
+}
+
+void Entry::reset(const Key& k)
+{
+    key = k;
+    dirty = false;
+    seen = 0;
+    built = false;
+    failed = false;
+    bvh.clear();
+    always.clear();
+    segPos.clear();
+    segLine.clear();
+    lineStart.clear();
+    lineVertBefore.clear();
+    lineSegBefore.clear();
+    for (int i = 0; i < 3; ++i) {
+        rootMn[i] = rootMx[i] = 0.0;
+    }
+}
+
+Entry* entryFor(const SoNode* node, SoMFInt32* index)
+{
+    std::lock_guard<std::mutex> lock(tableMutex());
+    auto& slot = table()[node];
+    if (!slot) {
+        slot = std::make_unique<Entry>();
+        slot->sensor = new SoFieldSensor(sensorCB, slot.get());
+        slot->sensor->setPriority(0);  // immediate: every change of the index field marks the entry
+        slot->sensor->attach(index);
+    }
+    return slot.get();
+}
+
+void forget(const SoNode* node)
+{
+    std::unique_ptr<Entry> gone;
+    {
+        std::lock_guard<std::mutex> lock(tableMutex());
+        auto& t = table();
+        if (t.empty()) {
+            return;
+        }
+        auto it = t.find(node);
+        if (it == t.end()) {
+            return;
+        }
+        gone = std::move(it->second);
+        t.erase(it);
+    }
+}
+
+bool makeKey(SoState* state, const SoMFInt32& index, Key& key, const SbVec3f*& coords)
+{
+    const SoCoordinateElement* ce = SoCoordinateElement::getInstance(state);
+    if (!ce || !ce->is3D()) {
+        return false;
+    }
+    coords = ce->getArrayPtr3();
+    key.numCoords = ce->getNum();
+    if (!coords || key.numCoords <= 0) {
+        return false;
+    }
+    key.coordsId = ce->getNodeId();
+    if (key.coordsId == 0) {
+        return false;  // coordinates not set by a node: no change tracking
+    }
+    key.coordsPtr = coords;
+    key.indexPtr = index.getValues(0);
+    key.numIndex = index.getNum();
+    return key.indexPtr != nullptr;
+}
+
+bool noTextures(SoState* state)
+{
+    int lastenabled = -1;
+    const SbBool* multienabled = SoMultiTextureEnabledElement::getEnabledUnits(state, lastenabled);
+    return lastenabled < 0 && !multienabled;
+}
+
+bool faceCandidates(
+    const SoNode* node,
+    SoMFInt32* index,
+    SoRayPickAction* action,
+    SoState* state,
+    std::vector<uint32_t>& out
+)
+{
+    if (!isGuiThread()) {
+        return false;
+    }
+    Line line;
+    if (!objectLine(action, line)) {
+        ++stats().facePicksStock;
+        return false;
+    }
+    const SbVec3f* coords = nullptr;
+    Entry* e = prepare(node, index, state, coords, buildFaces);
+    if (!e) {
+        ++stats().facePicksStock;
+        return false;
+    }
+    const int32_t* ci = e->key.indexPtr;
+    const double pad = mutant("shrink") ? -1e-3 * rootScale(*e) : roundingPad(line, *e, 0.0);
+    out.clear();
+    e->bvh.query(line, pad, [&](uint32_t t) {
+        const int32_t* v = ci + 4 * static_cast<size_t>(t);
+        const SbVec3f& p0 = coords[v[0]];
+        const SbVec3f& p1 = coords[v[1]];
+        const SbVec3f& p2 = coords[v[2]];
+        double mn[3];
+        double mx[3];
+        for (int k = 0; k < 3; ++k) {
+            mn[k] = std::min({p0[k], p1[k], p2[k]});
+            mx[k] = std::max({p0[k], p1[k], p2[k]});
+        }
+        if (lineHitsBox(line, mn, mx, pad)) {
+            out.push_back(t);
+        }
+    });
+    out.insert(out.end(), e->always.begin(), e->always.end());
+    if (!mutant("order")) {
+        std::sort(out.begin(), out.end());
+    }
+    ++stats().facePicksFast;
+    stats().trianglesGenerated += out.size();
+    return true;
+}
+
+bool edgeCandidates(
+    const SoNode* node,
+    SoMFInt32* index,
+    SoRayPickAction* action,
+    SoState* state,
+    std::vector<uint32_t>& out,
+    const Entry*& entry
+)
+{
+    if (!isGuiThread()) {
+        return false;
+    }
+    Line line;
+    if (!objectLine(action, line)) {
+        ++stats().edgePicksStock;
+        return false;
+    }
+    const SbVec3f* coords = nullptr;
+    Entry* e = prepare(node, index, state, coords, buildEdges);
+    if (!e) {
+        ++stats().edgePicksStock;
+        return false;
+    }
+    double ros = 0.0;
+    if (!e->bvh.empty() && !coneRadiusObjectSpace(action, state, *e, ros)) {
+        ++stats().edgePicksStock;
+        return false;
+    }
+    const int32_t* ci = e->key.indexPtr;
+    if (mutant("edge0")) {
+        ros = 0.0;
+    }
+    const double pad = roundingPad(line, *e, ros) + ros;
+    out.clear();
+    e->bvh.query(line, pad, [&](uint32_t s) {
+        const SbVec3f& p0 = coords[ci[e->segPos[s]]];
+        const SbVec3f& p1 = coords[ci[e->segPos[s] + 1]];
+        double mn[3];
+        double mx[3];
+        for (int k = 0; k < 3; ++k) {
+            mn[k] = std::min(p0[k], p1[k]);
+            mx[k] = std::max(p0[k], p1[k]);
+        }
+        if (lineHitsBox(line, mn, mx, pad)) {
+            out.push_back(s);
+        }
+    });
+    out.insert(out.end(), e->always.begin(), e->always.end());
+    std::sort(out.begin(), out.end());
+    entry = e;
+    ++stats().edgePicksFast;
+    stats().segmentsGenerated += out.size();
+    return true;
+}
+
+}  // namespace PickAccel
+}  // namespace PartGui
