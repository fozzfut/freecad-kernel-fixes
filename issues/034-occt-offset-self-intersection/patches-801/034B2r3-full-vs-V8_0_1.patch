+static void findVanishing034b(
+  const TopoDS_Shape&                                                                  theFaceComp,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&                 theCaps,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const NCollection_DataMap<TopoDS_Shape, BRepOffset_Offset, TopTools_ShapeMapHasher>& theMapSF,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  VanishRecord034b&                                                         theRec)
+{
+  theRec.Faces.Clear();
+  theRec.RimPairs.Clear();
+  theRec.RimMargin.Clear();
+  theRec.RimTargets.Clear();
+  theRec.Offset = theOffset;
+  theRec.SetVertices.Clear();
+  // 1. vanishing faces
+  for (TopExp_Explorer anExp(theFaceComp, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Face& aF = TopoDS::Face(anExp.Current());
+    if (theCaps.Contains(aF))
+    {
+      continue;
+    }
+    const BRepOffset_Offset* anOF = theMapSF.Seek(aF);
+    if (anOF == nullptr)
+    {
+      continue;
+    }
+    const double* anOff = theFaceOffset.Seek(aF);
+    if (theRec.LensFaces.Contains(aF) || anOF->Status() == BRepOffset_Reversed
+        || anOF->Status() == BRepOffset_Degenerated
+        || freeFormFaceVanishes034b(aF, anOff ? *anOff : theOffset))
+    {
+      theRec.Faces.Add(aF);
+    }
+  }
+  if (theRec.Faces.IsEmpty())
+  {
+    return;
+  }
+  for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator anItF(theRec.Faces);
+       anItF.More();
+       anItF.Next())
+  {
+    for (TopExp_Explorer anEV(anItF.Value(), TopAbs_VERTEX); anEV.More(); anEV.Next())
+    {
+      theRec.SetVertices.Add(anEV.Current());
+    }
+  }
+  // edges of the removed faces (they are not in the analysed shape)
+  NCollection_IndexedDataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aCapEdges;
+  for (int i = 1; i <= theCaps.Extent(); ++i)
+  {
+    for (TopExp_Explorer anEE(theCaps(i), TopAbs_EDGE); anEE.More(); anEE.Next())
+    {
+      if (!aCapEdges.Contains(anEE.Current()))
+      {
+        aCapEdges.Add(anEE.Current(), theCaps(i));
+      }
+    }
+  }
+  // vertices of the removed faces: a set touching a removed face at a vertex
+  // only reaches it too (the rim faces there meet the removed face beyond
+  // the end of their edges on it)
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aCapVertices;
+  for (int i = 1; i <= theCaps.Extent(); ++i)
+  {
+    for (TopExp_Explorer anEV(theCaps(i), TopAbs_VERTEX); anEV.More(); anEV.Next())
+    {
+      if (!aCapVertices.IsBound(anEV.Current()))
+      {
+        aCapVertices.Bind(anEV.Current(), theCaps(i));
+      }
+    }
+  }
+  // sharp edges whose two face offsets intersect (as in BuildOffsetByArc:
+  // concave edges of an outward offset, convex ones of an inward offset)
+  // and sharp edges that make a tube (the other kind)
+  const ChFiDS_TypeOfConcavity anIntType = theOffset < 0. ? ChFiDS_Convex : ChFiDS_Concave;
+  const ChFiDS_TypeOfConcavity aTubeType = theOffset < 0. ? ChFiDS_Concave : ChFiDS_Convex;
+  // 2. connected sets, their scope and their rims
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aVisited;
+  for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator aSeed(theRec.Faces);
+       aSeed.More();
+       aSeed.Next())
+  {
+    if (!aVisited.Add(aSeed.Value()))
+    {
+      continue;
+    }
+    NCollection_List<TopoDS_Shape>                                aStack;
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aRim, aRimCaps;
+    // set faces next to each rim face, removed faces reached by each set face
+    NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>
+      aRimNb;
+    NCollection_DataMap<TopoDS_Shape,
+                        NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>,
+                        TopTools_ShapeMapHasher>
+      aSetCaps;
+    Bnd_Box                                                       aSetBox;
+    aStack.Append(aSeed.Value());
+    bool isLensSet = false; // round 3: the set holds a lens face
+    while (!aStack.IsEmpty())
+    {
+      const TopoDS_Shape aF = aStack.First();
+      aStack.RemoveFirst();
+      BRepBndLib::Add(aF, aSetBox, false);
+      isLensSet = isLensSet || theRec.LensFaces.Contains(aF);
+      // a tube edge at a vertex of the set: the tube ends on the vanished
+      // face (its offset near the vertex is then not bounded by the rim)
+      for (TopExp_Explorer anEV(aF, TopAbs_VERTEX); anEV.More(); anEV.Next())
+      {
+        if (!theAnalyse.HasAncestor(anEV.Current()))
+        {
+          continue;
+        }
+        NCollection_List<TopoDS_Shape> aTubes;
+        theAnalyse.Edges(TopoDS::Vertex(anEV.Current()), aTubeType, aTubes);
+        if (!aTubes.IsEmpty())
+        {
+          theRec.Faces.Clear(); // out of scope
+          return;
+        }
+        if (const TopoDS_Shape* aCapV = aCapVertices.Seek(anEV.Current()))
+        {
+          aRimCaps.Add(*aCapV);
+          if (!aSetCaps.IsBound(aF))
+          {
+            aSetCaps.Bind(aF, NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>());
+          }
+          aSetCaps.ChangeFind(aF).Add(*aCapV);
+        }
+      }
+      for (TopExp_Explorer anEE(aF, TopAbs_EDGE); anEE.More(); anEE.Next())
+      {
+        const TopoDS_Edge& anE = TopoDS::Edge(anEE.Current());
+        if (BRep_Tool::Degenerated(anE))
+        {
+          continue;
+        }
+        if (!theAnalyse.HasAncestor(anE))
+        {
+          theRec.Faces.Clear();
+          return;
+        }
+        const NCollection_List<TopoDS_Shape>& anAnc = theAnalyse.Ancestors(anE);
+        if (anAnc.Extent() == 1)
+        {
+          if (BRep_Tool::IsClosed(anE, TopoDS::Face(aF)))
+          {
+            continue; // seam
+          }
+          const TopoDS_Shape* aCap = aCapEdges.Seek(anE);
+          if (aCap == nullptr)
+          {
+            theRec.Faces.Clear(); // free border: out of scope
+            return;
+          }
+          aRimCaps.Add(*aCap); // the set reaches a removed face
+          if (!aSetCaps.IsBound(aF))
+          {
+            aSetCaps.Bind(aF, NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>());
+          }
+          aSetCaps.ChangeFind(aF).Add(*aCap);
+          continue;
+        }
+        if (anAnc.Extent() != 2)
+        {
+          theRec.Faces.Clear();
+          return;
+        }
+        const TopoDS_Shape& aF1 = anAnc.First();
+        const TopoDS_Shape& aF2 = anAnc.Last();
+        if (aF1.IsSame(aF2))
+        {
+          continue; // seam
+        }
+        const TopoDS_Shape& anOther = aF1.IsSame(aF) ? aF2 : aF1;
+        if (theRec.Faces.Contains(anOther))
+        {
+          if (aVisited.Add(anOther))
+          {
+            aStack.Append(anOther);
+          }
+          continue;
+        }
+        // A tangent neighbour, or a neighbour across a sharp edge whose two
+        // offsets intersect (no tube: a convex edge of an inward offset, a
+        // concave edge of an outward one), is a rim face: the rim lemma holds
+        // for both (the offsets of such an edge's points are never on the
+        // offset). A sharp edge that makes a tube is out of scope: the tube
+        // itself folds when the set vanishes.
+        // every interval of the edge counts (an edge can be tangent over a
+        // part of its length and make a tube over another part)
+        const NCollection_List<BRepOffset_Interval>& aTypes = theAnalyse.Type(anE);
+        bool isRimEdge = !theCaps.Contains(anOther) && !aTypes.IsEmpty();
+        for (NCollection_List<BRepOffset_Interval>::Iterator anItT(aTypes); anItT.More() && isRimEdge;
+             anItT.Next())
+        {
+          isRimEdge = anItT.Value().Type() == ChFiDS_Tangential || anItT.Value().Type() == anIntType;
+        }
+        if (!isRimEdge)
+        {
+          theRec.Faces.Clear(); // neighbour across a tube edge: out of scope
+          return;
+        }
+        aRim.Add(anOther);
+        if (!aRimNb.IsBound(anOther))
+        {
+          aRimNb.Bind(anOther, NCollection_List<TopoDS_Shape>());
+        }
+        aRimNb.ChangeFind(anOther).Append(aF);
+      }
+    }
+    // Rim offsets meet inside their own domains (rim lemma): the copies are
+    // enlarged by the tolerance only. A removed face is not offset: the rim
+    // offsets must reach its surface across the vanished set, so the copies
+    // are enlarged by the size of the set plus the offset.
+    // Round 3: the two sides of a lens meet each other on their shared edge
+    // and the removed face on its surface there; nothing is prolonged across
+    // a lens.
+    const double aMargin = (aRimCaps.IsEmpty() || isLensSet)
+                             ? 0.
+                             : std::sqrt(aSetBox.SquareExtent()) + std::abs(theOffset);
+    // boxes of the rim offsets enlarged by the reach, computed once per face
+    NCollection_Array1<Bnd_Box> aRimBoxes(1, std::max(aRim.Extent(), 1));
+    for (int i = 1; i <= aRim.Extent(); ++i)
+    {
+      const BRepOffset_Offset* anOF = theMapSF.Seek(aRim(i));
+      if (anOF == nullptr || anOF->Face().IsNull())
+      {
+        theRec.Faces.Clear();
+        return;
+      }
+      BRepBndLib::Add(anOF->Face(), aRimBoxes(i), false);
+      aRimBoxes(i).Enlarge(aMargin);
+    }
+    for (int i = 1; i <= aRim.Extent(); ++i)
+    {
+      if (aMargin > 0.)
+      {
+        double* aRM = theRec.RimMargin.ChangeSeek(aRim(i));
+        if (aRM == nullptr)
+        {
+          theRec.RimMargin.Bind(aRim(i), aMargin);
+        }
+        else
+        {
+          *aRM = std::max(*aRM, aMargin);
+        }
+        if (!theRec.RimTargets.IsBound(aRim(i)))
+        {
+          theRec.RimTargets.Bind(aRim(i), NCollection_List<RimTarget034b>());
+        }
+        NCollection_List<RimTarget034b>& aTg = theRec.RimTargets.ChangeFind(aRim(i));
+        for (int c = 1; c <= aRimCaps.Extent(); ++c)
+        {
+          const TopoDS_Face& aCapF = TopoDS::Face(aRimCaps(c));
+          aTg.Append(RimTarget034b{aCapF, BRep_Tool::Surface(aCapF)});
+        }
+        for (int j = 1; j <= aRim.Extent(); ++j)
+        {
+          const BRepOffset_Offset* anOFj = theMapSF.Seek(aRim(j));
+          if (j != i && anOFj != nullptr && !anOFj->Face().IsNull())
+          {
+            aTg.Append(RimTarget034b{aRim(j), BRep_Tool::Surface(TopoDS::Face(anOFj->Face()))});
+          }
+        }
+      }
+      const BRepOffset_Offset* anOF1 = theMapSF.Seek(aRim(i));
+      if (anOF1 == nullptr || anOF1->Face().IsNull())
+      {
+        theRec.Faces.Clear();
+        return;
+      }
+      Bnd_Box aB1 = aRimBoxes(i);
+      aB1.Enlarge(Precision::Confusion() + aMargin);
+      for (int j = i + 1; j <= aRim.Extent(); ++j)
+      {
+        if (aB1.IsOut(aRimBoxes(j)) || lensJoined034c(theRec, theAnalyse, aRim(i), aRim(j)))
+        {
+          continue;
+        }
+        RimPair034b aPair;
+        aPair.A      = aRim(i);
+        aPair.B      = aRim(j);
+        aPair.Margin = aMargin;
+        theRec.RimPairs.Append(aPair);
+      }
+      for (int j = 1; j <= aRimCaps.Extent(); ++j)
+      {
+        // only a rim face next to a set face that reaches the removed face
+        // meets it across the set (a rim face elsewhere around the set has
+        // nothing to do with it)
+        bool isReached = false;
+        for (NCollection_List<TopoDS_Shape>::Iterator anItN(aRimNb.Find(aRim(i)));
+             anItN.More() && !isReached;
+             anItN.Next())
+        {
+          const NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>* aCapsOf =
+            aSetCaps.Seek(anItN.Value());
+          isReached = aCapsOf != nullptr && aCapsOf->Contains(aRimCaps(j));
+        }
+        if (!isReached)
+        {
+          continue;
+        }
+        // A rim face with an edge on the removed face keeps the stock
+        // section there (the offset of that edge, extended to the removed
+        // face): by the rim lemma the new corner with the other rim faces
+        // lies on it (inside for d > r, at its end for d = r), and its
+        // other end is the stock end at a face that does not vanish (a
+        // tube, a surviving blend, another removed face). Only a rim face
+        // that reaches the removed face across the set, with no edge on
+        // it, is intersected with it on an enlarged copy.
+        bool isOnCap = false;
+        for (TopExp_Explorer anExpE(aRim(i), TopAbs_EDGE); anExpE.More() && !isOnCap;
+             anExpE.Next())
+        {
+          const TopoDS_Shape* aCapOfE = aCapEdges.Seek(anExpE.Current());
+          isOnCap = aCapOfE != nullptr && aCapOfE->IsSame(aRimCaps(j));
+        }
+        if (isOnCap)
+        {
+          continue;
+        }
+        RimPair034b aPair;
+        aPair.A      = aRimCaps(j);
+        aPair.B      = aRim(i);
+        aPair.IsCapA = true;
+        aPair.Margin = aMargin;
+        theRec.RimPairs.Append(aPair);
+      }
+    }
+  }
