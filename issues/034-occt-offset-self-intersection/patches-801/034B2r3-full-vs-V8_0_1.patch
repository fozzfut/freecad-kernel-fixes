+//! Issue 034 lane B2, for BRepOffset_Inter3d (internal, not exported): true
+//! while the MakeOffsetShape() running on this thread builds its offset
+//! around vanishing faces (the stock flow is unchanged otherwise).
+bool BRepOffset_VanishActive034b()
+{
+  return THE_VANISH_034B != nullptr && !THE_VANISH_034B->Faces.IsEmpty();
+}
+
+//! Issue 034 lane B2 (internal, also used by BRepOffset_Inter3d): true if the
+//! removed face theCap and the initial face theF are a rim pair of the running
+//! offset (theF is a rim face next to a vanishing set that reaches theCap):
+//! their intersection is computed on enlarged copies in Intersection3D(), not
+//! from the offset edges of theF on theCap, which end where the set was.
+bool BRepOffset_RimCap034b(const TopoDS_Shape& theCap, const TopoDS_Shape& theF)
+{
+  if (!BRepOffset_VanishActive034b())
+  {
+    return false;
+  }
+  for (NCollection_List<RimPair034b>::Iterator anIt(THE_VANISH_034B->RimPairs); anIt.More();
+       anIt.Next())
+  {
+    if (anIt.Value().IsCapA && anIt.Value().A.IsSame(theCap) && anIt.Value().B.IsSame(theF))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//! Issue 034 lane B2 (internal, used by BRepOffset_Inter3d::ConnexIntByArc):
+//! the sections theLInt1 / theLInt2 of the offsets of the two faces of the
+//! sharp edge theE are prolonged at the ends that lie at a vertex of a
+//! vanishing set when one of the faces is a rim face of a set that reaches a
+//! removed face: the two rim offsets meet that removed face (which is not
+//! offset) across the set, beyond the stock end of their section. The other
+//! ends are kept.
+void BRepOffset_ProlongRimSections034b(const TopoDS_Shape&             theE,
+                                       const TopoDS_Shape&             theF1,
+                                       const TopoDS_Shape&             theF2,
+                                       NCollection_List<TopoDS_Shape>& theLInt1,
+                                       NCollection_List<TopoDS_Shape>& theLInt2)
+{
+  if (!BRepOffset_VanishActive034b() || theLInt1.IsEmpty())
+  {
+    return;
+  }
+  // the corners: the surfaces the section meets across the set (the removed
+  // faces, the offsets of the other rim faces), the two faces themselves out
+  NCollection_List<RimTarget034b> aTargets;
+  for (const TopoDS_Shape* aF : {&theF1, &theF2})
+  {
+    if (const NCollection_List<RimTarget034b>* aTg = THE_VANISH_034B->RimTargets.Seek(*aF))
+    {
+      for (NCollection_List<RimTarget034b>::Iterator anItT(*aTg); anItT.More(); anItT.Next())
+      {
+        if (!anItT.Value().Face.IsSame(theF1) && !anItT.Value().Face.IsSame(theF2))
+        {
+          aTargets.Append(anItT.Value());
+        }
+      }
+    }
+  }
+  TopoDS_Vertex aVa, aVb;
+  TopExp::Vertices(TopoDS::Edge(theE), aVa, aVb);
+  const bool isA = THE_VANISH_034B->SetVertices.Contains(aVa);
+  const bool isB = THE_VANISH_034B->SetVertices.Contains(aVb);
+  if (aTargets.IsEmpty() || (!isA && !isB) || aVa.IsNull() || aVb.IsNull())
+  {
+    return;
+  }
+  const gp_Pnt aPa = BRep_Tool::Pnt(aVa), aPb = BRep_Tool::Pnt(aVb);
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aNew;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theLInt1); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& aSE = TopoDS::Edge(anIt.Value());
+    TopoDS_Vertex      aN1, aN2;
+    TopExp::Vertices(TopoDS::Edge(aSE.Oriented(TopAbs_FORWARD)), aN1, aN2);
+    if (aN1.IsNull() || aN2.IsNull() || aNew.IsBound(aSE))
+    {
+      continue;
+    }
+    const gp_Pnt aP1 = BRep_Tool::Pnt(aN1), aP2 = BRep_Tool::Pnt(aN2);
+    const bool   isSwap =
+      aP1.Distance(aPb) + aP2.Distance(aPa) < aP1.Distance(aPa) + aP2.Distance(aPb);
+    const TopoDS_Edge aProl = prolongedSection034b(
+      aSE,
+      isSwap ? isB : isA,
+      isSwap ? isA : isB,
+      aTargets,
+      10. * BRep_Tool::Tolerance(aSE) + 1.e-3 * std::abs(THE_VANISH_034B->Offset));
+    if (!aProl.IsNull())
+    {
+      aNew.Bind(aSE, aProl);
+    }
+  }
+  if (aNew.IsEmpty())
+  {
+    return;
+  }
+  for (NCollection_List<TopoDS_Shape>* aL : {&theLInt1, &theLInt2})
+  {
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(*aL); anIt.More(); anIt.Next())
+    {
+      if (const TopoDS_Shape* aP = aNew.Seek(anIt.Value()))
+      {
+        // the prolonged copy has the parametrisation of the old edge
+        anIt.ChangeValue() = aP->Oriented(anIt.Value().Orientation());
+      }
+    }
+  }
+}
