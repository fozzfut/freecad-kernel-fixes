+  for (TopExp_Explorer anExp(theA, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Shape* aP = theRec.LensPartner.Seek(anExp.Current());
+    if (aP == nullptr || !theAnalyse.HasAncestor(*aP))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(theAnalyse.Ancestors(*aP)); anIt.More(); anIt.Next())
+    {
+      if (anIt.Value().IsSame(theB))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
