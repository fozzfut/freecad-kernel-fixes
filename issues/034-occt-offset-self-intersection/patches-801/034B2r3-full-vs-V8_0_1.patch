+//! true if some free-form face of theShape (not a removed face) folds on a
+//! part of it only: some grid sample folds, some does not (the samples of
+//! findLenses034c)
+static bool lensCandidate034c(
+  const TopoDS_Shape&                                                       theShape,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&      theCaps,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset)
+{
+  for (TopExp_Explorer anExp(theShape, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Face& aF = TopoDS::Face(anExp.Current());
+    if (theCaps.Contains(aF))
+    {
+      continue;
+    }
+    const double* anOff = theFaceOffset.Seek(aF);
+    const double  aD    = anOff ? *anOff : theOffset;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      TopLoc_Location                  aLoc;
+      const occ::handle<Geom_Surface>& aS0 = BRep_Tool::Surface(aF, aLoc);
+      if (aS0.IsNull())
+      {
+        continue;
+      }
+      occ::handle<Geom_Surface>                   aS  = aS0;
+      occ::handle<Geom_RectangularTrimmedSurface> aRT = occ::down_cast<Geom_RectangularTrimmedSurface>(aS);
+      if (!aRT.IsNull())
+      {
+        aS = aRT->BasisSurface();
+      }
+      const GeomAdaptor_Surface aGAS(aS);
+      const GeomAbs_SurfaceType aT = aGAS.GetType();
+      if (aT != GeomAbs_BSplineSurface && aT != GeomAbs_BezierSurface && aT != GeomAbs_SurfaceOfExtrusion
+          && aT != GeomAbs_SurfaceOfRevolution && aT != GeomAbs_OffsetSurface)
+      {
+        continue;
+      }
+      const double aDD = (aF.Orientation() == TopAbs_REVERSED) ? -aD : aD;
+      double       aU0, aU1, aV0, aV1;
+      BRepTools::UVBounds(aF, aU0, aU1, aV0, aV1);
+      IntTools_FClass2d aCls(aF, Precision::PConfusion());
+      bool              isFold = false, isReg = false;
+      std::vector<std::pair<double, gp_Pnt2d>> aLow; // the lowest regular samples
+      for (int i = 0; i <= 32 && !(isFold && isReg); ++i)
+      {
+        for (int j = 0; j <= 32 && !(isFold && isReg); ++j)
+        {
+          const gp_Pnt2d aP(aU0 + (aU1 - aU0) * i / 32, aV0 + (aV1 - aV0) * j / 32);
+          double         aG, a1, a2;
+          if (aCls.Perform(aP) == TopAbs_OUT || !foldFactor034c(*aS, aP.X(), aP.Y(), aDD, aG, a1, a2))
+          {
+            continue;
+          }
+          (aG < 0. ? isFold : isReg) = true;
+          if (aG >= 0. && aG < 0.75)
+          {
+            aLow.push_back(std::make_pair(aG, aP));
+          }
+        }
+      }
+      if (isReg && !isFold)
+      {
+        // a narrow fold between the samples
+        std::sort(aLow.begin(), aLow.end(), [](const std::pair<double, gp_Pnt2d>& theA,
+                                               const std::pair<double, gp_Pnt2d>& theB) { return theA.first < theB.first; });
+        for (size_t k = 0; k < aLow.size() && k < 8 && !isFold; ++k)
+        {
+          gp_Pnt2d aFound;
+          isFold = foldNear034c(*aS, aDD, aLow[k].second, (aU1 - aU0) / 32, (aV1 - aV0) / 32, aU0, aU1, aV0, aV1,
+                                aFound)
+                   && aCls.Perform(aFound) != TopAbs_OUT;
+        }
+      }
+      if (isFold && isReg)
+      {
+        return true;
+      }
+    }
+    catch (Standard_Failure const&)
+    {
+    }
+  }
+  return LENS034C_FAIL(false);
+}
