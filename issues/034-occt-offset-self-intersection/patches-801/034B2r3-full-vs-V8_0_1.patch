+//! max deviation of the pcurves of the edges of theS from their 3D curves
+//! (the measure of the BOP check, BOPTools_AlgoTools::ComputeTolerance); an
+//! edge whose tolerance under-reports it gets the measured value
+static void coverEdgeDeviations034c(const TopoDS_Shape& theS)
+{
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher> anEF;
+  TopExp::MapShapesAndAncestors(theS, TopAbs_EDGE, TopAbs_FACE, anEF);
+  BRep_Builder aBB;
+  for (int i = 1; i <= anEF.Extent(); ++i)
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anEF.FindKey(i));
+    if (BRep_Tool::Degenerated(anE))
+    {
+      continue;
+    }
+    double aMax = 0.;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anEF(i)); anIt.More(); anIt.Next())
+    {
+      double aD = 0., aPar = 0.;
+      try
+      {
+        OCC_CATCH_SIGNALS
+        if (BOPTools_AlgoTools::ComputeTolerance(TopoDS::Face(anIt.Value()), anE, aD, aPar))
+        {
+          aMax = std::max(aMax, aD);
+        }
+      }
+      catch (Standard_Failure const&)
+      {
+      }
+    }
+    if (aMax > BRep_Tool::Tolerance(anE))
+    {
+      aBB.UpdateEdge(anE, aMax * (1. + 1.e-6) + Precision::Confusion() * 1.e-3);
+    }
+  }
+}
