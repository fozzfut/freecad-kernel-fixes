+static void findVanishing034b(
+  const TopoDS_Shape&                                                                  theFaceComp,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&                 theCaps,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const NCollection_DataMap<TopoDS_Shape, BRepOffset_Offset, TopTools_ShapeMapHasher>& theMapSF,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  VanishRecord034b&                                                         theRec)
+{
+  theRec.Faces.Clear();
+  theRec.RimPairs.Clear();
+  // 1. vanishing faces
+  for (TopExp_Explorer anExp(theFaceComp, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Face& aF = TopoDS::Face(anExp.Current());
+    if (theCaps.Contains(aF))
+    {
+      continue;
+    }
+    const BRepOffset_Offset* anOF = theMapSF.Seek(aF);
+    if (anOF == nullptr)
+    {
+      continue;
+    }
+    const double* anOff = theFaceOffset.Seek(aF);
+    if (anOF->Status() == BRepOffset_Reversed || anOF->Status() == BRepOffset_Degenerated
+        || freeFormFaceVanishes034b(aF, anOff ? *anOff : theOffset))
+    {
+      theRec.Faces.Add(aF);
+    }
+  }
+  if (theRec.Faces.IsEmpty())
+  {
+    return;
+  }
+  // edges of the removed faces (they are not in the analysed shape)
+  NCollection_IndexedDataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aCapEdges;
+  for (int i = 1; i <= theCaps.Extent(); ++i)
+  {
