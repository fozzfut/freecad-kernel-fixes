+//! True if the shape holds no face.
+static bool hasNoFace034(const TopoDS_Shape& theS)
+{
+  return theS.IsNull() || !TopExp_Explorer(theS, TopAbs_FACE).More();
+}
+
+//=======================================================================
+// Issue 034 stage A2: structural guard of offset and thick solids.
+//
+// The boundary of a valid solid is a set of closed, coherently oriented
+// 2-manifold shells: every edge of a shell bounds two of its faces and
+// is used by them with opposite orientations (Requicha 1980). A thick
+// solid made with removed faces (shelling, Forsyth 1995)
+// has one more rule: each connected piece of the remaining input faces
+// that has a free boundary (the rim of the opening) is joined to its
+// offset into ONE shell; a piece without free boundary (e.g. the wall
+// of an inner void) keeps its own shell and gets a second one from its
+// offset. So a thick solid never has more shells than
+//   sum over the pieces: 1 (piece with a free boundary) or 2 (closed piece).
+// A result that breaks these counts is broken whatever the geometry:
+// an opening that was not cut leaves the offset shell closed and apart
+// (e.g. a box filleted on all edges with the top face removed).
+// The checks are pure topology, linear in the number of edges.
+//=======================================================================
+
+//! Uses of the edges of one shell: for each non-degenerated edge the
+//! number of FORWARD and REVERSED uses and the first face using it.
+struct EdgeUses034
+{
+  int NbF   = 0;
+  int NbR   = 0;
+  int Face1 = 0;
+  int Face2 = 0; //!< the first face of the second use (0 = none)
+};
+
+//! Collects the edge uses of the FORWARD/REVERSED faces of theS
+//! (orientations composed as in the shape, like BRepCheck_Shell).
+static void collectEdgeUses034(
+  const TopoDS_Shape&                                            theS,
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theEdges,
+  NCollection_DynamicArray<EdgeUses034>&                         theUses)
+{
+  int aFaceIdx = 0;
+  for (TopExp_Explorer aFExp(theS, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    const TopAbs_Orientation aFOr = aFExp.Current().Orientation();
+    if (aFOr != TopAbs_FORWARD && aFOr != TopAbs_REVERSED)
+    {
+      continue;
+    }
+    ++aFaceIdx;
+    for (TopExp_Explorer anEExp(aFExp.Current(), TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      const TopoDS_Edge&       anE  = TopoDS::Edge(anEExp.Current());
+      const TopAbs_Orientation anOr = anE.Orientation();
+      if ((anOr != TopAbs_FORWARD && anOr != TopAbs_REVERSED) || BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      const int anIdx = theEdges.Add(anE); // indices come in order 1, 2, ...
+      if (anIdx > theUses.Length())
+      {
+        theUses.Append(EdgeUses034());
+      }
+      EdgeUses034& aU = theUses.ChangeValue(anIdx - 1);
+      if (aU.NbF + aU.NbR == 0)
+      {
+        aU.Face1 = aFaceIdx;
+      }
+      else if (aU.NbF + aU.NbR == 1)
+      {
+        aU.Face2 = aFaceIdx;
+      }
+      (anOr == TopAbs_FORWARD ? aU.NbF : aU.NbR)++;
+    }
+  }
+}
+
+//! True if a shell of a solid of theS is open or incoherently oriented:
+//! a non-degenerated edge used once (BRepCheck_NotClosed), or used by two
+//! different faces with the same orientation (BRepCheck_BadOrientationOf
+//! Subshape). Edges with more than two uses are left to BRepCheck.
+static bool solidShellsBroken034(const TopoDS_Shape& theS)
+{
+  for (TopExp_Explorer aSoExp(theS, TopAbs_SOLID); aSoExp.More(); aSoExp.Next())
+  {
+    for (TopExp_Explorer aShExp(aSoExp.Current(), TopAbs_SHELL); aShExp.More(); aShExp.Next())
+    {
+      NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+      NCollection_DynamicArray<EdgeUses034>                         aUses;
+      collectEdgeUses034(aShExp.Current(), anEdges, aUses);
+      for (int i = 0; i < aUses.Length(); ++i)
+      {
+        const EdgeUses034& aU  = aUses.Value(i);
+        const int          aNb = aU.NbF + aU.NbR;
+        if (aNb == 1 || (aNb == 2 && aU.NbF != 1 && aU.Face1 != aU.Face2))
+        {
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+//! Largest number of shells a thick solid glued from the faces of theRest
+//! (the input without the removed faces) and their offsets can have: per
+//! connected piece of theRest, 1 if the piece has a free edge, else 2.
+static int maxThickShells034(const TopoDS_Shape& theRest)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aFaces;
+  for (TopExp_Explorer aFExp(theRest, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aFaces.Add(aFExp.Current());
+  }
+  const int aNbF = aFaces.Extent();
+  if (aNbF == 0)
+  {
+    return 0;
+  }
+  // union-find over the faces through their shared edges
+  NCollection_Array1<int> aParent(0, aNbF);
+  for (int i = 0; i <= aNbF; ++i)
+  {
+    aParent(i) = i;
+  }
+  auto aFind = [&aParent](int theI) {
+    while (aParent(theI) != theI)
+    {
+      aParent(theI) = aParent(aParent(theI));
+      theI          = aParent(theI);
+    }
+    return theI;
+  };
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  NCollection_DynamicArray<int> anEdgeFace; // first face of an edge
+  NCollection_DynamicArray<int> anEdgeUses;
+  for (int iF = 1; iF <= aNbF; ++iF)
+  {
+    for (TopExp_Explorer anEExp(aFaces(iF), TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anEExp.Current());
+      if (BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      const int anIdx = anEdges.Add(anE); // indices come in order 1, 2, ...
+      if (anIdx > anEdgeFace.Length())
+      {
+        anEdgeFace.Append(iF);
+        anEdgeUses.Append(0);
+      }
+      ++anEdgeUses.ChangeValue(anIdx - 1);
+      const int aR1 = aFind(anEdgeFace.Value(anIdx - 1)), aR2 = aFind(iF);
+      if (aR1 != aR2)
+      {
+        aParent(aR1) = aR2;
+      }
+    }
+  }
+  NCollection_Map<int> anOpenRoots, aRoots;
+  for (int i = 0; i < anEdgeUses.Length(); ++i)
+  {
+    if (anEdgeUses.Value(i) == 1)
+    {
+      anOpenRoots.Add(aFind(anEdgeFace.Value(i)));
+    }
+  }
+  int aMax = 0;
+  for (int iF = 1; iF <= aNbF; ++iF)
+  {
+    const int aR = aFind(iF);
+    if (aRoots.Add(aR))
+    {
+      aMax += anOpenRoots.Contains(aR) ? 1 : 2;
+    }
+  }
+  return aMax;
+}
+
+//! Stage A2: true if the join is the intersection and a free-form face of
+//! theFaces has a tangent edge (BRepOffset_Analyse: ChFiDS_Tangential): the
+//! offsets of the two faces are tangent along the edge and their
+//! intersection is ill-conditioned; the result can come back valid for
+//! BRepCheck but self-intersecting. Such results are checked like the ones
+//! where a face can fold. Analytic faces are left out (their tangency is
+//! handled exactly).
+static bool tangentFreeFormJoin034(const TopoDS_Shape&       theFaces,
+                                   const GeomAbs_JoinType    theJoin,
+                                   const BRepOffset_Analyse& theAnalyse)
+{
+  if (theJoin != GeomAbs_Intersection)
+  {
+    return false;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    NCollection_List<TopoDS_Shape> aTangent;
+    for (TopExp_Explorer aFExp(theFaces, TopAbs_FACE); aFExp.More(); aFExp.Next())
+    {
+      const TopoDS_Face&               aF = TopoDS::Face(aFExp.Current());
+      TopLoc_Location                  aLoc;
+      const occ::handle<Geom_Surface>& aS = BRep_Tool::Surface(aF, aLoc);
+      if (aS.IsNull())
+      {
+        continue;
+      }
+      switch (GeomAdaptor_Surface(aS).GetType())
+      {
+        case GeomAbs_Plane:
+        case GeomAbs_Cylinder:
+        case GeomAbs_Cone:
+        case GeomAbs_Sphere:
+        case GeomAbs_Torus:
+          continue;
+        default:
+          break;
+      }
+      theAnalyse.Edges(aF, ChFiDS_Tangential, aTangent);
+      if (!aTangent.IsEmpty())
+      {
+        return true;
+      }
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return true;
+  }
+  return false;
+}
+
+//=======================================================================
+// Issue 034 stage A2, round 2: which shells a thick solid may have.
+//
+// A thick solid is the input minus its inner offset (Rossignac-Requicha
+// 1986). The inner offset can split into several components: where the
+// input is thinner than 2|t| (a neck) the offset pinches off, and a
+// component that no opening reaches stays a closed cavity. So the shells
+// of a correct thick solid are of two kinds only:
+//  - ANCHORED: it holds kept input faces (one per connected piece of them);
+//  - CAVITY: offset faces only (images of kept faces, edges, vertices):
+//    the offset of a closed piece, or a pinched-off part of the hollow.
+// The wall of an opening (the image of a removed face) is the band of the
+// removed face between its rim (edges shared with kept faces) and the
+// offset; every piece of the band touches the rim, so the wall lies in an
+// anchored shell and meets offset faces there. Hence:
+//  - a shell without kept faces that holds a wall is impossible: the
+//    opening was not cut, the offset shell was closed across it (Broken);
+//  - more shells than the pieces give (maxThickShells034) are legal
+//    exactly when the extra ones are cavities: every shell without kept
+//    faces is made of known offset faces only, and every wall meets an
+//    offset face (the opening is cut through to the offset). Otherwise
+//    the extra shell is not explained by the construction (Proven false).
+// Pure topology on the history of the offset (myInitOffsetFace) and on the
+// copies made by the gluing; linear in the number of faces and edges.
+//=======================================================================
+struct ThickShells034
+{
+  bool Broken = false; //!< a shell without kept faces holds a wall
+  bool Proven = true;  //!< every shell is anchored or a cavity, every wall meets an offset face
+};
+
+static TopoDS_Shape glued034(const BRepTools_Quilt& theGlue, const TopoDS_Shape& theS)
+{
+  return theGlue.IsCopied(theS) ? theGlue.Copy(theS) : theS;
+}
+
+static ThickShells034 thickShells034(
+  const TopoDS_Shape&                                                  theSolid,
+  const TopoDS_Shape&                                                  theKept,
+  const BRepTools_Quilt&                                               theGlue,
+  const BRepAlgo_Image&                                                theInit,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theRemoved)
+{
+  ThickShells034                                         aRes;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aKept, aWalls, anOffsets;
+  for (TopExp_Explorer aFExp(theKept, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aKept.Add(glued034(theGlue, aFExp.Current()));
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator aRIt(theInit.Roots()); aRIt.More(); aRIt.Next())
+  {
+    const TopoDS_Shape& aRoot = aRIt.Value();
+    if (!theInit.HasImage(aRoot))
+    {
+      continue;
+    }
+    const bool                     isWall = theRemoved.Contains(aRoot);
+    NCollection_List<TopoDS_Shape> anImages;
+    theInit.LastImage(aRoot, anImages);
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anImages); anIt.More(); anIt.Next())
+    {
+      for (TopExp_Explorer aFExp(anIt.Value(), TopAbs_FACE); aFExp.More(); aFExp.Next())
+      {
+        const TopoDS_Shape aF = glued034(theGlue, aFExp.Current());
+        (isWall ? aWalls : anOffsets).Add(aF);
+      }
+    }
+  }
+  // shells: a shell without kept faces must be a cavity of offset faces
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> anOffsetEdges;
+  for (TopExp_Explorer aShExp(theSolid, TopAbs_SHELL); aShExp.More(); aShExp.Next())
+  {
+    bool isAnchored = false, hasWall = false, hasUnknown = false;
+    for (TopExp_Explorer aFExp(aShExp.Current(), TopAbs_FACE); aFExp.More(); aFExp.Next())
+    {
+      const TopoDS_Shape& aF = aFExp.Current();
+      if (aKept.Contains(aF))
+      {
+        isAnchored = true;
+      }
+      else if (aWalls.Contains(aF))
+      {
+        hasWall = true;
+      }
+      else if (anOffsets.Contains(aF))
+      {
+        for (TopExp_Explorer anEExp(aF, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+        {
+          anOffsetEdges.Add(anEExp.Current());
+        }
+      }
+      else
+      {
+        hasUnknown = true;
+      }
+    }
+    if (!isAnchored && hasWall)
+    {
+      aRes.Broken = true;
+      aRes.Proven = false;
+      return aRes;
+    }
+    if (!isAnchored && hasUnknown)
+    {
+      aRes.Proven = false;
+    }
+  }
+  // walls: each one meets an offset face (the opening reaches the offset)
+  for (TopExp_Explorer aFExp(theSolid, TopAbs_FACE); aRes.Proven && aFExp.More(); aFExp.Next())
+  {
+    if (!aWalls.Contains(aFExp.Current()))
+    {
+      continue;
+    }
+    bool isMet = false;
+    for (TopExp_Explorer anEExp(aFExp.Current(), TopAbs_EDGE); !isMet && anEExp.More();
+         anEExp.Next())
+    {
+      isMet = anOffsetEdges.Contains(anEExp.Current());
+    }
+    aRes.Proven = isMet;
+  }
+  return aRes;
+}
+
+//=======================================================================
+// Issue 034, lane B2: faces whose offset vanishes.
+//
+// Class: a face whose smallest principal offset factor 1 - d*k_i is
+// negative at EVERY point, i.e. the offset distance exceeds the radius
+// of curvature on the offset side over the whole face (a constant-radius
+// fillet, round, torus ring or corner ball smaller than the offset, as
+// an analytic surface or as a free-form one).
+//
+// Theory (Farouki 1986, Maekawa 1999; own derivation of the ball
+// argument): if 1 - d*k_i < 0 at x, the ball of radius |d| around
+// p = x + d*n(x) contains points of the face near x, so p lies strictly
+// closer than |d| to the input and is never on the offset. A face whose
+// factor is negative everywhere therefore contributes nothing to the
+// offset; its neighbours meet each other directly (Forsyth 1995: faces
+// may vanish, the surviving neighbours are extended and intersected).
+//
+// OCCT already drops analytic faces in this state (status Reversed or
+// Degenerated) but never joins their neighbours, so the shell stays open
+// (an error or an empty result); free-form faces in this state are kept
+// untrimmed and the result self-intersects. Here both kinds are dropped,
+// the offset edges they shared with their neighbours are not used, and
+// every pair of surviving faces around a connected set of vanishing
+// faces (the "rim") is intersected; the usual 2D intersection, loop and
+// shell steps then build the faces. The decision uses curvature only
+// (no distance field, see IP.txt of issue 034).
+//
+// Scope of this step: every edge of a vanishing set is shared by two faces
+// and either tangent (a blend network whose neighbours are tangent to it)
+// or sharp without a tube (a convex edge of an inward offset, a concave
+// edge of an outward one: the offsets of the two faces intersect there, so
+// the edge's own points never reach the offset and the rim lemma holds),
+// or it is an edge of a removed face of a thick solid (the rim offsets are
+// then extended across the set and intersected with the surface of the
+// removed face, which is not offset; the rim faces' own edges on the
+// removed face end where the set was, so the removed face is intersected
+// with enlarged copies of them). Sets with a tube edge on their boundary or
+// at one of their vertices (a blend ending on a sharp edge whose tube folds
+// too) are left to the stock flow; the stage A guard reports them.
+//=======================================================================
+
+//! Largest tolerance of the face and its edges (at least Precision::Confusion()).
+static double faceTolerance034b(const TopoDS_Face& theF)
+{
+  double aTol = std::max(BRep_Tool::Tolerance(theF), Precision::Confusion());
+  for (TopExp_Explorer anExp(theF, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    aTol = std::max(aTol, BRep_Tool::Tolerance(TopoDS::Edge(anExp.Current())));
+  }
+  return aTol;
+}
+
+//=======================================================================
+// Issue 034 lane B2, round 2: the vanishing decision is PROVEN.
+//
+// A face vanishes when min(1 - d*k1, 1 - d*k2) <= e at every point (e = 0,
+// or the degenerate allowance tolerance / size, see below). Equivalently
+// the symmetric matrix sigma*I - d*W (W the shape operator, sigma = 1 - e)
+// has a non-positive eigenvalue everywhere, i.e. its trace or its
+// determinant is <= 0 (both eigenvalues are positive iff trace > 0 and
+// det > 0). Multiplied by powers of |N| (N = Su x Sv, l.. = S.. . N,
+// E, F, G the first fundamental form):
+//   C1 = 2 sigma |N|^3 - d J,                     J = E lvv + G luu - 2 F luv,
+//   C2 = sigma^2 |N|^4 - sigma d |N| J + d^2 Q,   Q = luu lvv - luv^2
+// (Maekawa 1999 offset factors; the conditions of the fold trigger of lane
+// R-034g, used here in the opposite direction). A Bezier patch of the face
+// (a knot span of the B-spline; its parameters rescaled to [0, 1]^2, the
+// factors do not depend on the parametrization) is PROVEN vanishing when
+// the upper interval bound of C1 or of C2 over the patch is negative.
+// Bounds: the convex hull of the hodograph nets of the homogeneous net
+// bounds every derivative of the numerator and of the weight; S by the
+// hull of the Cartesian net (positive weights); the derivatives of
+// S = P / w by the Leibniz rule in interval arithmetic (Sederberg-Meyers
+// 1988; Hu-Maekawa-Patrikalakis 1997 interval Bezier arithmetic). The net
+// is moved to the centre of its box first (the derivatives do not change,
+// the Leibniz terms w' S then carry the size of the patch, not its
+// distance to the origin). A patch that is not proven is cut in two across
+// the direction that bends (de Casteljau on the homogeneous net).
+// The face does NOT vanish when the factor is above e at a point of the
+// face (exact evaluation; a patch centre is classified in the face).
+// A face whose patches are neither proven nor refuted within the budget is
+// "not proven": it is kept (the stock flow; the stage A guard reports a
+// broken result) - never dropped on a guess.
+// Degenerate allowance (d = r): e = tolerance / size, the offset of the
+// face then shrinks within the tolerance to a curve (the analytic status
+// Degenerated). No interval bound can prove a factor of exactly 0; a
+// free-form face that is a canonical surface within its tolerance
+// (GeomConvert_SurfToAnaSurf, the recognition OCCT uses for its own
+// conversions) is decided by the analytic rule of BRepOffset::Surface.
+//=======================================================================
+
+//! Closed interval (plain double arithmetic; the proofs require a margin
+//! of 1e-10 relative to the magnitude of the terms, far above the rounding
+//! error of the few dozen operations, about 1e-14).
+struct Itv034b
+{
+  double Lo;
+  double Hi;
+};
+
+inline Itv034b operator+(const Itv034b& theA, const Itv034b& theB)
+{
+  return {theA.Lo + theB.Lo, theA.Hi + theB.Hi};
+}
+
+inline Itv034b operator-(const Itv034b& theA, const Itv034b& theB)
+{
+  return {theA.Lo - theB.Hi, theA.Hi - theB.Lo};
+}
+
+inline Itv034b operator*(const Itv034b& theA, const Itv034b& theB)
+{
+  const double a = theA.Lo * theB.Lo, b = theA.Lo * theB.Hi;
+  const double c = theA.Hi * theB.Lo, e = theA.Hi * theB.Hi;
+  return {std::min(std::min(a, b), std::min(c, e)), std::max(std::max(a, b), std::max(c, e))};
+}
+
+inline Itv034b operator*(const double theS, const Itv034b& theA)
+{
+  return theS >= 0. ? Itv034b{theS * theA.Lo, theS * theA.Hi}
+                    : Itv034b{theS * theA.Hi, theS * theA.Lo};
+}
+
+//! theA / theB for theB.Lo > 0
+inline Itv034b divPos034b(const Itv034b& theA, const Itv034b& theB)
+{
+  return theA * Itv034b{1. / theB.Hi, 1. / theB.Lo};
+}
+
+inline double mag034b(const Itv034b& theA)
+{
+  return std::max(std::abs(theA.Lo), std::abs(theA.Hi));
+}
+
+struct IVec034b
+{
+  Itv034b C[3];
+};
+
+inline Itv034b dot034b(const IVec034b& theA, const IVec034b& theB)
+{
+  return theA.C[0] * theB.C[0] + theA.C[1] * theB.C[1] + theA.C[2] * theB.C[2];
+}
+
+inline IVec034b cross034b(const IVec034b& theA, const IVec034b& theB)
+{
+  return {{theA.C[1] * theB.C[2] - theA.C[2] * theB.C[1],
+           theA.C[2] * theB.C[0] - theA.C[0] * theB.C[2],
+           theA.C[0] * theB.C[1] - theA.C[1] * theB.C[0]}};
+}
+
+inline IVec034b scaled034b(const IVec034b& theX, const Itv034b& theF)
+{
+  return {{theX.C[0] * theF, theX.C[1] * theF, theX.C[2] * theF}};
+}
+
+inline IVec034b minus034b(const IVec034b& theX, const IVec034b& theY)
+{
+  return {{theX.C[0] - theY.C[0], theX.C[1] - theY.C[1], theX.C[2] - theY.C[2]}};
+}
+
+inline IVec034b divPos034b(const IVec034b& theX, const Itv034b& theW)
+{
+  return {{divPos034b(theX.C[0], theW), divPos034b(theX.C[1], theW), divPos034b(theX.C[2], theW)}};
+}
+
+//! Rational Bezier patch: homogeneous net (w x, w y, w z, w) at
+//! ((i * (NV + 1)) + j) * 4, degrees NU x NV, and the rectangle of face
+//! parameters it covers (linear map).
+struct Patch034b
+{
+  int                 NU = 0, NV = 0, Depth = 0;
+  std::vector<double> Net;
+  double              U0 = 0., U1 = 1., V0 = 0., V1 = 1.;
+
+  double* Q(const int i, const int j) { return &Net[((size_t)i * (NV + 1) + j) * 4]; }
+
+  const double* Q(const int i, const int j) const { return &Net[((size_t)i * (NV + 1) + j) * 4]; }
+};
+
+//! Interval hull of the (a, b)-th hodograph net (a, b <= 2) of component c
+//! of the homogeneous net: every value of that derivative over the patch
+//! is a convex combination of these coefficients.
+static Itv034b hodoHull034b(const Patch034b& theP, const int theA, const int theB, const int theC)
+{
+  if (theA > theP.NU || theB > theP.NV)
+  {
+    return {0., 0.};
+  }
+  const double aFa = theA == 0 ? 1. : (theA == 1 ? theP.NU : theP.NU * (theP.NU - 1.));
+  const double aFb = theB == 0 ? 1. : (theB == 1 ? theP.NV : theP.NV * (theP.NV - 1.));
+  static const double THE_W[3][3] = {{1., 0., 0.}, {-1., 1., 0.}, {1., -2., 1.}};
+  Itv034b             aR{RealLast(), -RealLast()};
+  for (int i = 0; i + theA <= theP.NU; ++i)
+  {
+    for (int j = 0; j + theB <= theP.NV; ++j)
+    {
+      double aV = 0.;
+      for (int k = 0; k <= theA; ++k)
+      {
+        for (int l = 0; l <= theB; ++l)
+        {
+          aV += THE_W[theA][k] * THE_W[theB][l] * theP.Q(i + k, j + l)[theC];
+        }
+      }
+      aV *= aFa * aFb;
+      aR.Lo = std::min(aR.Lo, aV);
+      aR.Hi = std::max(aR.Hi, aV);
+    }
+  }
+  return aR;
+}
+
+//! Test of one patch: 1 proven vanishing, 0 not proven, -1 no bound (a
+//! weight or the normal may vanish on the patch).
+static int patchVanishes034b(const Patch034b& thePatch, const double theD, const double theSigma)
+{
+  // The factors do not change under a rotation: the net is expressed in a
+  // frame of the patch (its s and t chords and their normal), where the box
+  // hulls of the derivative nets are far tighter than in world axes (a
+  // rotated fillet is bounded as tightly as an axis-aligned one).
+  Patch034b  theP = thePatch;
+  const int  aJm = theP.NV / 2, aIm = theP.NU / 2;
+  auto       aCart = [&](const int i, const int j) {
+    const double* q = thePatch.Q(i, j);
+    return gp_XYZ(q[0] / q[3], q[1] / q[3], q[2] / q[3]);
+  };
+  const gp_XYZ aA = aCart(theP.NU, aJm) - aCart(0, aJm);
+  const gp_XYZ aB = aCart(aIm, theP.NV) - aCart(aIm, 0);
+  const gp_XYZ aZ = aA.Crossed(aB);
+  if (aA.Modulus() > gp::Resolution() && aZ.Modulus() > gp::Resolution())
+  {
+    const gp_XYZ aE1 = aA / aA.Modulus(), aE3 = aZ / aZ.Modulus();
+    const gp_XYZ aE2 = aE3.Crossed(aE1);
+    for (size_t k = 0; k + 3 < theP.Net.size(); k += 4)
+    {
+      const gp_XYZ aX(theP.Net[k], theP.Net[k + 1], theP.Net[k + 2]);
+      theP.Net[k]     = aX.Dot(aE1);
+      theP.Net[k + 1] = aX.Dot(aE2);
+      theP.Net[k + 2] = aX.Dot(aE3);
+    }
+  }
+  Itv034b  aW{RealLast(), -RealLast()};
+  IVec034b aS;
+  for (int c = 0; c < 3; ++c)
+  {
+    aS.C[c] = {RealLast(), -RealLast()};
+  }
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      const double* q = theP.Q(i, j);
+      if (!(q[3] > 0.))
+      {
+        return -1;
+      }
+      aW.Lo = std::min(aW.Lo, q[3]);
+      aW.Hi = std::max(aW.Hi, q[3]);
+      for (int c = 0; c < 3; ++c)
+      {
+        const double x = q[c] / q[3];
+        aS.C[c].Lo     = std::min(aS.C[c].Lo, x);
+        aS.C[c].Hi     = std::max(aS.C[c].Hi, x);
+      }
+    }
+  }
+  IVec034b aPd[3][3];
+  Itv034b  aWd[3][3];
+  for (int a = 0; a <= 2; ++a)
+  {
+    for (int b = 0; a + b <= 2; ++b)
+    {
+      if (a + b == 0)
+      {
+        continue;
+      }
+      for (int c = 0; c < 3; ++c)
+      {
+        aPd[a][b].C[c] = hodoHull034b(theP, a, b, c);
+      }
+      aWd[a][b] = hodoHull034b(theP, a, b, 3);
+    }
+  }
+  // P = S w (Leibniz):
+  //   S_s  = (P_s - w_s S) / w
+  //   S_ss = (P_ss - 2 w_s S_s - w_ss S) / w
+  //   S_st = (P_st - w_t S_s - w_s S_t - w_st S) / w
+  const IVec034b aSs  = divPos034b(minus034b(aPd[1][0], scaled034b(aS, aWd[1][0])), aW);
+  const IVec034b aSt  = divPos034b(minus034b(aPd[0][1], scaled034b(aS, aWd[0][1])), aW);
+  const IVec034b aSss = divPos034b(
+    minus034b(minus034b(aPd[2][0], scaled034b(aSs, 2. * aWd[1][0])), scaled034b(aS, aWd[2][0])),
+    aW);
+  const IVec034b aStt = divPos034b(
+    minus034b(minus034b(aPd[0][2], scaled034b(aSt, 2. * aWd[0][1])), scaled034b(aS, aWd[0][2])),
+    aW);
+  const IVec034b aSst = divPos034b(
+    minus034b(minus034b(minus034b(aPd[1][1], scaled034b(aSs, aWd[0][1])), scaled034b(aSt, aWd[1][0])),
+              scaled034b(aS, aWd[1][1])),
+    aW);
+  const IVec034b aN  = cross034b(aSs, aSt);
+  const Itv034b  aN2 = dot034b(aN, aN);
+  if (!(aN2.Lo > 0.))
+  {
+    return -1; // the normal may vanish on the patch (a pole): no bound
+  }
+  const Itv034b aNm{std::sqrt(aN2.Lo), std::sqrt(aN2.Hi)};
+  const Itv034b anE = dot034b(aSs, aSs), aF = dot034b(aSs, aSt), aG = dot034b(aSt, aSt);
+  const Itv034b aLuu = dot034b(aSss, aN), aLuv = dot034b(aSst, aN), aLvv = dot034b(aStt, aN);
+  const Itv034b aJ   = anE * aLvv + aG * aLuu - 2. * (aF * aLuv);
+  const Itv034b aQ   = aLuu * aLvv - aLuv * aLuv;
+  const Itv034b aN3  = aN2 * aNm;
+  const Itv034b aN4  = aN2 * aN2;
+  const Itv034b aNJ  = aNm * aJ;
+  const Itv034b aC1  = 2. * theSigma * aN3 - theD * aJ;
+  const Itv034b aC2  = (theSigma * theSigma) * aN4 - (theSigma * theD) * aNJ + (theD * theD) * aQ;
+  const double  aM1  = 1.e-10 * (2. * theSigma * mag034b(aN3) + std::abs(theD) * mag034b(aJ));
+  const double  aM2  = 1.e-10
+                     * (theSigma * theSigma * mag034b(aN4) + std::abs(theSigma * theD) * mag034b(aNJ)
+                        + theD * theD * mag034b(aQ));
+  return (aC1.Hi < -aM1 || aC2.Hi < -aM2) ? 1 : 0;
+}
+
+//! Splits the patch at the middle of s (theU) or t (de Casteljau).
+static void split034b(const Patch034b& theP, const bool theU, Patch034b& theA, Patch034b& theB)
+{
+  theA = theP;
+  theB = theP;
+  ++theA.Depth;
+  ++theB.Depth;
+  const int           aN = theU ? theP.NU : theP.NV, aM = theU ? theP.NV : theP.NU;
+  std::vector<double> aRow((size_t)(aN + 1) * 4);
+  for (int m = 0; m <= aM; ++m)
+  {
+    for (int k = 0; k <= aN; ++k)
+    {
+      const double* q = theU ? theP.Q(k, m) : theP.Q(m, k);
+      std::copy(q, q + 4, &aRow[(size_t)k * 4]);
+    }
+    // after r steps aRow[0] is the r-th point of the first half and
+    // aRow[aN - r] the (aN - r)-th point of the second half
+    for (int r = 0; r <= aN; ++r)
+    {
+      double* qa = theU ? theA.Q(r, m) : theA.Q(m, r);
+      double* qb = theU ? theB.Q(aN - r, m) : theB.Q(m, aN - r);
+      std::copy(&aRow[0], &aRow[0] + 4, qa);
+      std::copy(&aRow[(size_t)(aN - r) * 4], &aRow[(size_t)(aN - r) * 4] + 4, qb);
+      for (int k = 0; k < aN - r; ++k)
+      {
+        for (int c = 0; c < 4; ++c)
+        {
+          aRow[(size_t)k * 4 + c] = 0.5 * (aRow[(size_t)k * 4 + c] + aRow[(size_t)(k + 1) * 4 + c]);
+        }
+      }
+    }
+  }
+  if (theU)
+  {
+    theA.U1 = theB.U0 = 0.5 * (theP.U0 + theP.U1);
+  }
+  else
+  {
+    theA.V1 = theB.V0 = 0.5 * (theP.V0 + theP.V1);
+  }
+}
+
+//! Largest norm of the second differences of the Cartesian net along s
+//! (theU) or t, times the squared degree: where the patch bends (a patch is
+//! never cut along a straight direction).
+static double bend034b(const Patch034b& theP, const bool theU)
+{
+  const int aN = theU ? theP.NU : theP.NV;
+  if (aN < 2)
+  {
+    return 0.;
+  }
+  double aMax = 0.;
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      if ((theU ? i : j) + 2 > aN)
+      {
+        continue;
+      }
+      const double* q0 = theP.Q(i, j);
+      const double* q1 = theU ? theP.Q(i + 1, j) : theP.Q(i, j + 1);
+      const double* q2 = theU ? theP.Q(i + 2, j) : theP.Q(i, j + 2);
+      double        aS = 0.;
+      for (int c = 0; c < 3; ++c)
+      {
+        const double x = q2[c] / q2[3] - 2. * q1[c] / q1[3] + q0[c] / q0[3];
+        aS += x * x;
+      }
+      aMax = std::max(aMax, std::sqrt(aS));
+    }
+  }
+  return aMax * aN * aN;
+}
+
+//! Homogeneous net of a Bezier surface covering [U0,U1]x[V0,V1] of the face
+//! parameters, moved to the centre of its Cartesian box.
+static bool bezierPatch034b(const occ::handle<Geom_BezierSurface>& theBz,
+                            const double                           theU0,
+                            const double                           theU1,
+                            const double                           theV0,
+                            const double                           theV1,
+                            Patch034b&                             theP)
+{
+  if (theBz.IsNull() || theBz->UDegree() > 25 || theBz->VDegree() > 25)
+  {
+    return false;
+  }
+  theP.NU = theBz->UDegree();
+  theP.NV = theBz->VDegree();
+  theP.Net.assign((size_t)(theP.NU + 1) * (theP.NV + 1) * 4, 0.);
+  theP.U0 = theU0;
+  theP.U1 = theU1;
+  theP.V0 = theV0;
+  theP.V1 = theV1;
+  gp_XYZ aMin(RealLast(), RealLast(), RealLast()), aMax(-RealLast(), -RealLast(), -RealLast());
+  for (int i = 1; i <= theP.NU + 1; ++i)
+  {
+    for (int j = 1; j <= theP.NV + 1; ++j)
+    {
+      const gp_XYZ aX = theBz->Pole(i, j).XYZ();
+      for (int c = 1; c <= 3; ++c)
+      {
+        aMin.SetCoord(c, std::min(aMin.Coord(c), aX.Coord(c)));
+        aMax.SetCoord(c, std::max(aMax.Coord(c), aX.Coord(c)));
+      }
+    }
+  }
+  const gp_XYZ aC = 0.5 * (aMin + aMax);
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      const gp_XYZ aX = theBz->Pole(i + 1, j + 1).XYZ() - aC;
+      const double aW = theBz->Weight(i + 1, j + 1);
+      double*      q  = theP.Q(i, j);
+      q[0]            = aW * aX.X();
+      q[1]            = aW * aX.Y();
+      q[2]            = aW * aX.Z();
+      q[3]            = aW;
+    }
+  }
+  return true;
+}
+
+//! Budget of the proof: patches tested per face and depth of the cuts (a
+//! limit that is reached leaves the face "not proven", i.e. kept: a cost
+//! bound, never a decision).
+const int THE_VANISH_BUDGET_034B = 4096;
+const int THE_VANISH_DEPTH_034B  = 24;
+
+//! Proof over the Bezier patches of the face region [U0,U1]x[V0,V1]:
+//! 1 vanishes, 0 does not vanish (a point of the face above theLimit),
+//! -1 not proven.
+static int provenVanish034b(const TopoDS_Face&               theF,
+                            const occ::handle<Geom_Surface>& theS,
+                            const double                     theD,
+                            const double                     theLimit,
+                            const double                     theU0,
+                            const double                     theU1,
+                            const double                     theV0,
+                            const double                     theV1)
+{
+  std::vector<Patch034b>    aStack;
+  occ::handle<Geom_Surface> aS = theS;
+  while (!occ::down_cast<Geom_RectangularTrimmedSurface>(aS).IsNull())
+  {
+    aS = occ::down_cast<Geom_RectangularTrimmedSurface>(aS)->BasisSurface();
+  }
+  if (occ::handle<Geom_BSplineSurface> aBS = occ::down_cast<Geom_BSplineSurface>(aS))
+  {
+    if (aBS->IsUPeriodic() || aBS->IsVPeriodic())
+    {
+      return -1;
+    }
+    double aSU0, aSU1, aSV0, aSV1;
+    aBS->Bounds(aSU0, aSU1, aSV0, aSV1);
+    const double aU0 = std::max(theU0, aSU0), aU1 = std::min(theU1, aSU1);
+    const double aV0 = std::max(theV0, aSV0), aV1 = std::min(theV1, aSV1);
+    if (!(aU1 - aU0 > Precision::PConfusion()) || !(aV1 - aV0 > Precision::PConfusion()))
+    {
+      return -1;
+    }
+    GeomConvert_BSplineSurfaceToBezierSurface aConv(aBS, aU0, aU1, aV0, aV1, Precision::PConfusion());
+    NCollection_Array1<double> aUK(1, aConv.NbUPatches() + 1), aVK(1, aConv.NbVPatches() + 1);
+    aConv.UKnots(aUK);
+    aConv.VKnots(aVK);
+    for (int i = 1; i <= aConv.NbUPatches(); ++i)
+    {
+      for (int j = 1; j <= aConv.NbVPatches(); ++j)
+      {
+        Patch034b aP;
+        if (!bezierPatch034b(aConv.Patch(i, j), aUK(i), aUK(i + 1), aVK(j), aVK(j + 1), aP))
+        {
+          return -1;
+        }
+        aStack.push_back(std::move(aP));
+      }
+    }
+  }
+  else if (occ::handle<Geom_BezierSurface> aBz = occ::down_cast<Geom_BezierSurface>(aS))
+  {
+    const double aU0 = std::max(theU0, 0.), aU1 = std::min(theU1, 1.);
+    const double aV0 = std::max(theV0, 0.), aV1 = std::min(theV1, 1.);
+    if (!(aU1 > aU0) || !(aV1 > aV0))
+    {
+      return -1;
+    }
+    occ::handle<Geom_BezierSurface> aSeg = occ::down_cast<Geom_BezierSurface>(aBz->Copy());
+    aSeg->Segment(aU0, aU1, aV0, aV1);
+    Patch034b aP;
+    if (!bezierPatch034b(aSeg, aU0, aU1, aV0, aV1, aP))
+    {
+      return -1;
+    }
+    aStack.push_back(std::move(aP));
+  }
+  else
+  {
+    return -1; // no exact Bezier form: not proven
+  }
+  std::unique_ptr<IntTools_FClass2d> aCls;
+  int                                aBudget = THE_VANISH_BUDGET_034B;
+  while (!aStack.empty())
+  {
+    Patch034b aP = std::move(aStack.back());
+    aStack.pop_back();
+    if (--aBudget < 0)
+    {
+      return -1;
+    }
+    if (patchVanishes034b(aP, theD, 1. - theLimit) == 1)
+    {
+      continue;
+    }
+    // a point of the face above the limit refutes the face
+    const double aUc = 0.5 * (aP.U0 + aP.U1), aVc = 0.5 * (aP.V0 + aP.V1);
+    double       aFct;
+    if (offsetFactor034(*theS, aUc, aVc, theU1 - theU0, theV1 - theV0, theD, aFct) && aFct > theLimit)
+    {
+      if (!aCls)
+      {
+        aCls.reset(new IntTools_FClass2d(theF, Precision::PConfusion()));
+      }
+      if (aCls->Perform(gp_Pnt2d(aUc, aVc)) == TopAbs_IN)
+      {
+        return 0;
+      }
+    }
+    if (aP.Depth >= THE_VANISH_DEPTH_034B)
+    {
+      return -1;
+    }
+    const double aBu = bend034b(aP, true), aBv = bend034b(aP, false);
+    const bool   isU = aP.NU > 0 && (aBu >= aBv || aP.NV == 0);
+    Patch034b    aA, aB;
+    split034b(aP, isU, aA, aB);
+    aStack.push_back(std::move(aA));
+    aStack.push_back(std::move(aB));
+  }
+  return 1;
+}
+
+//! Canonical twin of a free-form face, decided by the analytic rule:
+//! 1 vanishes (status Reversed / Degenerated), 0 does not, -1 not canonical.
+static int canonicalVanish034b(const occ::handle<Geom_Surface>& theS,
+                               const double                     theD,
+                               const double                     theTol,
+                               const double                     theU0,
+                               const double                     theU1,
+                               const double                     theV0,
+                               const double                     theV1)
+{
+  // the face bounds (from its pcurves) clamped to the surface bounds: the
+  // recognition refuses a range that exceeds them by a rounding error
+  double aSU0, aSU1, aSV0, aSV1;
+  theS->Bounds(aSU0, aSU1, aSV0, aSV1);
+  const double aU0 = theS->IsUPeriodic() ? theU0 : std::max(theU0, aSU0);
+  const double aU1 = theS->IsUPeriodic() ? theU1 : std::min(theU1, aSU1);
+  const double aV0 = theS->IsVPeriodic() ? theV0 : std::max(theV0, aSV0);
+  const double aV1 = theS->IsVPeriodic() ? theV1 : std::min(theV1, aSV1);
+  if (!(aU1 > aU0) || !(aV1 > aV0))
+  {
+    return -1;
+  }
+  GeomConvert_SurfToAnaSurf       aConv(theS);
+  const occ::handle<Geom_Surface> anA = aConv.ConvertToAnalytical(theTol, aU0, aU1, aV0, aV1);
+  if (anA.IsNull() || aConv.Gap() > theTol)
+  {
+    return -1;
+  }
+  const GeomAdaptor_Surface anAd(anA);
+  if (anAd.GetType() == GeomAbs_Plane)
+  {
+    return 0;
+  }
+  if (anAd.GetType() != GeomAbs_Cylinder && anAd.GetType() != GeomAbs_Sphere
+      && anAd.GetType() != GeomAbs_Torus)
+  {
+    return -1;
+  }
+  // orientation of the twin: the natural normals at the middle of the face
+  gp_Pnt aP;
+  gp_Vec aDu, aDv;
+  theS->D1(0.5 * (aU0 + aU1), 0.5 * (aV0 + aV1), aP, aDu, aDv);
+  const gp_Vec               aNs = aDu.Crossed(aDv);
+  GeomAPI_ProjectPointOnSurf aProj(aP, anA);
+  if (!aProj.IsDone() || aProj.NbPoints() == 0 || aNs.Magnitude() <= gp::Resolution())
+  {
+    return -1;
+  }
+  double aU, aV;
+  aProj.LowerDistanceParameters(aU, aV);
+  gp_Pnt aPa;
+  gp_Vec aDua, aDva;
+  anA->D1(aU, aV, aPa, aDua, aDva);
+  const gp_Vec aNa = aDua.Crossed(aDva);
+  if (aNa.Magnitude() <= gp::Resolution())
+  {
+    return -1;
+  }
+  BRepOffset_Status aStatus = BRepOffset_Good;
+  BRepOffset::Surface(anA, aNs.Dot(aNa) > 0. ? theD : -theD, aStatus);
+  return (aStatus == BRepOffset_Reversed || aStatus == BRepOffset_Degenerated) ? 1 : 0;
+}
+
+//! True if the offset of the free-form face vanishes (PROVEN, see above):
+//! the smallest principal offset factor is <= 0 at every point of the face,
+//! or at most tolerance / size (the offset shrinks within the tolerance to a
+//! curve or a point, as an analytic face with the status Degenerated). A
+//! face that does not vanish is refuted by one evaluation at a point of its
+//! boundary or at its middle (the usual case); a canonical free-form face
+//! follows the analytic rule; the others are proven per Bezier patch, and a
+//! face that is not proven is kept. Planes never vanish; analytic cylinders,
+//! spheres, tori and cones are decided by BRepOffset::Surface (status
+//! Reversed / Degenerated).
+static bool freeFormFaceVanishes034b(const TopoDS_Face& theF, const double theOffset)
+{
+  try
+  {
+    OCC_CATCH_SIGNALS
+    TopLoc_Location                  aLoc;
+    const occ::handle<Geom_Surface>& aS = BRep_Tool::Surface(theF, aLoc);
+    if (aS.IsNull() || std::abs(theOffset) <= Precision::Confusion())
+    {
+      return false;
+    }
+    const GeomAdaptor_Surface aGAS(aS);
+    switch (aGAS.GetType())
+    {
+      case GeomAbs_Plane:
+      case GeomAbs_Cylinder:
+      case GeomAbs_Cone:
+      case GeomAbs_Sphere:
+      case GeomAbs_Torus:
+        return false;
+      default:
+        break;
+    }
+    const double aD = (theF.Orientation() == TopAbs_REVERSED) ? -theOffset : theOffset;
+    // largest factor that still counts as vanishing: 0, or tolerance / size
+    // once a positive factor has been seen (the box is computed only then)
+    double aLimit    = 0.;
+    bool   isLimited = false;
+    auto   isAbove   = [&](const double theFct) {
+      if (theFct <= aLimit)
+      {
+        return false;
+      }
+      if (!isLimited)
+      {
+        isLimited = true;
+        // the chord between two vertices is at most the size of the face, so
+        // tolerance / chord bounds the limit from above: a factor over it is
+        // decided without the bounding box (the usual case, one evaluation)
+        const double aTolF   = faceTolerance034b(theF);
+        double       aChord2 = 0.;
+        gp_Pnt       aP0;
+        bool         isFirst = true;
+        for (TopExp_Explorer anExpV(theF, TopAbs_VERTEX); anExpV.More(); anExpV.Next())
+        {
+          const gp_Pnt aP = BRep_Tool::Pnt(TopoDS::Vertex(anExpV.Current()));
+          if (isFirst)
+          {
+            aP0     = aP;
+            isFirst = false;
+          }
+          aChord2 = std::max(aChord2, aP0.SquareDistance(aP));
+        }
+        if (aChord2 > 0. && theFct > aTolF / std::sqrt(aChord2))
+        {
+          aLimit = aTolF / std::sqrt(aChord2);
+          return true;
+        }
+        Bnd_Box aBox;
+        BRepBndLib::Add(theF, aBox, false);
+        if (!aBox.IsVoid() && aBox.SquareExtent() > 0.)
+        {
+          aLimit = faceTolerance034b(theF) / std::sqrt(aBox.SquareExtent());
+        }
+      }
+      return theFct > aLimit;
+    };
+    // a point of the face boundary first (the middle of the first edge's
+    // pcurve; the face vanishes only if the factor is negative on its
+    // closure too): a face that does not vanish is rejected with one
+    // evaluation, before the parametric box of the face is computed
+    for (TopExp_Explorer anExpE(theF, TopAbs_EDGE); anExpE.More(); anExpE.Next())
+    {
+      double                          aF, aL;
+      const occ::handle<Geom2d_Curve> aC2d =
+        BRep_Tool::CurveOnSurface(TopoDS::Edge(anExpE.Current()), theF, aF, aL);
+      if (aC2d.IsNull() || Precision::IsInfinite(aF) || Precision::IsInfinite(aL))
+      {
+        continue;
+      }
+      const gp_Pnt2d aUV = aC2d->Value(0.5 * (aF + aL));
+      double         aFct0;
+      if (offsetFactor034(*aS, aUV.X(), aUV.Y(), 1., 1., aD, aFct0) && isAbove(aFct0))
+      {
+        return false;
+      }
+      break;
+    }
+    double aU0, aU1, aV0, aV1;
+    BRepTools::UVBounds(theF, aU0, aU1, aV0, aV1);
+    if (!(aU1 > aU0) || !(aV1 > aV0))
+    {
+      return false;
+    }
+    // the middle next: a face that does not vanish is rejected at once
+    double aFct;
+    if (offsetFactor034(*aS, 0.5 * (aU0 + aU1), 0.5 * (aV0 + aV1), aU1 - aU0, aV1 - aV0, aD, aFct)
+        && isAbove(aFct))
+    {
+      return false;
+    }
+    // the degenerate allowance: tolerance / size of the face
+    const double aTolF = faceTolerance034b(theF);
+    Bnd_Box      aBox;
+    BRepBndLib::Add(theF, aBox, false);
+    const double aProofLimit =
+      (!aBox.IsVoid() && aBox.SquareExtent() > 0.) ? aTolF / std::sqrt(aBox.SquareExtent()) : 0.;
+    // a canonical surface within the tolerance: the analytic rule
+    const int aCanon = canonicalVanish034b(aS, aD, aTolF, aU0, aU1, aV0, aV1);
+    if (aCanon >= 0)
+    {
+      return aCanon == 1;
+    }
+    // otherwise proven per Bezier patch (not proven: kept)
+    return provenVanish034b(theF, aS, aD, aProofLimit, aU0, aU1, aV0, aV1) == 1;
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+}
+
+//! Surface extended by theLen (3D chord length) beyond every non-periodic
+//! boundary, for bounded B-spline / Bezier surfaces and offsets of them; null
+//! for other surfaces (unbounded or not extendable).
+static occ::handle<Geom_Surface> extendedSurface034b(const occ::handle<Geom_Surface>& theS,
+                                                     const double                     theLen)
+{
+  occ::handle<Geom_OffsetSurface> anOff = occ::down_cast<Geom_OffsetSurface>(theS);
+  if (!anOff.IsNull())
+  {
+    const occ::handle<Geom_Surface> aB = extendedSurface034b(anOff->BasisSurface(), theLen);
+    return aB.IsNull() ? occ::handle<Geom_Surface>()
+                       : occ::handle<Geom_Surface>(new Geom_OffsetSurface(aB, anOff->Offset(), true));
+  }
+  // polynomial B-spline / Bezier only: GeomLib::ExtendSurfByLength keeps
+  // their parametrisation on the original domain (checked); for rational
+  // surfaces it is not guaranteed, they are not extended
+  occ::handle<Geom_BoundedSurface> aBS;
+  occ::handle<Geom_BSplineSurface> aBSpl = occ::down_cast<Geom_BSplineSurface>(theS);
+  occ::handle<Geom_BezierSurface>  aBez  = occ::down_cast<Geom_BezierSurface>(theS);
+  if ((!aBSpl.IsNull() && !aBSpl->IsURational() && !aBSpl->IsVRational())
+      || (!aBez.IsNull() && !aBez->IsURational() && !aBez->IsVRational()))
+  {
+    aBS = occ::down_cast<Geom_BoundedSurface>(theS->Copy());
+  }
+  if (aBS.IsNull())
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  for (int aDir = 0; aDir < 2; ++aDir)
+  {
+    const bool isU = aDir == 0;
+    if (isU ? aBS->IsUPeriodic() : aBS->IsVPeriodic())
+    {
+      continue;
+    }
+    GeomLib::ExtendSurfByLength(aBS, theLen, 1, isU, false);
+    GeomLib::ExtendSurfByLength(aBS, theLen, 1, isU, true);
+  }
+  return aBS;
+}
+
+//! Surface of the face extended in place (same parametrisation on the
+//! original domain, checked for GeomLib::ExtendSurfByLength) by theLen
+//! beyond its bounds when it is a bounded B-spline / Bezier surface or an
+//! offset of one and the face reaches a bound; the pcurves of the face edges
+//! are registered again on the new surface. The rim offsets of a vanishing
+//! set may have to reach beyond the offset face (a removed face of a thick
+//! solid across the set, or an intersection on the boundary itself).
+static void extendFaceSurface034b(const TopoDS_Face& theF, const double theLen)
+{
+  TopLoc_Location                 aLoc;
+  const occ::handle<Geom_Surface> aS = BRep_Tool::Surface(theF, aLoc);
+  double                          aU0, aU1, aV0, aV1, aSU0, aSU1, aSV0, aSV1;
+  BRepTools::UVBounds(theF, aU0, aU1, aV0, aV1);
+  aS->Bounds(aSU0, aSU1, aSV0, aSV1);
+  const double aPTol = Precision::PConfusion();
+  const bool   isEndU =
+    !aS->IsUPeriodic() && !Precision::IsInfinite(aSU0) && !Precision::IsInfinite(aSU1)
+    && (aU0 - aSU0 < aPTol || aSU1 - aU1 < aPTol);
+  const bool isEndV =
+    !aS->IsVPeriodic() && !Precision::IsInfinite(aSV0) && !Precision::IsInfinite(aSV1)
+    && (aV0 - aSV0 < aPTol || aSV1 - aV1 < aPTol);
+  if (!isEndU && !isEndV)
+  {
+    return;
+  }
+  const occ::handle<Geom_Surface> anExt = extendedSurface034b(aS, theLen);
+  if (anExt.IsNull())
+  {
+    return;
+  }
+  // pcurves of the edges on the old surface (one or two for a closed edge)
+  TopoDS_Face aFF = theF;
+  aFF.Orientation(TopAbs_FORWARD);
+  NCollection_List<TopoDS_Shape>              anEdges;
+  NCollection_List<occ::handle<Geom2d_Curve>> aC1s, aC2s;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aDone;
+  for (TopExp_Explorer anExp(aFF, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+    if (!aDone.Add(anE))
+    {
+      continue;
+    }
+    double                    aF, aL;
+    occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(anE, aFF, aF, aL), aC2;
+    if (BRep_Tool::IsClosed(anE, aFF))
+    {
+      aC2 = BRep_Tool::CurveOnSurface(TopoDS::Edge(anE.Reversed()), aFF, aF, aL);
+    }
+    anEdges.Append(anE.Oriented(TopAbs_FORWARD));
+    aC1s.Append(aC1);
+    aC2s.Append(aC2);
+  }
+  BRep_Builder aBB;
+  aBB.UpdateFace(theF, anExt, aLoc, BRep_Tool::Tolerance(theF));
+  NCollection_List<occ::handle<Geom2d_Curve>>::Iterator anIt1(aC1s), anIt2(aC2s);
+  for (NCollection_List<TopoDS_Shape>::Iterator anItE(anEdges); anItE.More();
+       anItE.Next(), anIt1.Next(), anIt2.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anItE.Value());
+    if (anIt1.Value().IsNull())
+    {
+      continue;
+    }
+    if (anIt2.Value().IsNull())
+    {
+      aBB.UpdateEdge(anE, anIt1.Value(), aFF, BRep_Tool::Tolerance(anE));
+    }
+    else
+    {
+      // the order of a closed edge's pcurves follows the edge orientation
+      TopoDS_Edge anEF = anE;
+      anEF.Orientation(TopAbs_FORWARD);
+      aBB.UpdateEdge(anEF, anIt1.Value(), anIt2.Value(), aFF, BRep_Tool::Tolerance(anE));
+    }
+  }
+}
+
+//! Copy of the face enlarged by ten times the largest tolerance of the face
+//! plus theExtra (orientation kept, same surface and location, so the
+//! pcurves computed on the copy belong to the face). The intersection of two
+//! rim faces can lie exactly on their boundaries (offset equal to the radius
+//! of the vanishing blend); on the enlarged copies it lies inside, away from
+//! the boundary edges.
+static TopoDS_Face enlargedCopy034b(const TopoDS_Face& theF, const double theExtra)
+{
+  TopLoc_Location           aLoc;
+  occ::handle<Geom_Surface> aS = BRep_Tool::Surface(theF, aLoc);
+  double                    aU0, aU1, aV0, aV1, aSU0, aSU1, aSV0, aSV1;
+  BRepTools::UVBounds(theF, aU0, aU1, aV0, aV1);
+  const double aMargin = 10. * faceTolerance034b(theF) + theExtra;
+  aS->Bounds(aSU0, aSU1, aSV0, aSV1);
+  const double aPTol = Precision::PConfusion();
+  // parametric steps for the 3D margin (largest over 9 points)
+  double aDU = 0., aDV = 0.;
+  for (int i = 0; i <= 2; ++i)
+  {
+    for (int j = 0; j <= 2; ++j)
+    {
+      gp_Pnt aP;
+      gp_Vec aSu, aSv;
+      aS->D1(aU0 + (aU1 - aU0) * i / 2., aV0 + (aV1 - aV0) * j / 2., aP, aSu, aSv);
+      const double aMu = aSu.Magnitude(), aMv = aSv.Magnitude();
+      if (aMu > gp::Resolution())
+      {
+        aDU = std::max(aDU, aMargin / aMu);
+      }
+      if (aMv > gp::Resolution())
+      {
+        aDV = std::max(aDV, aMargin / aMv);
+      }
+    }
+  }
+  if (!(aS->IsUPeriodic() && aU1 - aU0 >= aS->UPeriod() - aPTol))
+  {
+    aU0 = aS->IsUPeriodic() ? aU0 - aDU : std::max(aU0 - aDU, aSU0);
+    aU1 = aS->IsUPeriodic() ? aU1 + aDU : std::min(aU1 + aDU, aSU1);
+  }
+  if (!(aS->IsVPeriodic() && aV1 - aV0 >= aS->VPeriod() - aPTol))
+  {
+    aV0 = aS->IsVPeriodic() ? aV0 - aDV : std::max(aV0 - aDV, aSV0);
+    aV1 = aS->IsVPeriodic() ? aV1 + aDV : std::min(aV1 + aDV, aSV1);
+  }
+  BRepLib_MakeFace aMF(aS, aU0, aU1, aV0, aV1, Precision::Confusion());
+  if (!aMF.IsDone())
+  {
+    return theF;
+  }
+  TopoDS_Face aNF = aMF.Face();
+  aNF.Location(aLoc);
+  aNF.Orientation(theF.Orientation());
+  return aNF;
+}
+
+
+//! Copy of the section edge theNE (a rim offset face on a removed face)
+//! prolonged along its curve by the arc length theLen at its first and/or last
+//! end; the other end keeps its vertex (it is shared with the section of the
+//! face that does not vanish there: a tube, a surviving blend, another removed
+//! face). The prolongation stays inside the parameter bounds of the 3D curve
+//! and of the pcurves. Null if no end can be prolonged.
+static TopoDS_Edge prolongedSection034b(const TopoDS_Edge& theNE,
+                                        const bool         theAtFirst,
+                                        const bool         theAtLast,
+                                        const double       theLen)
+{
+  TopoDS_Edge aNE = theNE;
+  aNE.Orientation(TopAbs_FORWARD);
+  TopLoc_Location               aLoc;
+  double                        aF, aL;
+  occ::handle<Geom_Curve>       aC  = BRep_Tool::Curve(aNE, aLoc, aF, aL);
+  const occ::handle<BRep_TEdge> aTE = occ::down_cast<BRep_TEdge>(aNE.TShape());
+  if (aC.IsNull() || aTE.IsNull() || !(aL > aF) || !(theLen > 0.))
+  {
+    return TopoDS_Edge();
+  }
+  // trimmed curves are replaced by their basis curves (same parameters)
+  const bool isTrimmed3d = !occ::down_cast<Geom_TrimmedCurve>(aC).IsNull();
+  for (occ::handle<Geom_TrimmedCurve> aTC = occ::down_cast<Geom_TrimmedCurve>(aC); !aTC.IsNull();
+       aTC                                = occ::down_cast<Geom_TrimmedCurve>(aC))
+  {
+    aC = aTC->BasisCurve();
+  }
+  auto aBasis2d = [](occ::handle<Geom2d_Curve> theC) {
+    for (occ::handle<Geom2d_TrimmedCurve> aTC = occ::down_cast<Geom2d_TrimmedCurve>(theC);
+         !aTC.IsNull();
+         aTC = occ::down_cast<Geom2d_TrimmedCurve>(theC))
+    {
+      theC = aTC->BasisCurve();
+    }
+    return theC;
+  };
+  // common parameter domain of the 3D curve and of the pcurves
+  double aBF = aC->FirstParameter(), aBL = aC->LastParameter();
+  for (const occ::handle<BRep_CurveRepresentation>& aCR : aTE->Curves())
+  {
+    if (aCR->IsCurveOnSurface())
+    {
+      const occ::handle<Geom2d_Curve> aPC = aBasis2d(aCR->PCurve());
+      if (!aPC.IsNull())
+      {
+        aBF = std::max(aBF, aPC->FirstParameter());
+        aBL = std::min(aBL, aPC->LastParameter());
+      }
+      if (aCR->IsCurveOnClosedSurface())
+      {
+        const occ::handle<Geom2d_Curve> aPC2 = aBasis2d(aCR->PCurve2());
+        if (!aPC2.IsNull())
+        {
+          aBF = std::max(aBF, aPC2->FirstParameter());
+          aBL = std::min(aBL, aPC2->LastParameter());
+        }
+      }
+    }
+  }
+  // a closed (periodic) curve is prolonged by at most a quarter of the rest
+  // of its period at each end: the two ends never meet
+  if (aC->IsPeriodic())
+  {
+    const double aRest = aC->Period() - (aL - aF);
+    if (!(aRest > Precision::PConfusion()))
+    {
+      return TopoDS_Edge();
+    }
+    aBF = std::max(aBF, aF - 0.25 * aRest);
+    aBL = std::min(aBL, aL + 0.25 * aRest);
+  }
+  // parameter at the arc length theLen from the end (at most the bound)
+  const GeomAdaptor_Curve aGC(aC);
+  auto                    aReach = [&](const double theEnd, const double theBound) {
+    if (std::abs(theBound - theEnd) <= Precision::PConfusion())
+    {
+      return theEnd;
+    }
+    try
+    {
+      OCC_CATCH_SIGNALS
+      GCPnts_AbscissaPoint anAP(aGC, theBound > theEnd ? theLen : -theLen, theEnd);
+      if (anAP.IsDone())
+      {
+        const double aP = anAP.Parameter();
+        return theBound > theEnd ? std::min(std::max(aP, theEnd), theBound)
+                                 : std::max(std::min(aP, theEnd), theBound);
+      }
+    }
+    catch (Standard_Failure const&)
+    {
+    }
+    return theEnd;
+  };
+  const double aNF = theAtFirst ? aReach(aF, aBF) : aF;
+  const double aNL = theAtLast ? aReach(aL, aBL) : aL;
+  if (!(aNF < aF) && !(aNL > aL))
+  {
+    return TopoDS_Edge();
+  }
+  TopoDS_Vertex aV1, aV2;
+  TopExp::Vertices(aNE, aV1, aV2);
+  const double aTolE = BRep_Tool::Tolerance(aNE);
+  if (aNF < aF)
+  {
+    aV1 = BRepLib_MakeVertex(aC->Value(aNF).Transformed(aLoc.Transformation()));
+  }
+  if (aNL > aL)
+  {
+    aV2 = BRepLib_MakeVertex(aC->Value(aNL).Transformed(aLoc.Transformation()));
+  }
+  TopoDS_Edge aNew = TopoDS::Edge(aNE.EmptyCopied());
+  aNew.Orientation(TopAbs_FORWARD);
+  BRep_Builder aBB;
+  if (isTrimmed3d)
+  {
+    aBB.UpdateEdge(aNew, aC, aLoc, aTolE);
+  }
+  for (const occ::handle<BRep_CurveRepresentation>& aCR : aTE->Curves())
+  {
+    if (!aCR->IsCurveOnSurface())
+    {
+      continue;
+    }
+    const occ::handle<Geom2d_Curve> aPC = aBasis2d(aCR->PCurve());
+    if (aCR->IsCurveOnClosedSurface())
+    {
+      const occ::handle<Geom2d_Curve> aPC2 = aBasis2d(aCR->PCurve2());
+      if (aPC != aCR->PCurve() || aPC2 != aCR->PCurve2())
+      {
+        aBB.UpdateEdge(aNew, aPC, aPC2, aCR->Surface(), aCR->Location(), aTolE);
+      }
+    }
+    else if (aPC != aCR->PCurve())
+    {
+      aBB.UpdateEdge(aNew, aPC, aCR->Surface(), aCR->Location(), aTolE);
+    }
+  }
+  aBB.Range(aNew, aNF, aNL);
+  aBB.Add(aNew, aV1.Oriented(TopAbs_FORWARD));
+  aBB.Add(aNew, aV2.Oriented(TopAbs_REVERSED));
+  aBB.UpdateVertex(aV1, aNF, aNew, std::max(aTolE, BRep_Tool::Tolerance(aV1)));
+  aBB.UpdateVertex(aV2, aNL, aNew, std::max(aTolE, BRep_Tool::Tolerance(aV2)));
+  aNew.Orientation(theNE.Orientation());
+  return aNew;
+}
+
+//! Vanishing faces of the current offset and the face pairs to intersect.
+struct RimPair034b
+{
+  TopoDS_Shape A;              //!< initial face (a removed face if IsCapA)
+  TopoDS_Shape B;              //!< initial face
+  bool         IsCapA = false; //!< A is a removed face of a thick solid (not offset)
+  double       Margin = 0.;    //!< enlargement of the copies beyond the tolerance margin
+};
+
+struct VanishRecord034b
+{
+  const void*                                            Owner = nullptr;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> Faces;    //!< initial faces
+  NCollection_List<RimPair034b>                          RimPairs; //!< faces to intersect
+  //! rim faces of sets that reach a removed face -> how far their offsets
+  //! reach across the set (size of the set + |offset|)
+  NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher> RimMargin;
+  //! vertices of the vanishing faces
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> SetVertices;
+};
+
+//! The record of the MakeOffsetShape() running on this thread (nesting-safe).
+thread_local VanishRecord034b* THE_VANISH_034B = nullptr;
+
+//! Sets the record for the duration of one MakeOffsetShape().
+class VanishScope034b
+{
+public:
+  VanishScope034b(VanishRecord034b* theRec)
+      : myPrev(THE_VANISH_034B)
+  {
+    THE_VANISH_034B = theRec;
+  }
+
+  ~VanishScope034b() { THE_VANISH_034B = myPrev; }
+
+private:
+  VanishRecord034b* myPrev;
+};
+} // namespace
+
+//! Issue 034 lane B2, for BRepOffset_Inter3d (internal, not exported): true
+//! while the MakeOffsetShape() running on this thread builds its offset
+//! around vanishing faces (the stock flow is unchanged otherwise).
+bool BRepOffset_VanishActive034b()
+{
+  return THE_VANISH_034B != nullptr && !THE_VANISH_034B->Faces.IsEmpty();
+}
+
+//! Issue 034 lane B2 (internal, also used by BRepOffset_Inter3d): true if the
+//! removed face theCap and the initial face theF are a rim pair of the running
+//! offset (theF is a rim face next to a vanishing set that reaches theCap):
+//! their intersection is computed on enlarged copies in Intersection3D(), not
+//! from the offset edges of theF on theCap, which end where the set was.
+bool BRepOffset_RimCap034b(const TopoDS_Shape& theCap, const TopoDS_Shape& theF)
+{
+  if (!BRepOffset_VanishActive034b())
+  {
+    return false;
+  }
+  for (NCollection_List<RimPair034b>::Iterator anIt(THE_VANISH_034B->RimPairs); anIt.More();
+       anIt.Next())
+  {
+    if (anIt.Value().IsCapA && anIt.Value().A.IsSame(theCap) && anIt.Value().B.IsSame(theF))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//! Issue 034 lane B2 (internal, used by BRepOffset_Inter3d::ConnexIntByArc):
+//! the sections theLInt1 / theLInt2 of the offsets of the two faces of the
+//! sharp edge theE are prolonged at the ends that lie at a vertex of a
+//! vanishing set when one of the faces is a rim face of a set that reaches a
+//! removed face: the two rim offsets meet that removed face (which is not
+//! offset) across the set, beyond the stock end of their section. The other
+//! ends are kept.
+void BRepOffset_ProlongRimSections034b(const TopoDS_Shape&             theE,
+                                       const TopoDS_Shape&             theF1,
+                                       const TopoDS_Shape&             theF2,
+                                       NCollection_List<TopoDS_Shape>& theLInt1,
+                                       NCollection_List<TopoDS_Shape>& theLInt2)
+{
+  if (!BRepOffset_VanishActive034b() || theLInt1.IsEmpty())
+  {
+    return;
+  }
+  const double* aM1   = THE_VANISH_034B->RimMargin.Seek(theF1);
+  const double* aM2   = THE_VANISH_034B->RimMargin.Seek(theF2);
+  const double  aReach = std::max(aM1 ? *aM1 : 0., aM2 ? *aM2 : 0.);
+  TopoDS_Vertex aVa, aVb;
+  TopExp::Vertices(TopoDS::Edge(theE), aVa, aVb);
+  const bool isA = THE_VANISH_034B->SetVertices.Contains(aVa);
+  const bool isB = THE_VANISH_034B->SetVertices.Contains(aVb);
+  if (!(aReach > 0.) || (!isA && !isB) || aVa.IsNull() || aVb.IsNull())
+  {
+    return;
+  }
+  const gp_Pnt aPa = BRep_Tool::Pnt(aVa), aPb = BRep_Tool::Pnt(aVb);
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aNew;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theLInt1); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& aSE = TopoDS::Edge(anIt.Value());
+    TopoDS_Vertex      aN1, aN2;
+    TopExp::Vertices(TopoDS::Edge(aSE.Oriented(TopAbs_FORWARD)), aN1, aN2);
+    if (aN1.IsNull() || aN2.IsNull() || aNew.IsBound(aSE))
+    {
+      continue;
+    }
+    const gp_Pnt aP1 = BRep_Tool::Pnt(aN1), aP2 = BRep_Tool::Pnt(aN2);
+    const bool   isSwap =
+      aP1.Distance(aPb) + aP2.Distance(aPa) < aP1.Distance(aPa) + aP2.Distance(aPb);
+    const TopoDS_Edge aProl = prolongedSection034b(aSE,
+                                                   isSwap ? isB : isA,
+                                                   isSwap ? isA : isB,
+                                                   aReach + 10. * BRep_Tool::Tolerance(aSE));
+    if (!aProl.IsNull())
+    {
+      aNew.Bind(aSE, aProl);
+    }
+  }
+  if (aNew.IsEmpty())
+  {
+    return;
+  }
+  for (NCollection_List<TopoDS_Shape>* aL : {&theLInt1, &theLInt2})
+  {
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(*aL); anIt.More(); anIt.Next())
+    {
+      if (const TopoDS_Shape* aP = aNew.Seek(anIt.Value()))
+      {
+        // the prolonged copy has the parametrisation of the old edge
+        anIt.ChangeValue() = aP->Oriented(anIt.Value().Orientation());
+      }
+    }
+  }
+}
