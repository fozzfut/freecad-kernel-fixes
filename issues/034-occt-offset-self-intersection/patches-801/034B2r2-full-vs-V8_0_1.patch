+//! True if the two solids coincide: same volume and same bounding box.
+static bool sameSolid034(const TopoDS_Shape& theA, const TopoDS_Shape& theB)
+{
+  GProp_GProps aPA, aPB;
+  BRepGProp::VolumeProperties(theA, aPA);
+  BRepGProp::VolumeProperties(theB, aPB);
+  const double aVA = std::abs(aPA.Mass()), aVB = std::abs(aPB.Mass());
+  if (std::abs(aVA - aVB) > 1.e-7 * std::max(aVA, aVB))
+  {
+    return false;
+  }
+  Bnd_Box aBA, aBB;
+  BRepBndLib::Add(theA, aBA, false);
+  BRepBndLib::Add(theB, aBB, false);
+  if (aBA.IsVoid() || aBB.IsVoid())
+  {
+    return false;
+  }
+  const double aTol = 1.e-6 * std::sqrt(aBA.SquareExtent()) + Precision::Confusion();
+  return aBA.CornerMin().Distance(aBB.CornerMin()) <= aTol
+         && aBA.CornerMax().Distance(aBB.CornerMax()) <= aTol;
+}
