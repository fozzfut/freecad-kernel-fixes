+  // recognition refuses a range that exceeds them by a rounding error
+  double aSU0, aSU1, aSV0, aSV1;
+  theS->Bounds(aSU0, aSU1, aSV0, aSV1);
+  const double aU0 = theS->IsUPeriodic() ? theU0 : std::max(theU0, aSU0);
+  const double aU1 = theS->IsUPeriodic() ? theU1 : std::min(theU1, aSU1);
+  const double aV0 = theS->IsVPeriodic() ? theV0 : std::max(theV0, aSV0);
+  const double aV1 = theS->IsVPeriodic() ? theV1 : std::min(theV1, aSV1);
+  if (!(aU1 > aU0) || !(aV1 > aV0))
