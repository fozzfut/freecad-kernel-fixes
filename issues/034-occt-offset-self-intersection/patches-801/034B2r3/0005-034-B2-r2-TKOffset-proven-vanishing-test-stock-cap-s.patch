+  gp_Pnt aP;
+  gp_Vec aDu, aDv;
+  theS->D1(0.5 * (aU0 + aU1), 0.5 * (aV0 + aV1), aP, aDu, aDv);
+  const gp_Vec               aNs = aDu.Crossed(aDv);
+  GeomAPI_ProjectPointOnSurf aProj(aP, anA);
+  if (!aProj.IsDone() || aProj.NbPoints() == 0 || aNs.Magnitude() <= gp::Resolution())
+  {
+    return -1;
+  }
+  double aU, aV;
+  aProj.LowerDistanceParameters(aU, aV);
+  gp_Pnt aPa;
+  gp_Vec aDua, aDva;
+  anA->D1(aU, aV, aPa, aDua, aDva);
+  const gp_Vec aNa = aDua.Crossed(aDva);
+  if (aNa.Magnitude() <= gp::Resolution())
+  {
+    return -1;
+  }
+  BRepOffset_Status aStatus = BRepOffset_Good;
+  BRepOffset::Surface(anA, aNs.Dot(aNa) > 0. ? theD : -theD, aStatus);
+  return (aStatus == BRepOffset_Reversed || aStatus == BRepOffset_Degenerated) ? 1 : 0;
+}
