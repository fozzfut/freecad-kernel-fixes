+//! Canonical twin of a free-form face, decided by the analytic rule:
+//! 1 vanishes (status Reversed / Degenerated), 0 does not, -1 not canonical.
+static int canonicalVanish034b(const occ::handle<Geom_Surface>& theS,
+                               const double                     theD,
+                               const double                     theTol,
+                               const double                     theU0,
+                               const double                     theU1,
+                               const double                     theV0,
+                               const double                     theV1)
+{
