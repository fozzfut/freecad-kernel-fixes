-//! True if the offset of the free-form face vanishes: the smallest principal
-//! offset factor is negative at every point of the face, or at most
-//! tolerance / size (the offset shrinks below the tolerance to a curve or a
-//! point, as an analytic face with the status Degenerated). Sampled grid over
-//! the UV box restricted to the face (4 samples per knot span of a B-spline,
-//! 16 to 64 steps), then a local ascent from the largest sample. Stops at the
-//! first sample that proves the face does not vanish (the usual case costs one
-//! evaluation). Planes never vanish; analytic cylinders, spheres, tori and
-//! cones are decided by BRepOffset::Surface (status Reversed / Degenerated).
+//=======================================================================
+// Issue 034 lane B2, round 2: the vanishing decision is PROVEN.
+//
+// A face vanishes when min(1 - d*k1, 1 - d*k2) <= e at every point (e = 0,
+// or the degenerate allowance tolerance / size, see below). Equivalently
+// the symmetric matrix sigma*I - d*W (W the shape operator, sigma = 1 - e)
+// has a non-positive eigenvalue everywhere, i.e. its trace or its
+// determinant is <= 0 (both eigenvalues are positive iff trace > 0 and
+// det > 0). Multiplied by powers of |N| (N = Su x Sv, l.. = S.. . N,
+// E, F, G the first fundamental form):
+//   C1 = 2 sigma |N|^3 - d J,                     J = E lvv + G luu - 2 F luv,
+//   C2 = sigma^2 |N|^4 - sigma d |N| J + d^2 Q,   Q = luu lvv - luv^2
+// (Maekawa 1999 offset factors; the conditions of the fold trigger of lane
+// R-034g, used here in the opposite direction). A Bezier patch of the face
+// (a knot span of the B-spline; its parameters rescaled to [0, 1]^2, the
+// factors do not depend on the parametrization) is PROVEN vanishing when
+// the upper interval bound of C1 or of C2 over the patch is negative.
+// Bounds: the convex hull of the hodograph nets of the homogeneous net
+// bounds every derivative of the numerator and of the weight; S by the
+// hull of the Cartesian net (positive weights); the derivatives of
+// S = P / w by the Leibniz rule in interval arithmetic (Sederberg-Meyers
+// 1988; Hu-Maekawa-Patrikalakis 1997 interval Bezier arithmetic). The net
+// is moved to the centre of its box first (the derivatives do not change,
+// the Leibniz terms w' S then carry the size of the patch, not its
+// distance to the origin). A patch that is not proven is cut in two across
+// the direction that bends (de Casteljau on the homogeneous net).
+// The face does NOT vanish when the factor is above e at a point of the
+// face (exact evaluation; a patch centre is classified in the face).
+// A face whose patches are neither proven nor refuted within the budget is
+// "not proven": it is kept (the stock flow; the stage A guard reports a
+// broken result) - never dropped on a guess.
+// Degenerate allowance (d = r): e = tolerance / size, the offset of the
+// face then shrinks within the tolerance to a curve (the analytic status
+// Degenerated). No interval bound can prove a factor of exactly 0; a
+// free-form face that is a canonical surface within its tolerance
+// (GeomConvert_SurfToAnaSurf, the recognition OCCT uses for its own
+// conversions) is decided by the analytic rule of BRepOffset::Surface.
+//=======================================================================
+
+//! Closed interval (plain double arithmetic; the proofs require a margin
+//! of 1e-10 relative to the magnitude of the terms, far above the rounding
+//! error of the few dozen operations, about 1e-14).
+struct Itv034b
+{
+  double Lo;
+  double Hi;
+};
+
+inline Itv034b operator+(const Itv034b& theA, const Itv034b& theB)
+{
+  return {theA.Lo + theB.Lo, theA.Hi + theB.Hi};
+}
+
+inline Itv034b operator-(const Itv034b& theA, const Itv034b& theB)
+{
+  return {theA.Lo - theB.Hi, theA.Hi - theB.Lo};
+}
+
+inline Itv034b operator*(const Itv034b& theA, const Itv034b& theB)
+{
+  const double a = theA.Lo * theB.Lo, b = theA.Lo * theB.Hi;
+  const double c = theA.Hi * theB.Lo, e = theA.Hi * theB.Hi;
+  return {std::min(std::min(a, b), std::min(c, e)), std::max(std::max(a, b), std::max(c, e))};
+}
+
+inline Itv034b operator*(const double theS, const Itv034b& theA)
+{
+  return theS >= 0. ? Itv034b{theS * theA.Lo, theS * theA.Hi}
+                    : Itv034b{theS * theA.Hi, theS * theA.Lo};
+}
+
+//! theA / theB for theB.Lo > 0
+inline Itv034b divPos034b(const Itv034b& theA, const Itv034b& theB)
+{
+  return theA * Itv034b{1. / theB.Hi, 1. / theB.Lo};
+}
+
+inline double mag034b(const Itv034b& theA)
+{
+  return std::max(std::abs(theA.Lo), std::abs(theA.Hi));
+}
+
+struct IVec034b
+{
+  Itv034b C[3];
+};
+
+inline Itv034b dot034b(const IVec034b& theA, const IVec034b& theB)
+{
+  return theA.C[0] * theB.C[0] + theA.C[1] * theB.C[1] + theA.C[2] * theB.C[2];
+}
+
+inline IVec034b cross034b(const IVec034b& theA, const IVec034b& theB)
+{
+  return {{theA.C[1] * theB.C[2] - theA.C[2] * theB.C[1],
+           theA.C[2] * theB.C[0] - theA.C[0] * theB.C[2],
+           theA.C[0] * theB.C[1] - theA.C[1] * theB.C[0]}};
+}
+
+inline IVec034b scaled034b(const IVec034b& theX, const Itv034b& theF)
+{
+  return {{theX.C[0] * theF, theX.C[1] * theF, theX.C[2] * theF}};
+}
+
+inline IVec034b minus034b(const IVec034b& theX, const IVec034b& theY)
+{
+  return {{theX.C[0] - theY.C[0], theX.C[1] - theY.C[1], theX.C[2] - theY.C[2]}};
+}
+
+inline IVec034b divPos034b(const IVec034b& theX, const Itv034b& theW)
+{
+  return {{divPos034b(theX.C[0], theW), divPos034b(theX.C[1], theW), divPos034b(theX.C[2], theW)}};
+}
+
+//! Rational Bezier patch: homogeneous net (w x, w y, w z, w) at
+//! ((i * (NV + 1)) + j) * 4, degrees NU x NV, and the rectangle of face
+//! parameters it covers (linear map).
+struct Patch034b
+{
+  int                 NU = 0, NV = 0, Depth = 0;
+  std::vector<double> Net;
+  double              U0 = 0., U1 = 1., V0 = 0., V1 = 1.;
+
+  double* Q(const int i, const int j) { return &Net[((size_t)i * (NV + 1) + j) * 4]; }
+
+  const double* Q(const int i, const int j) const { return &Net[((size_t)i * (NV + 1) + j) * 4]; }
+};
+
+//! Interval hull of the (a, b)-th hodograph net (a, b <= 2) of component c
+//! of the homogeneous net: every value of that derivative over the patch
+//! is a convex combination of these coefficients.
+static Itv034b hodoHull034b(const Patch034b& theP, const int theA, const int theB, const int theC)
+{
+  if (theA > theP.NU || theB > theP.NV)
+  {
+    return {0., 0.};
+  }
+  const double aFa = theA == 0 ? 1. : (theA == 1 ? theP.NU : theP.NU * (theP.NU - 1.));
+  const double aFb = theB == 0 ? 1. : (theB == 1 ? theP.NV : theP.NV * (theP.NV - 1.));
+  static const double THE_W[3][3] = {{1., 0., 0.}, {-1., 1., 0.}, {1., -2., 1.}};
+  Itv034b             aR{RealLast(), -RealLast()};
+  for (int i = 0; i + theA <= theP.NU; ++i)
+  {
+    for (int j = 0; j + theB <= theP.NV; ++j)
+    {
+      double aV = 0.;
+      for (int k = 0; k <= theA; ++k)
+      {
+        for (int l = 0; l <= theB; ++l)
+        {
+          aV += THE_W[theA][k] * THE_W[theB][l] * theP.Q(i + k, j + l)[theC];
+        }
+      }
+      aV *= aFa * aFb;
+      aR.Lo = std::min(aR.Lo, aV);
+      aR.Hi = std::max(aR.Hi, aV);
+    }
+  }
+  return aR;
+}
+
+//! Test of one patch: 1 proven vanishing, 0 not proven, -1 no bound (a
+//! weight or the normal may vanish on the patch).
+static int patchVanishes034b(const Patch034b& theP, const double theD, const double theSigma)
+{
+  Itv034b  aW{RealLast(), -RealLast()};
+  IVec034b aS;
+  for (int c = 0; c < 3; ++c)
+  {
+    aS.C[c] = {RealLast(), -RealLast()};
+  }
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      const double* q = theP.Q(i, j);
+      if (!(q[3] > 0.))
+      {
+        return -1;
+      }
+      aW.Lo = std::min(aW.Lo, q[3]);
+      aW.Hi = std::max(aW.Hi, q[3]);
+      for (int c = 0; c < 3; ++c)
+      {
+        const double x = q[c] / q[3];
+        aS.C[c].Lo     = std::min(aS.C[c].Lo, x);
+        aS.C[c].Hi     = std::max(aS.C[c].Hi, x);
+      }
+    }
+  }
+  IVec034b aPd[3][3];
+  Itv034b  aWd[3][3];
+  for (int a = 0; a <= 2; ++a)
+  {
+    for (int b = 0; a + b <= 2; ++b)
+    {
+      if (a + b == 0)
+      {
+        continue;
+      }
+      for (int c = 0; c < 3; ++c)
+      {
+        aPd[a][b].C[c] = hodoHull034b(theP, a, b, c);
+      }
+      aWd[a][b] = hodoHull034b(theP, a, b, 3);
+    }
+  }
+  // P = S w (Leibniz):
+  //   S_s  = (P_s - w_s S) / w
+  //   S_ss = (P_ss - 2 w_s S_s - w_ss S) / w
+  //   S_st = (P_st - w_t S_s - w_s S_t - w_st S) / w
+  const IVec034b aSs  = divPos034b(minus034b(aPd[1][0], scaled034b(aS, aWd[1][0])), aW);
+  const IVec034b aSt  = divPos034b(minus034b(aPd[0][1], scaled034b(aS, aWd[0][1])), aW);
+  const IVec034b aSss = divPos034b(
+    minus034b(minus034b(aPd[2][0], scaled034b(aSs, 2. * aWd[1][0])), scaled034b(aS, aWd[2][0])),
+    aW);
+  const IVec034b aStt = divPos034b(
+    minus034b(minus034b(aPd[0][2], scaled034b(aSt, 2. * aWd[0][1])), scaled034b(aS, aWd[0][2])),
+    aW);
+  const IVec034b aSst = divPos034b(
+    minus034b(minus034b(minus034b(aPd[1][1], scaled034b(aSs, aWd[0][1])), scaled034b(aSt, aWd[1][0])),
+              scaled034b(aS, aWd[1][1])),
+    aW);
+  const IVec034b aN  = cross034b(aSs, aSt);
+  const Itv034b  aN2 = dot034b(aN, aN);
+  if (!(aN2.Lo > 0.))
+  {
+    return -1; // the normal may vanish on the patch (a pole): no bound
+  }
+  const Itv034b aNm{std::sqrt(aN2.Lo), std::sqrt(aN2.Hi)};
+  const Itv034b anE = dot034b(aSs, aSs), aF = dot034b(aSs, aSt), aG = dot034b(aSt, aSt);
+  const Itv034b aLuu = dot034b(aSss, aN), aLuv = dot034b(aSst, aN), aLvv = dot034b(aStt, aN);
+  const Itv034b aJ   = anE * aLvv + aG * aLuu - 2. * (aF * aLuv);
+  const Itv034b aQ   = aLuu * aLvv - aLuv * aLuv;
+  const Itv034b aN3  = aN2 * aNm;
+  const Itv034b aN4  = aN2 * aN2;
+  const Itv034b aNJ  = aNm * aJ;
+  const Itv034b aC1  = 2. * theSigma * aN3 - theD * aJ;
+  const Itv034b aC2  = (theSigma * theSigma) * aN4 - (theSigma * theD) * aNJ + (theD * theD) * aQ;
+  const double  aM1  = 1.e-10 * (2. * theSigma * mag034b(aN3) + std::abs(theD) * mag034b(aJ));
+  const double  aM2  = 1.e-10
+                     * (theSigma * theSigma * mag034b(aN4) + std::abs(theSigma * theD) * mag034b(aNJ)
+                        + theD * theD * mag034b(aQ));
+  return (aC1.Hi < -aM1 || aC2.Hi < -aM2) ? 1 : 0;
+}
+
+//! Splits the patch at the middle of s (theU) or t (de Casteljau).
+static void split034b(const Patch034b& theP, const bool theU, Patch034b& theA, Patch034b& theB)
+{
+  theA = theP;
+  theB = theP;
+  ++theA.Depth;
+  ++theB.Depth;
+  const int           aN = theU ? theP.NU : theP.NV, aM = theU ? theP.NV : theP.NU;
+  std::vector<double> aRow((size_t)(aN + 1) * 4);
+  for (int m = 0; m <= aM; ++m)
+  {
+    for (int k = 0; k <= aN; ++k)
+    {
+      const double* q = theU ? theP.Q(k, m) : theP.Q(m, k);
+      std::copy(q, q + 4, &aRow[(size_t)k * 4]);
+    }
+    // after r steps aRow[0] is the r-th point of the first half and
+    // aRow[aN - r] the (aN - r)-th point of the second half
+    for (int r = 0; r <= aN; ++r)
+    {
+      double* qa = theU ? theA.Q(r, m) : theA.Q(m, r);
+      double* qb = theU ? theB.Q(aN - r, m) : theB.Q(m, aN - r);
+      std::copy(&aRow[0], &aRow[0] + 4, qa);
+      std::copy(&aRow[(size_t)(aN - r) * 4], &aRow[(size_t)(aN - r) * 4] + 4, qb);
+      for (int k = 0; k < aN - r; ++k)
+      {
+        for (int c = 0; c < 4; ++c)
+        {
+          aRow[(size_t)k * 4 + c] = 0.5 * (aRow[(size_t)k * 4 + c] + aRow[(size_t)(k + 1) * 4 + c]);
+        }
+      }
+    }
+  }
+  if (theU)
+  {
+    theA.U1 = theB.U0 = 0.5 * (theP.U0 + theP.U1);
+  }
+  else
+  {
+    theA.V1 = theB.V0 = 0.5 * (theP.V0 + theP.V1);
+  }
+}
+
+//! Largest norm of the second differences of the Cartesian net along s
+//! (theU) or t, times the squared degree: where the patch bends (a patch is
+//! never cut along a straight direction).
+static double bend034b(const Patch034b& theP, const bool theU)
+{
+  const int aN = theU ? theP.NU : theP.NV;
+  if (aN < 2)
+  {
+    return 0.;
+  }
+  double aMax = 0.;
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      if ((theU ? i : j) + 2 > aN)
+      {
+        continue;
+      }
+      const double* q0 = theP.Q(i, j);
+      const double* q1 = theU ? theP.Q(i + 1, j) : theP.Q(i, j + 1);
+      const double* q2 = theU ? theP.Q(i + 2, j) : theP.Q(i, j + 2);
+      double        aS = 0.;
+      for (int c = 0; c < 3; ++c)
+      {
+        const double x = q2[c] / q2[3] - 2. * q1[c] / q1[3] + q0[c] / q0[3];
+        aS += x * x;
+      }
+      aMax = std::max(aMax, std::sqrt(aS));
+    }
+  }
+  return aMax * aN * aN;
+}
+
+//! Homogeneous net of a Bezier surface covering [U0,U1]x[V0,V1] of the face
+//! parameters, moved to the centre of its Cartesian box.
+static bool bezierPatch034b(const occ::handle<Geom_BezierSurface>& theBz,
+                            const double                           theU0,
+                            const double                           theU1,
+                            const double                           theV0,
+                            const double                           theV1,
+                            Patch034b&                             theP)
+{
+  if (theBz.IsNull() || theBz->UDegree() > 25 || theBz->VDegree() > 25)
+  {
+    return false;
+  }
+  theP.NU = theBz->UDegree();
+  theP.NV = theBz->VDegree();
+  theP.Net.assign((size_t)(theP.NU + 1) * (theP.NV + 1) * 4, 0.);
+  theP.U0 = theU0;
+  theP.U1 = theU1;
+  theP.V0 = theV0;
+  theP.V1 = theV1;
+  gp_XYZ aMin(RealLast(), RealLast(), RealLast()), aMax(-RealLast(), -RealLast(), -RealLast());
+  for (int i = 1; i <= theP.NU + 1; ++i)
+  {
+    for (int j = 1; j <= theP.NV + 1; ++j)
+    {
+      const gp_XYZ aX = theBz->Pole(i, j).XYZ();
+      for (int c = 1; c <= 3; ++c)
+      {
+        aMin.SetCoord(c, std::min(aMin.Coord(c), aX.Coord(c)));
+        aMax.SetCoord(c, std::max(aMax.Coord(c), aX.Coord(c)));
+      }
+    }
+  }
+  const gp_XYZ aC = 0.5 * (aMin + aMax);
+  for (int i = 0; i <= theP.NU; ++i)
+  {
+    for (int j = 0; j <= theP.NV; ++j)
+    {
+      const gp_XYZ aX = theBz->Pole(i + 1, j + 1).XYZ() - aC;
+      const double aW = theBz->Weight(i + 1, j + 1);
+      double*      q  = theP.Q(i, j);
+      q[0]            = aW * aX.X();
+      q[1]            = aW * aX.Y();
+      q[2]            = aW * aX.Z();
+      q[3]            = aW;
+    }
+  }
+  return true;
+}
+
+//! Budget of the proof: patches tested per face and depth of the cuts (a
+//! limit that is reached leaves the face "not proven", i.e. kept: a cost
+//! bound, never a decision).
+const int THE_VANISH_BUDGET_034B = 4096;
+const int THE_VANISH_DEPTH_034B  = 24;
+
+//! Proof over the Bezier patches of the face region [U0,U1]x[V0,V1]:
+//! 1 vanishes, 0 does not vanish (a point of the face above theLimit),
+//! -1 not proven.
+static int provenVanish034b(const TopoDS_Face&               theF,
+                            const occ::handle<Geom_Surface>& theS,
+                            const double                     theD,
+                            const double                     theLimit,
