+//! vertex on the surface of theF at theUV
+static TopoDS_Vertex lensVertex034c(const TopoDS_Face& theF, const gp_Pnt2d& theUV, const double theTol)
+{
+  TopLoc_Location                  aLoc;
+  const occ::handle<Geom_Surface>& aS = BRep_Tool::Surface(theF, aLoc);
+  gp_Pnt                           aP = aS->Value(theUV.X(), theUV.Y());
+  if (!aLoc.IsIdentity())
+  {
+    aP.Transform(aLoc.Transformation());
+  }
+  TopoDS_Vertex aV;
+  BRep_Builder().MakeVertex(aV, aP, theTol);
+  return aV;
+}
+
+//! edge on theF with the pcurve theC2d on [theF0, theL0], vertices theV0, theV1
+static TopoDS_Edge lensEdge034c(const TopoDS_Face&               theF,
+                                const occ::handle<Geom2d_Curve>& theC2d,
+                                const double                     theT0,
+                                const double                     theT1,
+                                const TopoDS_Vertex&             theV0,
+                                const TopoDS_Vertex&             theV1,
+                                const double                     theTol)
+{
+  BRep_Builder aBB;
+  TopoDS_Edge  anE;
+  aBB.MakeEdge(anE);
+  aBB.UpdateEdge(anE, theC2d, theF, theTol);
+  aBB.Range(anE, theT0, theT1);
+  aBB.Add(anE, theV0.Oriented(TopAbs_FORWARD));
+  aBB.Add(anE, theV1.Oriented(TopAbs_REVERSED));
+  BRepLib::BuildCurve3d(anE, theTol);
+  aBB.UpdateVertex(theV0, theT0, anE, theTol);
+  aBB.UpdateVertex(theV1, theT1, anE, theTol);
+  // the tolerance covers the deviation of the 3D curve from the pcurve (the
+  // pcurve itself is kept: its parameter is shared with the partner edge)
+  double aDev = 0., aPar = 0.;
+  if (BOPTools_AlgoTools::ComputeTolerance(theF, anE, aDev, aPar) && aDev > BRep_Tool::Tolerance(anE))
+  {
+    aBB.UpdateEdge(anE, aDev * (1. + 1.e-6));
+    aBB.UpdateVertex(theV0, aDev * (1. + 1.e-6));
+    aBB.UpdateVertex(theV1, aDev * (1. + 1.e-6));
+  }
+  return anE;
+}
+
+//! Result of the lens split of the faces of a shape.
+struct LensSplit034c
+{
+  occ::handle<BRepTools_ReShape>                                           ReShape;
+  occ::handle<BRepTools_ReShape>                                           Skin; //!< the edge splits only
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>                   LensFaces;
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> Partner;
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> Origin;
+};
+
+//! UV curve of one side of a lens, shifted by whole periods into the face range
+static bool lensSide034c(const Lens034c&                  theLens,
+                         const bool                       theIsP,
+                         const LensFace034c&              theDom,
+                         NCollection_Sequence<gp_Pnt2d>&  theUV,
+                         gp_Pnt2d&                        theShift)
+{
+  theUV.Clear();
+  const gp_Pnt2d aFirst = theIsP ? theLens.Pts.First().P : theLens.Pts.First().Q;
+  const gp_Pnt2d aW     = theDom.Wrap(aFirst);
+  theShift              = gp_Pnt2d(aW.X() - aFirst.X(), aW.Y() - aFirst.Y());
+  const double anEpsU   = 1.e-9 * (theDom.U1() - theDom.U0()), anEpsV = 1.e-9 * (theDom.V1() - theDom.V0());
+  for (int i = 1; i <= theLens.Pts.Length(); ++i)
+  {
+    const gp_Pnt2d& aP = theIsP ? theLens.Pts.Value(i).P : theLens.Pts.Value(i).Q;
+    const gp_Pnt2d  aQ(aP.X() + theShift.X(), aP.Y() + theShift.Y());
+    if ((theDom.UPer() > 0. && (aQ.X() < theDom.U0() - anEpsU || aQ.X() > theDom.U0() + theDom.UPer() + anEpsU))
+        || (theDom.VPer() > 0. && (aQ.Y() < theDom.V0() - anEpsV || aQ.Y() > theDom.V0() + theDom.VPer() + anEpsV)))
+    {
+      return LENS034C_FAIL(false); // the curve crosses the seam
+    }
+    theUV.Append(aQ);
+  }
+  return true;
+}
+
+//! interpolating pcurve through theUV with parameters theT
+static occ::handle<Geom2d_Curve> lensPCurve034c(const NCollection_Sequence<gp_Pnt2d>& theUV,
+                                               const NCollection_Sequence<double>&   theT)
+{
+  const int aN = theUV.Length();
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aPts = new NCollection_HArray1<gp_Pnt2d>(1, aN);
+  occ::handle<NCollection_HArray1<double>>   aPar = new NCollection_HArray1<double>(1, aN);
+  for (int i = 1; i <= aN; ++i)
+  {
+    aPts->SetValue(i, theUV.Value(i));
+    aPar->SetValue(i, theT.Value(i));
+  }
+  Geom2dAPI_Interpolate anInt(aPts, aPar, false, Precision::PConfusion());
+  anInt.Perform();
+  if (!anInt.IsDone())
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+  return anInt.Curve();
+}
+
+//! Splits the faces with lenses (see the header of the issue 034 B2 round 3
+//! block). theFacesLenses: face (as in the shape) -> its lenses. Returns false
+//! when a configuration is out of scope (nothing is changed then).
+static bool lensSplit034c(
+  const NCollection_IndexedDataMap<TopoDS_Shape, NCollection_Sequence<Lens034c>, TopTools_ShapeMapHasher>&
+                                                                            theFacesLenses,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  LensSplit034c&                                                            theRes)
+{
+  theRes.ReShape = new BRepTools_ReShape();
+  theRes.Skin    = new BRepTools_ReShape();
+  // 1. boundary splits: edge -> parameters
+  NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<double>, TopTools_ShapeMapHasher> aSplits;
+  struct Ray034c
+  {
+    gp_Pnt2d    From, To;
+    TopoDS_Edge Edge;
+    double      T = 0.;
+    int         Lens = 0, End = 0;
+  };
+  NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<Ray034c>, TopTools_ShapeMapHasher> aRays;
+  for (int aFi = 1; aFi <= theFacesLenses.Extent(); ++aFi)
+  {
+    const TopoDS_Face&                     aF = TopoDS::Face(theFacesLenses.FindKey(aFi));
+    const NCollection_Sequence<Lens034c>& aLs = theFacesLenses(aFi);
+    TopLoc_Location                        aLoc;
+    occ::handle<Geom_Surface>              aS  = BRep_Tool::Surface(aF, aLoc);
+    const LensFace034c                     aDom(aF, aS);
+    const double* aFOff = theFaceOffset.Seek(aF);
+    const double  aDD   = (aF.Orientation() == TopAbs_REVERSED) ? -(aFOff ? *aFOff : theOffset)
+                                                                : (aFOff ? *aFOff : theOffset);
+    Bnd_Box      aFBox;
+    BRepBndLib::Add(aF, aFBox, false);
+    const double aSize = aFBox.IsVoid() ? 1. : std::sqrt(aFBox.SquareExtent());
+    aRays.Bind(aF, NCollection_Sequence<Ray034c>());
+    for (int l = 1; l <= aLs.Length(); ++l)
+    {
+      const Lens034c& aL = aLs.Value(l);
+      int             aNbExit = 0;
+      for (int anEnd = 0; anEnd < 2; ++anEnd)
+      {
+        if (!aL.Miter[anEnd])
+        {
+          ++aNbExit;
+          const LensExit034c& anX = aL.Exit[anEnd];
+          if (BRep_Tool::IsClosed(anX.Edge, aF))
+          {
+            return LENS034C_FAIL(false); // an exit on a seam
+          }
+          if (!aSplits.IsBound(anX.Edge))
+          {
+            aSplits.Bind(anX.Edge, NCollection_Sequence<double>());
+          }
+          aSplits.ChangeFind(anX.Edge).Append(anX.T);
+          if (anX.Both)
+          {
+            if (BRep_Tool::IsClosed(anX.Edge2, aF))
+            {
+              return LENS034C_FAIL(false);
+            }
+            if (!aSplits.IsBound(anX.Edge2))
+            {
+              aSplits.Bind(anX.Edge2, NCollection_Sequence<double>());
+            }
+            aSplits.ChangeFind(anX.Edge2).Append(anX.T2);
+          }
+        }
+      }
+      if (aNbExit == 2)
+      {
+        continue;
+      }
+      // rays from the miter ends that must cut the face in two
+      for (int anEnd = 0; anEnd < 2; ++anEnd)
+      {
+        if (!aL.Miter[anEnd] || (aNbExit == 1 && false))
+        {
+          continue;
+        }
+        const int      aN  = aL.Pts.Length();
+        const XPt034c& aM  = anEnd == 0 ? aL.Pts.First() : aL.Pts.Last();
+        double         aSMax = 0.;
+        for (int i = 1; i <= aN; ++i)
+        {
+          aSMax = std::max(aSMax, aL.Pts.Value(i).C[3]);
+        }
+        // the lens opens away from the miter: the ray goes the other way
+        gp_Pnt2d aCk = aM.P;
+        for (int k = 1; k <= aN; ++k)
+        {
+          const XPt034c& aPk = aL.Pts.Value(anEnd == 0 ? k : aN + 1 - k);
+          if (aPk.C[3] >= 0.1 * aSMax)
+          {
+            aCk = gp_Pnt2d(0.5 * (aPk.P.X() + aPk.Q.X()), 0.5 * (aPk.P.Y() + aPk.Q.Y()));
+            break;
+          }
+        }
+        double aRu = aM.P.X() - aCk.X(), aRv = aM.P.Y() - aCk.Y();
+        gp_Pnt aPm;
+        gp_Vec aDu, aDv;
+        aS->D1(aM.P.X(), aM.P.Y(), aPm, aDu, aDv);
+        const double aSp = (aDu * aRu + aDv * aRv).Magnitude();
+        if (!(aSp > 1.e-300))
+        {
+          return LENS034C_FAIL(false);
+        }
+        aRu /= aSp;
+        aRv /= aSp;
+        const double aStep = aSize / 400.;
+        double       aT    = 0.;
+        bool         isOut = false;
+        for (int anIt = 0; anIt < 4000; ++anIt)
+        {
+          const gp_Pnt2d aPn(aM.P.X() + (aT + aStep) * aRu, aM.P.Y() + (aT + aStep) * aRv);
+          if (!aDom.IsIn(aPn))
+          {
+            isOut = true;
+            break;
+          }
+          aT += aStep;
+          double aG, a1, a2;
+          if (aT > 0.02 * aSize && (!foldFactor034c(*aS, aPn.X(), aPn.Y(), aDD, aG, a1, a2) || aG <= 0.))
+          {
+            return LENS034C_FAIL(false); // the ray runs into a fold
+          }
+        }
+        if (!isOut)
+        {
+          return LENS034C_FAIL(false);
+        }
+        double aLo = aT, aHi = aT + aStep;
+        for (int anIt = 0; anIt < 50; ++anIt)
+        {
+          const double aMd = 0.5 * (aLo + aHi);
+          (aDom.IsIn(gp_Pnt2d(aM.P.X() + aMd * aRu, aM.P.Y() + aMd * aRv)) ? aLo : aHi) = aMd;
+        }
+        const gp_Pnt2d aEndG(aM.P.X() + aLo * aRu, aM.P.Y() + aLo * aRv);
+        Ray034c        aRay;
+        double         aDist = 0.;
+        if (!aDom.Project(aDom.Wrap(aEndG), aRay.Edge, aRay.T, aDist) || BRep_Tool::IsClosed(aRay.Edge, aF))
+        {
+          return LENS034C_FAIL(false);
+        }
+        aRay.From = aM.P;
+        aRay.Lens = l;
+        aRay.End  = anEnd;
+        double                          aCF, aCL;
+        const occ::handle<Geom2d_Curve> aBC = BRep_Tool::CurveOnSurface(aRay.Edge, aF, aCF, aCL);
+        aRay.To                             = aBC->Value(aRay.T);
+        // the ray must not cross a lens
+        for (int m = 1; m <= aLs.Length(); ++m)
+        {
+          const NCollection_Sequence<gp_Pnt2d>& aPoly = aLs.Value(m).Poly;
+          for (int a = 1; a <= aPoly.Length(); ++a)
+          {
+            const gp_Pnt2d& aA1 = aPoly.Value(a);
+            const gp_Pnt2d& aA2 = aPoly.Value(a == aPoly.Length() ? 1 : a + 1);
+            const gp_Pnt2d  aR0(aRay.From.X() + 1.e-6 * (aRay.To.X() - aRay.From.X()),
+                               aRay.From.Y() + 1.e-6 * (aRay.To.Y() - aRay.From.Y()));
+            if (segCross034c(aR0, aRay.To, aA1, aA2))
+            {
+              return LENS034C_FAIL(false);
+            }
+          }
+        }
+        aRays.ChangeFind(aF).Append(aRay);
+        if (!aSplits.IsBound(aRay.Edge))
+        {
+          aSplits.Bind(aRay.Edge, NCollection_Sequence<double>());
+        }
+        aSplits.ChangeFind(aRay.Edge).Append(aRay.T);
+        if (aNbExit == 1)
+        {
+          break; // one ray is enough: the exit already cuts the face on the other side
+        }
+      }
+    }
+  }
+  // 2. split the boundary edges
+  NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<TopoDS_Shape>, TopTools_ShapeMapHasher> aPieces;
+  NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<double>, TopTools_ShapeMapHasher> aPieceT; // vertex params
+  NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<TopoDS_Shape>, TopTools_ShapeMapHasher> aPieceV;
+  BRep_Builder aBB;
+  for (NCollection_DataMap<TopoDS_Shape, NCollection_Sequence<double>, TopTools_ShapeMapHasher>::Iterator anIt(aSplits);
+       anIt.More();
+       anIt.Next())
+  {
+    const TopoDS_Edge anE = TopoDS::Edge(anIt.Key().Oriented(TopAbs_FORWARD));
+    double            aF, aL;
+    BRep_Tool::Range(anE, aF, aL);
+    TopoDS_Vertex aVf, aVl;
+    TopExp::Vertices(anE, aVf, aVl);
+    const double aTolE = BRep_Tool::Tolerance(anE);
+    BRepAdaptor_Curve anAC(anE);
+    NCollection_Sequence<double> aTs;
+    for (int i = 1; i <= anIt.Value().Length(); ++i)
+    {
+      aTs.Append(anIt.Value().Value(i));
+    }
+    // sort
+    for (int i = 1; i <= aTs.Length(); ++i)
+    {
+      for (int j = i + 1; j <= aTs.Length(); ++j)
+      {
+        if (aTs.Value(j) < aTs.Value(i))
+        {
+          const double aT = aTs.Value(i);
+          aTs.SetValue(i, aTs.Value(j));
+          aTs.SetValue(j, aT);
+        }
+      }
+    }
+    NCollection_Sequence<double>       aKnots;
+    NCollection_Sequence<TopoDS_Shape> aVs;
+    aKnots.Append(aF);
+    aVs.Append(aVf);
+    for (int i = 1; i <= aTs.Length(); ++i)
+    {
+      const double aT  = aTs.Value(i);
+      const gp_Pnt aP  = anAC.Value(aT);
+      const double aTl = std::max(aTolE, BRep_Tool::Tolerance(TopoDS::Vertex(aVs.Last())));
+      if (aP.Distance(anAC.Value(aKnots.Last())) <= 2. * aTl || aP.Distance(anAC.Value(aL)) <= 2. * aTolE)
+      {
+        return LENS034C_FAIL(false); // a split point on a vertex: out of scope (the pieces would be degenerate)
+      }
+      TopoDS_Vertex aV;
+      aBB.MakeVertex(aV, aP, aTolE);
+      aKnots.Append(aT);
+      aVs.Append(aV);
+    }
+    aKnots.Append(aL);
+    aVs.Append(aVl);
+    NCollection_Sequence<TopoDS_Shape> aPs;
+    TopoDS_Wire                         aW;
+    aBB.MakeWire(aW);
+    for (int i = 1; i < aKnots.Length(); ++i)
+    {
+      TopoDS_Edge aP = TopoDS::Edge(anE.EmptyCopied());
+      aBB.Range(aP, aKnots.Value(i), aKnots.Value(i + 1));
+      aBB.Add(aP, TopoDS::Vertex(aVs.Value(i)).Oriented(TopAbs_FORWARD));
+      aBB.Add(aP, TopoDS::Vertex(aVs.Value(i + 1)).Oriented(TopAbs_REVERSED));
+      if (i > 1)
+      {
+        aBB.UpdateVertex(TopoDS::Vertex(aVs.Value(i)), aKnots.Value(i), aP, aTolE);
+      }
+      if (i + 1 < aKnots.Length())
+      {
+        aBB.UpdateVertex(TopoDS::Vertex(aVs.Value(i + 1)), aKnots.Value(i + 1), aP, aTolE);
+      }
+      aPs.Append(aP);
+      aBB.Add(aW, aP);
+    }
+    aPieces.Bind(anE, aPs);
+    aPieceT.Bind(anE, aKnots);
+    aPieceV.Bind(anE, aVs);
+    theRes.ReShape->Replace(anE, aW);
+    theRes.Skin->Replace(anE, aW);
+  }
+  auto splitVertex = [&](const TopoDS_Edge& theE, const double theT) -> TopoDS_Vertex {
+    const TopoDS_Shape                  aKey = theE.Oriented(TopAbs_FORWARD);
+    const NCollection_Sequence<double>* aKs  = aPieceT.Seek(aKey);
+    if (aKs == nullptr)
+    {
+      return TopoDS_Vertex();
+    }
+    for (int i = 2; i < aKs->Length(); ++i)
+    {
+      if (aKs->Value(i) == theT)
+      {
+        return TopoDS::Vertex(aPieceV.Find(aKey).Value(i));
+      }
+    }
+    return TopoDS_Vertex();
+  };
+  // 3. the faces
+  for (int aFi = 1; aFi <= theFacesLenses.Extent(); ++aFi)
+  {
+    const TopoDS_Face&                     aFo = TopoDS::Face(theFacesLenses.FindKey(aFi));
+    const TopoDS_Face                      aF  = TopoDS::Face(aFo.Oriented(TopAbs_FORWARD));
+    const NCollection_Sequence<Lens034c>& aLs  = theFacesLenses(aFi);
+    TopLoc_Location                        aLoc;
+    occ::handle<Geom_Surface>              aS = BRep_Tool::Surface(aF, aLoc);
+    const LensFace034c                     aDom(aF, aS);
+    const double                           aTolF = std::max(BRep_Tool::Tolerance(aF), Precision::Confusion());
+    NCollection_List<TopoDS_Shape>         anEdges;
+    for (TopExp_Explorer anExp(aF, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Shape&                       anE = anExp.Current();
+      const NCollection_Sequence<TopoDS_Shape>* aPs = aPieces.Seek(anE.Oriented(TopAbs_FORWARD));
+      if (aPs == nullptr)
+      {
+        anEdges.Append(anE);
+        continue;
+      }
+      for (int i = 1; i <= aPs->Length(); ++i)
+      {
+        anEdges.Append(aPs->Value(i).Oriented(anE.Orientation()));
+      }
+    }
+    NCollection_List<TopoDS_Shape> aNewEdges;
+    for (int l = 1; l <= aLs.Length(); ++l)
+    {
+      const Lens034c&                aL = aLs.Value(l);
+      NCollection_Sequence<gp_Pnt2d> aUV1, aUV2;
+      gp_Pnt2d                       aSh1, aSh2;
+      if (!lensSide034c(aL, true, aDom, aUV1, aSh1) || !lensSide034c(aL, false, aDom, aUV2, aSh2))
+      {
+        return LENS034C_FAIL(false);
+      }
+      NCollection_Sequence<double> aT;
+      for (int i = 1; i <= aL.Pts.Length(); ++i)
+      {
+        aT.Append(aL.Pts.Value(i).L);
+      }
+      const occ::handle<Geom2d_Curve> aC1 = lensPCurve034c(aUV1, aT);
+      const occ::handle<Geom2d_Curve> aC2 = lensPCurve034c(aUV2, aT);
+      if (aC1.IsNull() || aC2.IsNull())
+      {
+        return LENS034C_FAIL(false);
+      }
+      // vertices of the ends
+      TopoDS_Vertex aV1[2], aV2[2]; // C1 ends, C2 ends
+      for (int anEnd = 0; anEnd < 2; ++anEnd)
+      {
+        const gp_Pnt2d& aP1 = anEnd == 0 ? aUV1.First() : aUV1.Last();
+        const gp_Pnt2d& aP2 = anEnd == 0 ? aUV2.First() : aUV2.Last();
+        if (aL.Miter[anEnd])
+        {
+          if (aP1.Distance(aP2) > 1.e-9 * (1. + std::abs(aP1.X()) + std::abs(aP1.Y())))
+          {
+            return LENS034C_FAIL(false); // the two sides wrapped differently: the lens crosses a seam
+          }
+          aV1[anEnd] = aV2[anEnd] = lensVertex034c(aF, aP1, aTolF);
+          continue;
+        }
+        if (!aL.Exit[anEnd].Both && (aSh1.X() != aSh2.X() || aSh1.Y() != aSh2.Y()))
+        {
+          return LENS034C_FAIL(false); // a chord across a seam
+        }
+        const LensExit034c& anX = aL.Exit[anEnd];
+        const TopoDS_Vertex aVb = splitVertex(anX.Edge, anX.T);
+        if (aVb.IsNull())
+        {
+          return LENS034C_FAIL(false);
+        }
+        if (anX.Both)
+        {
+          const TopoDS_Vertex aVb2 = splitVertex(anX.Edge2, anX.T2);
+          if (aVb2.IsNull())
+          {
+            return LENS034C_FAIL(false);
+          }
+          aV1[anEnd] = anX.IsP ? aVb : aVb2;
+          aV2[anEnd] = anX.IsP ? aVb2 : aVb;
+          continue;
+        }
+        const TopoDS_Vertex aVi = lensVertex034c(aF, anX.IsP ? aP2 : aP1, aTolF);
+        aV1[anEnd]              = anX.IsP ? aVb : aVi;
+        aV2[anEnd]              = anX.IsP ? aVi : aVb;
+        // the chord between the two preimages of the exit point
+        const gp_Pnt2d                  aA = anX.IsP ? aP1 : aP2, aB = anX.IsP ? aP2 : aP1;
+        const double                    aLen = aA.Distance(aB);
+        if (!(aLen > 0.))
+        {
+          return LENS034C_FAIL(false);
+        }
+        const occ::handle<Geom2d_Line> aLine = new Geom2d_Line(aA, gp_Dir2d(aB.X() - aA.X(), aB.Y() - aA.Y()));
+        const TopoDS_Edge aCh = lensEdge034c(aF, aLine, 0., aLen, aVb, aVi, aTolF);
+        aNewEdges.Append(aCh);
+      }
+      const TopoDS_Edge anE1 = lensEdge034c(aF, aC1, aT.First(), aT.Last(), aV1[0], aV1[1], aTolF);
+      const TopoDS_Edge anE2 = lensEdge034c(aF, aC2, aT.First(), aT.Last(), aV2[0], aV2[1], aTolF);
+      aNewEdges.Append(anE1);
+      aNewEdges.Append(anE2);
+      theRes.Partner.Bind(anE1, anE2);
+      theRes.Partner.Bind(anE2, anE1);
+      // rays of this lens
+      for (int r = 1; r <= aRays.Find(aFo).Length(); ++r)
+      {
+        const Ray034c& aR = aRays.Find(aFo).Value(r);
+        if (aR.Lens != l)
+        {
+          continue;
+        }
+        const TopoDS_Vertex aVb = splitVertex(aR.Edge, aR.T);
+        if (aVb.IsNull())
+        {
+          return LENS034C_FAIL(false);
+        }
+        const gp_Pnt2d aA(aR.From.X() + aSh1.X(), aR.From.Y() + aSh1.Y());
+        const gp_Pnt2d aB = aR.To;
+        const double   aLen = aA.Distance(aB);
+        if (!(aLen > 0.))
+        {
+          return LENS034C_FAIL(false);
+        }
+        const occ::handle<Geom2d_Line> aLine = new Geom2d_Line(aA, gp_Dir2d(aB.X() - aA.X(), aB.Y() - aA.Y()));
+        aNewEdges.Append(lensEdge034c(aF, aLine, 0., aLen, aV1[aR.End], aVb, aTolF));
+      }
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(aNewEdges); anIt.More(); anIt.Next())
+    {
+      anEdges.Append(anIt.Value().Oriented(TopAbs_FORWARD));
+      anEdges.Append(anIt.Value().Oriented(TopAbs_REVERSED));
+    }
+    BOPAlgo_BuilderFace aBF;
+    aBF.SetFace(aF);
+    aBF.SetShapes(anEdges);
+    aBF.Perform();
+    if (aBF.HasErrors() || aBF.Areas().Extent() < aLs.Length() + 1)
+    {
+      return LENS034C_FAIL(false);
+    }
+    // the lens faces: the areas inside a lens (a seam can cut a lens in two)
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aLensAreas;
+    occ::handle<IntTools_Context>                          aCtx = new IntTools_Context();
+    NCollection_Array1<int>                                aLensHits(1, aLs.Length());
+    aLensHits.Init(0);
+    for (NCollection_List<TopoDS_Shape>::Iterator anItA(aBF.Areas()); anItA.More(); anItA.Next())
+    {
+      gp_Pnt   aP3;
+      gp_Pnt2d aP2;
+      if (BOPTools_AlgoTools3D::PointInFace(TopoDS::Face(anItA.Value()), aP3, aP2, aCtx) != 0)
+      {
+        return LENS034C_FAIL(false);
+      }
+      int aLensOf = 0;
+      for (int l = 1; l <= aLs.Length() && aLensOf == 0; ++l)
+      {
+        for (int aKu = -1; aKu <= 1 && aLensOf == 0; ++aKu)
+        {
+          for (int aKv = -1; aKv <= 1 && aLensOf == 0; ++aKv)
+          {
+            if ((aKu != 0 && aDom.UPer() == 0.) || (aKv != 0 && aDom.VPer() == 0.))
+            {
+              continue;
+            }
+            if (inPoly034c(aLs.Value(l).Poly, gp_Pnt2d(aP2.X() + aKu * aDom.UPer(), aP2.Y() + aKv * aDom.VPer())))
+            {
+              aLensOf = l;
+            }
+          }
+        }
+      }
+      if (aLensOf > 0)
+      {
+        aLensAreas.Add(anItA.Value());
+        ++aLensHits(aLensOf);
+      }
+    }
+    for (int l = 1; l <= aLs.Length(); ++l)
+    {
+      if (aLensHits(l) == 0)
+      {
+        return LENS034C_FAIL(false);
+      }
+    }
+    if (aLensAreas.Extent() == aBF.Areas().Extent())
+    {
+      return LENS034C_FAIL(false); // nothing of the face survives: a vanishing face
+    }
+    TopoDS_Compound aComp;
+    aBB.MakeCompound(aComp);
+    for (NCollection_List<TopoDS_Shape>::Iterator anItA(aBF.Areas()); anItA.More(); anItA.Next())
+    {
+      const TopoDS_Shape anA = anItA.Value().Oriented(TopAbs_FORWARD);
+      aBB.Add(aComp, anA);
+      theRes.Origin.Bind(anA, aFo);
+      if (aLensAreas.Contains(anItA.Value()))
+      {
+        theRes.LensFaces.Add(anA);
+      }
+    }
+    theRes.ReShape->Replace(aF, aComp);
+  }
+  return true;
+}
+} // namespace
+
+namespace
+{
+//! Pass of the running MakeOffsetShape()/MakeThickSolid() (issue 034 B2 r3):
+//! pass 1 is the flow of rounds 1-2; only when it fails and a face folds
+//! partially, pass 2 repeats the operation on the input split along its
+//! lenses. A result of pass 1 is never changed.
+struct LensPass034c
+{
+  const void* Owner = nullptr;
+  int         Mode  = 0; //!< 1: pass 1 (no lens), 2: pass 2 (lens split)
+  //! pass 2: the split of the input (faces -> pieces, edges -> wires of
+  //! their pieces), the same split of the edges only (the faces of the
+  //! input keep their surface domain: the skin of a thick solid), the
+  //! lens faces and the input face of every piece
+  occ::handle<BRepTools_ReShape>                                           Split;
+  occ::handle<BRepTools_ReShape>                                           Skin;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>                   LensFaces;
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> Origin;
+};
+
+thread_local LensPass034c THE_LENS_PASS_034C;
+
+class LensPassScope034c
+{
+public:
+  LensPassScope034c(const void* theOwner)
