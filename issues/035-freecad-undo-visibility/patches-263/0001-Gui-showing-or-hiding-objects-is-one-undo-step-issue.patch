-                    visible = obj->Visibility.getValue();
                     obj->Visibility.setValue(!visible);
                 }
                 visibilityIconDoubleClickTimer.start();
diff --git a/src/Gui/VisibilityTransaction.h b/src/Gui/VisibilityTransaction.h
new file mode 100644
index 0000000..009c861
--- /dev/null
+++ b/src/Gui/VisibilityTransaction.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+
+#include <algorithm>
+#include <vector>
+
+#include <App/Application.h>
+#include <App/Document.h>
+
+namespace Gui
+{
+
+/** One undo step for one user action that shows or hides objects.
+ *
+ * Used by Std_ToggleVisibility, Std_ShowSelection, Std_HideSelection, Std_ShowObjects,
+ * Std_HideObjects, Std_ToggleObjects and the tree view's eye icon and Space key.
+ *
+ * App::DocumentObject::Visibility carries Property::NoModify, and App::Document::_checkTransaction
+ * never opens a transaction for a NoModify property, so a visibility change made outside an open
+ * transaction was not undoable: Ctrl+Z skipped it and undid the modeling step before it instead.
+ * The view provider's Visibility is recorded by an open transaction (TransactionViewProvider), and
+ * undo/redo of that record restores both properties.
+ *
+ * The transaction named @a name is booked on every given document that has none of its own, with
+ * one transaction ID, and committed when this object goes out of scope. Nothing is booked when a
+ * document already has a transaction booked or pending, a global transaction is active, or an undo
+ * or redo is running: then the change belongs to that step, as before. Nothing is booked either
+ * when the caller knows the action changes nothing (@a changes false): setting a Visibility to the
+ * value it has is still recorded, and would leave an undo step that does nothing.
+ *
+ * Preference BaseApp/Preferences/View/UndoVisibility (default true); false restores the previous
+ * behaviour (only Std_ToggleVisibility, and only with PropertyView/AutoTransactionView).
+ */
+class VisibilityTransaction
+{
+public:
+    static bool enabled()
+    {
+        return App::GetApplication()
+            .GetParameterGroupByPath("User parameter:BaseApp/Preferences/View")
+            ->GetBool("UndoVisibility", true);
+    }
+
+    VisibilityTransaction(const char* name, std::vector<App::Document*> docs, bool changes = true)
+    {
+        if (!changes || !enabled() || App::GetApplication().getGlobalTransaction() != 0) {
+            return;
+        }
+        std::vector<App::Document*> seen;
+        for (App::Document* doc : docs) {
+            if (!doc || std::find(seen.begin(), seen.end(), doc) != seen.end()) {
+                continue;
+            }
+            seen.push_back(doc);
+            if (doc->getBookedTransactionID() != 0 || doc->hasPendingTransaction()
+                || doc->transacting() || doc->isTransactionLocked()) {
+                continue;
+            }
+            int id = doc->openTransaction(App::TransactionName {.name = name, .temporary = false}, tid);
+            if (tid == 0) {
+                tid = id;
+            }
+        }
+    }
+
+    ~VisibilityTransaction()
+    {
+        if (tid != 0) {
+            App::GetApplication().commitTransaction(tid);
+        }
+    }
+
+    VisibilityTransaction(const VisibilityTransaction&) = delete;
+    VisibilityTransaction& operator=(const VisibilityTransaction&) = delete;
+
+private:
+    int tid {0};
+};
+
+}  // namespace Gui
