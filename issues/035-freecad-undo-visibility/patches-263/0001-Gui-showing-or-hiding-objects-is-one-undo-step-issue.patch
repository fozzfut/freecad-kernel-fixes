From 2af3f99ed16c62fe799228afcf49bae60137d1cd Mon Sep 17 00:00:00 2001
From: fozzfut <vanolia13@gmail.com>
Date: Sun, 27 Sep 2026 17:25:30 +0700
Subject: [PATCH] Gui: showing or hiding objects is one undo step (issue 035)

App::DocumentObject::Visibility has Property::NoModify, and
App::Document::_checkTransaction ignores NoModify properties when it
decides whether to open the booked transaction, so a visibility change
made outside an open transaction was not recorded: Ctrl+Z skipped it and
undid the modeling step before it (e.g. hide a body after a Pad, Ctrl+Z
removes the Pad and the body stays hidden). Only Std_ToggleVisibility
opened a transaction, and only with PropertyView/AutoTransactionView
(default false); Std_ShowSelection, Std_HideSelection, Std_ShowObjects,
Std_HideObjects, Std_ToggleObjects and the tree's eye icon and Space key
opened none.

Gui::VisibilityTransaction (header only) books one transaction per user
action on every document the action touches and commits it at the end;
the view provider's Visibility record restores both properties on
undo/redo. Nothing is booked when a document already has a transaction
(a task dialog/tool is running: the change stays part of that step, as
before), during undo/redo, while a global transaction is active, or when
the action changes nothing (hide an already hidden selection, hide all
with everything hidden).

Preference BaseApp/Preferences/View/UndoVisibility (default true);
false = previous behaviour. Std_ToggleSelectability and property editor
edits keep AutoTransactionView.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Gui/CommandView.cpp         | 108 ++++++++++++++++++++++++++++++++
 src/Gui/Tree.cpp                |  26 +++++++-
 src/Gui/VisibilityTransaction.h |  80 +++++++++++++++++++++++
 3 files changed, 211 insertions(+), 3 deletions(-)
 create mode 100644 src/Gui/VisibilityTransaction.h

diff --git a/src/Gui/CommandView.cpp b/src/Gui/CommandView.cpp
index c5b0d4f..c533154 100644
--- a/src/Gui/CommandView.cpp
+++ b/src/Gui/CommandView.cpp
@@ -94,6 +94,7 @@
 #include "View3DInventorViewer.h"
 #include "ViewParams.h"
 #include "ViewProviderGeometryObject.h"
+#include "VisibilityTransaction.h"
 #include "WaitCursor.h"
 
 using namespace Gui;
@@ -134,6 +135,84 @@ public:
         }
     }
 };
+
+// Documents a visibility change of the current selection can touch: the selected object's, and
+// those of the sub-object and its parent the selection resolves to (a link to another document).
+std::vector<App::Document*> selectionDocuments()
+{
+    std::vector<App::Document*> docs;
+    for (const auto& sel : Selection().getCompleteSelection(ResolveMode::NoResolve)) {
+        if (!sel.pObject || !sel.pObject->isAttachedToDocument()) {
+            continue;
+        }
+        docs.push_back(sel.pObject->getDocument());
+        App::DocumentObject* parent = nullptr;
+        std::string element;
+        auto obj = sel.pObject->resolve(sel.SubName, &parent, &element);
+        if (obj && obj->isAttachedToDocument()) {
+            docs.push_back(obj->getDocument());
+        }
+        if (parent && parent->isAttachedToDocument()) {
+            docs.push_back(parent->getDocument());
+        }
+    }
+    return docs;
+}
+
+// Whether showing (@a show) or hiding the current selection changes anything (the element
+// visibility for a sub-object its parent handles, the view provider's otherwise).
+bool selectionChanges(bool show)
+{
+    for (const auto& sel : Selection().getCompleteSelection(ResolveMode::NoResolve)) {
+        if (!sel.pObject || !sel.pObject->isAttachedToDocument()) {
+            continue;
+        }
+        App::DocumentObject* parent = nullptr;
+        std::string element;
+        auto obj = sel.pObject->resolve(sel.SubName, &parent, &element);
+        if (!obj || !obj->isAttachedToDocument()) {
+            continue;
+        }
+        if (parent) {
+            int vis = parent->isElementVisible(element.c_str());
+            if (vis >= 0) {
+                if ((vis > 0) != show) {
+                    return true;
+                }
+                continue;
+            }
+        }
+        auto vp = Application::Instance->getViewProvider(obj);
+        if (vp && vp->isShow() != show) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Whether showing (@a show) or hiding all objects of the active document changes anything.
+bool documentChanges(bool show)
+{
+    Gui::Document* doc = Application::Instance->activeDocument();
+    if (!doc) {
+        return false;
+    }
+    for (auto obj : doc->getDocument()->getObjects()) {
+        if (doc->isShow(obj->getNameInDocument()) != show) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::vector<App::Document*> activeDocument()
+{
+    std::vector<App::Document*> docs;
+    if (auto doc = App::GetApplication().getActiveDocument()) {
+        docs.push_back(doc);
+    }
+    return docs;
+}
 }  // namespace
 
