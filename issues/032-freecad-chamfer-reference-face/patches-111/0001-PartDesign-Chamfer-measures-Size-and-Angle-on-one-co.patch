+
+bool isPlanar(const TopoDS_Face& face)
+{
+    BRepAdaptor_Surface surf(face, Standard_False);
+    return surf.GetType() == GeomAbs_Plane;
+}
+
+double faceArea(const TopoDS_Face& face)
+{
+    GProp_GProps props;
+    BRepGProp::SurfaceProperties(face, props);
+    return props.Mass();
+}
+
+// The adjacent face of every edge that Size (and the Angle) is measured on. OCCT's
+// BRepFilletAPI_MakeChamfer::Add(Dis1, Dis2, E, F) / AddDA(Dis, Angle, E, F) measure Dis1 / Dis on F
+// and the angle from F (BlendFunc_ChAsym), so this choice alone decides which face gets which value.
+// Legacy: the first ancestor (FlipDirection: the last), as TopoShape::makeElementChamfer does.
+// Consistent: the better of the two faces by (picked in Base, number of chamfered edges it bounds,
+// planar, larger area); a full tie keeps the first ancestor. FlipDirection takes the other face.
+std::vector<TopoDS_Shape> chooseReferenceFaces(
+    const Part::TopoShape& shape,
+    const std::vector<Part::TopoShape>& edges,
+    const TopTools_IndexedMapOfShape& picked,
+    bool consistent,
+    bool flip
+)
+{
+    std::vector<std::pair<TopoDS_Shape, TopoDS_Shape>> adjacent;
+    adjacent.reserve(edges.size());
+    TopTools_IndexedMapOfShape faceIndex;
+    std::vector<int> count;
+    auto countFace = [&](const TopoDS_Shape& f) {
+        const int i = faceIndex.Add(f);
+        if (i > static_cast<int>(count.size())) {
+            count.push_back(0);
+        }
+        ++count[i - 1];
+    };
+    for (const auto& e : edges) {
+        const auto faces = shape.findAncestorsShapes(e.getShape(), TopAbs_FACE);
+        if (faces.empty()) {
+            FC_THROWM(Base::CADKernelError, "chamfer edge has no adjacent face");
+        }
+        adjacent.emplace_back(faces.front(), faces.back());
+        countFace(faces.front());
+        if (!faces.back().IsSame(faces.front())) {
+            countFace(faces.back());
+        }
+    }
+
+    std::vector<double> area(count.size(), -1.0);
+    std::vector<int> planar(count.size(), -1);
+    auto areaOf = [&](int i) {
+        if (area[i - 1] < 0.0) {
+            area[i - 1] = faceArea(TopoDS::Face(faceIndex.FindKey(i)));
+        }
+        return area[i - 1];
+    };
+    auto planarOf = [&](int i) {
+        if (planar[i - 1] < 0) {
+            planar[i - 1] = isPlanar(TopoDS::Face(faceIndex.FindKey(i))) ? 1 : 0;
+        }
+        return planar[i - 1];
+    };
+    // true: the first face wins
+    auto firstWins = [&](const TopoDS_Shape& a, const TopoDS_Shape& b) {
+        const int ia = faceIndex.FindIndex(a);
+        const int ib = faceIndex.FindIndex(b);
+        const bool pa = picked.Contains(a);
+        const bool pb = picked.Contains(b);
+        if (pa != pb) {
+            return pa;
+        }
+        if (count[ia - 1] != count[ib - 1]) {
+            return count[ia - 1] > count[ib - 1];
+        }
+        if (planarOf(ia) != planarOf(ib)) {
+            return planarOf(ia) > planarOf(ib);
+        }
+        const double aa = areaOf(ia);
+        const double ab = areaOf(ib);
+        if (std::abs(aa - ab) > 1e-9 * std::max(aa, ab)) {
+            return aa > ab;
+        }
+        return true;
+    };
+
+    std::vector<TopoDS_Shape> ref;
+    ref.reserve(edges.size());
+    for (const auto& [first, last] : adjacent) {
+        if (!consistent || first.IsSame(last)) {
+            ref.push_back(flip ? last : first);
+            continue;
+        }
+        const bool takeFirst = firstWins(first, last);
+        ref.push_back((takeFirst != flip) ? first : last);
+    }
+    return ref;
+}
+
+// Unit direction in `face`, perpendicular to the edge at parameter t, pointing into the face.
+// False when it cannot be found (then no diagnosis is made).
+bool intoFace(const TopoDS_Edge& edge, const TopoDS_Face& face, double t, gp_Vec& dir)
+{
+    double f = 0.0;
+    double l = 0.0;
+    Handle(Geom2d_Curve) pc = BRep_Tool::CurveOnSurface(edge, face, f, l);
+    if (pc.IsNull()) {
+        return false;
+    }
+    gp_Pnt2d uv;
+    gp_Vec2d d2;
+    pc->D1(t, uv, d2);
+    if (d2.Magnitude() < 1e-15) {
+        return false;
+    }
+    gp_Vec2d n2(-d2.Y(), d2.X());
+    n2.Normalize();
+    BRepAdaptor_Surface surf(face, Standard_False);
+    gp_Pnt p;
+    gp_Vec du;
+    gp_Vec dv;
+    surf.D1(uv.X(), uv.Y(), p, du, dv);
+    gp_Vec w = du * n2.X() + dv * n2.Y();
+    BRepAdaptor_Curve curve(edge);
+    gp_Pnt pe;
+    gp_Vec tangent;
+    curve.D1(t, pe, tangent);
+    if (w.Magnitude() < 1e-15 || tangent.Magnitude() < 1e-15) {
+        return false;
+    }
+    tangent.Normalize();
+    const double eps = 1e-4 / w.Magnitude();  // about 0.1 um across the face
+    for (double sign : {1.0, -1.0}) {
+        BRepClass_FaceClassifier cls(face, gp_Pnt2d(uv.X() + sign * eps * n2.X(), uv.Y() + sign * eps * n2.Y()), 1e-9);
+        if (cls.State() == TopAbs_IN) {
+            gp_Vec d = w * sign;
+            d -= tangent * d.Dot(tangent);
+            if (d.Magnitude() < 1e-15) {
+                return false;
+            }
+            dir = d.Normalized();
+            return true;
+        }
+    }
+    return false;
+}
+
+// "Distance and Angle": the first edge whose chamfer can never reach the other face, because the
+// angle from the reference face plus the angle between the two faces (at the middle of the edge)
+// is 180 degrees or more. Empty when none is found.
+std::string diagnoseAngle(
+    const Part::TopoShape& shape,
+    const std::vector<Part::TopoShape>& edges,
+    const std::vector<TopoDS_Shape>& ref,
+    double angleDeg
+)
+{
+    for (size_t i = 0; i < edges.size() && i < ref.size(); ++i) {
+        const TopoDS_Edge& e = TopoDS::Edge(edges[i].getShape());
+        const auto faces = shape.findAncestorsShapes(e, TopAbs_FACE);
+        if (faces.size() != 2 || faces.front().IsSame(faces.back())) {
+            continue;
+        }
+        const TopoDS_Face& fr = TopoDS::Face(ref[i]);
+        const TopoDS_Face& fo = TopoDS::Face(faces.front().IsSame(fr) ? faces.back() : faces.front());
+        double f = 0.0;
+        double l = 0.0;
+        if (BRep_Tool::Curve(e, f, l).IsNull()) {
+            continue;
+        }
+        const double t = 0.5 * (f + l);
+        gp_Vec u1;
+        gp_Vec u2;
+        if (!intoFace(e, fr, t, u1) || !intoFace(e, fo, t, u2)) {
+            continue;
+        }
+        const double dihedral = Base::toDegrees(u1.Angle(u2));
+        if (dihedral + angleDeg >= 180.0 - 1e-9) {
+            std::stringstream str;
+            str.precision(6);
+            str << "The angle " << angleDeg << " deg from Face" << shape.findShape(fr) << " and the "
+                << dihedral << " deg between the faces of Edge" << shape.findShape(e)
+                << " add up to 180 deg or more: the chamfer never meets Face" << shape.findShape(fo)
+                << ". Use a smaller angle or flip the direction.";
+            return str.str();
+        }
+    }
+    return {};
+}
