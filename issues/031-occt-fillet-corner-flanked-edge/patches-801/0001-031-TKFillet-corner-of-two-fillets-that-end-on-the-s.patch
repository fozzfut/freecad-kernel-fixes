+//=======================================================================
+// function : StripeEndOnEdge
+// purpose  : true when the common point that ends the stripe on its side jfposit lies on
+//           the edge E; gives its parameter on E
+//=======================================================================
+
+static bool StripeEndOnEdge(const occ::handle<ChFiDS_Stripe>& stripe,
+                            const int                         sensS,
+                            const int                         jfposit,
+                            const int                         indice,
+                            const TopoDS_Edge&                E,
+                            double&                           par)
+{
+  const ChFiDS_CommonPoint& cp =
+    stripe->SetOfSurfData()->Value(indice)->Vertex(sensS == 1, jfposit);
+  if (!cp.IsOnArc() || !cp.Arc().IsSame(E))
+  {
+    return false;
+  }
+  par = cp.ParameterOnArc();
+  return true;
+}
