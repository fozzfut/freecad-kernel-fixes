     }
   }
 
+  // flank(ic): sharp edge ic on which the stripes on both sides of it end (parameters of their
+  // ends on it: parflm from the stripe icmoins, parflp from the stripe icplus);
+  // keepend(ic): stripe ic whose both neighbours are such edges (see below)
+  NCollection_Array1<bool>   flank(0, size);
+  NCollection_Array1<bool>   keepend(0, size);
+  NCollection_Array1<double> parflm(0, size);
+  NCollection_Array1<double> parflp(0, size);
+  NCollection_Array1<bool>   farplus(0, size); // flanked edge: the stripe icplus ends farther
+  NCollection_Array1<double> setback(0, size); // kept stripe: how far it is cut back
+  for (ic = 0; ic <= size; ic++)
+  {
+    farplus.SetValue(ic, false);
+    setback.SetValue(ic, 0.);
+    flank.SetValue(ic, false);
+    keepend.SetValue(ic, false);
+    parflm.SetValue(ic, 0.);
+    parflp.SetValue(ic, 0.);
+  }
+
   // case if there are only intersections
   // the parametres on Pcurves are the extremities of the stripe
   double para;
@@ -2062,6 +2105,133 @@ void ChFi3d_Builder::PerformMoreThreeCorner(const int Jndex, const int nconges)
       }
     }
 
+    // A rolling ball whose fillet ends on a sharp (not filleted) edge touches that edge there.
+    // When the fillets on both sides of a sharp edge both end on it at different points, the
+    // corner's boundary between them is the piece of the edge between these two points (the
+    // contact set of the rolling ball). Cutting the fillets back to one common setback distance
+    // below would move their ends off the edge onto the faces and leave the plate a G0 curve
+    // across a face there, along which it can fold. So such stripes are not cut back that way
+    // when every neighbour of theirs is such an edge, and such an edge is cut where the farther
+    // of its two fillets ends (below).
+    if (!deuxconges && !deuxcgnontg)
+    {
+      for (ic = 0; ic < nedge; ic++)
+      {
+        Indices(nedge, ic, icplus, icmoins);
+        if (!sharp.Value(ic) || sharp.Value(icplus) || sharp.Value(icmoins) || samedge.Value(ic)
+            || oksea.Value(ic) || oksea.Value(icmoins) || icplus == icmoins)
+        {
+          continue;
+        }
+        // rolling-ball fillets only: a chamfer has no ball touching the edge
+        if (occ::handle<ChFiDS_FilSpine>::DownCast(CD.Value(icmoins)->Spine()).IsNull()
+            || occ::handle<ChFiDS_FilSpine>::DownCast(CD.Value(icplus)->Spine()).IsNull())
+        {
+          continue;
+        }
+        const TopoDS_Edge& Eflank = TopoDS::Edge(Evive.Value(ic));
+        double             parm = 0., parp = 0.;
+        if (StripeEndOnEdge(CD.Value(icmoins),
+                            sens.Value(icmoins),
+                            jf.Value(icmoins),
+                            i.Value(icmoins, ic),
+                            Eflank,
+                            parm)
+            && StripeEndOnEdge(CD.Value(icplus),
+                               sens.Value(icplus),
+                               3 - jf.Value(icplus),
+                               i.Value(icplus, ic),
+                               Eflank,
+                               parp))
+        {
+          BRepAdaptor_Curve Cflank(Eflank);
+          if (Cflank.Value(parm).Distance(Cflank.Value(parp)) > tolapp)
+          {
+            flank.SetValue(ic, true);
+            parflm.SetValue(ic, parm);
+            parflp.SetValue(ic, parp);
+          }
+        }
+      }
+      bool changed = true;
+      while (changed)
+      {
+        changed = false;
+        for (ic = 0; ic < nedge; ic++)
+        {
+          Indices(nedge, ic, icplus, icmoins);
+          if (!sharp.Value(ic))
+          {
+            keepend.SetValue(ic, flank.Value(icplus) && flank.Value(icmoins));
+          }
+        }
+        for (ic = 0; ic < nedge; ic++)
+        {
+          Indices(nedge, ic, icplus, icmoins);
+          if (flank.Value(ic) && !(keepend.Value(icplus) && keepend.Value(icmoins)))
+          {
+            flank.SetValue(ic, false);
+            changed = true;
+          }
+        }
+      }
+      // The farther stripe on a flanked edge ends with its cross tangent along the edge's faces,
+      // the nearer one with its cross tangent pointing across: between the two ends the corner
+      // must turn by the angle between them within the gap along the edge. With both ends kept,
+      // no G1 surface between them is fair (its section needs an inflection), so the farther
+      // stripe is set back by that gap, as the setback vertex blends do (Varady-Rockwood), and
+      // its line on the face down to the edge becomes a G1 border of the corner. A stripe must be
+      // the farther one, or the nearer one, on both of its edges; otherwise nothing changes.
+      bool coherent = true;
+      for (ic = 0; ic < nedge; ic++)
+      {
+        if (flank.Value(ic))
+        {
+          Indices(nedge, ic, icplus, icmoins);
+          BRepAdaptor_Curve Cflank(TopoDS::Edge(Evive.Value(ic)));
+          const gp_Pnt      Pm = Cflank.Value(parflm.Value(ic));
+          const gp_Pnt      Pp = Cflank.Value(parflp.Value(ic));
+          farplus.SetValue(ic, Pp.Distance(som) > Pm.Distance(som));
+          const int    ifar = farplus.Value(ic) ? icplus : icmoins;
+          const double gap  = Pm.Distance(Pp);
+          if (gap > setback.Value(ifar))
+          {
+            setback.SetValue(ifar, gap);
+          }
+        }
+      }
+      for (ic = 0; ic < nedge; ic++)
+      {
+        if (keepend.Value(ic))
+        {
+          Indices(nedge, ic, icplus, icmoins);
+          // this stripe is icplus of the edge icmoins and icmoins of the edge icplus
+          const bool farm = farplus.Value(icmoins);
+          const bool farp = !farplus.Value(icplus);
+          if (farm != farp)
+          {
+            coherent = false;
+          }
+          // the setback must stay well inside the stripe's last piece
+          const ChFiDS_FaceInterference& fi =
+            CD.Value(ic)->SetOfSurfData()->Value(i.Value(ic, icplus))->InterferenceOnS1();
+          if (setback.Value(ic) >= 0.5 * std::abs(fi.LastParameter() - fi.FirstParameter()))
+          {
+            coherent = false;
+          }
+        }
+      }
+      if (!coherent)
+      {
+        for (ic = 0; ic <= size; ic++)
+        {
+          flank.SetValue(ic, false);
+          keepend.SetValue(ic, false);
+          setback.SetValue(ic, 0.);
+        }
+      }
+    }
+
     //  calculate max distance to the top at each point
     NCollection_Array1<double> dist1(0, size);
     NCollection_Array1<double> dist2(0, size);
@@ -2139,6 +2309,10 @@ void ChFi3d_Builder::PerformMoreThreeCorner(const int Jndex, const int nconges)
           // it is necessary to be on to remain on the edge
           p.SetValue(ic, icplus, p.Value(ic, icmoins));
         }
+        else if (keepend.Value(ic))
+        {
+          // its own end, or its setback: set below, after the common points are looked at
+        }
