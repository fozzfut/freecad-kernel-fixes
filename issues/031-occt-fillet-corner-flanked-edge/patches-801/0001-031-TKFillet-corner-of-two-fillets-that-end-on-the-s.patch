@@ -2316,6 +2490,36 @@ void ChFi3d_Builder::PerformMoreThreeCorner(const int Jndex, const int nconges)
     }
   }
 
+  // a sharp edge with fillets ending on it on both sides is cut where the farther one ended;
+  // the connection to that one is a line on the face (it is set back), the one to the nearer
+  // one is the piece of the edge
+  for (ic = 0; ic < nedge; ic++)
+  {
+    if (flank.Value(ic))
+    {
+      Indices(nedge, ic, icplus, icmoins);
+      para = farplus.Value(ic) ? parflp.Value(ic) : parflm.Value(ic);
+      p.SetValue(ic, icmoins, para);
+      p.SetValue(ic, icplus, para);
+      // the farther stripe is set back: both connections are curves
+      ponctuel.SetValue(ic, false);
+      ponctuel.SetValue(icmoins, false);
+    }
+  }
+  for (ic = 0; ic < nedge; ic++)
+  {
+    if (keepend.Value(ic))
+    {
+      Indices(nedge, ic, icplus, icmoins);
+      isfirst         = (sens.Value(ic) == 1);
+      const double ec = isfirst ? setback.Value(ic) : -setback.Value(ic);
+      Calcul_Param(CD.Value(ic), jf.Value(ic), i.Value(ic, icplus), isfirst, para);
+      p.SetValue(ic, icplus, para + ec);
+      Calcul_Param(CD.Value(ic), 3 - jf.Value(ic), i.Value(ic, icmoins), isfirst, para);
+      p.SetValue(ic, icmoins, para + ec);
+    }
+  }
+
   // in case of a free border the parameter corresponding
   // to the common point on the free edge is chosen.
 
