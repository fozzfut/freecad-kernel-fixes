+            ChFi3d_edge_common_faces(myEFMap(Efl), Fe1, Fe2);
+            const TopoDS_Face& Fb    = Fe1.IsSame(Fa) ? Fe2 : Fe1;
+            const double       pfar  = onic ? p.Value(ic, icplus) : p.Value(icplus, ic);
+            const double       pnear = onic ? parflp.Value(ic) : parflm.Value(icplus);
+            gp_Dir             nfar, nnear;
+            if (!Fb.IsSame(Fa) && NormalOnEdge(Fb, Efl, pfar, nfar)
+                && NormalOnEdge(Fa, Efl, pnear, nnear))
+            {
+              const occ::handle<Adaptor3d_CurveOnSurface> HPiv =
+                PivotBorder(pcurve, Asurf, alongce, alongrev, pfar, pnear, nfar, nnear);
+              if (!HPiv.IsNull())
+              {
+                HPlate = HPiv;
+                Order.SetValue(n3d, 1);
+              }
+            }
+          }
           occ::handle<GeomPlate_CurveConstraint> Cont =
-            new GeomPlate_CurveConstraint(HCons, Order.Value(n3d), 10, tolapp3d, angular, 0.1);
+            new GeomPlate_CurveConstraint(HPlate, Order.Value(n3d), 10, tolapp3d, angular, 0.1);
           PSurf.Add(Cont);
 
           // calculation of curve 3d if it is not a projection
