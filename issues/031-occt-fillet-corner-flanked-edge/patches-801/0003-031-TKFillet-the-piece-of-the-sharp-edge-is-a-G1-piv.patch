+//=======================================================================
+// function : NormalOnEdge
+// purpose  : outward normal of the face F at the point of parameter par of its edge E
+//=======================================================================
+
+static bool NormalOnEdge(const TopoDS_Face& F, const TopoDS_Edge& E, const double par, gp_Dir& N)
+{
+  double                          f, l;
+  const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(E, F, f, l);
+  if (pc.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d      uv = pc->Value(par);
+  BRepAdaptor_Surface S(F);
+  gp_Pnt              P;
+  gp_Vec              du, dv;
+  S.D1(uv.X(), uv.Y(), P, du, dv);
+  const gp_Vec n = du.Crossed(dv);
+  if (n.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  N = gp_Dir(n);
+  if (F.Orientation() == TopAbs_REVERSED)
+  {
+    N.Reverse();
+  }
+  return true;
+}
+
+//=======================================================================
+// function : PivotBorder
+// purpose  : the piece of a sharp edge between the ends of two fillets, as a curve on a ruled
+//           surface whose tangent plane along the edge turns about the edge from the normal nfar
+//           (edge parameter pfar) to nnear (edge parameter pnear): the tangent planes of a ball
+//           that pivots on the edge. pcurve is the piece on the face surface Asurf; its parameter
+//           is the edge's (reversed when rev, through ce). The returned curve keeps pcurve's
+//           parameter, so the plate's curve for this border matches the 3d curve of the border.
+//=======================================================================
+
+static occ::handle<Adaptor3d_CurveOnSurface> PivotBorder(
+  const occ::handle<Geom2d_Curve>&        pcurve,
+  const occ::handle<GeomAdaptor_Surface>& Asurf,
+  const occ::handle<Geom2d_Curve>&        ce,
+  const bool                              rev,
+  const double                            pfar,
+  const double                            pnear,
+  const gp_Dir&                           nfar,
+  const gp_Dir&                           nnear)
+{
+  occ::handle<Adaptor3d_CurveOnSurface> res;
+  const double                          t0 = pcurve->FirstParameter();
+  const double                          t1 = pcurve->LastParameter();
+  if (std::abs(pnear - pfar) < Precision::PConfusion() || t1 - t0 < Precision::PConfusion())
+  {
+    return res;
+  }
+  const int                                 np = 17;
+  occ::handle<NCollection_HArray1<gp_Pnt>> P0 = new NCollection_HArray1<gp_Pnt>(1, np);
+  occ::handle<NCollection_HArray1<gp_Pnt>> P1 = new NCollection_HArray1<gp_Pnt>(1, np);
+  occ::handle<NCollection_HArray1<double>> T  = new NCollection_HArray1<double>(1, np);
+  const double                              turn = nfar.Angle(nnear);
+  const gp_Vec                              axis = gp_Vec(nfar).Crossed(gp_Vec(nnear));
+  double                                    h    = 0.;
+  for (int k = 1; k <= np; k++)
+  {
+    const double t    = t0 + (t1 - t0) * (k - 1) / (np - 1);
+    const double epar = rev ? ce->ReversedParameter(t) : t;
+    double       s    = (epar - pfar) / (pnear - pfar);
+    s                 = std::min(1., std::max(0., s));
+    gp_Pnt2d     uv;
+    gp_Vec2d     duv;
+    pcurve->D1(t, uv, duv);
+    gp_Pnt P;
+    gp_Vec du, dv;
+    Asurf->D1(uv.X(), uv.Y(), P, du, dv);
+    const gp_Vec tg = du * duv.X() + dv * duv.Y();
+    if (tg.Magnitude() < gp::Resolution())
+    {
+      return res;
+    }
+    gp_Dir n = nfar;
+    if (axis.Magnitude() > gp::Resolution())
+    {
+      n.Rotate(gp_Ax1(P, gp_Dir(axis)), s * turn);
+    }
+    const gp_Vec d = gp_Vec(n).Crossed(tg);
+    if (d.Magnitude() < gp::Resolution())
+    {
+      return res;
+    }
+    P0->SetValue(k, P);
+    T->SetValue(k, t);
+    if (k > 1)
+    {
+      h += P.Distance(P0->Value(k - 1));
+    }
+    P1->SetValue(k, P.Translated(gp_Vec(gp_Dir(d)))); // unit ruling, scaled below
+  }
+  if (h < Precision::Confusion())
+  {
+    return res;
+  }
+  for (int k = 1; k <= np; k++)
+  {
+    const gp_Vec d(P0->Value(k), P1->Value(k));
+    P1->SetValue(k, P0->Value(k).Translated(d * h));
+  }
+  GeomAPI_Interpolate I0(P0, T, false, Precision::Confusion());
+  GeomAPI_Interpolate I1(P1, T, false, Precision::Confusion());
+  I0.Perform();
+  I1.Perform();
+  if (!I0.IsDone() || !I1.IsDone())
+  {
+    return res;
+  }
+  const occ::handle<Geom_BSplineCurve>& C0 = I0.Curve();
+  const occ::handle<Geom_BSplineCurve>& C1 = I1.Curve();
+  if (C0->NbPoles() != C1->NbPoles() || C0->Degree() != C1->Degree()
+      || C0->NbKnots() != C1->NbKnots())
+  {
+    return res;
+  }
+  const int                  nu = C0->NbPoles();
+  NCollection_Array2<gp_Pnt> poles(1, nu, 1, 2);
+  for (int k = 1; k <= nu; k++)
+  {
+    poles.SetValue(k, 1, C0->Pole(k));
+    poles.SetValue(k, 2, C1->Pole(k));
+  }
+  NCollection_Array1<double> vk(1, 2);
+  NCollection_Array1<int>    vm(1, 2);
+  vk.SetValue(1, 0.);
+  vk.SetValue(2, 1.);
+  vm.SetValue(1, 2);
+  vm.SetValue(2, 2);
+  occ::handle<Geom_BSplineSurface> piv = new Geom_BSplineSurface(poles,
+                                                                  C0->Knots(),
+                                                                  vk,
+                                                                  C0->Multiplicities(),
+                                                                  vm,
+                                                                  C0->Degree(),
+                                                                  1);
+  occ::handle<Geom2d_Line>         l  = new Geom2d_Line(gp_Pnt2d(0., 0.), gp_Dir2d(1., 0.));
+  occ::handle<Geom2d_TrimmedCurve> lt = new Geom2d_TrimmedCurve(l, t0, t1);
+  occ::handle<Geom2dAdaptor_Curve> ac = new Geom2dAdaptor_Curve(lt);
+  occ::handle<GeomAdaptor_Surface> as = new GeomAdaptor_Surface(piv);
+  res = new Adaptor3d_CurveOnSurface(Adaptor3d_CurveOnSurface(ac, as));
+  return res;
+}
