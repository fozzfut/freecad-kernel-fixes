+/*!
+  Ends a seek that is still under way (the timed flight of seekToPoint). The seek writes the
+  camera pose absolutely on every step, so another camera motion started or placed while it runs
+  would be overwritten by it. With \a finish the camera takes the seek's end pose first, as at its
+  last step; otherwise it stays where the seek has brought it. A seek started from seek mode ends
+  as at its own end (setSeekMode(false)); a seek started directly by seekToPoint leaves the modes
+  as they are. Nothing happens when no seek runs.
+*/
+void SIM::Coin3D::Quarter::SoQTQuarterAdaptor::endSeek(bool finish)
+{
+    if (!m_seeksensor->isScheduled()) {
+        return;
+    }
+
+    SoCamera* cam = getSoRenderManager()->getCamera();
+    if (finish && cam) {
+        cam->position = m_cameraendposition;
+        cam->orientation = m_cameraendorient;
+    }
+
+    if (m_inseekmode) {
+        this->setSeekMode(false);
+    }
+    else {
+        m_seeksensor->unschedule();
+        interactiveCountDec();
+    }
+}
+
 void SIM::Coin3D::Quarter::SoQTQuarterAdaptor::setSeekDistance(const float distance)
 {
     m_seekdistance = distance;
