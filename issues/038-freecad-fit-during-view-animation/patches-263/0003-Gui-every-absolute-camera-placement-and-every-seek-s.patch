 void NavigationStyle::startAnimating(const std::shared_ptr<NavigationAnimation>& animation, bool wait) const
 {
+    // A seek still under way writes the camera pose absolutely on every step: it would undo this
+    // animation and, at its end (setSeekMode(false)), stop it. The new motion replaces it, as it
+    // replaces a running animation (NavigationAnimator::start stops that where it is).
