+/**
+ * @brief Starts a seek (Quarter's timed flight to the picked point)
+ *
+ * The seek writes the camera pose absolutely on every step: a view animation still running would
+ * go on turning the pose about its own rotation centre at the same time, so it is stopped first
+ * (as setSeekMode(true) stops it before the seek mode's point is picked).
+ */
+bool View3DInventorViewer::seekToPoint(const SbVec2s& screenpos)
+{
+    navigation->stopAnimating();
+    return inherited::seekToPoint(screenpos);
+}
+
+void View3DInventorViewer::seekToPoint(const SbVec3f& scenepos)
+{
+    navigation->stopAnimating();
+    inherited::seekToPoint(scenepos);
+}
