+      return;
+    }
+    for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+    {
+      const TopoDS_Shape& anEdge = anExp.Current();
+      EdgeOccurrence*     anOcc  = theRecord.Edges.ChangeSeek(anEdge);
+      if (anOcc == nullptr)
