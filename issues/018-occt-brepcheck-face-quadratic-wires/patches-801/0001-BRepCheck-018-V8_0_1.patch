diff --git a/src/ModelingAlgorithms/TKTopAlgo/BRepCheck/BRepCheck_BoxPairs.hxx b/src/ModelingAlgorithms/TKTopAlgo/BRepCheck/BRepCheck_BoxPairs.hxx
