+
+#ifndef _BRepCheck_FaceCache_HeaderFile
+#define _BRepCheck_FaceCache_HeaderFile
+
+#include <Geom_Surface.hxx>
+#include <NCollection_List.hxx>
+#include <Standard.hxx>
+#include <TopoDS_Shape.hxx>
+
+//! Defect 018, Task 6b (internal, not exported). Results that depend only on one face and that
+//! BRepCheck recomputed for every wire or edge of that face:
+//!  - Seams: the seam edges IsClosed2dForPeriodicFace() (BRepCheck_Wire.cxx) collects by walking
+//!    every edge of the face - for every wire of the face, W * E steps;
+//!  - Surface: the face surface in position, Su->Transformed((Floc * TFloc).Transformation()),
+//!    which BRepCheck_Edge::InContext() copied for every edge of the face.
+//! They are kept only while a BRepCheck_FaceCacheScope lives on the calling thread - one per call of
+//! the analyzer's worker (BRepCheck_ParallelAnalyzer::operator(), one chunk of shapes), which reads
+//! shapes and never modifies them; nested scopes (a thread that steals another chunk while it
+//! waits) stack and restore - and only for the last face asked for (IsEqual: the same TShape,
+//! location and orientation - the explored edges carry the face's orientation). A value is stored
+//! only after it was computed completely: an exception leaves it empty, and the next caller
+//! computes (and throws) again, as before. Without a scope Get() returns nullptr and the callers
+//! compute everything as before.
+class BRepCheck_FaceCache
+{
+public:
+  //! The entry of theFace on this thread, or nullptr without a scope. Another face than the last
+  //! one empties it.
+  static BRepCheck_FaceCache* Get(const TopoDS_Shape& theFace);
+
+  bool                           HasSeams = false; //!< Seams holds the complete list of the face
+  NCollection_List<TopoDS_Shape> Seams;
+  occ::handle<Geom_Surface>      Surface; //!< null until computed
+
+private:
+  friend class BRepCheck_FaceCacheScope;
+  TopoDS_Shape myFace;
+};
+
+//! Defect 018, Task 6b: makes BRepCheck_FaceCache::Get() keep its entry on this thread for its
+//! lifetime.
+class BRepCheck_FaceCacheScope
+{
+public:
+  BRepCheck_FaceCacheScope();
+  ~BRepCheck_FaceCacheScope();
+
+  BRepCheck_FaceCacheScope(const BRepCheck_FaceCacheScope&)            = delete;
+  BRepCheck_FaceCacheScope& operator=(const BRepCheck_FaceCacheScope&) = delete;
+
+private:
+  BRepCheck_FaceCache  myCache;
+  BRepCheck_FaceCache* myPrev;
+};
+
+#ifdef BREPCHECK_VERIFY_018
+//! Verification build only (defect 018; never shipped). Every new path compares its answer with
+//! the stock computation on every call; a difference is counted and logged, the run goes on.
+//!  BRCHK018_BREAK=<what>  spoils the new path <what> (negative control): fpairs, classify,
+//!                         forient, subshape, pairs, orient, seams, surface, occ, nbset;
+//!  BRCHK018_NOVERIFY=1    skips the comparisons, so a spoiled answer reaches the statuses;
+//!  BRCHK018_LOG=<file>    receives "MISMATCH <what> <detail>" per difference and, at process
+//!                         exit, "VERIFY-SUMMARY <what> calls=<n> mismatches=<m>" per path.
+bool BRepCheck_VerifyBreak(const char* theWhat);
+bool BRepCheck_VerifyOn();
+void BRepCheck_VerifyLog(const char* theLine);
+void BRepCheck_VerifyCall(const char* theWhat);
+void BRepCheck_VerifyFail(const char* theWhat, const char* theDetail);
+#endif
+
+#endif // _BRepCheck_FaceCache_HeaderFile
