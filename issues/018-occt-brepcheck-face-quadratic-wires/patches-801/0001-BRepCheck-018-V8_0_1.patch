+          aSame = aSame && anExp.More() == anOcc->HasSecond
+                  && (!anExp.More() || anExp.Current().Orientation() == anOcc->Second);
+        }
+        if (!aSame)
+        {
+          BRepCheck_VerifyFail("occ", "edge occurrence record != the explorer walk");
+        }
+      }
