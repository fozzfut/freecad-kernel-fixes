+//! the caller walks as before (and so meets the walk's exception, TopExp_Explorer.cxx:125, where
+//! the walk would).
+struct EdgeOccurrence
+{
+  TopAbs_Orientation First;
+  bool               HasSecond;
+  TopAbs_Orientation Second;
+};
+
+class FaceEdgeOccurrences
+{
+public:
+  const EdgeOccurrence* Find(const TopoDS_Shape& theFace, const TopoDS_Shape& theEdge)
+  {
+    const int* anIndex = myIndex.Seek(theFace);
+    if (anIndex == nullptr)
+    {
+      myRecords.emplace_back();
+      record(theFace, myRecords.back());
+      anIndex = myIndex.Bound(theFace, (int)myRecords.size() - 1);
+    }
+    const Record&         aRecord = myRecords[(size_t)*anIndex];
+    const EdgeOccurrence* anOcc   = aRecord.Mapped ? aRecord.Edges.Seek(theEdge) : nullptr;
+#ifdef BREPCHECK_VERIFY_018
+    if (aRecord.Mapped)
+    {
+      BRepCheck_VerifyCall("occ");
+      static thread_local EdgeOccurrence THE_SPOILED;
+      if (anOcc != nullptr && BRepCheck_VerifyBreak("occ"))
+      {
+        THE_SPOILED       = *anOcc;
+        THE_SPOILED.First = TopAbs::Reverse(THE_SPOILED.First);
+        anOcc             = &THE_SPOILED;
+      }
+      if (BRepCheck_VerifyOn())
+      {
+        // the stock walk: first IsSame occurrence, then the next one
+        TopExp_Explorer anExp(theFace, TopAbs_EDGE);
+        while (anExp.More() && !anExp.Current().IsSame(theEdge))
+          anExp.Next();
+        bool aSame = anExp.More() == (anOcc != nullptr);
+        if (aSame && anOcc != nullptr)
+        {
+          aSame = anExp.Current().Orientation() == anOcc->First;
+          anExp.Next();
+          while (anExp.More() && !anExp.Current().IsSame(theEdge))
