+// Copyright (c) 2026 - modification of Open CASCADE Technology 8.0.1 for FreeCAD (defect 018,
+// https://github.com/fozzfut/freecad-kernel-fixes). Distributed under GNU LGPL 2.1 with the Open
+// CASCADE exception, as the rest of OCCT.
+
+#include <BRepCheck_FaceCache.hxx>
+
+namespace
+{
+//! the cache of the innermost BRepCheck_FaceCacheScope of this thread, or nullptr
+thread_local BRepCheck_FaceCache* THE_ACTIVE_FACE_CACHE = nullptr;
+} // namespace
+
+BRepCheck_FaceCacheScope::BRepCheck_FaceCacheScope()
+    : myPrev(THE_ACTIVE_FACE_CACHE)
+{
+  THE_ACTIVE_FACE_CACHE = &myCache;
+}
+
+BRepCheck_FaceCacheScope::~BRepCheck_FaceCacheScope()
+{
+  THE_ACTIVE_FACE_CACHE = myPrev;
+}
+
+BRepCheck_FaceCache* BRepCheck_FaceCache::Get(const TopoDS_Shape& theFace)
+{
+  BRepCheck_FaceCache* aCache = THE_ACTIVE_FACE_CACHE;
+  if (aCache == nullptr)
+  {
+    return nullptr;
+  }
+  if (!aCache->myFace.IsEqual(theFace))
+  {
+    aCache->myFace   = theFace;
+    aCache->HasSeams = false;
+    aCache->Seams.Clear();
+    aCache->Surface.Nullify();
+  }
+  return aCache;
+}
+
+#ifdef BREPCHECK_VERIFY_018
+  #include <cstdio>
+  #include <cstdlib>
+  #include <cstring>
+  #include <map>
+  #include <mutex>
+  #include <string>
+
+namespace
+{
+std::mutex& verifyMutex()
+{
+  static std::mutex THE_MUTEX;
+  return THE_MUTEX;
+}
+
+//! calls and mismatches per path; written to BRCHK018_LOG and stderr at process exit
+struct VerifyCounters
+{
+  std::map<std::string, std::pair<long long, long long>> Counts;
+
+  ~VerifyCounters()
+  {
+    for (const auto& aCount : Counts)
+    {
+      char aLine[256];
+      std::snprintf(aLine,
+                    sizeof(aLine),
+                    "VERIFY-SUMMARY %s calls=%lld mismatches=%lld",
+                    aCount.first.c_str(),
+                    aCount.second.first,
+                    aCount.second.second);
+      BRepCheck_VerifyLog(aLine);
+      std::fprintf(stderr, "BRCHK018 %s\n", aLine);
+    }
+    std::fflush(stderr);
+  }
+};
+
+VerifyCounters& verifyCounters()
+{
+  static VerifyCounters THE_COUNTERS;
+  return THE_COUNTERS;
+}
+} // namespace
+
+bool BRepCheck_VerifyBreak(const char* theWhat)
+{
+  const char* aBreak = std::getenv("BRCHK018_BREAK");
+  return aBreak != nullptr && std::strcmp(aBreak, theWhat) == 0;
+}
+
+bool BRepCheck_VerifyOn()
+{
+  return std::getenv("BRCHK018_NOVERIFY") == nullptr;
+}
+
+void BRepCheck_VerifyLog(const char* theLine)
+{
+  if (const char* aPath = std::getenv("BRCHK018_LOG"))
+  {
+    if (FILE* aFile = std::fopen(aPath, "a"))
+    {
+      std::fprintf(aFile, "%s\n", theLine);
+      std::fclose(aFile);
+    }
+  }
+}
+
+void BRepCheck_VerifyCall(const char* theWhat)
+{
+  std::lock_guard<std::mutex> aLock(verifyMutex());
+  ++verifyCounters().Counts[theWhat].first;
+}
+
+void BRepCheck_VerifyFail(const char* theWhat, const char* theDetail)
+{
+  std::lock_guard<std::mutex> aLock(verifyMutex());
+  const long long aNb = ++verifyCounters().Counts[theWhat].second;
+  if (aNb <= 20)
+  {
+    char aLine[512];
+    std::snprintf(aLine, sizeof(aLine), "MISMATCH %s %s", theWhat, theDetail);
+    BRepCheck_VerifyLog(aLine);
+    std::fprintf(stderr, "BRCHK018 %s\n", aLine);
+    std::fflush(stderr);
+  }
+}
+#endif
