@@ -0,0 +1,161 @@
+// Copyright (c) 2026 - modification of Open CASCADE Technology 8.0.1 for FreeCAD (defect 018,
+// https://github.com/fozzfut/freecad-kernel-fixes). Distributed under GNU LGPL 2.1 with the Open
+// CASCADE exception, as the rest of OCCT.
+
+#ifndef _BRepCheck_BoxPairs_HeaderFile
+#define _BRepCheck_BoxPairs_HeaderFile
+
+#include <Bnd_Box2d.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdlib>
+#include <utility>
+#include <vector>
+
+//! Defect 018 (internal, not exported). BRepCheck visits pairs of 2D boxes (wires of a face, edges
+//! of a wire) and skips a pair when Bnd_Box2d::IsOut() says the boxes are apart; the loops test all
+//! N^2/2 pairs. Candidates() finds, by a sweep, a SUPERSET of the pairs that such a test does not
+//! skip; every caller then applies the loop's own test, with the loop's roles, to each candidate
+//! and visits the survivors in the loop's order. So the visited pairs are exactly the loop's.
+//!
+//! Why a superset (OCCT 8.0.1, Bnd_Box2d.cxx:456-479). For two boxes without flags (not void, not
+//! open, not whole) IsOut() is the fast path
+//!   A.Xmin - B.Xmax > A.Gap + B.Gap  or  B.Xmin - A.Xmax > ...  (same on y),
+//! and it is symmetric in A and B. It is not bit-for-bit the test "the Get() ranges are apart"
+//! (Get() rounds Xmin - Gap and Xmax + Gap separately), so the sweep does not compare the Get()
+//! ranges themselves: every range is widened by s = 1e-9 * (1 + 2 (|lo| + |hi|) + 4 Gap) on each
+//! side (lo, hi from Get(); |Xmin| <= |lo| + Gap, |Xmax| <= |hi| + Gap). If IsOut() is false, then
+//! in real numbers A.lo - B.hi <= 4u (|A.Xmin| + |B.Xmax| + A.Gap + B.Gap) + u (|A.lo| + |B.hi|)
+//! (u = 2^-53: one rounding in each of the subtraction, the sum of the gaps and the two Get()
+//! values), far below s_A + s_B, so the widened ranges overlap on both axes and the sweep reports
+//! the pair. The sweep only compares the widened doubles, it computes nothing with them.
+//! A box that is null (no box), void, open, whole, or whose widened range is not finite (NaN or
+//! overflow) is "special": it is paired with every other box, and the caller's own test decides.
+class BRepCheck_BoxPairs
+{
+public:
+  //! Unordered pairs (a, b), a < b, of indices into theBoxes, sorted and unique, that contain every
+  //! pair whose boxes IsOut() does not separate (see the class comment). Returns false (the caller
+  //! runs its original loop) if there would be more than theLimit candidates. May throw
+  //! std::bad_alloc (the callers catch it and run their original loop).
+  static bool Candidates(const std::vector<const Bnd_Box2d*>& theBoxes,
+                         const size_t                         theLimit,
+                         std::vector<std::pair<int, int>>&    thePairs)
+  {
+    thePairs.clear();
+    const int aNb = (int)theBoxes.size();
+    if (aNb < 2)
+    {
+      return true;
+    }
+    std::vector<int>    aFinite, aSpecial;
+    std::vector<double> aLo[2], aHi[2];
+    for (int a = 0; a < 2; ++a)
+    {
+      aLo[a].assign((size_t)aNb, 0.);
+      aHi[a].assign((size_t)aNb, 0.);
+    }
+#ifdef BREPCHECK_VERIFY_018
+    // verification build: BRCHK018_ALLPAIRS=1 makes every box special (all pairs are candidates),
+    // so the callers' own tests alone decide - the path of faces without reliable boxes
+    const bool isAllPairs = std::getenv("BRCHK018_ALLPAIRS") != nullptr;
+#else
+    const bool isAllPairs = false;
+#endif
+    for (int i = 0; i < aNb; ++i)
+    {
+      const Bnd_Box2d* aBox = theBoxes[(size_t)i];
+      if (isAllPairs || aBox == nullptr || aBox->IsVoid() || aBox->IsWhole() || aBox->IsOpenXmin()
+          || aBox->IsOpenXmax() || aBox->IsOpenYmin() || aBox->IsOpenYmax())
+      {
+        aSpecial.push_back(i);
+        continue;
+      }
+      double aX0 = 0., aY0 = 0., aX1 = 0., aY1 = 0.;
+      aBox->Get(aX0, aY0, aX1, aY1);
+      const double aGap = aBox->GetGap();
+      const double aSx  = 1.e-9 * (1. + 2. * (std::fabs(aX0) + std::fabs(aX1)) + 4. * aGap);
+      const double aSy  = 1.e-9 * (1. + 2. * (std::fabs(aY0) + std::fabs(aY1)) + 4. * aGap);
+      aLo[0][(size_t)i] = aX0 - aSx;
+      aHi[0][(size_t)i] = aX1 + aSx;
+      aLo[1][(size_t)i] = aY0 - aSy;
+      aHi[1][(size_t)i] = aY1 + aSy;
+      if (std::isfinite(aLo[0][(size_t)i]) && std::isfinite(aHi[0][(size_t)i])
+          && std::isfinite(aLo[1][(size_t)i]) && std::isfinite(aHi[1][(size_t)i]))
+      {
+        aFinite.push_back(i);
+      }
+      else
+      {
+        aSpecial.push_back(i); // NaN would break the ordering of the sort: not swept
+      }
+    }
+    for (size_t s = 0; s < aSpecial.size(); ++s)
+    {
+      for (int j = 0; j < aNb; ++j)
+      {
+        if (j != aSpecial[s])
+        {
+          thePairs.push_back(std::make_pair(std::min(aSpecial[s], j), std::max(aSpecial[s], j)));
+        }
+      }
+      if (thePairs.size() > theLimit)
+      {
+        return false;
+      }
+    }
+    // sweep along the axis on which the ranges overlap less (either axis gives the same pairs)
+    double aDensity[2] = {0., 0.};
+    for (int a = 0; a < 2 && !aFinite.empty(); ++a)
+    {
+      double aSum = 0., aMin = aLo[a][(size_t)aFinite[0]], aMax = aHi[a][(size_t)aFinite[0]];
+      for (size_t k = 0; k < aFinite.size(); ++k)
+      {
+        const size_t i = (size_t)aFinite[k];
+        aSum += aHi[a][i] - aLo[a][i];
+        aMin = std::min(aMin, aLo[a][i]);
+        aMax = std::max(aMax, aHi[a][i]);
+      }
+      aDensity[a] = aSum / std::max(aMax - aMin, 1.e-300);
+    }
+    const int        anA = (aDensity[1] < aDensity[0]) ? 1 : 0;
+    const int        anO = 1 - anA;
+    std::vector<int> anOrder(aFinite);
+    std::sort(anOrder.begin(), anOrder.end(), [&](const int theA, const int theB) {
+      return aLo[anA][(size_t)theA] < aLo[anA][(size_t)theB]
+             || (aLo[anA][(size_t)theA] == aLo[anA][(size_t)theB] && theA < theB);
+    });
+    std::vector<int> anActive;
+    for (size_t k = 0; k < anOrder.size(); ++k)
+    {
+      const int c     = anOrder[k];
+      size_t    aKeep = 0;
+      for (size_t m = 0; m < anActive.size(); ++m)
+      {
+        const int b = anActive[m];
+        if (aHi[anA][(size_t)b] < aLo[anA][(size_t)c])
+        {
+          continue; // apart from c and from every later box on this axis: leaves the active list
+        }
+        anActive[aKeep++] = b;
+        if (!(aHi[anO][(size_t)b] < aLo[anO][(size_t)c] || aLo[anO][(size_t)b] > aHi[anO][(size_t)c]))
+        {
+          thePairs.push_back(std::make_pair(std::min(b, c), std::max(b, c)));
+        }
+      }
+      anActive.resize(aKeep);
+      anActive.push_back(c);
+      if (thePairs.size() > theLimit)
+      {
+        return false;
+      }
+    }
+    std::sort(thePairs.begin(), thePairs.end());
+    thePairs.erase(std::unique(thePairs.begin(), thePairs.end()), thePairs.end());
+    return true;
+  }
+};
+
+#endif // _BRepCheck_BoxPairs_HeaderFile
