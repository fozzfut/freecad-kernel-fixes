+    }
+    double x = theP.X(), y = theP.Y();
+    if (std::isnan(x) || std::isnan(y))
+    {
+      return false;
+    }
+    x = transform2d(x, myCslUmin, myCslUmax - myCslUmin); // as SiDans, CSLib_Class2d.cxx:163-164
+    y = transform2d(y, myCslVmin, myCslVmax - myCslVmin);
+    const double aMx =
+      1.e-9 * (1. + std::fabs(x) + std::fabs(myPolyXmin) + std::fabs(myPolyXmax) + myCslTolu);
+    const double aMy =
+      1.e-9 * (1. + std::fabs(y) + std::fabs(myPolyYmin) + std::fabs(myPolyYmax) + myCslTolv);
+    return x < myPolyXmin - myCslTolu - aMx || x > myPolyXmax + myCslTolu + aMx
+           || y < myPolyYmin - myCslTolv - aMy || y > myPolyYmax + myCslTolv + aMy;
+  }
+
+  //! Defect 018. What Perform(P, false) returns when SiDans(P) == -1 on the only classifier:
+  //! TopAbs_OUT if its wire is an outer one (TabOrien 1), else TopAbs_IN
+  //! (BRepTopAdaptor_FClass2d.cxx:595-636 @V8_0_1). Meaningful only where IsFarOutside() is true.
+  TopAbs_State OutsideState() const
+  {
+    return (TabOrien.Length() >= 1 && TabOrien(1) == 1) ? TopAbs_OUT : TopAbs_IN;
+  }
+
+  //! Defect 018. A box in the face's (u, v) that contains every finite point for which
+  //! IsFarOutside() is false (a superset: it only chooses which points are looked at). false if
+  //! there is no such finite box - then every point has to be looked at. IsFarOutside() is false
+  //! only for a normalized x within [myPolyXmin - myCslTolu - aMx, myPolyXmax + myCslTolu + aMx]
+  //! (same on y); the box maps that range back to u by the inverse of transform2d() and widens it
+  //! by 1e-6 relative, far above both the 1e-9 margin and the rounding of the inverse.
+  bool NearBox(double& theU0, double& theV0, double& theU1, double& theV1) const
+  {
+    if (TabClass.Length() != 1 || TabOrien(1) == -1 || !myPolyOk)
+    {
+      return false;
+    }
+    const double du = myCslUmax - myCslUmin, dv = myCslVmax - myCslVmin;
+    const double aX0 = myPolyXmin - myCslTolu, aX1 = myPolyXmax + myCslTolu;
+    const double aY0 = myPolyYmin - myCslTolv, aY1 = myPolyYmax + myCslTolv;
+    theU0            = du > 1e-10 ? myCslUmin + aX0 * du : aX0;
+    theU1            = du > 1e-10 ? myCslUmin + aX1 * du : aX1;
+    theV0            = dv > 1e-10 ? myCslVmin + aY0 * dv : aY0;
+    theV1            = dv > 1e-10 ? myCslVmin + aY1 * dv : aY1;
+    const double aPu = 1.e-6 * (1. + std::fabs(theU0) + std::fabs(theU1) + std::fabs(du));
+    const double aPv = 1.e-6 * (1. + std::fabs(theV0) + std::fabs(theV1) + std::fabs(dv));
+    theU0 -= aPu;
+    theU1 += aPu;
+    theV0 -= aPv;
+    theV1 += aPv;
+    return std::isfinite(theU0) && std::isfinite(theU1) && std::isfinite(theV0)
+           && std::isfinite(theV1);
+  }
+
+private:
+  //! == transformToNormalized of CSLib_Class2d.cxx:30-38 @V8_0_1
+  static double transform2d(const double u, const double umin, const double umaxmumin)
+  {
+    if (umaxmumin > 1e-10)
+    {
+      return (u - umin) / umaxmumin;
+    }
+    return u;
+  }
+
+  //! Defect 018: called right after each "TabClass.Append(CSLib_Class2d(thePnts, theTolU, theTolV,
+  //! theUMin, theVMin, theUMax, theVMax))" of the constructor; stores what CSLib_Class2d::init
+  //! (CSLib_Class2d.cxx:43-99 @V8_0_1) derives from them. Only scalars: it allocates nothing.
+  void recordPolygon(const NCollection_Array1<gp_Pnt2d>& thePnts,
+                     const double                        theTolU,
+                     const double                        theTolV,
+                     const double                        theUMin,
+                     const double                        theVMin,
+                     const double                        theUMax,
+                     const double                        theVMax)
+  {
+    myPolyOk  = false;
+    myCslUmin = theUMin;
+    myCslVmin = theVMin;
+    myCslUmax = theUMax;
+    myCslVmax = theVMax;
+    if (theUMax <= theUMin || theVMax <= theVMin || thePnts.Length() < 3)
+    {
+      return; // CSLib_Class2d keeps myPointsCount = 0: SiDans() returns 0
+    }
+    const double aPrc = 1.e-10;
+    const double du = theUMax - theUMin, dv = theVMax - theVMin;
+    myCslTolu       = theTolU;
+    myCslTolv       = theTolV;
+    if (du > aPrc)
+    {
+      myCslTolu /= du;
+    }
+    if (dv > aPrc)
+    {
+      myCslTolv /= dv;
+    }
+    double aX0 = 0., aX1 = 0., aY0 = 0., aY1 = 0.;
+    for (int i = thePnts.Lower(); i <= thePnts.Upper(); ++i)
+    {
+      const double x = transform2d(thePnts(i).X(), theUMin, du);
+      const double y = transform2d(thePnts(i).Y(), theVMin, dv);
+      if (!std::isfinite(x) || !std::isfinite(y))
+      {
+        return;
+      }
+      if (i == thePnts.Lower())
+      {
+        aX0 = aX1 = x;
+        aY0 = aY1 = y;
+      }
+      aX0 = x < aX0 ? x : aX0;
+      aX1 = x > aX1 ? x : aX1;
+      aY0 = y < aY0 ? y : aY0;
+      aY1 = y > aY1 ? y : aY1;
+    }
+    myPolyXmin = aX0;
+    myPolyXmax = aX1;
+    myPolyYmin = aY0;
+    myPolyYmax = aY1;
+    myPolyOk   = std::isfinite(myCslTolu) && std::isfinite(myCslTolv) && std::isfinite(du)
+               && std::isfinite(dv) && std::isfinite(theUMin) && std::isfinite(theVMin);
+  }
+
+  NCollection_Sequence<CSLib_Class2d> TabClass;
+  NCollection_Sequence<int>           TabOrien;
+  double                              Toluv;
+  TopoDS_Face                         Face;
+  double                              U1;
+  double                              V1;
+  double                              U2;
+  double                              V2;
+  double                              Umin;
+  double                              Umax;
+  double                              Vmin;
+  double                              Vmax;
+
+  // defect 018: copies of what the (only) CSLib_Class2d was built from, see recordPolygon()
+  bool   myPolyOk  = false;
+  double myCslUmin = 0., myCslVmin = 0., myCslUmax = 0., myCslVmax = 0.;
+  double myCslTolu = 0., myCslTolv = 0.;
+  double myPolyXmin = 0., myPolyXmax = 0., myPolyYmin = 0., myPolyYmax = 0.;
+};
