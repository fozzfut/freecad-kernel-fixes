+
+namespace
+{
+//! Defect 018: the answer of the original IsInside() (BRepCheck_Face.cxx:934-941 @V8_0_1) for the
+//! state of its point.
+inline bool InsideByState(const TopAbs_State theState, const bool theWireBienOriente)
+{
+  return theWireBienOriente ? (theState == TopAbs_OUT) : (theState == TopAbs_IN);
+}
+
+//! Defect 018: FClass2d.IsFarOutside(theP) for a finite point only: a point with an infinite or NaN
+//! coordinate always gets the full Perform(theP, false). The shortcut is used with Perform(P, false)
+//! only - the call IsFarOutside() is proven for.
+inline bool IsProvenFarOutside(const BRepCheck_WireClass2d& theClass, const gp_Pnt2d& theP)
+{
+  return std::isfinite(theP.X()) && std::isfinite(theP.Y()) && theClass.IsFarOutside(theP);
+}
+
+//! Defect 018: the point the original IsInside() classifies for one wire, computed once.
+struct WirePoint
+{
+  int      State = 0; //!< 0 - not computed yet, 1 - Point is valid, 2 - IsInside() finds no edge
+  gp_Pnt2d Point;
+};
+
+//! Defect 018: uniform grid over the valid points of a vector of WirePoint (about one point per
+//! cell, cells shaped like the point cloud). Query() gives, in ascending index order, every index
+//! whose point lies in the box, plus every point with a non-finite coordinate (the grid cannot
+//! place those).
+class PointGrid
+{
+public:
+  void Build(const std::vector<WirePoint>& thePoints)
+  {
+    myAlways.clear();
+    double x0 = 0., y0 = 0., x1 = 0., y1 = 0.;
