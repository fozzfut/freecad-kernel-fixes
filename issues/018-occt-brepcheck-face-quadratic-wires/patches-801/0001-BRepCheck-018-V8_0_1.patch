+  }
+
+private:
+  struct Record
+  {
+    bool                                                                       Mapped = false;
+    NCollection_DataMap<TopoDS_Shape, EdgeOccurrence, TopTools_ShapeMapHasher> Edges;
+  };
+
+  static void record(const TopoDS_Shape& theFace, Record& theRecord)
+  {
+    int aNb = 0;
+    for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More() && aNb <= 32; anExp.Next())
+    {
+      ++aNb;
+    }
+    theRecord.Mapped = aNb > 32;
+    if (!theRecord.Mapped)
