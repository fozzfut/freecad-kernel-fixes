+// https://github.com/fozzfut/freecad-kernel-fixes). Distributed under GNU LGPL 2.1 with the Open
+// CASCADE exception, as the rest of OCCT.
+
+#ifndef _BRepCheck_SubShapeIndex_HeaderFile
+#define _BRepCheck_SubShapeIndex_HeaderFile
+
+#include <NCollection_Map.hxx>
+#include <Standard.hxx>
+#include <TopAbs_ShapeEnum.hxx>
+#include <TopoDS_Shape.hxx>
+#include <TopTools_ShapeMapHasher.hxx>
+
+//! Defect 018 (internal, not exported). BRepCheck_Vertex/Edge/Wire/Face::InContext(S) first check
+//! that their shape is a sub-shape of S by walking TopExp_Explorer(S, type) until IsSame(): for a
+//! face with n wires (edges, vertices) that is n^2/2 steps. Contains() gives the same answer.
+//! While a BRepCheck_SubShapeScope lives on the calling thread (one per call of the analyzer's
+//! worker, which does not modify shapes), the sub-shapes of the last context are kept in a map
+//! (TopTools_ShapeMapHasher: IsSame(), as the walk), so the check is O(1). The map is built only
+//! when the same context has already been walked 32 times (the analyzer asks once per sub-shape,
+//! so only a context with more than 32 sub-shapes of the type gets one): a smaller context - most
+//! faces - is walked, as before, with no counting pass and no allocation; an edge context (its
+//! vertices) is always walked directly.
+class BRepCheck_SubShapeIndex
+{
+public:
+  //! == TopExp_Explorer anExp (theContext, theType);
+  //!    for (; anExp.More(); anExp.Next()) { if (anExp.Current().IsSame (theSub)) break; }
+  //!    return anExp.More();
+  static bool Contains(const TopoDS_Shape&    theContext,
+                       const TopAbs_ShapeEnum theType,
+                       const TopoDS_Shape&    theSub);
+
+private:
+  friend class BRepCheck_SubShapeScope;
+  TopoDS_Shape     myContext;
+  TopAbs_ShapeEnum myType    = TopAbs_SHAPE;
+  int              myNbWalks = 0;     //!< walks done in myContext (a map is built at the 33rd call)
+  bool             myMapped  = false; //!< mySubs holds all the sub-shapes of myContext (set only
+                                      //!< after a complete build; an exception other than
+                                      //!< out-of-memory from the explorer leaves a partial mySubs
+                                      //!< with myMapped false: the next call on this context
+                                      //!< completes it, a new context clears it first)
+  bool             myNoMap   = false; //!< the map could not be allocated: myContext is walked
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> mySubs;
+};
+
+//! Defect 018: makes BRepCheck_SubShapeIndex::Contains() keep its map on this thread for its
+//! lifetime.
+class BRepCheck_SubShapeScope
+{
+public:
+  BRepCheck_SubShapeScope();
+  ~BRepCheck_SubShapeScope();
+
+  BRepCheck_SubShapeScope(const BRepCheck_SubShapeScope&)            = delete;
+  BRepCheck_SubShapeScope& operator=(const BRepCheck_SubShapeScope&) = delete;
+
+private:
+  BRepCheck_SubShapeIndex  myIndex;
+  BRepCheck_SubShapeIndex* myPrev;
+};
+
+#endif // _BRepCheck_SubShapeIndex_HeaderFile
