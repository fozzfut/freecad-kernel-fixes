+      }
+      else if (!anOcc->HasSecond)
+      {
+        anOcc->HasSecond = true;
+        anOcc->Second    = anEdge.Orientation();
+      }
+    }
+  }
+
+  NCollection_DataMap<TopoDS_Shape, int> myIndex; //!< face (IsEqual) -> index in myRecords
+  std::deque<Record>                     myRecords;
+};
