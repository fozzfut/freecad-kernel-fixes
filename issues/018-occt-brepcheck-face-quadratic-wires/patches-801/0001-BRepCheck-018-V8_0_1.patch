+++ b/src/ModelingAlgorithms/TKTopAlgo/BRepCheck/BRepCheck_SubShapeIndex.cxx
@@ -0,0 +1,129 @@
+// Copyright (c) 2026 - modification of Open CASCADE Technology 8.0.1 for FreeCAD (defect 018,
+// https://github.com/fozzfut/freecad-kernel-fixes). Distributed under GNU LGPL 2.1 with the Open
+// CASCADE exception, as the rest of OCCT.
+
+#include <BRepCheck_SubShapeIndex.hxx>
+#include <BRepCheck_FaceCache.hxx>
+
+#include <Standard_OutOfMemory.hxx>
+#include <TopExp_Explorer.hxx>
+
+#include <new>
+
+namespace
+{
+//! the index of the innermost BRepCheck_SubShapeScope of this thread, or nullptr
+thread_local BRepCheck_SubShapeIndex* THE_ACTIVE_INDEX = nullptr;
+
+//! a context is walked this many times before its map is built (building a map allocates; walking
+//! a few sub-shapes is cheaper, and the analyzer asks once per sub-shape, so a small context never
+//! gets a map)
+const int THE_MAX_WALKED = 32;
+
+//! the original check of InContext()
+bool walk(const TopoDS_Shape& theContext, const TopAbs_ShapeEnum theType, const TopoDS_Shape& theSub)
+{
+  TopExp_Explorer anExp(theContext, theType);
+  for (; anExp.More(); anExp.Next())
+  {
+    if (anExp.Current().IsSame(theSub))
+    {
+      break;
+    }
+  }
+  return anExp.More();
+}
+} // namespace
+
+BRepCheck_SubShapeScope::BRepCheck_SubShapeScope()
+    : myPrev(THE_ACTIVE_INDEX)
+{
+  THE_ACTIVE_INDEX = &myIndex;
+}
+
+BRepCheck_SubShapeScope::~BRepCheck_SubShapeScope()
+{
+  THE_ACTIVE_INDEX = myPrev;
+}
+
+bool BRepCheck_SubShapeIndex::Contains(const TopoDS_Shape&    theContext,
+                                       const TopAbs_ShapeEnum theType,
+                                       const TopoDS_Shape&    theSub)
+{
+  BRepCheck_SubShapeIndex* anIndex = THE_ACTIVE_INDEX;
+  bool                     aResult = false;
+  if (anIndex == nullptr || theContext.IsNull() || theContext.ShapeType() == TopAbs_EDGE)
+  {
+    // no scope, a null context, the vertices of an edge: the walk
+    return walk(theContext, theType, theSub);
+  }
+  if (anIndex->myType != theType || !anIndex->myContext.IsEqual(theContext))
+  {
+    if (!anIndex->mySubs.IsEmpty())
+    {
+      // also a partial map: an exception other than out-of-memory can leave the build loop below
+      // (myMapped stays false); the next context must not start from the sub-shapes of this one
+      anIndex->mySubs.Clear();
+    }
+    anIndex->myContext = theContext;
+    anIndex->myType    = theType;
+    anIndex->myNbWalks = 0;
+    anIndex->myMapped  = false;
+    anIndex->myNoMap   = false;
+  }
+  if (anIndex->myMapped)
+  {
+    aResult = anIndex->mySubs.Contains(theSub);
+  }
+  else if (anIndex->myNoMap)
+  {
+    return walk(theContext, theType, theSub);
+  }
+  else if (anIndex->myNbWalks < THE_MAX_WALKED)
+  {
+    ++anIndex->myNbWalks;
+    return walk(theContext, theType, theSub);
+  }
+  else
+  {
+    // the map is extra memory the walk never needed: if it cannot be allocated, this context is
+    // walked (as stock), and the out-of-memory exception does not reach the analyzer (where it
+    // would become a CheckFail status)
+    try
+    {
+      for (TopExp_Explorer anExp(theContext, theType); anExp.More(); anExp.Next())
+      {
+        anIndex->mySubs.Add(anExp.Current());
+      }
+      anIndex->myMapped = true; // only after the map is complete
+    }
+    catch (const Standard_OutOfMemory&)
+    {
+      anIndex->mySubs.Clear();
+      anIndex->myNoMap = true;
+    }
+    catch (const std::bad_alloc&)
+    {
+      anIndex->mySubs.Clear();
+      anIndex->myNoMap = true;
+    }
+    if (!anIndex->myMapped)
+    {
+      return walk(theContext, theType, theSub);
+    }
+    aResult = anIndex->mySubs.Contains(theSub);
+  }
+#ifdef BREPCHECK_VERIFY_018
+  // verification build: every answer of the map is compared with the walk
+  BRepCheck_VerifyCall("subshape");
+  if (BRepCheck_VerifyBreak("subshape"))
+  {
+    aResult = !aResult;
+  }
+  if (BRepCheck_VerifyOn() && aResult != walk(theContext, theType, theSub))
+  {
+    BRepCheck_VerifyFail("subshape", "map answer != the explorer walk");
+  }
+#endif
+  return aResult;
+}
