+//! Defect 018. The pairs (i, j), i < j, of the wires of theFace (0-based, in the order of
+//! TopExp_Explorer(theFace, TopAbs_WIRE)) for which the double loop of IntersectWires()
+//! (BRepCheck_Face.cxx:252-296 @V8_0_1) calls Intersect(), in the order it calls it: i ascending,
+//! then j ascending. That loop skips a pair only when both wire boxes are non-void and the first
+//! IsOut() the second. BRepCheck_BoxPairs::Candidates() gives a superset of the pairs the loop does
+//! not skip; the loop's own test, with the same roles, then filters it. Returns false (the caller
+//! runs the original loop) if a wire has no box in theMap, if the explorer does not give theNbWire
+//! wires, if there would be more than THE_MAX_PAIRS candidates, or if memory for the lists cannot
+//! be allocated (std::bad_alloc does not reach the analyzer).
+static bool WirePairsToIntersect(const TopoDS_Shape&               theFace,
+                                 const DataMapOfShapeBox2d&        theMap,
+                                 const int                         theNbWire,
+                                 std::vector<TopoDS_Wire>&         theWires,
+                                 std::vector<std::pair<int, int>>& thePairs)
+{
+  try
+  {
+    theWires.clear();
+    for (TopExp_Explorer anExp(theFace, TopAbs_WIRE); anExp.More(); anExp.Next())
+    {
+      theWires.push_back(TopoDS::Wire(anExp.Current()));
+    }
+    const int aNb = (int)theWires.size();
+    if (aNb != theNbWire)
+    {
+      return false;
+    }
+    std::vector<const Bnd_Box2d*> aBoxes((size_t)aNb, nullptr);
+    for (int i = 0; i < aNb; ++i)
+    {
+      aBoxes[(size_t)i] = theMap.Seek(theWires[(size_t)i]);
+      if (aBoxes[(size_t)i] == nullptr)
+      {
+        return false;
+      }
+    }
+    std::vector<std::pair<int, int>> aCand;
+    if (!BRepCheck_BoxPairs::Candidates(aBoxes, THE_MAX_PAIRS, aCand))
+    {
+      return false;
+    }
+    thePairs.clear();
+    thePairs.reserve(aCand.size());
+    for (size_t k = 0; k < aCand.size(); ++k)
+    {
+      const Bnd_Box2d& aBox1 = *aBoxes[(size_t)aCand[k].first];
+      const Bnd_Box2d& aBox2 = *aBoxes[(size_t)aCand[k].second];
+      if (!aBox1.IsVoid() && !aBox2.IsVoid() && aBox1.IsOut(aBox2))
+      {
+        continue; // the test of the original loop, same roles (line 281 @V8_0_1)
+      }
+      thePairs.push_back(aCand[k]); // aCand is sorted by (i, j): the loop's order
+    }
+    return true;
+  }
+  catch (const std::bad_alloc&)
+  {
+    theWires.clear();
+    thePairs.clear();
+    return false;
+  }
+}
