+
+  //! theU0 <= theU1, theV0 <= theV1, all finite (BRepCheck_WireClass2d::NearBox)
+  void Query(const double      theU0,
+             const double      theV0,
+             const double      theU1,
+             const double      theV1,
+             std::vector<int>& theOut) const
+  {
+    theOut = myAlways;
+    if (myNx > 0)
+    {
+      const int ia = axis(theU0, myX0, myIx, myNx), ib = axis(theU1, myX0, myIx, myNx);
+      const int ja = axis(theV0, myY0, myIy, myNy), jb = axis(theV1, myY0, myIy, myNy);
+      for (int j = ja; j <= jb; ++j)
+      {
+        for (int i = ia; i <= ib; ++i)
+        {
+          const size_t c = (size_t)j * (size_t)myNx + (size_t)i;
+          theOut.insert(theOut.end(),
+                        myIndex.begin() + myStart[c],
+                        myIndex.begin() + myStart[c + 1]);
+        }
+      }
+    }
+    std::sort(theOut.begin(), theOut.end());
+  }
+
+private:
+  static bool isGridPoint(const WirePoint& theP)
+  {
+    return theP.State == 1 && std::isfinite(theP.Point.X()) && std::isfinite(theP.Point.Y());
+  }
+
+  //! cell of a coordinate: monotone in the coordinate, clamped to [0, theN - 1]
+  static int axis(const double theV, const double theV0, const double theInv, const int theN)
+  {
+    const double f = (theV - theV0) * theInv;
+    if (!(f > 0.))
+    {
+      return 0;
+    }
+    if (f >= (double)theN)
+    {
+      return theN - 1;
+    }
+    return std::min((int)f, theN - 1);
+  }
+
+  size_t cell(const gp_Pnt2d& theP) const
+  {
+    return (size_t)axis(theP.Y(), myY0, myIy, myNy) * (size_t)myNx
+           + (size_t)axis(theP.X(), myX0, myIx, myNx);
+  }
+
+  int              myNx = 0, myNy = 0;
+  double           myX0 = 0., myY0 = 0., myIx = 0., myIy = 0.;
+  std::vector<int> myStart, myIndex, myAlways;
+};
