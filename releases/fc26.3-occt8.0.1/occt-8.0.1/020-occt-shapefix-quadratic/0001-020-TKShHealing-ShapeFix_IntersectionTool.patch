+    }
+    const std::size_t aNbSecond = aSweep1 ? aSecond.size() : (std::size_t)(aNbWir - n1);
+    for (std::size_t aK = 0; aK < aNbSecond; aK++)
+    {
+      const int   n2    = aSweep1 ? aSecond[aK] : n1 + 1 + (int)aK;
+      TopoDS_Wire wire2 = TopoDS::Wire(SeqWir.Value(n2));
       NCollection_DataMap<TopoDS_Shape, Bnd_Box2d, TopTools_ShapeMapHasher>& boxes2 =
         aSeqWirEdgeBoxes.ChangeValue(n2);
       Bnd_Box2d aBox2 = aSeqWirBoxes(n2);
@@ -1903,6 +2186,9 @@ bool ShapeFix_IntersectionTool::FixIntersectingWires(TopoDS_Face& face) const
       {
         continue;
       }
+      // defect 020: created after the box test (the stock created it before); the constructor only
+      // reads wire2
+      occ::handle<ShapeExtend_WireData> sewd2 = new ShapeExtend_WireData(wire2);
       // detect possible intersections:
       int  NbModif      = 0;
       int  nbReplaced   = 0;     // gka 06.09.04
@@ -2500,6 +2786,21 @@ bool ShapeFix_IntersectionTool::FixIntersectingWires(TopoDS_Face& face) const
         boxes2.Clear();
         Bnd_Box2d aNewBox2 = CreateBoxes2d(sewd2, face, boxes2);
         aSeqWirBoxes.SetValue(n2, aNewBox2);
+        // defect 020: both boxes were recomputed - from now on these wires are tested with every
+        // other wire
+        if (aUseSweep)
