+//=======================================================================
+// defect 020: SF = Context()->Apply (face) and the maximum vertex tolerance of SF
+// (FixSelfIntersectWire below) without copying the face when that Apply would rebuild nothing.
+// ShapeBuild_ReShape::Apply copies the shape and each of its sub-shapes (EmptyCopied,
+// ShapeBuild_ReShape.cxx:184) before it knows whether anything changed; FixSelfIntersectWire runs
+// it for every wire of the face - quadratic on a face with many holes.
+//=======================================================================
+namespace
+{
+//! The parent / child types TopoDS_Builder::Add accepts that occur under a face. Any other pair:
+//! the stock Apply runs (it rebuilds, or throws TopoDS_UnCompatibleShapes in B.Add there).
+static bool isFaceChild(const TopAbs_ShapeEnum theParent, const TopAbs_ShapeEnum theChild)
+{
+  switch (theParent)
+  {
+    case TopAbs_FACE:
+      return theChild == TopAbs_WIRE || theChild == TopAbs_VERTEX;
+    case TopAbs_WIRE:
+      return theChild == TopAbs_EDGE;
+    case TopAbs_EDGE:
+      return theChild == TopAbs_VERTEX;
+    default:
+      return false;
+  }
+}
+
+//! Walks theShape as ShapeBuild_ReShape::Apply (theShape) walks a shape in which nothing is
+//! recorded: the same children (TopoDS_Iterator (shape, false), ShapeBuild_ReShape.cxx:191), the
+//! same test of Value() (:158-169), and the Free (false) that B.Add (result, child) sets on every
+//! child it keeps (:205, TopoDS_Builder.cxx:49) - here set on a child only after its whole subtree
+//! passed, so when the walk stops the stock Apply sets the same flags again and the others. Reads
+//! the vertex tolerances in the order TopExp_Explorer (SF, TopAbs_VERTEX) meets them (children are
+//! never null: BRep_Tool::Tolerance cannot throw). False at the first sub-shape Apply would replace
+//! or remove, or at a parent / child pair the fast path does not take.
+static bool walkUnrecorded(const occ::handle<ShapeBuild_ReShape>& theCtx,
+                           const bool                             theConsLoc,
+                           const TopoDS_Shape&                    theShape,
+                           double&                                theMaxTolVert)
+{
+  const TopAbs_ShapeEnum aType = theShape.ShapeType();
+  for (TopoDS_Iterator anIt(theShape, false); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Shape&    aSub     = anIt.Value();
+    const TopAbs_ShapeEnum aSubType = aSub.ShapeType();
+    if (!isFaceChild(aType, aSubType))
+      return false;
+    const TopoDS_Shape aVal = theCtx->Value(aSub);
+    if (aVal.IsNull() || (theConsLoc ? !aVal.IsPartner(aSub) : !aVal.IsSame(aSub)))
+      return false;
+    if (aSubType == TopAbs_VERTEX)
+      theMaxTolVert = Max(theMaxTolVert, BRep_Tool::Tolerance(TopoDS::Vertex(aSub)));
+    else if (!walkUnrecorded(theCtx, theConsLoc, aSub, theMaxTolVert))
+      return false;
+    aSub.TShape()->Free(false);
+  }
+  return true;
+}
+
+//! True when nothing in the face is recorded: then theSF and theMaxTolVert are what the stock code
+//! computes, and the context is left as the stock Apply leaves it - no record (it writes only when
+//! it rebuilds, :228), the same Status (OK, or DONE1 after a chain of replacements of the face),
+//! the same Free flags. Apply (face, TopAbs_FACE) follows the same chain (:157-174) and stops
+//! before copying (:176-177). False (the caller runs the stock code): the context is not exactly a
+//! ShapeBuild_ReShape (a derived class may override Apply or Value), the face or a sub-shape is
+//! removed or replaced, the chain ends at a non-face or at a shape recorded as itself in another
+//! orientation (there Apply (face, TopAbs_FACE) would return the record, the full Apply the shape).
+static bool applyFaceUnrecorded(const occ::handle<ShapeBuild_ReShape>& theCtx,
+                                const TopoDS_Face&                     theFace,
+                                TopoDS_Shape&                          theSF,
+                                double&                                theMaxTolVert)
+{
+  if (typeid(*theCtx) != typeid(ShapeBuild_ReShape))
+    return false;
+  const bool   aConsLoc = theCtx->ModeConsiderLocation();
+  TopoDS_Shape aCur     = theFace;
+  // OCCT 8.0.1 applyImpl keeps the TShapes of the chain "in flight" and returns Value() of a shape
+  // met again without walking it (ShapeBuild_ReShape.cxx:219-227): the stock code decides such a
+  // chain, and any chain through a non-face (an in-flight wire, edge or vertex could be met again
+  // under the face).
+  NCollection_Sequence<const TopoDS_TShape*> aChain;
+  for (int aStep = 0;; aStep++)
+  {
+    if (aStep > 1000 || aCur.ShapeType() != TopAbs_FACE)
+      return false;
+    for (NCollection_Sequence<const TopoDS_TShape*>::Iterator anIt(aChain); anIt.More(); anIt.Next())
+    {
+      if (anIt.Value() == aCur.TShape().get())
+        return false;
+    }
+    aChain.Append(aCur.TShape().get());
+    const TopoDS_Shape aVal = theCtx->Value(aCur);
+    if (aVal.IsNull())
+      return false;
+    if (aConsLoc ? !aVal.IsPartner(aCur) : !aVal.IsSame(aCur))
+    {
+      aCur = aVal;
+      continue;
+    }
+    if (!aVal.IsEqual(aCur))
+      return false;
+    break;
+  }
+  if (aCur.ShapeType() != TopAbs_FACE)
+    return false;
+  double aMaxTolVert = 0.0;
+  if (!walkUnrecorded(theCtx, aConsLoc, aCur, aMaxTolVert))
+    return false;
+  theSF = theCtx->Apply(theFace, TopAbs_FACE);
+  if (!theSF.IsEqual(aCur))
+    return false; // not reached (see above); the stock Apply then decides and sets the status
+  theMaxTolVert = aMaxTolVert;
+  return true;
+}
+} // namespace
