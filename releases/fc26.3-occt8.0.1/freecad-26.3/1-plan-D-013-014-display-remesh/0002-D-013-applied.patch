+#ifndef PARTGUI_DISPLAYMESHREUSE_H
+#define PARTGUI_DISPLAYMESHREUSE_H
+
+#include <Standard_TypeDef.hxx>
+#include <TopoDS_Shape.hxx>
+
+#include <cstddef>
+#include <future>
+
+namespace PartGui
+{
+
+/** Display meshes that survive an edit (freecad-kernel-fixes, defect 013).
+ *
+ * FreeCAD 1.1.1 cleaned every face before meshing a shape for display (BRepTools::Clean in
+ * ViewProviderPartExt::setupCoinGeometry), so an edit that changed 4 faces of 174 meshed all 174 again.
+ * This registry keeps, per face (its TopoDS_TShape), the triangulation the display mesher made, the
+ * parameters it was made with and a fingerprint of the face's geometry. Before meshing, a face keeps its
+ * triangulation only if it still holds exactly that triangulation, the parameters are equal, every edge of
+ * the face still carries its polygon on it and the geometry is unchanged; every other face is cleaned the
+ * way BRepTools::Clean cleans it, and so are the edges, except for the polygons on kept triangulations.
+ * BRepMesh_IncrementalMesh then meshes the cleaned faces, reuses the kept ones and takes the edges they
+ * share from the kept faces' polygons, so the display mesh has no cracks. Internal to PartGui, not exported.
+ */
+class DisplayMeshReuse
+{
+public:
+    struct Params
+    {
+        Standard_Real lin;  ///< IMeshTools_Parameters::Deflection
+        Standard_Real ang;  ///< IMeshTools_Parameters::Angle, radians
+        bool csd;           ///< IMeshTools_Parameters::ControlSurfaceDeflection
+    };
+
+    struct Stats
+    {
+        int faces = 0;                ///< distinct faces (TShapes) of the shape
+        int kept = 0;                 ///< keep their triangulation
+        int fresh = 0;                ///< had no triangulation
+        int noSurface = 0;            ///< no surface: left as they are, as BRepTools::Clean does
+        int noEntry = 0;              ///< cleaned: the triangulation was not made by this mesher
+        int otherTriangulation = 0;   ///< cleaned: holds another triangulation than the registered one
+        int paramsDiffer = 0;         ///< cleaned: registered with other parameters
+        int edgePolygonsMissing = 0;  ///< cleaned: an edge lost its polygon on the triangulation
+        int geometryChanged = 0;      ///< cleaned: face, edge or vertex data changed in place
+        int cleaned() const
+        {
+            return noEntry + otherTriangulation + paramsDiffer + edgePolygonsMissing + geometryChanged;
+        }
+    };
+
+    /// Replaces BRepTools::Clean(shape, Standard_True) before BRepMesh_IncrementalMesh.
+    static Stats prepare(const TopoDS_Shape& shape, const Params& params);
+    /// Registers the triangulations the mesher left on the faces of shape.
+    static void record(const TopoDS_Shape& shape, const Params& params);
+
+    /// record() running on a worker thread; waits for it when destroyed (or at wait()). Owns no shape data.
+    class PendingRecord
+    {
+    public:
+        PendingRecord() = default;
+        explicit PendingRecord(std::future<void>&& worker);
+        PendingRecord(PendingRecord&&) = default;
+        PendingRecord(const PendingRecord&) = delete;
+        PendingRecord& operator=(const PendingRecord&) = delete;
+        PendingRecord& operator=(PendingRecord&&) = default;  // the old worker, if any, is waited for (std::async)
+        ~PendingRecord();
+        /// Blocks until record() is done. An exception of record() (only std::bad_alloc is possible) is swallowed:
+        /// the faces it did not reach stay unregistered and are cleaned by the next prepare(), as FreeCAD 1.1.1 does.
+        void wait();
+
+    private:
+        std::future<void> worker;
+    };
+
