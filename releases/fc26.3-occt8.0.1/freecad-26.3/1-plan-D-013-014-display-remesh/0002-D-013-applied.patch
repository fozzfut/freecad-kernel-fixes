+struct ReuseEntry
+{
+    Standard_Real lin;
+    Standard_Real ang;
+    bool csd;
+    std::uint64_t fingerprint;
+    Handle(Poly_Triangulation) triangulation;
+};
+
+struct ReuseRegistry
+{
+    std::mutex mutex;
+    std::unordered_map<const TopoDS_TShape*, ReuseEntry> entries;
+    std::size_t cursor = 0;  // the bucket the next sweep starts from
+
+    // Drops entries whose triangulation nobody but the registry holds (face and edges are gone). At most `budget`
+    // entries are looked at per call, resuming where the last call stopped: the cost stays proportional to the faces
+    // just meshed (a full sweep on each of 5000 parts opened would be quadratic).
+    void sweep(std::size_t budget)
+    {
+        const std::size_t buckets = entries.bucket_count();
+        if (entries.empty() || buckets == 0) {
+            return;
+        }
+        std::vector<const TopoDS_TShape*> dead;
+        std::size_t visited = 0;
+        std::size_t bucket = cursor % buckets;
+        for (std::size_t step = 0; step < buckets && visited < budget; ++step) {
+            for (auto it = entries.cbegin(bucket); it != entries.cend(bucket); ++it) {
+                ++visited;
+                if (it->second.triangulation->GetRefCount() == 1) {
+                    dead.push_back(it->first);
+                }
+            }
+            bucket = (bucket + 1) % buckets;
+        }
+        cursor = bucket;
+        for (const TopoDS_TShape* key : dead) {
+            entries.erase(key);
+        }
+    }
+};
+
+ReuseRegistry& reuseRegistry()
+{
+    // Never destroyed: at exit it may still hold triangulations; the process returns the memory, and no OCCT object
+    // is released during the static destruction of PartGui.
+    static ReuseRegistry* instance = new ReuseRegistry();
+    return *instance;
+}
+
+class FingerprintHash
+{
+public:
+    template<class T>
+    void add(const T& value)
+    {
+        const unsigned char* bytes = reinterpret_cast<const unsigned char*>(&value);
+        for (std::size_t i = 0; i < sizeof(T); ++i) {
+            hash ^= bytes[i];
+            hash *= 1099511628211ULL;
+        }
+    }
+    std::uint64_t hash = 1469598103934665603ULL;
+};
+
+// What BRepMesh reads from a face and can change while the face keeps its TShape: the surface, its location and the
+// face tolerance; for every edge its orientation, location, tolerance, flags and geometric representations (3D curve,
+// pcurves, ranges); the points and tolerances of the vertices. Geometry objects by address, values by their bits.
+// Location-free: the same TShape placed twice has one fingerprint.
+std::uint64_t fingerprint(const TopoDS_Face& located)
+{
+    const TopoDS_Face face = TopoDS::Face(located.Located(TopLoc_Location()));
+    FingerprintHash h;
+    TopLoc_Location surfaceLocation;
+    h.add(static_cast<const void*>(BRep_Tool::Surface(face, surfaceLocation).get()));
+    h.add(surfaceLocation.HashCode());
+    h.add(BRep_Tool::Tolerance(face));
+    h.add(BRep_Tool::NaturalRestriction(face));
+    for (TopExp_Explorer xe(face, TopAbs_EDGE); xe.More(); xe.Next()) {
+        const TopoDS_Edge& edge = TopoDS::Edge(xe.Current());
+        const auto* tedge = static_cast<const BRep_TEdge*>(edge.TShape().get());
+        h.add(static_cast<const void*>(tedge));
+        h.add(static_cast<int>(edge.Orientation()));
+        h.add(edge.Location().HashCode());
+        h.add(tedge->Tolerance());
+        h.add(tedge->SameParameter());
+        h.add(tedge->SameRange());
+        h.add(tedge->Degenerated());
+        for (BRep_ListIteratorOfListOfCurveRepresentation it(tedge->Curves()); it.More(); it.Next()) {
+            const Handle(BRep_CurveRepresentation)& cr = it.Value();
+            if (!cr->IsCurve3D() && !cr->IsCurveOnSurface()) {
+                continue;  // polygons are the mesher's own output; regularity does not reach the mesh
+            }
+            h.add(cr->Location().HashCode());
+            if (cr->IsCurve3D()) {
+                h.add(static_cast<const void*>(cr->Curve3D().get()));
+            }
+            else {
+                h.add(static_cast<const void*>(cr->Surface().get()));
+                h.add(static_cast<const void*>(cr->PCurve().get()));
+                if (cr->IsCurveOnClosedSurface()) {
+                    h.add(static_cast<const void*>(cr->PCurve2().get()));
+                }
+            }
+            const Handle(BRep_GCurve) gc = Handle(BRep_GCurve)::DownCast(cr);
+            if (!gc.IsNull()) {
+                h.add(gc->First());
+                h.add(gc->Last());
+            }
+        }
+        TopoDS_Vertex first, last;
+        TopExp::Vertices(edge, first, last);
+        for (const TopoDS_Vertex& vertex : {first, last}) {
+            if (vertex.IsNull()) {
+                h.add(0);
+                continue;
+            }
+            const auto* tvertex = static_cast<const BRep_TVertex*>(vertex.TShape().get());
+            const gp_Pnt& p = tvertex->Pnt();
+            h.add(p.X());
+            h.add(p.Y());
+            h.add(p.Z());
+            h.add(vertex.Location().HashCode());
+            h.add(tvertex->Tolerance());
+        }
+    }
+    return h.hash;
+}
+
+enum class ReuseVerdict
+{
+    Keep,
+    NoEntry,
+    OtherTriangulation,
+    ParamsDiffer,
+    EdgePolygonsMissing,
+    GeometryChanged
+};
+
+ReuseVerdict judgeFace(const ReuseEntry* entry,
+              const TopoDS_Face& face,
+              const Handle(Poly_Triangulation)& triangulation,
+              const TopLoc_Location& location,
+              const DisplayMeshReuse::Params& params)
+{
+    if (!entry) {
+        return ReuseVerdict::NoEntry;
+    }
+    if (entry->triangulation != triangulation) {
+        return ReuseVerdict::OtherTriangulation;
+    }
+    if (entry->lin != params.lin || entry->ang != params.ang || entry->csd != params.csd) {
+        return ReuseVerdict::ParamsDiffer;
+    }
+    for (TopExp_Explorer xe(face, TopAbs_EDGE); xe.More(); xe.Next()) {
+        if (BRep_Tool::PolygonOnTriangulation(TopoDS::Edge(xe.Current()), triangulation, location).IsNull()) {
+            return ReuseVerdict::EdgePolygonsMissing;
+        }
+    }
+    if (entry->fingerprint != fingerprint(face)) {
+        return ReuseVerdict::GeometryChanged;
+    }
+    return ReuseVerdict::Keep;
+}
+
+void tally(DisplayMeshReuse::Stats& stats, ReuseVerdict verdict)
+{
+    switch (verdict) {
+        case ReuseVerdict::NoEntry:
+            ++stats.noEntry;
+            break;
+        case ReuseVerdict::OtherTriangulation:
+            ++stats.otherTriangulation;
+            break;
+        case ReuseVerdict::ParamsDiffer:
+            ++stats.paramsDiffer;
+            break;
+        case ReuseVerdict::EdgePolygonsMissing:
+            ++stats.edgePolygonsMissing;
+            break;
+        case ReuseVerdict::GeometryChanged:
+            ++stats.geometryChanged;
+            break;
+        case ReuseVerdict::Keep:
+            ++stats.kept;
+            break;
+    }
+}
+
+}  // namespace
+
+DisplayMeshReuse::Stats DisplayMeshReuse::prepare(const TopoDS_Shape& shape, const Params& params)
+{
+    Stats stats;
+    ReuseRegistry& reg = reuseRegistry();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    const BRep_Builder builder;
+    const Handle(Poly_Triangulation) noTriangulation;
+    const Handle(Poly_PolygonOnTriangulation) noPolygon;
+    const Handle(Poly_Polygon3D) noPolygon3D;
+    std::unordered_set<const TopoDS_TShape*> seenFaces;
+    std::unordered_set<const Poly_Triangulation*> kept;
+
+    // Faces: BRepTools::Clean (BRepTools.cxx:770-809, OCCT 7.8.1) for each face, except the ones judged Keep.
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More(); xp.Next()) {
+        const TopoDS_Face& face = TopoDS::Face(xp.Current());
+        if (!seenFaces.insert(face.TShape().get()).second) {
+            continue;
+        }
+        ++stats.faces;
+        if (!BRep_Tool::IsGeometric(face)) {
+            ++stats.noSurface;
+            continue;
+        }
+        TopLoc_Location location;
+        const Handle(Poly_Triangulation)& triangulation = BRep_Tool::Triangulation(face, location);
+        if (triangulation.IsNull()) {
+            ++stats.fresh;
+            continue;
+        }
+        const auto entry = reg.entries.find(face.TShape().get());
+        const ReuseVerdict verdict =
+            judgeFace(entry == reg.entries.end() ? nullptr : &entry->second, face, triangulation, location, params);
+        tally(stats, verdict);
+        if (verdict == ReuseVerdict::Keep) {
+            kept.insert(triangulation.get());
+            continue;
+        }
+        for (TopExp_Explorer xe(face, TopAbs_EDGE); xe.More(); xe.Next()) {
+            builder.UpdateEdge(TopoDS::Edge(xe.Current()), noPolygon, triangulation, location);
+        }
+        builder.UpdateFace(face, noTriangulation);
+        if (entry != reg.entries.end()) {
+            reg.entries.erase(entry);
+        }
+    }
+
+    // Edges: BRepTools::Clean (BRepTools.cxx:811-860) with theForce, except the polygons on kept triangulations.
+    std::unordered_set<const TopoDS_TShape*> seenEdges;
+    for (TopExp_Explorer xp(shape, TopAbs_EDGE); xp.More(); xp.Next()) {
+        TopoDS_Edge edge = TopoDS::Edge(xp.Current());
+        edge.Location(TopLoc_Location());
+        if (!seenEdges.insert(edge.TShape().get()).second) {
+            continue;
+        }
+        if (!BRep_Tool::IsGeometric(edge)) {
+            continue;
+        }
+        TopLoc_Location location;
+        if (!BRep_Tool::Polygon3D(edge, location).IsNull()) {
+            builder.UpdateEdge(edge, noPolygon3D);
+        }
+        auto* tedge = static_cast<BRep_TEdge*>(edge.TShape().get());
+        BRep_ListOfCurveRepresentation& representations = tedge->ChangeCurves();
+        BRep_ListIteratorOfListOfCurveRepresentation it(representations);
+        while (it.More()) {
+            const Handle(BRep_CurveRepresentation)& cr = it.Value();
+            if (cr->IsPolygonOnTriangulation() && kept.count(cr->Triangulation().get()) == 0) {
+                representations.Remove(it);
+            }
+            else {
+                it.Next();
+            }
+        }
+        tedge->Modified(Standard_True);
+    }
+    return stats;
+}
+
+void DisplayMeshReuse::record(const TopoDS_Shape& shape, const Params& params)
+{
+    ReuseRegistry& reg = reuseRegistry();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    std::unordered_set<const TopoDS_TShape*> seen;
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More(); xp.Next()) {
+        const TopoDS_Face& face = TopoDS::Face(xp.Current());
+        const TopoDS_TShape* key = face.TShape().get();
+        if (!seen.insert(key).second) {
+            continue;
+        }
+        TopLoc_Location location;
+        const Handle(Poly_Triangulation)& triangulation = BRep_Tool::Triangulation(face, location);
+        if (triangulation.IsNull() || !BRep_Tool::IsGeometric(face)) {
+            reg.entries.erase(key);
+            continue;
+        }
+        const auto it = reg.entries.find(key);
+        if (it != reg.entries.end() && it->second.triangulation == triangulation && it->second.lin == params.lin
+            && it->second.ang == params.ang && it->second.csd == params.csd) {
+            continue;  // kept by prepare(): its fingerprint was just verified
+        }
+        reg.entries[key] = ReuseEntry {params.lin, params.ang, params.csd, fingerprint(face), triangulation};
+    }
+    reg.sweep(2 * seen.size() + 64);
+}
+
+DisplayMeshReuse::PendingRecord::PendingRecord(std::future<void>&& worker)
+    : worker(std::move(worker))
+{}
+
+DisplayMeshReuse::PendingRecord::~PendingRecord()
+{
+    wait();
+}
+
+void DisplayMeshReuse::PendingRecord::wait()
+{
+    if (!worker.valid()) {
+        return;
+    }
+    try {
+        worker.get();
+    }
+    catch (...) {
+        // record() stopped part way (out of memory): the entries it made are complete, the faces it did not reach
+        // have no entry and are cleaned by the next prepare() exactly as by BRepTools::Clean
+    }
+}
+
+DisplayMeshReuse::PendingRecord DisplayMeshReuse::recordAsync(const TopoDS_Shape& shape, const Params& params)
+{
+    if (!TopExp_Explorer(shape, TopAbs_FACE).More()) {
+        record(shape, params);  // nothing to fingerprint: only a portion of the sweep
+        return PendingRecord();
+    }
+    try {
+        return PendingRecord(std::async(std::launch::async, [shape, params] { record(shape, params); }));
+    }
+    catch (const std::system_error&) {
+        record(shape, params);  // no thread available: the same work on the caller's thread
+        return PendingRecord();
+    }
+}
+
+TopoDS_Shape DisplayMeshReuse::meshingScope(const TopoDS_Shape& shape)
+{
+    std::unordered_set<const TopoDS_TShape*> toMesh;
+    std::unordered_set<const TopoDS_TShape*> all;
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More(); xp.Next()) {
+        const TopoDS_Face& face = TopoDS::Face(xp.Current());
+        if (!all.insert(face.TShape().get()).second) {
+            continue;
+        }
+        TopLoc_Location location;
+        if (BRep_Tool::Triangulation(face, location).IsNull()) {
+            toMesh.insert(face.TShape().get());
+        }
+    }
+    if (toMesh.empty() || toMesh.size() == all.size()) {
+        return shape;
+    }
+    std::unordered_set<const TopoDS_TShape*> scope = toMesh;
+    TopTools_IndexedDataMapOfShapeListOfShape edgeFaces;
+    TopExp::MapShapesAndUniqueAncestors(shape, TopAbs_EDGE, TopAbs_FACE, edgeFaces);
+    for (Standard_Integer i = 1; i <= edgeFaces.Extent(); ++i) {
+        const TopTools_ListOfShape& faces = edgeFaces(i);
+        bool touches = false;
+        for (TopTools_ListOfShape::Iterator it(faces); it.More() && !touches; it.Next()) {
+            touches = toMesh.count(it.Value().TShape().get()) != 0;
+        }
+        if (!touches) {
+            continue;
+        }
+        for (TopTools_ListOfShape::Iterator it(faces); it.More(); it.Next()) {
+            scope.insert(it.Value().TShape().get());
+        }
+    }
+    if (scope.size() == all.size()) {
+        return shape;
+    }
+    const BRep_Builder builder;
+    TopoDS_Compound compound;
+    builder.MakeCompound(compound);
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More(); xp.Next()) {
+        if (scope.count(xp.Current().TShape().get()) != 0) {
+            builder.Add(compound, xp.Current());  // every occurrence, as BRepMesh sees them in the whole shape
+        }
+    }
+    for (TopExp_Explorer xp(shape, TopAbs_EDGE, TopAbs_FACE); xp.More(); xp.Next()) {
+        builder.Add(compound, xp.Current());  // free edges: their 3D polygons were removed, as by the stock
+    }
+    return compound;
+}
+
+std::size_t DisplayMeshReuse::sweepAll()
+{
+    ReuseRegistry& reg = reuseRegistry();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    const std::size_t before = reg.entries.size();
+    for (auto it = reg.entries.begin(); it != reg.entries.end();) {
+        if (it->second.triangulation->GetRefCount() == 1) {
+            it = reg.entries.erase(it);
+        }
+        else {
+            ++it;
+        }
+    }
+    reg.cursor = 0;
+    return before - reg.entries.size();
+}
+
+std::size_t DisplayMeshReuse::size()
+{
+    ReuseRegistry& reg = reuseRegistry();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    return reg.entries.size();
+}
+
+void DisplayMeshReuse::clear()
+{
+    ReuseRegistry& reg = reuseRegistry();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    reg.entries.clear();
+}
