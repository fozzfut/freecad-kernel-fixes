+//=======================================================================
+// function : ChFi3d_IsSmoothAtVertex
+// purpose  : Whether the edge E between the faces F1 and F2, met at a vertex
+//            where a fillet ends or passes, is smooth for the topology of that
+//            vertex (not counted there as a sharp edge).
+//            Two different faces: G2, as before.
+//            A seam (F1 = F2, E closed on the face): a fillet that reaches a
+//            seam crosses it inside ONE face, on one surface that is
+//            continuous across its seam; the corner curve is computed on that
+//            surface and split at the seam (PerformOneCorner, intcouture). The
+//            seam is then no crease as soon as the surface is tangent-
+//            continuous across it (G1). A seam that is G1 but not G2 (e.g. a
+//            closed BSpline surface with a knot of multiplicity degree-1 at the
+//            seam: a curvature jump) was counted as one more sharp edge, and
+//            the corner went to PerformIntersectionAtEnd, which intersects Fv
+//            with its neighbour across the seam - Fv itself.
+//=======================================================================
+bool ChFi3d_IsSmoothAtVertex(const TopoDS_Edge& E, const TopoDS_Face& F1, const TopoDS_Face& F2)
+{
+  if (F2.IsNull())
+  {
+    return false;
+  }
+  if (F1.IsSame(F2) && BRep_Tool::IsClosed(E, F1))
+  {
+    return ChFi3d::IsTangentFaces(E, F1, F2, GeomAbs_G1);
+  }
+  return ChFi3d::IsTangentFaces(E, F1, F2, GeomAbs_G2);
+}
