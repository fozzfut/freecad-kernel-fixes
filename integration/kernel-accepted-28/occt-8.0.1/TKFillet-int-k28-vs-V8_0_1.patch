+//=======================================================================
+// function : ChFi3d_PeriodicCopy
+// purpose  : The same surface as theS, made periodic in the directions where
+//            theS is closed but not periodic, so that a corner curve can be
+//            computed across the seam (ChFi3d_BoundFac clamps a non-periodic
+//            surface to its natural bounds). Returned only when it is exactly
+//            theS on the domain of theS with the same parameters (checked on a
+//            grid); null otherwise.
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_PeriodicCopy(const occ::handle<Geom_Surface>& theS,
+                                                     const bool                       theInU,
+                                                     const bool                       theInV)
+{
+  occ::handle<Geom_BSplineSurface> aBS;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<Geom_BSplineSurface> aSrc = occ::down_cast<Geom_BSplineSurface>(theS);
+    if (!aSrc.IsNull())
+    {
+      aBS = occ::down_cast<Geom_BSplineSurface>(aSrc->Copy());
+    }
+    else
+    {
+      aBS = GeomConvert::SurfaceToBSplineSurface(theS);
+    }
+    if (aBS.IsNull())
+    {
+      return nullptr;
+    }
+    if (theInU && !aBS->IsUPeriodic())
+    {
+      aBS->SetUPeriodic();
+    }
+    if (theInV && !aBS->IsVPeriodic())
+    {
+      aBS->SetVPeriodic();
+    }
+    double aU1, aU2, aV1, aV2;
+    theS->Bounds(aU1, aU2, aV1, aV2);
+    const int aN = 8;
+    for (int i = 0; i <= aN; i++)
+    {
+      const double aU = aU1 + (aU2 - aU1) * i / aN;
+      for (int j = 0; j <= aN; j++)
+      {
+        const double aV = aV1 + (aV2 - aV1) * j / aN;
+        if (theS->Value(aU, aV).Distance(aBS->Value(aU, aV)) > Precision::Confusion())
+        {
+          return nullptr;
+        }
+      }
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return nullptr;
+  }
+  return aBS;
+}
+
+//=======================================================================
+// function : ChFi3d_PieceOnFace
+// purpose  : Piece [theA, theB] of the pcurve thePc of a corner curve that
+//            crosses the seam of its face, moved by whole closed lengths
+//            (ChFi3d_ClosedLength) into the parameter domain of the face. The
+//            piece keeps the parameters of thePc, which were computed together
+//            with the 3d corner curve, so it matches the 3d piece within the
+//            tolerance reached for the corner curve.
+//=======================================================================
+
+static occ::handle<Geom2d_Curve> ChFi3d_PieceOnFace(const occ::handle<Geom2d_Curve>& thePc,
+                                                    const double                     theA,
+                                                    const double                     theB,
+                                                    const double                     theLU,
+                                                    const double                     theLV,
+                                                    const double                     theU1,
+                                                    const double                     theV1)
+{
+  occ::handle<Geom2d_Curve> aPiece = new Geom2d_TrimmedCurve(thePc, theA, theB);
+  const gp_Pnt2d            aMid   = thePc->Value(0.5 * (theA + theB));
+  double                    aDU = 0., aDV = 0.;
+  if (theLU > 0.)
+  {
+    aDU = -std::floor((aMid.X() - theU1) / theLU) * theLU;
+  }
+  if (theLV > 0.)
+  {
+    aDV = -std::floor((aMid.Y() - theV1) / theLV) * theLV;
+  }
+  if (aDU != 0. || aDV != 0.)
+  {
+    aPiece->Translate(gp_Vec2d(aDU, aDV));
+  }
+  return aPiece;
+}
