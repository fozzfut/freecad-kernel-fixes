+//=======================================================================
+// function : ChFi3d_CertifyEdgeTolerances
+// purpose  : The tolerance of an edge must bound the distance between its 3d
+//            curve and each of its pcurves on its faces (the B-rep tolerance
+//            invariant). The same-parameter pass over the new fillet faces
+//            (BRepLib::SameParameter, ShapeFix::SameParameter) sets the edge
+//            tolerance from a fixed sample of points, and can lower it to
+//            that sampled deviation; between the samples the pcurve of a
+//            corner edge on the face at the end of the fillet can deviate
+//            more (measured: 1.08e-7 set, 1.08e-7 * 1.002 true on a sphere;
+//            1e-7 set, 4.17e-7 true on a cone), and the result fails the
+//            curve-on-surface check (BOPAlgo_InvalidCurveOnSurface).
+//            For each edge of theNewFace, the true maximum distance on every
+//            face of the result that holds the edge is computed with
+//            BRepLib_CheckCurveOnSurface (global optimisation along the edge,
+//            the same measure the validity checks use); when it exceeds the
+//            edge tolerance, the tolerance is raised to it, and the tolerances
+//            of the end vertices to at least it. Tolerances are never lowered,
+//            so an edge whose tolerance already bounds its deviation is left
+//            exactly as it was.
+//=======================================================================
+void ChFi3d_CertifyEdgeTolerances(const TopoDS_Shape& theNewFace, const ChFiDS_Map& theEFMap)
+{
+  BRep_Builder                                           aBB;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aSeen;
+  for (TopExp_Explorer anExpE(theNewFace, TopAbs_EDGE); anExpE.More(); anExpE.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anExpE.Current());
+    if (BRep_Tool::Degenerated(anE) || !aSeen.Add(anE) || !theEFMap.Contains(anE))
+    {
+      continue;
+    }
+    double                                                 aMaxDist = 0.;
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aFaces;
+    for (NCollection_List<TopoDS_Shape>::Iterator anItF(theEFMap(anE)); anItF.More(); anItF.Next())
+    {
+      if (!aFaces.Add(anItF.Value()))
+      {
+        continue;
+      }
+      BRepLib_CheckCurveOnSurface aCheck(anE, TopoDS::Face(anItF.Value()));
+      aCheck.Perform();
+      if (aCheck.IsDone())
+      {
+        aMaxDist = std::max(aMaxDist, aCheck.MaxDistance());
+      }
+    }
+    if (aMaxDist > BRep_Tool::Tolerance(anE))
+    {
+      aBB.UpdateEdge(anE, aMaxDist);
+      for (TopExp_Explorer anExpV(anE, TopAbs_VERTEX); anExpV.More(); anExpV.Next())
+      {
+        const TopoDS_Vertex& aV = TopoDS::Vertex(anExpV.Current());
+        if (BRep_Tool::Tolerance(aV) < aMaxDist)
+        {
+          aBB.UpdateVertex(aV, aMaxDist);
+        }
+      }
+    }
+  }
+}
