+static void unfDump(const TopoDS_Shape& S, const char* tag)
+{
+  BRepCheck_Analyzer         an(S);
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> all;
+  TopExp::MapShapes(S, all);
+  for (int i = 1; i <= all.Extent(); i++)
+  {
+    occ::handle<BRepCheck_Result> r = an.Result(all(i));
+    if (r.IsNull())
+      continue;
+    for (BRepCheck_ListOfStatus::Iterator it(r->Status()); it.More(); it.Next())
+      if (it.Value() != BRepCheck_NoError)
+        fprintf(stderr, "UNFOLD %s check: sub %d type %d status %d\n", tag, i, (int)all(i).ShapeType(), (int)it.Value());
+    for (r->InitContextIterator(); r->MoreShapeInContext(); r->NextShapeInContext())
+      for (BRepCheck_ListOfStatus::Iterator it(r->StatusOnShape()); it.More(); it.Next())
+        if (it.Value() != BRepCheck_NoError)
+          fprintf(stderr, "UNFOLD %s check: sub %d type %d in ctx type %d status %d\n", tag, i, (int)all(i).ShapeType(),
+                  (int)r->ContextualShape().ShapeType(), (int)it.Value());
+  }
+  if (const char* d = getenv("CHFI3D_UNFOLD_DUMPDIR"))
+  {
+    char fn[512];
+    snprintf(fn, sizeof fn, "%s/%s.brep", d, tag);
+    BRepTools::Write(S, fn);
+  }
+}
