+//=======================================================================
+// function : ChFi3d_BasisOf
+// purpose  : the surface of the face, without the rectangular trim
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_BasisOf(const BRepAdaptor_Surface& Bs)
+{
+  occ::handle<Geom_Surface>                   aS = Bs.Surface().Surface();
+  occ::handle<Geom_RectangularTrimmedSurface> aT =
+    occ::down_cast<Geom_RectangularTrimmedSurface>(aS);
+  if (!aT.IsNull())
+  {
+    aS = aT->BasisSurface();
+  }
+  return aS;
+}
+
+//=======================================================================
+// function : ChFi3d_ClosedLength
+// purpose  : A face whose trim spans the whole closed range of its surface in
+//            a direction carries a seam there: the parameters U and U + L are
+//            the same points. L is the period of a periodic surface and the
+//            natural range of a surface that is closed but not periodic.
+//            0 when the face is not closed in that direction.
+//=======================================================================
+
+static void ChFi3d_ClosedLength(const BRepAdaptor_Surface& Bs, double& theLU, double& theLV)
+{
+  theLU = theLV = 0.;
+  const occ::handle<Geom_Surface> aS = ChFi3d_BasisOf(Bs);
+  if (aS.IsNull())
+  {
+    return;
+  }
+  double aU1, aU2, aV1, aV2;
+  aS->Bounds(aU1, aU2, aV1, aV2);
+  if (Bs.IsUClosed())
+  {
+    theLU = aS->IsUPeriodic() ? aS->UPeriod() : aU2 - aU1;
+  }
+  if (Bs.IsVClosed())
+  {
+    theLV = aS->IsVPeriodic() ? aS->VPeriod() : aV2 - aV1;
+  }
+  if (Precision::IsInfinite(theLU))
+  {
+    theLU = 0.;
+  }
+  if (Precision::IsInfinite(theLV))
+  {
+    theLV = 0.;
+  }
+}
+
+//=======================================================================
+// function : ChFi3d_BoundaryUse
+// purpose  : One use of an edge in the boundary of a face (a seam edge has
+//            two, one per pcurve): its pcurve, the indices of its end
+//            vertices, and its 3d curve for lengths.
+//=======================================================================
+
+namespace
+{
+struct ChFi3d_BoundaryUse
+{
+  TopoDS_Edge               Edge;
+  occ::handle<Geom2d_Curve> PC;
+  occ::handle<Geom_Curve>   C3d;
+  double                    First = 0., Last = 0.;
+  int                       IV1 = 0, IV2 = 0; // vertex at First / at Last
+};
+
+// 3d length of the use between the parameters theA and theB (polyline of
+// 16 chords; used only to order boundary paths)
+double ChFi3d_UseLength(const ChFi3d_BoundaryUse& theU, const double theA, const double theB)
+{
+  if (theU.C3d.IsNull())
+  {
+    return std::abs(theB - theA);
+  }
+  const int aN   = 16;
+  double    aLen = 0.;
+  gp_Pnt    aP   = theU.C3d->Value(theA);
+  for (int i = 1; i <= aN; i++)
+  {
+    const gp_Pnt aQ = theU.C3d->Value(theA + (theB - theA) * i / aN);
+    aLen += aP.Distance(aQ);
+    aP = aQ;
+  }
+  return aLen;
+}
+
+// whole closed lengths k*L (per direction) that move theRaw next to theRef
+gp_Vec2d ChFi3d_ClosedShift(const gp_Pnt2d& theRef,
+                            const gp_Pnt2d& theRaw,
+                            const double    theLU,
+                            const double    theLV)
+{
+  double aDU = 0., aDV = 0.;
+  if (theLU > 0.)
+  {
+    aDU = std::round((theRef.X() - theRaw.X()) / theLU) * theLU;
+  }
+  if (theLV > 0.)
+  {
+    aDV = std::round((theRef.Y() - theRaw.Y()) / theLV) * theLV;
+  }
+  return gp_Vec2d(aDU, aDV);
+}
+} // namespace
+
+//=======================================================================
+// function : ChFi3d_LiftCornerPoints
+// purpose  : Puts the two corner points p1 (on arc CV1.Arc()) and p2 (on arc
+//            CV2.Arc()) of a fillet on the closed face Fv on one branch of
+//            its parameter plane, by path lifting.
+//            The corner curve runs from p1 to p2 around the corner vertex V;
+//            with the boundary path p1 -> V -> p2 it bounds the corner piece
+//            of Fv that the fillet removes, so the two are homotopic and the
+//            lift of the corner curve ends where the lift of the boundary path
+//            ends. The boundary path is lifted by following the pcurves of the
+//            boundary edges from V; at each vertex the next pcurve is moved by
+//            the whole closed lengths k*L (ChFi3d_ClosedLength) that make it
+//            continuous. Shortest 3d paths from V are taken (Dijkstra), so the
+//            path is the local one around V and never one that goes around
+//            the face. The arcs need not contain V: when the seam crosses the
+//            boundary between V and a corner point, the boundary is split
+//            where it meets the seam and the path passes through that vertex,
+//            where it picks up the jump of one closed length.
+//            Degenerated edges are not followed (zero 3d length, any u).
+//            Only the relative position matters: the reference point (p1 if
+//            theRefOn1, else p2) keeps its value and the other one is moved by
+//            whole closed lengths. Returns false, changing nothing, when a
+//            point cannot be reached from V.
+//=======================================================================
+
+static bool ChFi3d_LiftCornerPoints(const TopoDS_Vertex&      theV,
+                                    const TopoDS_Face&        theFv,
+                                    const ChFiDS_CommonPoint& theCV1,
+                                    const ChFiDS_CommonPoint& theCV2,
+                                    const double              theLU,
+                                    const double              theLV,
+                                    const bool                theRefOn1,
+                                    gp_Pnt2d&                 theP1,
+                                    gp_Pnt2d&                 theP2)
+{
+  if (!theCV1.IsOnArc() || !theCV2.IsOnArc())
+  {
+    return false;
+  }
+  const TopoDS_Face aF = TopoDS::Face(theFv.Oriented(TopAbs_FORWARD));
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aVerts;
+  NCollection_Sequence<ChFi3d_BoundaryUse>                      aUses;
+  for (TopExp_Explorer anExp(aF, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+    if (BRep_Tool::Degenerated(anE))
+    {
+      continue;
+    }
+    ChFi3d_BoundaryUse aU;
+    aU.Edge = anE;
+    aU.PC   = BRep_Tool::CurveOnSurface(anE, aF, aU.First, aU.Last);
+    if (aU.PC.IsNull())
+    {
+      continue;
+    }
+    double a3F = 0., a3L = 0.;
+    aU.C3d = BRep_Tool::Curve(anE, a3F, a3L);
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(anE, aV1, aV2);
+    if (aV1.IsNull() || aV2.IsNull())
+    {
+      continue;
+    }
+    aU.IV1 = aVerts.Add(aV1);
+    aU.IV2 = aVerts.Add(aV2);
+    aUses.Append(aU);
+  }
+  const int aStart = aVerts.FindIndex(theV);
+  if (aStart == 0)
+  {
+    return false;
+  }
+
+  // Dijkstra from V over the boundary vertices; each reached vertex keeps its
+  // lifted 2d point
+  const int                    aNbV = aVerts.Extent();
+  NCollection_Array1<double>   aDist(1, aNbV);
+  NCollection_Array1<gp_Pnt2d> aLift(1, aNbV);
+  NCollection_Array1<bool>     aDone(1, aNbV);
+  aDist.Init(Precision::Infinite());
+  aDone.Init(false);
+  aDist(aStart)   = 0.;
+  bool isStartSet = false;
+  for (int i = 1; i <= aUses.Length() && !isStartSet; i++)
+  {
+    const ChFi3d_BoundaryUse& aU = aUses(i);
+    if (aU.IV1 == aStart)
+    {
+      aLift(aStart) = aU.PC->Value(aU.First);
+      isStartSet    = true;
+    }
+    else if (aU.IV2 == aStart)
+    {
+      aLift(aStart) = aU.PC->Value(aU.Last);
+      isStartSet    = true;
+    }
+  }
+  if (!isStartSet)
+  {
+    return false;
+  }
+  for (;;)
+  {
+    int aCur = 0;
+    for (int i = 1; i <= aNbV; i++)
+    {
+      if (!aDone(i) && !Precision::IsInfinite(aDist(i)) && (aCur == 0 || aDist(i) < aDist(aCur)))
+      {
+        aCur = i;
+      }
+    }
+    if (aCur == 0)
+    {
+      break;
+    }
+    aDone(aCur) = true;
+    for (int i = 1; i <= aUses.Length(); i++)
+    {
+      const ChFi3d_BoundaryUse& aU = aUses(i);
+      for (int aSide = 0; aSide < 2; aSide++)
+      {
+        const int    aFrom = aSide == 0 ? aU.IV1 : aU.IV2;
+        const int    aTo   = aSide == 0 ? aU.IV2 : aU.IV1;
+        const double aTF   = aSide == 0 ? aU.First : aU.Last;
+        const double aTT   = aSide == 0 ? aU.Last : aU.First;
+        if (aFrom != aCur || aDone(aTo))
+        {
+          continue;
+        }
+        const double aD = aDist(aCur) + ChFi3d_UseLength(aU, aTF, aTT);
+        if (aD < aDist(aTo))
+        {
+          const gp_Vec2d aShift =
+            ChFi3d_ClosedShift(aLift(aCur), aU.PC->Value(aTF), theLU, theLV);
+          aDist(aTo) = aD;
+          aLift(aTo) = aU.PC->Value(aTT).Translated(aShift);
+        }
+      }
+    }
+  }
+
+  // lifted corner point: reached through the nearer end of a use of its arc;
+  // returned as the whole closed lengths theK between it and the given point
+  auto aLiftPoint = [&](const ChFiDS_CommonPoint& theCV, const gp_Pnt2d& theP, gp_Vec2d& theK) {
+    const double aT    = theCV.ParameterOnArc();
+    double       aBest = Precision::Infinite();
+    for (int i = 1; i <= aUses.Length(); i++)
+    {
+      const ChFi3d_BoundaryUse& aU = aUses(i);
+      if (!aU.Edge.IsSame(theCV.Arc()))
+      {
+        continue;
+      }
+      for (int aSide = 0; aSide < 2; aSide++)
+      {
+        const int    aEnd = aSide == 0 ? aU.IV1 : aU.IV2;
+        const double aTE  = aSide == 0 ? aU.First : aU.Last;
+        if (Precision::IsInfinite(aDist(aEnd)))
+        {
+          continue;
+        }
+        const double aD = aDist(aEnd) + ChFi3d_UseLength(aU, aTE, aT);
+        if (aD < aBest)
+        {
+          const gp_Vec2d aShift =
+            ChFi3d_ClosedShift(aLift(aEnd), aU.PC->Value(aTE), theLU, theLV);
+          const gp_Pnt2d aL = aU.PC->Value(aT).Translated(aShift);
+          // the given point is the same boundary point on the pcurve of the
+          // arc: it differs from the lifted one by whole closed lengths only
+          theK  = ChFi3d_ClosedShift(aL, theP, theLU, theLV);
+          aBest = aD;
+        }
+      }
+    }
+    return !Precision::IsInfinite(aBest);
+  };
+  gp_Vec2d aK1, aK2;
+  if (!aLiftPoint(theCV1, theP1, aK1) || !aLiftPoint(theCV2, theP2, aK2))
+  {
+    return false;
+  }
+  if (theRefOn1)
+  {
+    theP2.Translate(aK2 - aK1);
+  }
+  else
