+//=================================================================================================
+// function : pickPeriodCopy
+// purpose  : R-009. On a face whose range along a periodic direction is wider than one period the same
+//            3D curve has several parametric copies, u2 + k*P, inside [theMin, theMax]; a curve lying on
+//            a valid face lies in exactly one of them. AdjustPCurveOnSurf tests one copy and moves by at
+//            most one period, which is not enough when more than two copies exist. theOffset is the offset
+//            that the stock test chose along the direction (theIsU: U, else V; theOther is the offset
+//            already fixed along the other direction). It is kept when its midpoint is not OUT of the face
+//            (the stock result). Otherwise every other copy inside the range is tested at the midpoint and
+//            at the parameters 1/4 and 3/4 of the curve; the first copy (nearest to theOffset) that has the
+//            midpoint and both other points IN or ON is taken, else the copy with the most such points and
+//            the midpoint IN or ON, else theOffset.
+//=================================================================================================
+static double pickPeriodCopy(const TopoDS_Face&               theF,
+                             const occ::handle<Geom2d_Curve>& theC2D,
+                             const double                     theFirst,
+                             const double                     theLast,
+                             const bool                       theIsU,
+                             const double                     theOffset,
+                             const double                     theOther,
+                             const double                     thePeriod,
+                             const double                     theMin,
+                             const double                     theMax,
+                             const double                     theDelta)
+{
+  const double aT[3] = {0.5 * (theFirst + theLast),
+                        theFirst + 0.25 * (theLast - theFirst),
+                        theFirst + 0.75 * (theLast - theFirst)};
+  gp_Pnt2d     aP[3];
+  for (int i = 0; i < 3; ++i)
+  {
+    theC2D->D0(aT[i], aP[i]);
+  }
+  // number of the tested points of the copy with the given offset that are IN or ON the face;
+  // theNb = 1 tests the midpoint only
+  auto aNbIn = [&](const double theOff, const int theNb) {
+    int aNb = 0;
+    for (int i = 0; i < theNb; ++i)
+    {
+      const gp_Pnt2d aPi = theIsU ? gp_Pnt2d(aP[i].X() + theOff, aP[i].Y() + theOther)
+                                  : gp_Pnt2d(aP[i].X() + theOther, aP[i].Y() + theOff);
+      BRepClass_FaceClassifier aClassifier;
+      aClassifier.Perform(theF, aPi, theDelta);
+      if (aClassifier.State() != TopAbs_OUT)
+      {
+        ++aNb;
+      }
+      else if (i == 0)
+      {
+        return 0;
+      }
+    }
+    return aNb;
+  };
+  if (aNbIn(theOffset, 1) > 0)
+  {
+    return theOffset;
+  }
+  const double aX0    = theIsU ? aP[0].X() : aP[0].Y();
+  double       aBest  = theOffset;
+  int          aNbMax = 0;
+  for (int k = 1;; ++k)
+  {
+    bool isInRange = false;
+    for (int aSign = 1; aSign >= -1; aSign -= 2)
+    {
+      const double anOff = theOffset + aSign * k * thePeriod;
+      const double aX    = aX0 + anOff;
+      if (aX < theMin - theDelta || aX > theMax + theDelta)
+      {
+        continue;
+      }
+      isInRange     = true;
+      const int aNb = aNbIn(anOff, 3);
+      if (aNb == 3)
+      {
+        return anOff;
+      }
+      if (aNb > aNbMax)
+      {
+        aNbMax = aNb;
+        aBest  = anOff;
+      }
+    }
+    if (!isInRange && (aX0 + theOffset - k * thePeriod < theMin - theDelta)
+        && (aX0 + theOffset + k * thePeriod > theMax + theDelta))
+    {
+      break;
+    }
+  }
+  return aBest;
+}
+
