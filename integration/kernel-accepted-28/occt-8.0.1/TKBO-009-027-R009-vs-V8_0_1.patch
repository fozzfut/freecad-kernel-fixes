+//=================================================================================================
+// function : nextPeriodCopy
+// purpose  : Moves theX to the next period copy tested by the periodic recadrage of Perform() and
+//            TestOnRestriction(). The stock order is kept: theStart, theStart + P, ... while <= theMax.
+//            A face whose parametric range is wider than one period holds several copies of one
+//            surface point; GeomInt::AdjustPeriodic returns the highest copy for a parameter below
+//            theMin, so the copies below theStart were never tested and a point of the face could be
+//            classified OUT. On such a face (theIsWide) the scan continues downwards from
+//            theStart - P while >= theMin. Returns false when the scan is exhausted.
+//=================================================================================================
+static bool nextPeriodCopy(double&      theX,
+                           bool&        theIsDown,
+                           const double theStart,
+                           const double theMin,
+                           const double theMax,
+                           const double thePeriod,
+                           const bool   theIsWide)
+{
+  if (!theIsDown)
+  {
+    theX += thePeriod;
+    if (!(theX > theMax))
+    {
+      return true;
+    }
+    if (!theIsWide)
+    {
+      return false;
+    }
+    theIsDown = true;
+    theX      = theStart - thePeriod;
+  }
+  else
+  {
+    theX -= thePeriod;
+  }
+  return !(theX < theMin);
+}
