+//=================================================================================================
+// function : restrictToOnePeriod009
+// purpose  : R-009 r2. The intersectors (IntPatch walking and approximation, GeomInt pcurves) work on
+//            the parametric domain loaded into the adaptor and assume that the surface map is one to
+//            one on it. A face whose range along a periodic direction is wider than one period (a
+//            Refine-merged thread strip, a band wound several times around a torus tube) gives a domain
+//            that covers part of the surface several times. A section curve that winds along that
+//            direction then lifts to one open arc running through all the copies: the walking line
+//            covers the same 3D points up to [range/period] times, its approximation overlaps itself,
+//            paves projected on it land on an arbitrary pass, and pieces that lie on the face in no copy
+//            are kept or genuine pieces are lost (measured: 0 section edges, or 113 of section length
+//            where 33.7 lie on the face).
+//            Every point of such a face is the image of a parameter inside ONE period window
+//            [min, min + P] of that direction (the surface is P-periodic), so the section of the face
+//            is contained in the section of the window; the window is the fundamental domain of the
+//            universal-cover argument (see LITERATURE-R009 r2). The section is therefore computed on
+//            the window and each resulting section-edge piece is placed on its copy of the face later
+//            by the r1 code (IntTools_FClass2d scans every copy; BOPTools_AlgoTools2D::pickPeriodCopy).
+//            The window is applied only when the overlap (range - P) exceeds the parametric
+//            resolution of the face tolerance: a smaller overlap maps within tolerance of the window
+//            start, creates no distinct 3D point and leaves the stock domain (and results) unchanged.
+//            Returns true when the domain was changed; theLow receives the window starts (U, V).
+//=================================================================================================
+static bool restrictToOnePeriod009(const occ::handle<GeomAdaptor_Surface>& theHS,
+                                   const occ::handle<Geom_Surface>&        theS,
+                                   const double                            theTol,
+                                   double                                  theLow[2],
+                                   bool                                    theIsWin[2])
+{
+  double aU[2] = {theHS->FirstUParameter(), theHS->LastUParameter()};
+  double aV[2] = {theHS->FirstVParameter(), theHS->LastVParameter()};
+  theLow[0]    = aU[0];
+  theLow[1]    = aV[0];
+  theIsWin[0] = theIsWin[1] = false;
+  if (theHS->IsUPeriodic() && !Precision::IsInfinite(aU[0]) && !Precision::IsInfinite(aU[1]))
+  {
+    const double aP = theHS->UPeriod();
+    if (aP > 0. && (aU[1] - aU[0]) - aP > theHS->UResolution(theTol))
+    {
+      aU[1]       = aU[0] + aP;
+      theIsWin[0] = true;
+    }
+  }
+  if (theHS->IsVPeriodic() && !Precision::IsInfinite(aV[0]) && !Precision::IsInfinite(aV[1]))
+  {
+    const double aP = theHS->VPeriod();
+    if (aP > 0. && (aV[1] - aV[0]) - aP > theHS->VResolution(theTol))
