+//=================================================================================================
+// 027: far-vertex rejection in IsVertexOnLine.
+// A B-spline or Bezier curve with positive weights lies in the convex hull of its poles, hence in
+// the axis-aligned box of the poles, over its whole parameter range (Boehm 1980; Sederberg-Nishita
+// 1990 use the same property to discard curve pieces). The distance from a point to that box is a
+// lower bound of its distance to every point of the curve, including the points the projector
+// returns and the curve ends. When that bound exceeds the vertex/curve tolerance sum (with a margin
+// for rounding of the evaluated curve points), IsVertexOnLine returns false on every path, so the
+// projection (O(number of spans) per vertex, run for every vertex x every section curve) is skipped.
+namespace
+{
+//! Returns the distance from thePnt to the box of the poles of theCurve, or -1 when the curve is not
+//! exactly a Geom_BSplineCurve or Geom_BezierCurve. theScale receives the largest absolute coordinate
+//! of the box and the point (for the rounding margin).
+static double distanceToPolesBox(const occ::handle<Geom_Curve>& theCurve,
+                                 const gp_Pnt&                  thePnt,
+                                 double&                        theScale)
+{
+  const NCollection_Array1<gp_Pnt>* aPoles = nullptr;
+  if (theCurve->DynamicType() == STANDARD_TYPE(Geom_BSplineCurve))
+  {
+    aPoles = &static_cast<const Geom_BSplineCurve*>(theCurve.get())->Poles();
+  }
+  else if (theCurve->DynamicType() == STANDARD_TYPE(Geom_BezierCurve))
+  {
+    aPoles = &static_cast<const Geom_BezierCurve*>(theCurve.get())->Poles();
+  }
+  if (aPoles == nullptr || aPoles->IsEmpty())
+  {
+    return -1.;
+  }
+  double aMin[3], aMax[3];
+  const gp_XYZ& aP0 = aPoles->First().XYZ();
+  for (int k = 0; k < 3; ++k)
+  {
+    aMin[k] = aMax[k] = aP0.Coord(k + 1);
+  }
+  for (NCollection_Array1<gp_Pnt>::Iterator anIt(*aPoles); anIt.More(); anIt.Next())
+  {
+    const gp_XYZ& aP = anIt.Value().XYZ();
+    for (int k = 0; k < 3; ++k)
+    {
+      const double aC = aP.Coord(k + 1);
+      aMin[k]         = std::min(aMin[k], aC);
+      aMax[k]         = std::max(aMax[k], aC);
+    }
+  }
+  double aSq = 0.;
+  theScale   = 0.;
+  for (int k = 0; k < 3; ++k)
+  {
+    const double aC = thePnt.XYZ().Coord(k + 1);
+    const double aD = aC < aMin[k] ? aMin[k] - aC : (aC > aMax[k] ? aC - aMax[k] : 0.);
+    aSq += aD * aD;
+    theScale = std::max(theScale, std::max(std::abs(aC), std::max(std::abs(aMin[k]), std::abs(aMax[k]))));
+  }
+  return std::sqrt(aSq);
+}
+
+//! True when the vertex point is provably farther than theTolSum from every point of theCurve.
+static bool isFarFromCurveHull(const occ::handle<Geom_Curve>& theCurve,
+                               const gp_Pnt&                  thePnt,
+                               const double                   theTolSum)
+{
+  double       aScale = 0.;
+  const double aDist  = distanceToPolesBox(theCurve, thePnt, aScale);
+  if (!(aDist >= 0.)) // other curve types, NaN
+  {
+    return false;
+  }
+  // margin: rounding of evaluated curve points and of the distances (far above 1e-15 * scale)
+  const double aMargin = 1.e-7 + 1.e-9 * aScale;
+#ifdef INTTOOLS_027_MUTANT_A
+  (void)aMargin;
+  return true; // negative control: every projection is skipped, also for vertices on the line
+#else
+  return aDist > theTolSum + aMargin;
+#endif
+}
+} // namespace
