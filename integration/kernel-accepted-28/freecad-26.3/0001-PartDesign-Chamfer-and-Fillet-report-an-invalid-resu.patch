@@ -56,6 +56,7 @@
 #include <Mod/Part/App/TopoShape.h>
 #include <Mod/Part/App/TopoShapeOpCode.h>
 
+#include "DressUpValidity.h"
 #include "FeatureChamfer.h"
 
 #include <Base/ProgramVersion.h>
@@ -351,6 +352,38 @@ std::string diagnoseAngle(
     return {};
 }
 
+// Text for a chamfer whose result solid is invalid. Two distances / Distance and Angle: names the
+// face(s) Size is measured on and suggests Flip direction (the other face). Equal distance: Flip
+// changes nothing, so it suggests a smaller Size.
+std::string invalidChamferMessage(
+    const Part::TopoShape& shape,
+    const std::vector<TopoDS_Shape>& refFaces,
+    int chamferType
+)
+{
+    if (chamferType == 0 || refFaces.empty()) {
+        return QT_TRANSLATE_NOOP("Exception", "Chamfer gives an invalid solid; try a smaller Size");
+    }
+    std::vector<int> seen;
+    std::string faces;
+    for (const auto& f : refFaces) {
+        const int i = shape.findShape(f);
+        if (i <= 0 || std::find(seen.begin(), seen.end(), i) != seen.end()) {
+            continue;
+        }
+        seen.push_back(i);
+        faces += (faces.empty() ? "Face" : ", Face") + std::to_string(i);
+    }
+    // The template is marked for translation; FreeCAD shows the returned text with the face
+    // names filled in.
+    std::string msg = QT_TRANSLATE_NOOP(
+        "Exception",
+        "Chamfer gives an invalid solid with Size on %1; try Flip direction"
+    );
+    msg.replace(msg.find("%1"), 2, faces);
+    return msg;
+}
+
 }  // namespace
 
 App::DocumentObjectExecReturn* Chamfer::execute()
@@ -482,6 +515,7 @@ App::DocumentObjectExecReturn* Chamfer::execute()
 
         TopTools_ListOfShape aLarg;
         aLarg.Append(TopShape.getShape());
+        bool resultValid = true;
         if (!BRepAlgo::IsValid(aLarg, shape.getShape(), Standard_False, Standard_False)) {
             ShapeFix_ShapeTolerance aSFT;
             aSFT.LimitTolerance(
@@ -490,6 +524,19 @@ App::DocumentObjectExecReturn* Chamfer::execute()
                 Precision::Confusion(),
                 TopAbs_SHAPE
             );
+            // The check above already failed; only here can the result be invalid, so a valid
+            // chamfer pays nothing extra. Did limiting the tolerances repair it?
+            resultValid = dressUpResultIsValid(TopShape.getShape(), shape.getShape());
+        }
+        if (!resultValid) {
+            // OCCT can return an invalid solid without an error (e.g. a Size running into a
+            // fillet at the edge end). New chamfers fail; old documents (Legacy) keep the stock
+            // result and get one warning per recompute, so they still open and recompute.
+            std::string why = invalidChamferMessage(TopShape, refFaces, chamferType);
+            if (consistent) {
+                return new App::DocumentObjectExecReturn(why);
+            }
+            Base::Console().warning("{}: {}\n", Label.getValue(), why);
         }
 
         // store shape before refinement
