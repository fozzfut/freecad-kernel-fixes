+#ifndef PARTDESIGN_DRESSUPVALIDITY_H
+#define PARTDESIGN_DRESSUPVALIDITY_H
+
+#include <BRepCheck_Analyzer.hxx>
+#include <BRepCheck_Shell.hxx>
+#include <BRepCheck_Status.hxx>
+#include <BRep_Builder.hxx>
+#include <TopExp.hxx>
+#include <TopExp_Explorer.hxx>
+#include <TopTools_IndexedMapOfShape.hxx>
+#include <TopoDS.hxx>
+#include <TopoDS_Compound.hxx>
+#include <TopoDS_Shape.hxx>
+
+namespace PartDesign
+{
+
+// Read-only re-run of the check BRepAlgo::IsValid(base, result, false, false) makes on a dress-up
+// result: the faces of the result that are not faces of the base get the full BRepCheck (with the
+// geometric controls), every shell of the result its status and orientation check. Unlike
+// BRepAlgo::IsValid it never repairs anything (no SameParameter), so calling it cannot change the
+// result. Faces taken over unchanged from the base are not checked: a defect already in the base
+// is not the dress-up's fault. Not exported (header-only, internal).
+inline bool dressUpResultIsValid(const TopoDS_Shape& base, const TopoDS_Shape& result)
+{
+    if (result.IsNull() || result.IsSame(base)) {
+        return true;
+    }
+    TopTools_IndexedMapOfShape baseFaces;
+    TopExp::MapShapes(base, TopAbs_FACE, baseFaces);
+    if (baseFaces.IsEmpty()) {
+        return BRepCheck_Analyzer(result, true).IsValid();
+    }
+    TopoDS_Compound toCheck;
+    BRep_Builder builder;
+    for (TopExp_Explorer ex(result, TopAbs_FACE); ex.More(); ex.Next()) {
+        if (!baseFaces.Contains(ex.Current())) {
+            if (toCheck.IsNull()) {
+                builder.MakeCompound(toCheck);
+            }
+            builder.Add(toCheck, ex.Current());
+        }
+    }
+    if (!toCheck.IsNull() && !BRepCheck_Analyzer(toCheck, true).IsValid()) {
+        return false;
+    }
+    for (TopExp_Explorer ex(result, TopAbs_SHELL); ex.More(); ex.Next()) {
+        BRepCheck_Shell shell(TopoDS::Shell(ex.Current()));
+        if (shell.Status().First() != BRepCheck_NoError) {
+            return false;
+        }
+        if (shell.Orientation(false) != BRepCheck_NoError) {
+            return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace PartDesign
+
+#endif  // PARTDESIGN_DRESSUPVALIDITY_H
