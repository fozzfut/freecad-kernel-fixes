+        anArcs.Append(TopoDS::Face(anArc));
+        aBoxes.Append(aBox);
+      }
+    }
+    for (int k1 = 1; k1 <= anArcs.Length(); ++k1)
+    {
+      for (int k2 = k1 + 1; k2 <= anArcs.Length(); ++k2)
+      {
+        if (aBoxes(k1).IsOut(aBoxes(k2)) || IsDone(anArcs(k1), anArcs(k2)))
+        {
+          continue;
+        }
+        ++offsetArcPairs034().Candidates;
+        if (!offsetArcPairs034().Enabled)
+        {
+          continue;
+        }
+        BRepOffset_Tool::Inter3D(anArcs(k1), anArcs(k2), LInt1, LInt2, mySide, NullEdge, NullFace, NullFace);
+        Store(anArcs(k1), anArcs(k2), LInt1, LInt2);
+      }
+    }
+  }
