+  // Issue 034, lane cav: the tubes of the edges (and spheres of the
+  // vertices) of the arc join are pieces of the offset of the solid, the
+  // union of the offsets of all its faces, edges and vertices (Rossignac-
+  // Requicha 1986). Its boundary is cut out of their boundaries by ALL the
+  // pairs that meet, not only by the pairs that share a vertex: where the
+  // solid is thinner than 2|t| (a neck, a rib) the tubes of edges on
+  // opposite sides of the thin part meet, and the offset changes topology
+  // there (Sherbrooke-Patrikalakis-Brisson 1996: at the medial axis). The
+  // pairs above follow the adjacency of the input only, so such tubes were
+  // never intersected: they ran through each other and the offset of the
+  // part behind the neck did not close (its shell was dropped as debris).
+  // Here every other pair of tubes/spheres whose boxes overlap is
+  // intersected as well (a broad-phase box test, the intersection itself
+  // decides; a pair that does not meet adds nothing).
+  {
+    NCollection_Sequence<TopoDS_Face> anArcs;
+    NCollection_Sequence<Bnd_Box>     aBoxes;
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aSeen;
+    for (int aType = 0; aType < 2; ++aType)
+    {
+      for (Exp.Init(ShapeInit, aType == 0 ? TopAbs_EDGE : TopAbs_VERTEX); Exp.More(); Exp.Next())
+      {
+        if (!InitOffsetFace.HasImage(Exp.Current()))
