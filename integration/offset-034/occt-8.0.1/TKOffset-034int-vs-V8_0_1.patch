+//! Issue 034, lane cav: state of the pairs of arc-join tubes/spheres that
+//! are not neighbours in the input (see ConnexIntByArc): Enabled for the
+//! second construction of BRepOffset_MakeOffset, Candidates counts the
+//! pairs whose boxes overlap. Not exported (no Standard_EXPORT).
+OffsetArcPairs034& offsetArcPairs034()
+{
+  static thread_local OffsetArcPairs034 aState;
+  return aState;
+}
+
+//=======================================================================
+// Issue 034, lane cav: intersection of enlarged faces at the size of the
+// model when the "infinite" enlargement lost it.
+//
+// The intersection join intersects the offset faces enlarged to +-1.e+7
+// (TheInfini of BRepOffset_Tool): with 15 significant digits a coordinate
+// of 1.e+7 carries an error of ~1.e-9 before any computation, and the
+// sections are bounded where they leave these far boundaries (edge/face
+// intersections at 1.e+7). The TheInfini note assumes the result is still
+// within Precision::Confusion(); in a general placement (rotation +
+// translation of the part) the far boundaries are no longer aligned with
+// the section and that assumption fails: the section curve is found but
+// gets no bounded edge (no pave block), the pair is reported as not
+// intersecting and the offset face keeps the untrimmed boundary of its
+// neighbour - a shell that is not closed and is dropped as debris
+// (Jackson 1995, SPM: a tolerance must cover the numerical error of the
+// geometry it is attached to; here the 1.e+7 bounds exceed it).
+// When the enlarged pair gives no section, the same surfaces are
+// intersected again on a window of the size of the offset faces: their
+// UV box widened by 10 times its size on each side (the finite extension
+// of BRepOffset_Tool::EnLargeFace), clipped to the enlarged box. Same
+// surfaces and locations -> the section edges (and their pcurves) belong
+// to the enlarged faces as before; only pairs that found no section are
+// computed again, a pair with a section is never touched.
+//=======================================================================
+static bool window034(const TopoDS_Face& theNF, const TopoDS_Face& theOF, TopoDS_Face& theW)
+{
+  if (theOF.IsNull() || theNF.IsNull())
+  {
+    return false;
+  }
+  TopLoc_Location                  aLN, aLO;
+  const occ::handle<Geom_Surface>& aSN = BRep_Tool::Surface(theNF, aLN);
+  const occ::handle<Geom_Surface>& aSO = BRep_Tool::Surface(theOF, aLO);
+  if (aSN.IsNull() || aSN != aSO || !aLN.IsEqual(aLO))
+  {
+    return false; // the enlargement changed the surface: UV of the offset face do not apply
+  }
+  double aNU0, aNU1, aNV0, aNV1, aU0, aU1, aV0, aV1;
+  BRepTools::UVBounds(theNF, aNU0, aNU1, aNV0, aNV1);
+  BRepTools::UVBounds(theOF, aU0, aU1, aV0, aV1);
+  const double aDU = aU1 - aU0, aDV = aV1 - aV0;
+  double       aWU0 = aNU0, aWU1 = aNU1, aWV0 = aNV0, aWV1 = aNV1;
+  if (!aSN->IsUPeriodic())
+  {
+    aWU0 = std::max(aNU0, aU0 - 10. * aDU);
+    aWU1 = std::min(aNU1, aU1 + 10. * aDU);
+  }
+  if (!aSN->IsVPeriodic())
+  {
+    aWV0 = std::max(aNV0, aV0 - 10. * aDV);
+    aWV1 = std::min(aNV1, aV1 + 10. * aDV);
+  }
+  if (aWU0 <= aNU0 && aWU1 >= aNU1 && aWV0 <= aNV0 && aWV1 >= aNV1)
+  {
+    return false; // the window is the enlarged face itself
+  }
+  BRepLib_MakeFace aMF(aSN, aWU0, aWU1, aWV0, aWV1, BRep_Tool::Tolerance(theNF));
+  if (!aMF.IsDone())
+  {
+    return false;
+  }
+  theW = aMF.Face();
+  theW.Location(aLN);
+  theW.Orientation(theNF.Orientation());
+  return true;
+}
+
+//! Intersects the windows of the two enlarged faces (see window034); the
+//! edges are stored for the enlarged faces by the caller.
+static void interWindows034(const TopoDS_Face&              theNF1,
+                            const TopoDS_Face&              theOF1,
+                            const TopoDS_Face&              theNF2,
+                            const TopoDS_Face&              theOF2,
+                            NCollection_List<TopoDS_Shape>& theL1,
+                            NCollection_List<TopoDS_Shape>& theL2,
+                            const TopAbs_State              theSide,
+                            const TopoDS_Edge&              theRefEdge,
+                            const TopoDS_Face&              theRefFace1,
+                            const TopoDS_Face&              theRefFace2)
+{
+  TopoDS_Face aW1 = theNF1, aW2 = theNF2;
+  bool        isW1 = false, isW2 = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    isW1 = window034(theNF1, theOF1, aW1);
+    isW2 = window034(theNF2, theOF2, aW2);
+  }
+  catch (Standard_Failure const&)
+  {
+    return; // no window: the pair stays without section, as before
+  }
+  if (!isW1 && !isW2)
+  {
+    return;
+  }
+  NCollection_List<TopoDS_Shape> aL1, aL2;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    BRepOffset_Tool::Inter3D(aW1, aW2, aL1, aL2, theSide, theRefEdge, theRefFace1, theRefFace2);
+  }
+  catch (Standard_Failure const&)
+  {
+    return; // the pair stays without section, as before
+  }
+  // BRepLib_MakeFace puts the U range of a periodic surface into its first
+  // period; bring the pcurves back into the UV range of the enlarged faces
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(aL1); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anIt.Value());
+    for (int k = 0; k < 2; ++k)
+    {
+      const TopoDS_Face& aW  = k == 0 ? aW1 : aW2;
+      const TopoDS_Face& aNF = k == 0 ? theNF1 : theNF2;
+      if ((k == 0 ? !isW1 : !isW2) || !BRep_Tool::Surface(aNF)->IsUPeriodic())
+      {
+        continue;
+      }
+      double                           aF, aL;
+      const occ::handle<Geom2d_Curve>& aC2d = BRep_Tool::CurveOnSurface(anE, aW, aF, aL);
+      if (aC2d.IsNull())
+      {
+        continue;
+      }
+      occ::handle<Geom2d_Curve> aC2dA;
+      BOPTools_AlgoTools2D::AdjustPCurveOnFace(aNF, aF, aL, aC2d, aC2dA);
+      if (!aC2dA.IsNull() && aC2dA != aC2d)
+      {
+        BRep_Builder().UpdateEdge(anE, aC2dA, aNF, BRep_Tool::Tolerance(anE));
+      }
+    }
+  }
+  theL1 = aL1;
+  theL2 = aL2;
+}
