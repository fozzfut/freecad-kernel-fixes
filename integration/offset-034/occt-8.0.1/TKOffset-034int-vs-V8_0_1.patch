+
+//! True if the shape holds no face.
+static bool hasNoFace034(const TopoDS_Shape& theS)
+{
+  return theS.IsNull() || !TopExp_Explorer(theS, TopAbs_FACE).More();
+}
+
+//=======================================================================
+// Issue 034 stage A2: structural guard of offset and thick solids.
+//
+// The boundary of a valid solid is a set of closed, coherently oriented
+// 2-manifold shells: every edge of a shell bounds two of its faces and
+// is used by them with opposite orientations (Requicha 1980). A thick
+// solid made with removed faces (shelling, Forsyth 1995)
+// has one more rule: each connected piece of the remaining input faces
+// that has a free boundary (the rim of the opening) is joined to its
+// offset into ONE shell; a piece without free boundary (e.g. the wall
+// of an inner void) keeps its own shell and gets a second one from its
+// offset. So a thick solid never has more shells than
+//   sum over the pieces: 1 (piece with a free boundary) or 2 (closed piece).
+// A result that breaks these counts is broken whatever the geometry:
+// an opening that was not cut leaves the offset shell closed and apart
+// (e.g. a box filleted on all edges with the top face removed).
+// The checks are pure topology, linear in the number of edges.
+//=======================================================================
+
+//! Uses of the edges of one shell: for each non-degenerated edge the
+//! number of FORWARD and REVERSED uses and the first face using it.
+struct EdgeUses034
+{
+  int NbF   = 0;
+  int NbR   = 0;
+  int Face1 = 0;
+  int Face2 = 0; //!< the first face of the second use (0 = none)
+};
+
+//! Collects the edge uses of the FORWARD/REVERSED faces of theS
+//! (orientations composed as in the shape, like BRepCheck_Shell).
+static void collectEdgeUses034(
+  const TopoDS_Shape&                                            theS,
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theEdges,
+  NCollection_DynamicArray<EdgeUses034>&                         theUses)
+{
+  int aFaceIdx = 0;
+  for (TopExp_Explorer aFExp(theS, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    const TopAbs_Orientation aFOr = aFExp.Current().Orientation();
+    if (aFOr != TopAbs_FORWARD && aFOr != TopAbs_REVERSED)
+    {
+      continue;
+    }
+    ++aFaceIdx;
+    for (TopExp_Explorer anEExp(aFExp.Current(), TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      const TopoDS_Edge&       anE  = TopoDS::Edge(anEExp.Current());
+      const TopAbs_Orientation anOr = anE.Orientation();
+      if ((anOr != TopAbs_FORWARD && anOr != TopAbs_REVERSED) || BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      const int anIdx = theEdges.Add(anE); // indices come in order 1, 2, ...
+      if (anIdx > theUses.Length())
+      {
+        theUses.Append(EdgeUses034());
+      }
+      EdgeUses034& aU = theUses.ChangeValue(anIdx - 1);
+      if (aU.NbF + aU.NbR == 0)
+      {
+        aU.Face1 = aFaceIdx;
+      }
+      else if (aU.NbF + aU.NbR == 1)
+      {
+        aU.Face2 = aFaceIdx;
+      }
+      (anOr == TopAbs_FORWARD ? aU.NbF : aU.NbR)++;
+    }
+  }
+}
+
+//! True if a shell of a solid of theS is open or incoherently oriented:
+//! a non-degenerated edge used once (BRepCheck_NotClosed), or used by two
+//! different faces with the same orientation (BRepCheck_BadOrientationOf
+//! Subshape). Edges with more than two uses are left to BRepCheck.
+static bool shellBroken034(const TopoDS_Shape& theShell)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  NCollection_DynamicArray<EdgeUses034>                         aUses;
+  collectEdgeUses034(theShell, anEdges, aUses);
+  for (int i = 0; i < aUses.Length(); ++i)
+  {
+    const EdgeUses034& aU  = aUses.Value(i);
+    const int          aNb = aU.NbF + aU.NbR;
+    if (aNb == 1 || (aNb == 2 && aU.NbF != 1 && aU.Face1 != aU.Face2))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool solidShellsBroken034(const TopoDS_Shape& theS)
+{
+  for (TopExp_Explorer aSoExp(theS, TopAbs_SOLID); aSoExp.More(); aSoExp.Next())
+  {
+    for (TopExp_Explorer aShExp(aSoExp.Current(), TopAbs_SHELL); aShExp.More(); aShExp.Next())
+    {
+      if (shellBroken034(aShExp.Current()))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+//! Issue 034, lane cav: the same test on every shell of theS, also on the
+//! shells outside any solid. MakeSolid() puts a shell that is not closed
+//! loose into a compound, where solidShellsBroken034() does not look; for
+//! a closed input (isClosedInput034) such a shell is a broken offset.
+static bool anyShellBroken034(const TopoDS_Shape& theS)
+{
+  for (TopExp_Explorer aShExp(theS, TopAbs_SHELL); aShExp.More(); aShExp.Next())
+  {
+    if (shellBroken034(aShExp.Current()))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//! Issue 034, lane cav: true if no edge of the faces to offset is a free
+//! bound (the input is closed: the offset of a closed boundary is closed).
+static bool isClosedInput034(const TopoDS_Shape& theFaceComp, const BRepOffset_Analyse& theAnalyse)
+{
+  for (TopExp_Explorer anEExp(theFaceComp, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anEExp.Current());
+    if (BRep_Tool::Degenerated(anE) || !theAnalyse.HasAncestor(anE)
+        || theAnalyse.Ancestors(anE).Extent() >= 2)
+    {
+      continue;
+    }
+    const NCollection_List<BRepOffset_Interval>& aType = theAnalyse.Type(anE);
+    if (!aType.IsEmpty() && aType.First().Type() == ChFiDS_FreeBound)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+//! Number of shells of theS.
+static int nbShells034(const TopoDS_Shape& theS)
+{
+  int aNb = 0;
+  for (TopExp_Explorer aShExp(theS, TopAbs_SHELL); aShExp.More(); aShExp.Next())
+  {
+    ++aNb;
+  }
+  return aNb;
+}
+
+//! Largest number of shells a thick solid glued from the faces of theRest
+//! (the input without the removed faces) and their offsets can have: per
+//! connected piece of theRest, 1 if the piece has a free edge, else 2.
+static int maxThickShells034(const TopoDS_Shape& theRest)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aFaces;
+  for (TopExp_Explorer aFExp(theRest, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aFaces.Add(aFExp.Current());
+  }
+  const int aNbF = aFaces.Extent();
+  if (aNbF == 0)
+  {
+    return 0;
+  }
+  // union-find over the faces through their shared edges
+  NCollection_Array1<int> aParent(0, aNbF);
+  for (int i = 0; i <= aNbF; ++i)
+  {
+    aParent(i) = i;
+  }
+  auto aFind = [&aParent](int theI) {
+    while (aParent(theI) != theI)
+    {
+      aParent(theI) = aParent(aParent(theI));
+      theI          = aParent(theI);
+    }
+    return theI;
+  };
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+  NCollection_DynamicArray<int> anEdgeFace; // first face of an edge
+  NCollection_DynamicArray<int> anEdgeUses;
+  for (int iF = 1; iF <= aNbF; ++iF)
+  {
+    for (TopExp_Explorer anEExp(aFaces(iF), TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anEExp.Current());
+      if (BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      const int anIdx = anEdges.Add(anE); // indices come in order 1, 2, ...
+      if (anIdx > anEdgeFace.Length())
+      {
+        anEdgeFace.Append(iF);
+        anEdgeUses.Append(0);
+      }
+      ++anEdgeUses.ChangeValue(anIdx - 1);
+      const int aR1 = aFind(anEdgeFace.Value(anIdx - 1)), aR2 = aFind(iF);
+      if (aR1 != aR2)
+      {
+        aParent(aR1) = aR2;
+      }
+    }
+  }
+  NCollection_Map<int> anOpenRoots, aRoots;
+  for (int i = 0; i < anEdgeUses.Length(); ++i)
+  {
+    if (anEdgeUses.Value(i) == 1)
+    {
+      anOpenRoots.Add(aFind(anEdgeFace.Value(i)));
+    }
+  }
+  int aMax = 0;
+  for (int iF = 1; iF <= aNbF; ++iF)
+  {
+    const int aR = aFind(iF);
+    if (aRoots.Add(aR))
+    {
+      aMax += anOpenRoots.Contains(aR) ? 1 : 2;
+    }
+  }
+  return aMax;
+}
+
+//! Stage A2: true if the join is the intersection and a free-form face of
+//! theFaces has a tangent edge (BRepOffset_Analyse: ChFiDS_Tangential): the
+//! offsets of the two faces are tangent along the edge and their
+//! intersection is ill-conditioned; the result can come back valid for
+//! BRepCheck but self-intersecting. Such results are checked like the ones
+//! where a face can fold. Analytic faces are left out (their tangency is
+//! handled exactly).
+static bool tangentFreeFormJoin034(const TopoDS_Shape&       theFaces,
+                                   const GeomAbs_JoinType    theJoin,
+                                   const BRepOffset_Analyse& theAnalyse)
+{
+  if (theJoin != GeomAbs_Intersection)
+  {
+    return false;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    NCollection_List<TopoDS_Shape> aTangent;
+    for (TopExp_Explorer aFExp(theFaces, TopAbs_FACE); aFExp.More(); aFExp.Next())
+    {
+      const TopoDS_Face&               aF = TopoDS::Face(aFExp.Current());
+      TopLoc_Location                  aLoc;
+      const occ::handle<Geom_Surface>& aS = BRep_Tool::Surface(aF, aLoc);
+      if (aS.IsNull())
+      {
+        continue;
+      }
+      switch (GeomAdaptor_Surface(aS).GetType())
+      {
+        case GeomAbs_Plane:
+        case GeomAbs_Cylinder:
+        case GeomAbs_Cone:
+        case GeomAbs_Sphere:
+        case GeomAbs_Torus:
+          continue;
+        default:
+          break;
+      }
+      theAnalyse.Edges(aF, ChFiDS_Tangential, aTangent);
+      if (!aTangent.IsEmpty())
+      {
+        return true;
+      }
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return true;
+  }
+  return false;
+}
+
+//=======================================================================
+// Issue 034 stage A2, round 2: which shells a thick solid may have.
+//
+// A thick solid is the input minus its inner offset (Rossignac-Requicha
+// 1986). The inner offset can split into several components: where the
+// input is thinner than 2|t| (a neck) the offset pinches off, and a
+// component that no opening reaches stays a closed cavity. So the shells
+// of a correct thick solid are of two kinds only:
+//  - ANCHORED: it holds kept input faces (one per connected piece of them);
+//  - CAVITY: offset faces only (images of kept faces, edges, vertices):
+//    the offset of a closed piece, or a pinched-off part of the hollow.
+// The wall of an opening (the image of a removed face) is the band of the
+// removed face between its rim (edges shared with kept faces) and the
+// offset; every piece of the band touches the rim, so the wall lies in an
+// anchored shell and meets offset faces there. Hence:
+//  - a shell without kept faces that holds a wall is impossible: the
+//    opening was not cut, the offset shell was closed across it (Broken);
+//  - more shells than the pieces give (maxThickShells034) are legal
+//    exactly when the extra ones are cavities: every shell without kept
+//    faces is made of known offset faces only, and every wall meets an
+//    offset face (the opening is cut through to the offset). Otherwise
+//    the extra shell is not explained by the construction (Proven false).
+// Pure topology on the history of the offset (myInitOffsetFace) and on the
+// copies made by the gluing; linear in the number of faces and edges.
+//=======================================================================
+struct ThickShells034
+{
+  bool Broken = false; //!< a shell without kept faces holds a wall
+  bool Proven = true;  //!< every shell is anchored or a cavity, every wall meets an offset face
+};
+
+static TopoDS_Shape glued034(const BRepTools_Quilt& theGlue, const TopoDS_Shape& theS)
+{
+  return theGlue.IsCopied(theS) ? theGlue.Copy(theS) : theS;
+}
+
+static ThickShells034 thickShells034(
+  const TopoDS_Shape&                                                  theSolid,
+  const TopoDS_Shape&                                                  theKept,
+  const BRepTools_Quilt&                                               theGlue,
+  const BRepAlgo_Image&                                                theInit,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theRemoved)
+{
+  ThickShells034                                         aRes;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aKept, aWalls, anOffsets;
+  for (TopExp_Explorer aFExp(theKept, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aKept.Add(glued034(theGlue, aFExp.Current()));
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator aRIt(theInit.Roots()); aRIt.More(); aRIt.Next())
+  {
+    const TopoDS_Shape& aRoot = aRIt.Value();
+    if (!theInit.HasImage(aRoot))
+    {
+      continue;
+    }
+    const bool                     isWall = theRemoved.Contains(aRoot);
+    NCollection_List<TopoDS_Shape> anImages;
+    theInit.LastImage(aRoot, anImages);
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(anImages); anIt.More(); anIt.Next())
+    {
+      for (TopExp_Explorer aFExp(anIt.Value(), TopAbs_FACE); aFExp.More(); aFExp.Next())
+      {
+        const TopoDS_Shape aF = glued034(theGlue, aFExp.Current());
+        (isWall ? aWalls : anOffsets).Add(aF);
+      }
+    }
+  }
+  // shells: a shell without kept faces must be a cavity of offset faces
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> anOffsetEdges;
+  for (TopExp_Explorer aShExp(theSolid, TopAbs_SHELL); aShExp.More(); aShExp.Next())
+  {
+    bool isAnchored = false, hasWall = false, hasUnknown = false;
+    for (TopExp_Explorer aFExp(aShExp.Current(), TopAbs_FACE); aFExp.More(); aFExp.Next())
+    {
+      const TopoDS_Shape& aF = aFExp.Current();
+      if (aKept.Contains(aF))
+      {
+        isAnchored = true;
+      }
+      else if (aWalls.Contains(aF))
+      {
+        hasWall = true;
+      }
+      else if (anOffsets.Contains(aF))
+      {
+        for (TopExp_Explorer anEExp(aF, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+        {
+          anOffsetEdges.Add(anEExp.Current());
+        }
+      }
+      else
+      {
+        hasUnknown = true;
+      }
+    }
+    if (!isAnchored && hasWall)
+    {
+      aRes.Broken = true;
+      aRes.Proven = false;
+      return aRes;
+    }
+    if (!isAnchored && hasUnknown)
+    {
+      aRes.Proven = false;
+    }
+  }
+  // walls: each one meets an offset face (the opening reaches the offset)
+  for (TopExp_Explorer aFExp(theSolid, TopAbs_FACE); aRes.Proven && aFExp.More(); aFExp.Next())
+  {
+    if (!aWalls.Contains(aFExp.Current()))
+    {
+      continue;
+    }
+    bool isMet = false;
+    for (TopExp_Explorer anEExp(aFExp.Current(), TopAbs_EDGE); !isMet && anEExp.More();
+         anEExp.Next())
+    {
+      isMet = anOffsetEdges.Contains(anEExp.Current());
+    }
+    aRes.Proven = isMet;
+  }
+  return aRes;
+}
+
+//! Issue 034 A3. True if theF1 and theF2 are G1 along theE, with the same
+//! criterion as BRepOffset_Analyse (EdgeAnalyse): two planes only by the
+//! continuity flag of the edge, other pairs by ChFi3d::IsTangentFaces.
+static bool edgeTangent034(const TopoDS_Edge& theE,
+                           const TopoDS_Face& theF1,
+                           const TopoDS_Face& theF2)
+{
+  const BRepAdaptor_Surface aS1(theF1, false), aS2(theF2, false);
+  if (aS1.GetType() == GeomAbs_Plane && aS2.GetType() == GeomAbs_Plane)
+  {
+    return BRep_Tool::Continuity(theE, theF1, theF2) > GeomAbs_C0;
+  }
+  return ChFi3d::IsTangentFaces(theE, theF1, theF2);
+}
+
+//! Issue 034 A3. How the offset of a kept face F meets the removed face C
+//! ("cork") across a shared edge E (round 2). Heights are measured along the
+//! common outward normal n of F and C (G1 along E). At distance s from E into
+//! F, with k_F and k_C the normal curvatures of F and C across E (along n):
+//!   offset of F:  h(s) = t + k_off s^2 / 2,  k_off = k_F / (1 - t k_F)
+//!   surface of C: h(s) =     k_C   s^2 / 2   (C continued across E)
+//! so the gap is g(s) = t + (k_off - k_C) s^2 / 2 (Maekawa 1999 for k_off):
+//!  - t (k_off - k_C) < 0: the offset CROSSES the cork surface next to E
+//!    (convex edge outward, concave edge inward, a cylinder under a
+//!    hemisphere inward): trimming by the cork is well posed and its limit
+//!    for a vanishing blend radius is the sharp-edge rule of OCCT (the
+//!    offset is extended to the cork and cut there) -> context cork;
+//!  - otherwise the offset runs AWAY from the cork (convex inward, concave
+//!    outward): no crossing, the rim is the wall E -> E + t n; its limit
+//!    at r = |t| is again the sharp rule (the offset of the next face meets
+//!    the cork plane at the wall's foot);
+//!  - 1 - t k <= margin (a principal factor at E): the offset of F
+//!    collapses at the rim (a blend smaller than the offset): neither rule,
+//!    the vanishing-face construction of lane B2 or the stock path.
+enum RimKind034
+{
+  RimKind034_Sharp    = 0, //!< not tangent
+  RimKind034_Cross    = 1, //!< tangent, the offset crosses the cork surface
+  RimKind034_Away     = 2, //!< tangent, the offset runs away from it (wall)
+  RimKind034_Collapse = 3, //!< tangent, the offset collapses at the rim
+  RimKind034_Unknown  = 4  //!< tangent, kind changes along the edge or not computable
+};
+
+//! Normal curvature of theS at (theU, theV) along the parameter direction
+//! (theA, theB), signed along theN (unit). False at a singular point.
+static bool normalCurvature034(const BRepAdaptor_Surface& theS,
+                               const double               theU,
+                               const double               theV,
+                               const double               theA,
+                               const double               theB,
+                               const gp_Vec&              theN,
+                               double&                    theK)
+{
+  gp_Pnt aP;
+  gp_Vec aSu, aSv, aSuu, aSvv, aSuv;
+  theS.D2(theU, theV, aP, aSu, aSv, aSuu, aSvv, aSuv);
+  const double aI = aSu.SquareMagnitude() * theA * theA + 2. * aSu.Dot(aSv) * theA * theB
+                    + aSv.SquareMagnitude() * theB * theB;
+  if (aI <= 1.e-300)
+  {
+    return false;
+  }
+  theK = (aSuu.Dot(theN) * theA * theA + 2. * aSuv.Dot(theN) * theA * theB
+          + aSvv.Dot(theN) * theB * theB)
+         / aI;
+  return true;
+}
+
+//! Outward unit normal of theF at (theU, theV); false where undefined.
+static bool outwardNormal034(const BRepAdaptor_Surface& theS,
+                             const TopoDS_Face&         theF,
+                             const double               theU,
+                             const double               theV,
+                             gp_Vec&                    theN)
+{
+  gp_Pnt aP;
+  gp_Vec aSu, aSv;
+  theS.D1(theU, theV, aP, aSu, aSv);
+  theN             = aSu.Crossed(aSv);
+  const double aNm = theN.Magnitude();
+  if (aNm <= 1.e-12 * std::max(aSu.Magnitude() * aSv.Magnitude(), 1.e-300))
+  {
+    return false;
+  }
+  theN.Divide(theF.Orientation() == TopAbs_REVERSED ? -aNm : aNm);
+  return true;
+}
+
+//! Issue 034 A3 round 2. Plane of a planar removed face theC (in the
+//! coordinates of the shape) and its outward unit normal theN. A B-spline or
+//! Bezier surface is planar when all its poles lie on the plane (convex hull
+//! property; positive weights): this holds whatever the placement of the
+//! poles, where the inertia test of GeomLib_IsPlanarSurface can miss a plane
+//! written in general position. Other surfaces: GeomLib_IsPlanarSurface.
+static bool corkPlane034(const TopoDS_Face& theC, gp_Pln& thePln, gp_Vec& theN)
+{
+  TopLoc_Location                  aLoc;
+  const occ::handle<Geom_Surface>& aS = BRep_Tool::Surface(theC, aLoc);
+  if (aS.IsNull())
+  {
+    return false;
+  }
+  const BRepAdaptor_Surface aBAS(theC, false);
+  double                    aU0, aU1, aV0, aV1;
+  BRepTools::UVBounds(theC, aU0, aU1, aV0, aV1);
+  const double aUm = 0.5 * (aU0 + aU1), aVm = 0.5 * (aV0 + aV1);
+  if (!outwardNormal034(aBAS, theC, aUm, aVm, theN))
+  {
+    return false;
+  }
+  const gp_Pnt        aP0 = aBAS.Value(aUm, aVm); // with the location
+  const gp_Dir        aD(theN);
+  const double        aTol = Precision::Confusion();
+  const GeomAdaptor_Surface aGAS(aS);
+  const gp_Trsf       aT = aLoc.Transformation();
+  auto aOnPlane = [&aP0, &aD, aTol, &aT](const gp_Pnt& theP) {
+    return std::abs(gp_Vec(aP0, theP.Transformed(aT)).Dot(gp_Vec(aD))) <= aTol;
+  };
+  if (aGAS.GetType() == GeomAbs_Plane)
+  {
+    thePln = gp_Pln(aP0, aD);
+    return true;
+  }
+  if (aGAS.GetType() == GeomAbs_BSplineSurface)
+  {
+    const occ::handle<Geom_BSplineSurface> aB = aGAS.BSpline();
+    for (int i = 1; i <= aB->NbUPoles(); ++i)
+    {
+      for (int j = 1; j <= aB->NbVPoles(); ++j)
+      {
+        if (!aOnPlane(aB->Pole(i, j)))
+        {
+          return false;
+        }
+      }
+    }
+    thePln = gp_Pln(aP0, aD);
+    return true;
+  }
+  if (aGAS.GetType() == GeomAbs_BezierSurface)
+  {
+    const occ::handle<Geom_BezierSurface> aB = aGAS.Bezier();
+    for (int i = 1; i <= aB->NbUPoles(); ++i)
+    {
+      for (int j = 1; j <= aB->NbVPoles(); ++j)
+      {
+        if (!aOnPlane(aB->Pole(i, j)))
+        {
+          return false;
+        }
+      }
+    }
+    thePln = gp_Pln(aP0, aD);
+    return true;
+  }
+  GeomLib_IsPlanarSurface aPlanarity(aS, aTol);
+  if (!aPlanarity.IsPlanar())
+  {
+    return false;
+  }
+  gp_Pln aPln = aPlanarity.Plan();
+  aPln.Transform(aT);
+  if (!aPln.Axis().Direction().IsParallel(aD, Precision::Angular()) || !aOnPlane(aPln.Location().Transformed(aT.Inverted())))
+  {
+    return false;
+  }
+  thePln = gp_Pln(aP0, aD);
+  return true;
+}
+
+//! Issue 034 A3. Kind of the rim edge theE between the kept face theF
+//! (offset theOffset) and the cork theC (see RimKind034). Five samples
+//! inside the edge; every sample must give the same kind.
+static RimKind034 rimEdgeKind034(const TopoDS_Edge& theE,
+                                 const TopoDS_Face& theF,
+                                 const TopoDS_Face& theC,
+                                 const double       theOffset,
+                                 double&            theCross)
+{
+  if (!edgeTangent034(theE, theF, theC))
+  {
+    return RimKind034_Sharp;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    // orientation of theE on the natural side of theF (material on its left)
+    TopAbs_Orientation anOrF = TopAbs_EXTERNAL;
+    int                aNbUse = 0;
+    for (TopExp_Explorer anExp(theF.Oriented(TopAbs_FORWARD), TopAbs_EDGE); anExp.More();
+         anExp.Next())
+    {
+      if (anExp.Current().IsSame(theE))
+      {
+        anOrF = anExp.Current().Orientation();
+        ++aNbUse;
+      }
+    }
+    if (aNbUse != 1 || (anOrF != TopAbs_FORWARD && anOrF != TopAbs_REVERSED)
+        || std::abs(theOffset) <= Precision::Confusion())
+    {
+      return RimKind034_Unknown; // seam or internal use: not a rim
+    }
+    double                          aF0, aL0, aC0, aC1;
+    const occ::handle<Geom2d_Curve> aPCF = BRep_Tool::CurveOnSurface(theE, theF, aF0, aL0);
+    const occ::handle<Geom2d_Curve> aPCC = BRep_Tool::CurveOnSurface(theE, theC, aC0, aC1);
+    if (aPCF.IsNull() || aPCC.IsNull())
+    {
+      return RimKind034_Unknown;
+    }
+    const BRepAdaptor_Surface aSF(theF), aSC(theC);
+    const BRepAdaptor_Curve   aCE(theE);
+    const double              aMargin = Precision::Confusion() / std::abs(theOffset);
+    int                       aKind   = -1;
+    for (int i = 1; i <= 5; ++i)
+    {
+      const double aW = aF0 + (aL0 - aF0) * i / 6.;
+      gp_Pnt2d     aUVF;
+      gp_Vec2d     aTF;
+      aPCF->D1(aW, aUVF, aTF);
+      // the same point on theC through the 3D curve parameter (SameParameter)
+      const gp_Pnt2d aUVC = aPCC->Value(aC0 + (aC1 - aC0) * (aW - aF0) / (aL0 - aF0));
+      gp_Vec         aNF, aNC;
+      if (!outwardNormal034(aSF, theF, aUVF.X(), aUVF.Y(), aNF)
+          || !outwardNormal034(aSC, theC, aUVC.X(), aUVC.Y(), aNC) || aNF.Dot(aNC) <= 0.)
+      {
+        return RimKind034_Unknown;
+      }
+      // regularity of the offset of theF at the rim: every principal factor
+      double aFct = 1.;
+      {
+        TopLoc_Location                  aLoc;
+        const occ::handle<Geom_Surface>& aGS = BRep_Tool::Surface(theF, aLoc);
+        double                           aU0, aU1, aV0, aV1;
+        BRepTools::UVBounds(theF, aU0, aU1, aV0, aV1);
+        const double aD = (theF.Orientation() == TopAbs_REVERSED) ? -theOffset : theOffset;
+        if (!aGS.IsNull()
+            && offsetFactor034(*aGS, aUVF.X(), aUVF.Y(), aU1 - aU0, aV1 - aV0, aD, aFct)
+            && aFct <= aMargin)
+        {
+          if (aKind >= 0 && aKind != RimKind034_Collapse)
+          {
+            return RimKind034_Unknown;
+          }
+          aKind = RimKind034_Collapse;
+          continue;
+        }
+      }
+      // direction across theE into theF: left of the pcurve on the natural side
+      const double aS = (anOrF == TopAbs_FORWARD) ? 1. : -1.;
+      const double aA = -aS * aTF.Y(), aB = aS * aTF.X();
+      double       aKF, aKC;
+      if (!normalCurvature034(aSF, aUVF.X(), aUVF.Y(), aA, aB, aNF, aKF))
+      {
+        return RimKind034_Unknown;
+      }
+      // the same 3D direction in the parameters of theC
+      gp_Pnt aP;
+      gp_Vec aSu, aSv, aCu, aCv;
+      aSF.D1(aUVF.X(), aUVF.Y(), aP, aSu, aSv);
+      const gp_Vec aDir = aSu * aA + aSv * aB;
+      aSC.D1(aUVC.X(), aUVC.Y(), aP, aCu, aCv);
+      const double anE = aCu.SquareMagnitude(), aFF = aCu.Dot(aCv), aG = aCv.SquareMagnitude();
+      const double aDet = anE * aG - aFF * aFF;
+      if (aDet <= 1.e-300)
+      {
+        return RimKind034_Unknown;
+      }
+      const double aDu = aDir.Dot(aCu), aDv = aDir.Dot(aCv);
+      if (!normalCurvature034(aSC,
+                              aUVC.X(),
+                              aUVC.Y(),
+                              (aG * aDu - aFF * aDv) / aDet,
+                              (anE * aDv - aFF * aDu) / aDet,
+                              aNF,
+                              aKC))
+      {
+        return RimKind034_Unknown;
+      }
+      const double aKOff = aKF / (1. - theOffset * aKF);
+      // |t (k_off - k_C)| <= 1e-9: a crossing would lie more than ~4.5e4 |t|
+      // away from the rim - parallel (decision D-A3-7)
+      const double aGap  = theOffset * (aKOff - aKC);
+      const int    aHere = aGap < -1.e-9 ? RimKind034_Cross : RimKind034_Away;
+      if (aHere == RimKind034_Cross)
+      {
+        // second-order distance of the crossing from E: 2|t| / |k_off - k_C|
+        // (not below the true one on circular sections)
+        theCross = std::max(theCross, std::sqrt(2. * std::abs(theOffset) / std::abs(aKOff - aKC)));
+      }
+      if (aKind >= 0 && aKind != aHere)
+      {
+        return RimKind034_Unknown;
+      }
+      aKind = aHere;
+    }
+    return aKind < 0 ? RimKind034_Unknown : static_cast<RimKind034>(aKind);
+  }
+  catch (Standard_Failure const&)
+  {
+  }
+  return RimKind034_Unknown;
+}
+
+//! Issue 034 A3. Class of a removed face ("cork") of a thick solid:
+//! 0 - no tangent rim edge (stock path, unchanged);
+//! 1 - WALL cork: every rim edge tangent with the offset running away from
+//!     the cork and regular (no image, walls E -> E + t n);
+//! 2 - CONTEXT cork with tangent crossing edges (the others sharp): stock
+//!     trimming by the cork, the result is checked;
+//! 3 - anything else with a tangent edge (collapsing offset at the rim,
+//!     wall and trimming edges on one cork, kind not computable, or, arc
+//!     join, a tube of a sharp kept edge ending on the rim of a wall cork):
+//!     stock path, the result is checked;
+//! 4 - like 2 with crossing edges only: stock trimming first; where it
+//!     fails, the wall construction with the rim bead cut off by the plane
+//!     of the removed face (the flush construction in MakeThickSolid()). theCross: largest second-order
+//!     distance of the crossing from the rim.
+//! theEF: edge -> faces of the whole input; theCorks: all removed faces.
+static int corkKind034(
+  const TopoDS_Shape& theCork,
+  const NCollection_IndexedDataMap<TopoDS_Shape,
+                                   NCollection_List<TopoDS_Shape>,
+                                   TopTools_ShapeMapHasher>&                   theEF,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&         theCorks,
+  const double                                                                 theOffset,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>&    theFaceOffset,
+  const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& thePlanface,
+  const NCollection_IndexedDataMap<TopoDS_Shape,
+                                   NCollection_List<TopoDS_Shape>,
+                                   TopTools_ShapeMapHasher>&                   theVE,
+  const GeomAbs_JoinType                                                       theJoin,
+  double&                                                                      theCross)
+{
+  int aNb[5] = {0, 0, 0, 0, 0};
+  theCross   = 0.;
+  for (TopExp_Explorer anExp(theCork, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+    if (BRep_Tool::Degenerated(anE))
+    {
+      continue;
+    }
+    const NCollection_List<TopoDS_Shape>* aLF = theEF.Seek(anE);
+    if (aLF == nullptr)
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(*aLF); anIt.More(); anIt.Next())
+    {
+      const TopoDS_Shape& aF = anIt.Value();
+      if (aF.IsSame(theCork) || theCorks.Contains(aF))
+      {
+        continue;
+      }
+      const double* anOff = theFaceOffset.Seek(aF);
+      if (anOff == nullptr)
+      {
+        const TopoDS_Shape* aPF = thePlanface.Seek(aF);
+        anOff                   = aPF != nullptr ? theFaceOffset.Seek(*aPF) : nullptr;
+      }
+      ++aNb[rimEdgeKind034(anE,
+                           TopoDS::Face(aF),
+                           TopoDS::Face(theCork),
+                           anOff != nullptr ? *anOff : theOffset,
+                           theCross)];
+    }
+  }
+  const int aNbTan = aNb[1] + aNb[2] + aNb[3] + aNb[4];
+  if (aNbTan == 0)
+  {
+    return 0;
+  }
+  if (aNb[3] + aNb[4] != 0 || (aNb[2] != 0 && aNb[0] + aNb[1] != 0))
+  {
+    return 3;
+  }
+  if (aNb[1] != 0)
+  {
+    // tangent crossing edges, the others sharp; 4 = crossing edges only
+    return aNb[0] == 0 ? 4 : 2;
+  }
+  if (theJoin == GeomAbs_Arc)
+  {
+    // A sharp kept edge ending on the rim that gets an arc tube (convex for
+    // an outward offset, concave for an inward one): the tube meets the rim
+    // in an arc whose angle vanishes where the edge ends tangentially; the
+    // walls do not model that end -> not a wall cork.
+    const ChFiDS_TypeOfConcavity aTubeType = theOffset > 0. ? ChFiDS_Convex : ChFiDS_Concave;
+    for (TopExp_Explorer aVExp(theCork, TopAbs_VERTEX); aVExp.More(); aVExp.Next())
+    {
+      const NCollection_List<TopoDS_Shape>* aLE = theVE.Seek(aVExp.Current());
+      if (aLE == nullptr)
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator anItE(*aLE); anItE.More(); anItE.Next())
+      {
+        const TopoDS_Edge&                    anE = TopoDS::Edge(anItE.Value());
+        const NCollection_List<TopoDS_Shape>* aLF = theEF.Seek(anE);
+        if (BRep_Tool::Degenerated(anE) || aLF == nullptr || aLF->Extent() != 2)
+        {
+          continue;
+        }
+        const TopoDS_Face& aF1 = TopoDS::Face(aLF->First());
+        const TopoDS_Face& aF2 = TopoDS::Face(aLF->Last());
+        if (theCorks.Contains(aF1) || theCorks.Contains(aF2) || edgeTangent034(anE, aF1, aF2))
+        {
+          continue;
+        }
+        if (ChFi3d::DefineConnectType(anE, aF1, aF2, std::sin(Precision::Angular()), false)
+            == aTubeType)
+        {
+          return 3;
+        }
+      }
+    }
+  }
+  return 1;
+}
+
+//! Issue 034 A3. A vertex on a free boundary where every other edge is
+//! tangent: all its faces share the normal there, so the offset of the
+//! vertex is one point and the offset faces must share one vertex (as for a
+//! vertex inside a tangent fan). Free edges impose no normal; degenerated
+//! edges (poles) are points and count neither way. Without a free edge the
+//! stock rule applies unchanged.
+static bool tangentFan034(const BRepOffset_Analyse& theA, const TopoDS_Vertex& theV)
+{
+  int  aNbTan  = 0;
+  bool isOpen  = false;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theA.Ancestors(theV)); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anIt.Value());
+    if (BRep_Tool::Degenerated(anE))
+    {
+      continue;
+    }
+    const NCollection_List<BRepOffset_Interval>& aLI = theA.Type(anE);
+    if (aLI.IsEmpty())
+    {
+      return false;
+    }
+    for (NCollection_List<BRepOffset_Interval>::Iterator anItI(aLI); anItI.More(); anItI.Next())
+    {
+      if (anItI.Value().Type() != aLI.First().Type())
+      {
+        return false;
+      }
+    }
+    if (aLI.First().Type() == ChFiDS_Tangential)
+    {
+      ++aNbTan;
+    }
+    else if (aLI.First().Type() == ChFiDS_FreeBound)
+    {
+      isOpen = true;
+    }
+    else
+    {
+      return false;
+    }
+  }
+  return aNbTan > 0 && isOpen;
+}
+
+//! Issue 034 A3. Record of SetFaces() for the object that runs (no new
+//! members: the class layout stays that of OCCT 8.0.1): the removed faces
+//! that are context faces (the offsets of their neighbours are extended to
+//! them and they are trimmed to the rim) - all of them except the wall
+//! corks, which get no image - in the order of myFaces; and whether some
+//! removed face has a tangent rim edge (then the result is checked).
+struct CorkRecord034
+{
+  const void*                                                   Owner = nullptr;
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> Context;
+  bool                                                          Tangent = false;
+  //! planar removed faces (as given) whose rim edges all cross, with the
+  //! crossing distance: the flush fallback of MakeThickSolid()
+  NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher> Crossing;
+};
+
+thread_local CorkRecord034 THE_CORK_RECORD_034;
+
+//! The object whose crossing corks are built as wall corks (the inner run
+//! of the flush fallback). Set only through ScopedOwner034.
+thread_local const void* THE_FORCE_WALLS_034 = nullptr;
+
+//! Sets a thread-local owner pointer for the lifetime of the scope and puts
+//! the previous value back on EVERY exit of the scope: normal return,
+//! Standard_Failure, any other C++ exception (and, built with /EHa, a
+//! structured exception). An owner pointer left behind by an exception
+//! would name a destroyed object, and a later object created at the same
+//! address would take that object's role (review offset-A3 r2, R1).
+class ScopedOwner034
+{
+public:
+  ScopedOwner034(const void*& theSlot, const void* theOwner)
+      : mySlot(theSlot),
+        myPrev(theSlot)
+  {
+    mySlot = theOwner;
+  }
+
+  ~ScopedOwner034() { mySlot = myPrev; }
+
+  ScopedOwner034(const ScopedOwner034&)            = delete;
+  ScopedOwner034& operator=(const ScopedOwner034&) = delete;
+
+private:
+  const void*& mySlot;
+  const void*  myPrev;
+};
+
+//! The context corks of theOwner: the removed faces that have an image (all
+//! but the wall corks), taken from theFaces as they are NOW, in their order
+//! and orientation (MakeOffsetShape() re-keys the removed faces with their
+//! orientation in the shape after SetFaces(), RemoveCorks()): rebuilt at
+//! every call, so the steps see exactly the stock list when no cork is a
+//! wall cork.
+static const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& contextCorks034(
+  const void*                                                          theOwner,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theFaces,
+  const BRepAlgo_Image&                                                theInitOffsetFace)
+{
+  CorkRecord034& aRec = THE_CORK_RECORD_034;
+  if (aRec.Owner != theOwner)
+  {
+    aRec.Owner   = theOwner;
+    aRec.Tangent = false;
+    aRec.Crossing.Clear();
+  }
+  aRec.Context.Clear();
+  for (int i = 1; i <= theFaces.Extent(); ++i)
+  {
+    if (theInitOffsetFace.HasImage(theFaces(i)))
+    {
+      aRec.Context.Add(theFaces(i));
+    }
+  }
+  return aRec.Context;
+}
+
+//! Releases the record of theOwner (the shapes it holds).
+struct CorkRecordRelease034
+{
+  const void* Owner;
+
+  ~CorkRecordRelease034()
+  {
+    if (THE_CORK_RECORD_034.Owner == Owner)
+    {
+      THE_CORK_RECORD_034.Owner   = nullptr;
+      THE_CORK_RECORD_034.Tangent = false;
+      THE_CORK_RECORD_034.Context.Clear();
+      THE_CORK_RECORD_034.Crossing.Clear();
+    }
+  }
+};
+} // namespace
+
+//=======================================================================
+// Issue 034, lane R-034-inner: removed faces with a loop that leads to
+// material.
+//
+// A removed face (cork) can separate the kept faces into several pieces:
+// the plate top over a blind pocket (the pocket rim is an inner loop of
+// the top; the pocket walls and floor are a piece of their own), a pocket
+// floor around an island. The thick solid is the input minus its inner
+// offset with the removed faces as openings (Rossignac-Requicha 1986); the
+// offset of a union is the union of the offsets (the Minkowski sum
+// distributes over the union), so the thick solid of such an input is the
+// union of the thick solids of the pieces: one lump per piece, disjoint
+// unless two pieces come closer than the thickness. The offset
+// construction is local (faces, edges, vertices and their neighbours), so
+// it builds every piece as it stands; three global places assumed one
+// piece: the input check, the side of the trace on the cork, and the
+// assembly of the result into one solid.
+//
+// Side of the trace. The offset of a kept face next to a cork is cut by
+// the cork surface; the wall of the opening is the band of that surface
+// between the rim edge and the trace. For a CONVEX rim edge and an inward
+// offset (a concave rim edge and an outward offset) the trace lies inside
+// the cork; for the two other combinations it lies outside (the band
+// extends the cork beyond its boundary: the floor of a pocket with sharp
+// walls, the base of an island). The stock code takes the side from the
+// sign of the offset only (marked "Temporary" there), i.e. it assumes
+// convex rims. A cork whose rim edges are all concave gets the other side
+// here; every other cork keeps the stock rule.
+//
+// Crossing traces. Where the offsets of the two neighbours of a rim vertex
+// overlap (a sharp concave edge and an outward offset: the rim of a
+// pocket or of a hole in the removed top; a sharp convex edge and an
+// inward offset at a concave cork: the base of an island), their traces
+// cross on the cork. On a cork whose band is built on the face as it
+// stands (InSide false) the stock 2D intersection gave the crossing
+// vertex the opposite orientation to the one of the offset faces, which
+// lost their loops (intersectCork034in()).
+//=======================================================================
+namespace
+{
+//! Number of connected pieces (shells glued through shared edges) of the faces of theS.
+static int nbPieces034in(const TopoDS_Shape& theS)
+{
+  BRepTools_Quilt aGlue;
+  for (TopExp_Explorer aFExp(theS, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aGlue.Add(aFExp.Current());
+  }
+  int aNb = 0;
+  for (TopExp_Explorer aShExp(aGlue.Shells(), TopAbs_SHELL); aShExp.More(); aShExp.Next())
+  {
+    ++aNb;
+  }
+  return aNb;
+}
+
+//! True if the kept faces theKept together with the removed faces theCorks
+//! are one connected piece (the removal alone split the kept faces).
+static bool connectedWithCorks034in(
+  const TopoDS_Shape&                                                  theKept,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theCorks)
+{
+  TopoDS_Compound aC;
+  BRep_Builder    aB;
+  aB.MakeCompound(aC);
+  for (TopExp_Explorer aFExp(theKept, TopAbs_FACE); aFExp.More(); aFExp.Next())
+  {
+    aB.Add(aC, aFExp.Current());
+  }
+  for (int i = 1; i <= theCorks.Extent(); ++i)
+  {
+    aB.Add(aC, theCorks(i));
+  }
+  return nbPieces034in(aC) == 1;
+}
+
+//! Sine of the angular tolerance of the edge analysis, as computed in
+//! MakeOffsetShape() for BRepOffset_Analyse::Perform().
+static double analyseSinTol034in(const double theTol, const double theOffset)
+{
+  const double aCoeff =
+    std::min(theTol / (std::abs(theOffset * 0.5) + Precision::Confusion()), 1.0);
+  return std::abs(std::sin(4. * std::asin(aCoeff)));
+}
+
+//! True if every rim edge of the cork theCork (an edge it shares with a
+//! kept face) is a sharp CONCAVE edge of the input, and the cork has no free
+//! edge and shares no edge or vertex with another cork. The convexity is the
+//! one of BRepOffset_Analyse (ChFi3d::DefineConnectType, same tolerance).
+static bool concaveCork034in(
+  const TopoDS_Face&                                                   theCork,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theCorks,
+  const BRepOffset_Analyse&                                            theAnalyse,
+  const double                                                         theSinTol)
+{
+  bool isAny = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    for (TopExp_Explorer anEExp(theCork, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anEExp.Current());
+      if (BRep_Tool::Degenerated(anE))
+      {
+        continue;
+      }
+      if (!theAnalyse.HasAncestor(anE) || theAnalyse.Ancestors(anE).Extent() != 1)
+      {
+        return false; // free edge, edge between corks, or non-manifold
+      }
+      const TopoDS_Face& aF = TopoDS::Face(theAnalyse.Ancestors(anE).First());
+      if (BRep_Tool::Continuity(anE, theCork, aF) > GeomAbs_C0
+          || ChFi3d::DefineConnectType(anE, theCork, aF, theSinTol, false) != ChFiDS_Concave)
+      {
+        return false;
+      }
+      isAny = true;
+    }
+    // no vertex shared with another cork (the loops of such corks are built together)
+    for (int i = 1; i <= theCorks.Extent(); ++i)
+    {
+      if (theCorks(i).IsSame(theCork))
+      {
+        continue;
+      }
+      NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aVs;
+      for (TopExp_Explorer aVExp(theCorks(i), TopAbs_VERTEX); aVExp.More(); aVExp.Next())
+      {
+        aVs.Add(aVExp.Current());
+      }
+      for (TopExp_Explorer aVExp(theCork, TopAbs_VERTEX); aVExp.More(); aVExp.Next())
+      {
+        if (aVs.Contains(aVExp.Current()))
+        {
+          return false;
+        }
+      }
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  return isAny;
+}
+
+//! Splits the corks by the side of the trace of the offsets of their
+//! neighbours: theIn (inside the cork, the stock rule of an inward offset)
+//! and theOut. Every cork follows the stock rule (side given by the sign of
+//! the offset) except the concave ones. Returns true when some cork is on
+//! the other side than the stock rule gives.
+//! 034 integration: theCorks are the context corks of the step (issue 034
+//! A3: the removed faces with an image; wall corks are built as walls and
+//! take no part), theAll all removed faces (a cork that shares a vertex
+//! with any removed face is not concave); both are myFaces when there is
+//! no wall cork, as in lane R-034-inner.
+static bool splitCorks034in(
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theCorks,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theAll,
+  const BRepOffset_Analyse&                                            theAnalyse,
+  const double                                                         theOffset,
+  const double                                                         theTol,
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&       theIn,
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&       theOut)
+{
+  const double aSinTol   = analyseSinTol034in(theTol, theOffset);
+  const bool   isStockIn = (theOffset < 0.);
+  bool         isChanged = false;
+  for (int i = 1; i <= theCorks.Extent(); ++i)
+  {
+    const bool isConcave =
+      concaveCork034in(TopoDS::Face(theCorks(i)), theAll, theAnalyse, aSinTol);
+    const bool isIn = isConcave ? !isStockIn : isStockIn;
+    isChanged       = isChanged || isConcave;
+    if (isIn)
+    {
+      theIn.Add(theCorks(i));
+    }
+    else
+    {
+      theOut.Add(theCorks(i));
+    }
+  }
+  return isChanged;
+}
+
+//! Reverses, on each cork of theConcave, the edges that the intersection
+//! with the offsets stored on it (the traces; the cork's own edges are left
+//! as they are). The intersection orients a trace for a convex rim (band
+//! between the rim outside and the trace inside); on a concave cork the
+//! band lies between the trace outside and the rim inside.
+//! theOnOffsets: the same trace is also reversed on the offset faces that
+//! hold it (join by intersection: BRepOffset_Tool::Inter3D orients the
+//! section on BOTH faces from the normals as for a convex rim, so the
+//! offset of a wall on a concave rim would keep its part on the wrong
+//! side of the cork; the arc join orients the offset side by itself).
+static void reverseTraces034in(
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theConcave,
+  const occ::handle<BRepAlgo_AsDes>&                                   theAsDes,
+  const bool                                                           theOnOffsets = false)
+{
+  for (int i = 1; i <= theConcave.Extent(); ++i)
+  {
+    const TopoDS_Shape& aCork = theConcave(i);
+    if (!theAsDes->HasDescendant(aCork))
+    {
+      continue;
+    }
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> anOwn;
+    for (TopExp_Explorer anEExp(aCork, TopAbs_EDGE); anEExp.More(); anEExp.Next())
+    {
+      anOwn.Add(anEExp.Current());
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(theAsDes->ChangeDescendant(aCork));
+         anIt.More();
+         anIt.Next())
+    {
+      if (anOwn.Contains(anIt.Value()))
+      {
+        continue;
+      }
+      anIt.ChangeValue().Reverse();
+      if (!theOnOffsets || !theAsDes->HasAscendant(anIt.Value()))
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator anAIt(theAsDes->Ascendant(anIt.Value()));
+           anAIt.More();
+           anAIt.Next())
+      {
+        const TopoDS_Shape& anOF = anAIt.Value();
+        if (anOF.IsSame(aCork) || anOF.ShapeType() != TopAbs_FACE
+            || !theAsDes->HasDescendant(anOF))
+        {
+          continue;
+        }
+        for (NCollection_List<TopoDS_Shape>::Iterator anOIt(theAsDes->ChangeDescendant(anOF));
+             anOIt.More();
+             anOIt.Next())
+        {
+          if (anOIt.Value().IsSame(anIt.Value()))
+          {
+            anOIt.ChangeValue().Reverse();
+          }
+        }
+      }
+    }
+  }
+}
+
+//! 2D intersection on a cork whose band is built on the face as it stands
+//! (BuildOnContext() with InSide false), with the crossings of its traces
+//! (the edges an offset face holds too) oriented as on the offset faces.
+//!
+//! BRepOffset_Inter2d orients a crossing vertex on an edge from the
+//! orientation of the OTHER edge in the face being intersected. Two traces
+//! that cross each other on the cork (the offsets of the two neighbours of
+//! a rim vertex overlap: a sharp concave edge with an outward offset, a
+//! sharp convex edge with an inward one at a concave cork) meet where the
+//! offset faces themselves meet, and the same vertex is computed on those
+//! offset faces. The trace is kept between its crossings on both faces,
+//! but on the cork it lies on the far side of the other trace's band, so
+//! with the band as material the cork gives the opposite orientation. The
+//! fused vertex then sits twice on the trace with both orientations and
+//! the offset face loses its loop: its wall and the band of the cork are
+//! missing (stock: "command not done" for a removed top over a through
+//! hole with an outward offset). On a cork built reversed (InSide true)
+//! the material side is the other one and both faces agree.
+//!
+//! The trace x trace pairs are therefore intersected first, with the
+//! traces reversed; every other pair (a trace with an edge of the cork or
+//! with an edge between corks) is intersected as in the stock code, the
+//! trace pairs being marked as done in theEdgeIntEdges for that pass.
+static void intersectCork034in(
+  const TopoDS_Face&                                                   theCork,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theCorks,
+  const occ::handle<BRepAlgo_AsDes>&                                   theAsDes,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theNewEdges,
+  const double                                                         theTol,
+  NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>&
+    theEdgeIntEdges,
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>&
+                               theDMVV,
+  const Message_ProgressRange& theRange)
+{
+  Message_ProgressScope          aPS(theRange, nullptr, 2);
+  NCollection_List<TopoDS_Shape> aTraces;
+  if (theAsDes->HasDescendant(theCork))
+  {
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(theAsDes->Descendant(theCork)); anIt.More();
+         anIt.Next())
+    {
+      if (!theAsDes->HasAscendant(anIt.Value()))
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator anAIt(theAsDes->Ascendant(anIt.Value()));
+           anAIt.More();
+           anAIt.Next())
+      {
+        if (anAIt.Value().ShapeType() == TopAbs_FACE && !theCorks.Contains(anAIt.Value()))
+        {
+          aTraces.Append(anIt.Value());
+          break;
+        }
+      }
+    }
+  }
+  if (aTraces.Extent() < 2)
+  {
+    BRepOffset_Inter2d::Compute(theAsDes,
+                                theCork,
+                                theNewEdges,
+                                theTol,
+                                theEdgeIntEdges,
+                                theDMVV,
+                                aPS.Next(2));
+    return;
+  }
+  // pass 1: the traces alone, reversed
+  const NCollection_List<TopoDS_Shape> aSaved = theAsDes->Descendant(theCork);
+  NCollection_List<TopoDS_Shape>&      aList  = theAsDes->ChangeDescendant(theCork);
+  aList.Clear();
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(aTraces); anIt.More(); anIt.Next())
+  {
+    aList.Append(anIt.Value().Reversed());
+  }
+  BRepOffset_Inter2d::Compute(theAsDes,
+                              theCork,
+                              theNewEdges,
+                              theTol,
+                              theEdgeIntEdges,
+                              theDMVV,
+                              aPS.Next());
+  aList = aSaved;
+  // pass 2: the whole list, the trace x trace pairs marked as done
+  NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher> aKept;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aNew;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(aTraces); anIt.More(); anIt.Next())
+  {
+    const TopoDS_Shape& aT = anIt.Value();
+    if (theEdgeIntEdges.IsBound(aT))
+    {
+      if (!aKept.IsBound(aT))
+      {
+        aKept.Bind(aT, theEdgeIntEdges(aT));
+      }
+    }
+    else if (aNew.Add(aT))
+    {
+      theEdgeIntEdges.Bind(aT, NCollection_List<TopoDS_Shape>());
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt2(aTraces); anIt2.More(); anIt2.Next())
+    {
+      if (!anIt2.Value().IsSame(aT))
+      {
+        theEdgeIntEdges.ChangeFind(aT).Append(anIt2.Value());
+      }
+    }
+  }
+  BRepOffset_Inter2d::Compute(theAsDes,
+                              theCork,
+                              theNewEdges,
+                              theTol,
+                              theEdgeIntEdges,
+                              theDMVV,
+                              aPS.Next());
+  for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator anIt(aNew); anIt.More();
+       anIt.Next())
+  {
+    theEdgeIntEdges.UnBind(anIt.Key());
+  }
+  for (NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>::
+         Iterator anIt(aKept);
+       anIt.More();
+       anIt.Next())
+  {
+    theEdgeIntEdges.ChangeFind(anIt.Key()) = anIt.Value();
+  }
+}
+
+//! Signed volume enclosed by a closed shell (positive: an outer shell).
+static double shellVolume034in(const TopoDS_Shape& theShell)
+{
+  GProp_GProps aProps;
+  BRepGProp::VolumeProperties(theShell, aProps, true);
+  return aProps.Mass();
+}
+
+//! Full check of a result of the new constructions: BRepCheck and BOP
+//! self-interference (resultIsBroken034), and every solid encloses a
+//! positive volume (not inside out). An exception counts as broken.
+static bool innerResultBroken034in(const TopoDS_Shape& theRes)
+{
+  try
+  {
+    OCC_CATCH_SIGNALS
